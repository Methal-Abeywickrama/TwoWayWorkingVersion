  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 92.0]
    rotation: 0
    state: enabled
- name: TX_BUFFER
  id: variable
  parameters:
    comment: 'Pluto TX buffer (samples). Must be a

      multiple of 32 (8 bits x sps). The framer

      fills every burst to whole buffers.'
    value: BUFFER_SIZE * sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1016, 40.0]
    rotation: 0
    state: enabled
- name: TX_HOLD_MS

- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX (buffer-aligned)\n\
      \nSame frame format as before, so the deframer and the other PC are unchanged:\n\
      \  [preamble][1A CF FC 1D][len:2][dest:1][msg_id:1][rep:1][n_reps:1][payload][CRC32:4][tail][pad]\n\
      \n  tail  min_tail bytes (default 8). The Constellation Modulator's pulse-shaping\
      \ filter\n        delays the signal by about 22 symbols (88 samples at sps=4),\
      \ so the last CRC bits\n        only leave the modulator once a few more bytes\
      \ have gone in after them.\n  pad   fills the burst up to a whole number of\
      \ Pluto TX buffers, so the sink pushes the\n        whole burst at once and\
      \ nothing is left waiting in the sink.\n\n        samples per byte = (8 / bits_per_symbol)\
      \ * sps         (BPSK, sps 4: 32)\n        pad unit (bytes) = tx_buffer / samples\
      \ per byte          (4096 samples: 128 bytes)\n        tx_buffer must be the\
      \ Pluto sink's buffer size and a multiple of samples per byte.\n\nEvery burst\
      \ PDU carries this metadata. PDU to Tagged Stream turns each entry into a stream\n\
      tag on the burst's first byte; after the modulator the tags sit on the burst's\
      \ first sample:\n  tx_sob      True\n  burst_data  number of samples that carry\
      \ the frame (preamble ... tail)\n  burst_len   number of samples in the whole\
      \ burst (always n * tx_buffer)\nThe TX Burst Gate block reads these tags, blanks\
      \ the pad and switches the transmitter off.\n\"\"\"\nimport zlib\nimport pmt\n\
      from gnuradio import gr\n\nSYNC_WORD = bytes([0x1A, 0xCF, 0xFC, 0x1D])\nHDR_BYTES\
      \ = 6\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(self, peer_id=1,\
      \ preamble_len=512, repeat_count=1, max_payload_len=8192,\n                \
      \ preamble_byte=0xFF, tx_buffer=4096, sps=4, bits_per_symbol=1,\n          \
      \       min_tail=8, pad_byte=0x00):\n        gr.basic_block.__init__(self, name=\"\
      Packet Framer TX (Buffer-aligned Burst)\",\n                               \
      \ in_sig=None, out_sig=None)\n        self.peer_id = int(peer_id) & 0xFF\n \
      \       self.preamble_len = int(preamble_len)\n        self.repeat_count = int(repeat_count)\n\
      \        self.max_payload_len = min(int(max_payload_len), 0xFFFF)\n        self.preamble_byte\
      \ = int(preamble_byte) & 0xFF\n        self.tx_buffer = int(tx_buffer)\n   \
      \     self.sps = int(sps)\n        self.bits_per_symbol = int(bits_per_symbol)\n\
      \        self.min_tail = max(0, int(min_tail))\n        self.pad_byte = int(pad_byte)\
      \ & 0xFF\n        self._msg_id = 0\n        self._unit()                   \
      \   # fail early (in GRC) on a bad tx_buffer / sps\n\n        self.message_port_register_in(pmt.intern(\"\
      msg_in\"))\n        self.set_msg_handler(pmt.intern(\"msg_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    # samples\
      \ per byte and pad unit in bytes (re-read every frame, so GRC callbacks work)\n\
      \    def _unit(self):\n        if self.bits_per_symbol not in (1, 2, 4, 8):\n\
      \            raise ValueError(\"bits_per_symbol must be 1, 2, 4 or 8\")\n  \
      \      spb = (8 // self.bits_per_symbol) * self.sps\n        if self.tx_buffer\
      \ <= 0 or self.tx_buffer % spb:\n            raise ValueError(f\"tx_buffer ({self.tx_buffer})\
      \ must be a positive multiple of \"\n                             f\"{spb} samples\
      \ (8/bits_per_symbol * sps)\")\n        return spb, self.tx_buffer // spb\n\n\
      \    @staticmethod\n    def _extract_payload(msg):\n        if pmt.is_pair(msg):\n\
      \            data = pmt.cdr(msg)\n            if pmt.is_u8vector(data):\n  \
      \              return bytes(pmt.u8vector_elements(data))\n            return\
      \ str(pmt.to_python(data)).encode(\"utf-8\")\n        if pmt.is_symbol(msg):\n\
      \            return pmt.symbol_to_string(msg).encode(\"utf-8\")\n        val\
      \ = pmt.to_python(msg)\n        if isinstance(val, (bytes, bytearray)):\n  \
      \          return bytes(val)\n        return str(val).encode(\"utf-8\")\n\n\
      \    def build_burst(self, payload, msg_id, rep, n_reps):\n        \"\"\"Returns\
      \ (burst bytes, data samples, total samples).\"\"\"\n        spb, unit = self._unit()\n\
      \        header = len(payload).to_bytes(2, \"big\") + bytes([self.peer_id, msg_id,\
      \ rep, n_reps])\n        crc = zlib.crc32(header + payload).to_bytes(4, \"big\"\
      )\n        body = (bytes([self.preamble_byte]) * self.preamble_len + SYNC_WORD\
      \ + header + payload\n                + crc + bytes(self.min_tail))\n      \
      \  pad = (-len(body)) % unit\n        burst = body + bytes([self.pad_byte])\
      \ * pad\n        return burst, len(body) * spb, len(burst) * spb\n\n    def\
      \ handle_msg(self, msg):\n        try:\n            payload = self._extract_payload(msg)\n\
      \        except Exception as e:\n            print(f\"[TX] Could not parse message:\
      \ {e}\", flush=True)\n            return\n        if not payload:\n        \
      \    return\n        if len(payload) > self.max_payload_len:\n            print(f\"\
      [TX] Payload {len(payload)} B truncated to {self.max_payload_len} B\", flush=True)\n\
      \            payload = payload[:self.max_payload_len]\n\n        msg_id = self._msg_id\n\
      \        self._msg_id = (self._msg_id + 1) & 0xFF\n        n_reps = max(1, min(255,\
      \ self.repeat_count))\n\n        for rep in range(n_reps):\n            burst,\
      \ data_samps, total_samps = self.build_burst(payload, msg_id, rep, n_reps)\n\
      \            if rep == 0:\n                nbuf = total_samps // self.tx_buffer\n\
      \                print(f\"[TX] msg #{msg_id} (to peer {self.peer_id}): {len(payload)}\
      \ B payload, \"\n                      f\"burst {len(burst)} B = {nbuf} x {self.tx_buffer}\
      \ samples \"\n                      f\"(signal {data_samps}, blank {total_samps\
      \ - data_samps}), \"\n                      f\"{n_reps} burst(s)\", flush=True)\n\
      \            meta = pmt.make_dict()\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      tx_sob\"), pmt.PMT_T)\n            meta = pmt.dict_add(meta, pmt.intern(\"burst_data\"\
      ), pmt.from_long(data_samps))\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      burst_len\"), pmt.from_long(total_samps))\n            vec = pmt.init_u8vector(len(burst),\
      \ list(burst))\n            self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(meta,\
      \ vec))\n"
    affinity: ''
    alias: ''
    bits_per_symbol: '1'
    comment: ''
    max_payload_len: '8192'
    maxoutbuf: '0'
    min_tail: MIN_TAIL
    minoutbuf: '0'
    pad_byte: '0'
    peer_id: 1-MY_ID
    preamble_byte: '0xFF'
    preamble_len: '128'
    repeat_count: '5'
    sps: sps
    tx_buffer: TX_BUFFER
  states:
    _io_cache: ('Packet Framer TX (Buffer-aligned Burst)', 'PacketFramerTX', [('peer_id',
      '1'), ('preamble_len', '512'), ('repeat_count', '1'), ('max_payload_len', '8192'),
      ('preamble_byte', '255'), ('tx_buffer', '4096'), ('sps', '4'), ('bits_per_symbol',
      '1'), ('min_tail', '8'), ('pad_byte', '0')], [('msg_in', 'message', 1)], [('pdu_out',
      'message', 1)], '', ['bits_per_symbol', 'max_payload_len', 'min_tail', 'pad_byte',
      'peer_id', 'preamble_byte', 'preamble_len', 'repeat_count', 'sps', 'tx_buffer'])
    bus_sink: false
    bus_source: false

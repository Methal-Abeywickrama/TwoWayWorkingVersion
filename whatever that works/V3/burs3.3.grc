    bus_structure: null
    coordinate: [424, 88.0]
    rotation: 0
    state: enabled
- name: MIN_TAIL
  id: variable
  parameters:
    comment: 'Bytes after the CRC so the modulator''s

      RRC filter (~22 symbols) has sent the

      last bit before the gate blanks.'
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 40.0]
    rotation: 0
    state: enabled
- name: MY_ID

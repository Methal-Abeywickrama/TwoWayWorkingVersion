      \ echo_margin_db=self.echo_margin_db, gate_mode=1)\n        cws = \", \".join(str(self._cw_for(k))\
      \ for k in range(self.k_max + 1))\n        print(f\"[MAC] ID {self.my_id}: SR-ARQ\
      \ burst M={self.burst_m}, window N={self.window_n}, TXOP limit \"\n        \
      \      f\"{1e3 * self.txop_limit_s:g} ms | p-persist {self.p_persist:g}, slot\
      \ {1e3 * self.slot_s:g} ms, SIFS \"\n              f\"{1e3 * self.sifs_s:g}\
      \ ms, DIFS {1e3 * self.difs():.1f} ms, CW {cws}, retry limit {self.retry_limit},\

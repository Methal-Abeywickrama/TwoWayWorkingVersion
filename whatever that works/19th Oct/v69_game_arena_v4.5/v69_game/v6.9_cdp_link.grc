- name: epy_logger
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Session Logger (v6.9) - writes compact\
      \ performance logs of this flowgraph.\n\nFolder: log_dir if given, else $CDP_DEBUG_DIR\
      \ (set by cdp_daemon.py to its session folder), else\n~/cdp_debug/<date>_<time>_node<id>.\
      \ Files (CSV, one header line, times in seconds since t0 of flowgraph.json):\n\
      \  flowgraph.json   t0 (epoch), node, every block's settings\n  csma_txop.csv\
      \    one row per channel access (data burst, datagram burst, Block ACK): waits,\
      \ contention, airtime\n  csma_1s.csv      MAC state once a second while active\
      \ (every 10 s when idle)\n  arq_tx.csv       one row per Block ACK result /\
      \ timeout (window movement, retransmissions, drops)\n  arq_rx.csv       one\
      \ row per reliable frame received (reordering, duplicates, window)\n  udp.csv\
      \          one row per datagram sent / received (timestamps, one-way delay,\
      \ gaps)\n  msgs.csv         one row per reliable message (file / chat) sent\
      \ or received at the socket bridge\n  phy_1s.csv       receiver counters once\
      \ a second while frames arrive (sync, CRC, squelch, noise floor)\n  events.log\
      \       rare things worth reading (drops, late unmute, client connects, errors)\n\
      Columns are documented in LOGS.md (proc_cpu in csma_1s.csv = CPU of the whole\
      \ flowgraph process, 100 = one core).\nWiring: the message input 'attach' must\
      \ be connected (the .grc connects the bridge's mac_ctrl to it). GNU Radio only\n\
      runs blocks that sit on a stream or message connection; without one this block\
      \ is built but never started, so it\nwrites nothing (and prints no \"[LOG] performance\
      \ logs -> ...\" line). The messages themselves are ignored.\nNothing here changes\
      \ how the link works.\n\"\"\"\nimport json\nimport os\nimport socket\nimport\
      \ threading\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n#\
      \ ---- shared debug bus (one per flowgraph process; the Stress Test block writes\
      \ it to disk) ----\nimport sys as _sys\nimport types as _types\nimport collections\
      \ as _collections\nimport time as _time\n\n\ndef _bus():\n    b = _sys.modules.get(\"\
      cdp_dbg_bus\")\n    if b is None:\n        nb = _types.ModuleType(\"cdp_dbg_bus\"\
      )\n        nb.events = _collections.deque(maxlen=400000)   # dicts; oldest dropped\
      \ if nobody writes them\n        nb.sources = {}                           \
      \      # name -> object with dbg_snapshot()\n        b = _sys.modules.setdefault(\"\
      cdp_dbg_bus\", nb)\n    return b\n\n\ndef _emit(blk, kind, /, **kw):\n    kw[\"\
      t\"] = round(_time.time(), 6)\n    kw[\"blk\"] = blk\n    kw[\"k\"] = kind\n\
      \    _bus().events.append(kw)\n# ---- end debug bus ----\n\nCOLS = {\n    \"\
      csma_txop.csv\": [\"t\", \"kind\", \"dst\", \"bsn\", \"n\", \"bytes\", \"retx\"\
      , \"q\", \"wait_ms\", \"att_ms\", \"p_ms\", \"p_draws\",\n                 \
      \     \"bo\", \"cw\", \"defer\", \"busy_ms\", \"nav_ms\", \"unmute_ms\", \"\
      air_ms\", \"off_ms\", \"echo_ms\", \"res\",\n                      \"acked\"\
      , \"rtt_ms\", \"bitmap\", \"sns\"],\n    \"csma_1s.csv\": [\"t\", \"busy_pct\"\
      , \"nav_pct\", \"tx_pct\", \"floor_db\", \"thr_db\", \"queue\", \"udp_q\", \"\
      ba_due\", \"cw\", \"k\",\n                    \"phase\", \"awaiting_ba\", \"\
      rate_pct\", \"echo_ms\", \"mute\", \"mute_wr_max_ms\", \"deferrals\", \"busy_on\"\
      ,\n                    \"nav_set\", \"tx_D\", \"tx_BA\", \"ba_rx\", \"ba_timeout\"\
      , \"retry_drop\", \"rx_data\", \"rx_dup\", \"windows\",\n                  \
      \  \"proc_cpu\", \"load1\"],\n    \"arq_tx.csv\": [\"t\", \"dst\", \"what\"\
      , \"bsn\", \"acked\", \"nacked\", \"dropped\", \"ws0\", \"ws\", \"used\", \"\
      backlog\"],\n    \"arq_rx.csv\": [\"t\", \"src\", \"sn\", \"bsn\", \"idx\",\
      \ \"cnt\", \"dup\", \"deliv\", \"buf\", \"gaveup\", \"rws\", \"retry\", \"fec\"\
      ],\n    \"udp.csv\": [\"t\", \"dir\", \"peer\", \"useq\", \"bytes\", \"owd_ms\"\
      , \"iat_ms\", \"gap\", \"mac_sn\"],\n    \"msgs.csv\": [\"t\", \"dir\", \"peer\"\
      , \"mid\", \"ref\", \"bytes\", \"segs\", \"got\", \"frames_tx\", \"resent\"\
      , \"dups\", \"wait_s\",\n                 \"dur_s\", \"kBps\", \"owd_first_ms\"\
      , \"owd_max_ms\", \"res\"],\n    \"phy_1s.csv\": [\"t\", \"corr_tags\", \"corr_best\"\
      , \"train\", \"train_ok\", \"locks\", \"crc_fail\", \"bad_len\", \"ok\", \"\
      other\",\n                   \"own\", \"sq_eob\", \"noise_db\", \"squelch_db\"\
      ],\n}\nEVENT_KINDS = {\"seg_resend\", \"cancel\", \"udp_drop\", \"drop\", \"\
      retry_drop\", \"late_unmute\", \"ba_stray\", \"abort\", \"transitions_suppressed\"\
      ,\n               \"error\", \"client\", \"msg_submit_fail\"}\n\n\ndef ranges(xs):\n\
      \    \"\"\"[3,4,5,9] -> '3-5 9' (compact list of sequence numbers)\"\"\"\n \
      \   xs = sorted(int(x) for x in xs)\n    out, i = [], 0\n    while i < len(xs):\n\
      \        j = i\n        while j + 1 < len(xs) and xs[j + 1] == xs[j] + 1:\n\
      \            j += 1\n        out.append(str(xs[i]) if i == j else f\"{xs[i]}-{xs[j]}\"\
      )\n        i = j + 1\n    return \" \".join(out)\n\n\ndef cell(v):\n    if v\
      \ is None:\n        return \"\"\n    if isinstance(v, float):\n        return\
      \ f\"{v:.3f}\".rstrip(\"0\").rstrip(\".\") if abs(v) < 1e6 else f\"{v:.0f}\"\
      \n    if isinstance(v, (list, tuple)):\n        return ranges(v) if all(isinstance(x,\
      \ (int, np.integer)) for x in v) else \" \".join(map(str, v))\n    if isinstance(v,\
      \ dict):\n        return json.dumps(v, separators=(\",\", \":\"))\n    s = str(v)\n\
      \    return '\"' + s.replace('\"', \"'\") + '\"' if (\",\" in s or '\"' in s)\
      \ else s\n\n\nclass SessionLogger(gr.basic_block):\n    def __init__(self, my_id=1,\
      \ log_dir=\"\", flush_s=0.5, idle_every_s=10.0):\n        gr.basic_block.__init__(self,\
      \ name=\"Session Logger (performance logs)\", in_sig=None, out_sig=None)\n \
      \       self.my_id = int(my_id)\n        self.log_dir = str(log_dir)\n     \
      \   self.flush_s = float(flush_s)\n        self.idle_every_s = float(idle_every_s)\n\
      \        self._stop = threading.Event()\n        self._thr = None\n        self._f\
      \ = {}\n        self._t0 = None\n        self._cfg = {}\n        self._last_csma_row\
      \ = 0.0\n        self._last_phy_row = 0.0\n        self.dir = None\n       \
      \ self._cpu_last = None\n        self._ev_sec = {}                    # (blk,\
      \ kind) -> [second, count] : at most 5 identical lines per second\n        #\
      \ connected only so that GNU Radio runs this block (see Wiring above); what\
      \ arrives is ignored\n        self.message_port_register_in(pmt.intern(\"attach\"\
      ))\n        self.set_msg_handler(pmt.intern(\"attach\"), self._on_attach)\n\n\
      \    def _on_attach(self, msg):\n        pass\n\n    def start(self):\n    \
      \    d = self.log_dir or os.environ.get(\"CDP_DEBUG_DIR\", \"\")\n        if\
      \ not d:\n            d = os.path.join(os.path.expanduser(\"~/cdp_debug\"),\n\
      \                             _time.strftime(\"%Y%m%d_%H%M%S\") + f\"_node{self.my_id}\"\
      )\n        d = os.path.expanduser(d)\n        os.makedirs(d, exist_ok=True)\n\
      \        self.dir = d\n        self._t0 = _time.time()\n        for name, cols\
      \ in COLS.items():\n            f = open(os.path.join(d, name), \"w\", buffering=1\
      \ << 16)\n            f.write(\",\".join(cols) + \"\\n\")\n            self._f[name]\
      \ = f\n        self._f[\"events.log\"] = open(os.path.join(d, \"events.log\"\
      ), \"w\", buffering=1 << 14)\n        self._cfg = {\"t0\": round(self._t0, 3),\
      \ \"t0_local\": _time.strftime(\"%Y-%m-%d %H:%M:%S\"), \"node\": self.my_id,\n\
      \                     \"host\": socket.gethostname(), \"env\": {k: v for k,\
      \ v in os.environ.items() if k.startswith(\"CDP_\")},\n                    \
      \ \"blocks\": {}}\n        self._write_cfg()\n        _bus().sources[\"logger\"\
      ] = self\n        self._stop.clear()\n        self._thr = threading.Thread(target=self._run,\
      \ name=\"session-logger\", daemon=True)\n        self._thr.start()\n       \
      \ print(f\"[LOG] performance logs -> {d}\", flush=True)\n        return True\n\
      \n    def stop(self):\n        self._stop.set()\n        if self._thr is not\
      \ None:\n            self._thr.join(timeout=3.0)\n        self._drain()\n  \
      \      self._snapshots(final=True)\n        self._line(\"events.log\", f\"{self._rel():.3f}\
      \ flowgraph stopped\")\n        for f in self._f.values():\n            try:\n\
      \                f.close()\n            except Exception:\n                pass\n\
      \        return True\n\n    # ------------------------------------------------------------------\
      \ helpers\n    def _rel(self, t=None):\n        return (t if t is not None else\
      \ _time.time()) - self._t0\n\n    def _row(self, name, d):\n        try:\n \
      \           self._f[name].write(\",\".join(cell(d.get(c)) for c in COLS[name])\
      \ + \"\\n\")\n        except Exception:\n            pass\n\n    def _event(self,\
      \ t, blk, k, e):\n        key, sec = (blk, k), int(t)\n        cur = self._ev_sec.get(key)\n\
      \        if cur is None or cur[0] != sec:\n            if cur is not None and\
      \ cur[1] > 5:\n                self._line(\"events.log\", f\"{cur[0]}.999 {blk}\
      \ {k} ... {cur[1] - 5} more in that second\")\n            cur = self._ev_sec[key]\
      \ = [sec, 0]\n        cur[1] += 1\n        if cur[1] <= 5:\n            rest\
      \ = \" \".join(f\"{kk}={cell(v)}\" for kk, v in e.items() if kk not in (\"t\"\
      , \"blk\", \"k\", \"ts\"))\n            self._line(\"events.log\", f\"{t:.3f}\
      \ {blk} {k} {rest}\")\n\n    def _line(self, name, txt):\n        try:\n   \
      \         self._f[name].write(txt + \"\\n\")\n        except Exception:\n  \
      \          pass\n\n    def _write_cfg(self):\n        try:\n            with\
      \ open(os.path.join(self.dir, \"flowgraph.json\"), \"w\") as f:\n          \
      \      json.dump(self._cfg, f, indent=1, default=str)\n        except Exception:\n\
      \            pass\n\n    # ------------------------------------------------------------------\
      \ main loop\n    def _run(self):\n        nxt = _time.monotonic() + 1.0\n  \
      \      while not self._stop.wait(self.flush_s):\n            self._drain()\n\
      \            if _time.monotonic() >= nxt:\n                nxt += 1.0\n    \
      \            self._snapshots()\n            for f in self._f.values():\n   \
      \             try:\n                    f.flush()\n                except Exception:\n\
      \                    pass\n\n    def _drain(self):\n        ev = _bus().events\n\
      \        cfg_changed = False\n        while True:\n            try:\n      \
      \          e = ev.popleft()\n            except IndexError:\n              \
      \  break\n            try:\n                cfg_changed |= self._handle(e)\n\
      \            except Exception as ex:\n                self._line(\"events.log\"\
      , f\"{self._rel():.3f} logger error {ex!r} on {e.get('blk')}/{e.get('k')}\"\
      )\n        if cfg_changed:\n            self._write_cfg()\n\n    def _handle(self,\
      \ e):\n        blk, k = e.get(\"blk\", \"\"), e.get(\"k\", \"\")\n        t\
      \ = round(self._rel(e.get(\"t\")), 3)\n        if k == \"config\":\n       \
      \     self._cfg[\"blocks\"][blk] = {kk: v for kk, v in e.items() if kk not in\
      \ (\"t\", \"blk\", \"k\")}\n            return True\n        if blk == \"csma\"\
      :\n            if k == \"txop\":\n                self._row(\"csma_txop.csv\"\
      , {**e, \"t\": t})\n            elif k == \"arq\":\n                self._row(\"\
      arq_tx.csv\", {\"t\": t, \"dst\": e.get(\"dst\"), \"what\": e.get(\"what\"),\
      \ \"bsn\": e.get(\"bsn\"),\n                                         \"acked\"\
      : e.get(\"acked\"), \"nacked\": e.get(\"nacked\"),\n                       \
      \                  \"dropped\": e.get(\"dropped\"), \"ws0\": e.get(\"ws_before\"\
      ), \"ws\": e.get(\"ws\"),\n                                         \"used\"\
      : e.get(\"used\"), \"backlog\": e.get(\"backlog\")})\n            elif k ==\
      \ \"rx_data\" and not e.get(\"noack\"):\n                self._row(\"arq_rx.csv\"\
      , {\"t\": t, \"src\": e.get(\"src\"), \"sn\": e.get(\"seq\"), \"bsn\": e.get(\"\
      bsn\"),\n                                         \"idx\": e.get(\"idx\"), \"\
      cnt\": e.get(\"cnt\"), \"dup\": e.get(\"dup\"),\n                          \
      \               \"deliv\": e.get(\"delivered\"), \"buf\": e.get(\"buffered\"\
      ),\n                                         \"gaveup\": e.get(\"gave_up\"),\
      \ \"rws\": e.get(\"rws\"), \"retry\": e.get(\"retry\"),\n                  \
      \                       \"fec\": e.get(\"fec\")})\n            elif k == \"\
      ba_rx\" and e.get(\"late\"):\n                self._line(\"events.log\", f\"\
      {t:.3f} csma late Block ACK burst {e.get('bsn')} from {e.get('src')} \"\n  \
      \                                       f\"bitmap {e.get('bitmap')}\")\n   \
      \         elif k in EVENT_KINDS:\n                self._event(t, blk, k, e)\n\
      \            return False\n        if blk == \"bridge\":\n            if k ==\
      \ \"udp_tx\":\n                self._row(\"udp.csv\", {\"t\": t, \"dir\": \"\
      tx\", \"peer\": e.get(\"dst\"), \"useq\": e.get(\"useq\"),\n               \
      \                       \"bytes\": e.get(\"bytes\")})\n            elif k ==\
      \ \"udp_rx\":\n                self._row(\"udp.csv\", {\"t\": t, \"dir\": \"\
      rx\", \"peer\": e.get(\"src\"), \"useq\": e.get(\"useq\"),\n               \
      \                       \"bytes\": e.get(\"bytes\"), \"owd_ms\": e.get(\"owd_ms\"\
      ), \"iat_ms\": e.get(\"iat_ms\"),\n                                      \"\
      gap\": e.get(\"gap\"), \"mac_sn\": e.get(\"mac_sn\")})\n            elif k ==\
      \ \"msg_tx\":\n                self._row(\"msgs.csv\", {**e, \"t\": t, \"dir\"\
      : \"tx\", \"peer\": e.get(\"dst\"), \"got\": e.get(\"acked\")})\n          \
      \  elif k == \"msg_rx\":\n                self._row(\"msgs.csv\", {**e, \"t\"\
      : t, \"dir\": \"rx\", \"peer\": e.get(\"src\")})\n            elif k in EVENT_KINDS\
      \ or k == \"msg_submit\":\n                if k != \"msg_submit\":\n       \
      \             self._event(t, blk, k, e)\n            return False\n        if\
      \ k in EVENT_KINDS or k == \"warning\":\n            self._event(t, blk, k,\
      \ e)\n        return False\n\n    # ------------------------------------------------------------------\
      \ once a second\n    def _snapshots(self, final=False):\n        now = _time.time()\n\
      \        t = round(self._rel(now), 3)\n        src = _bus().sources\n      \
      \  cs = src.get(\"csma\")\n        if cs is not None:\n            try:\n  \
      \              s = cs.dbg_snapshot()\n            except Exception:\n      \
      \          s = None\n            if s:\n                active = any(s.get(x)\
      \ for x in (\"tx_D\", \"tx_BA\", \"ba_rx\", \"rx_data\", \"deferrals\", \"busy_on\"\
      )) or \\\n                    s.get(\"queue\") or s.get(\"ba_due\") or (s.get(\"\
      busy_pct\") or 0) > 1\n                cpu = _time.process_time()\n        \
      \        proc_cpu = None\n                if self._cpu_last is not None:\n \
      \                   proc_cpu = round(100.0 * (cpu - self._cpu_last[0]) / max(1e-6,\
      \ now - self._cpu_last[1]), 1)\n                self._cpu_last = (cpu, now)\n\
      \                try:\n                    load1 = round(os.getloadavg()[0],\
      \ 2)\n                except (OSError, AttributeError):\n                  \
      \  load1 = None\n                if active or final or now - self._last_csma_row\
      \ >= self.idle_every_s or (proc_cpu or 0) > 90:\n                    self._last_csma_row\
      \ = now\n                    s[\"proc_cpu\"], s[\"load1\"] = proc_cpu, load1\n\
      \                    w = s.get(\"windows\") or {}\n                    self._row(\"\
      csma_1s.csv\", {**s, \"t\": t, \"tx_pct\": s.get(\"self_tx_pct\"), \"echo_ms\"\
      : s.get(\"echo_med_ms\"),\n                                              \"\
      mute_wr_max_ms\": s.get(\"mute_write_ms_max\"),\n                          \
      \                    \"udp_q\": sum((s.get(\"udp_q\") or {}).values()),\n  \
      \                                            \"windows\": \" \".join(f\"{d}:{v['ws']}/{v['used']}/{v['backlog']}\"\
      \n                                                                  for d, v\
      \ in w.items())})\n        df, co, no = src.get(\"deframer\"), src.get(\"corr\"\
      ), src.get(\"noise\")\n        row = {\"t\": t}\n        try:\n            if\
      \ df is not None:\n                d = df.dbg_snapshot()\n                row.update({\"\
      train\": d.get(\"train\"), \"train_ok\": d.get(\"train_clean\"), \"locks\":\
      \ d.get(\"lock\"),\n                            \"crc_fail\": d.get(\"crc_fail\"\
      ), \"bad_len\": d.get(\"bad_len\"), \"ok\": d.get(\"ok\"),\n               \
      \             \"other\": d.get(\"other\"), \"own\": d.get(\"own\"), \"sq_eob\"\
      : d.get(\"sq_eob\")})\n            if co is not None:\n                c = co.dbg_snapshot()\n\
      \                row.update({\"corr_tags\": c.get(\"tags\"), \"corr_best\":\
      \ c.get(\"best\")})\n            if no is not None:\n                z = no.dbg_snapshot()\n\
      \                row.update({\"noise_db\": z.get(\"floor_db\"), \"squelch_db\"\
      : z.get(\"squelch_thr_db\")})\n        except Exception:\n            pass\n\
      \        active = any(row.get(x) for x in (\"corr_tags\", \"train\", \"locks\"\
      , \"crc_fail\", \"ok\", \"sq_eob\"))\n        if active or final or now - self._last_phy_row\
      \ >= self.idle_every_s:\n            self._last_phy_row = now\n            self._row(\"\
      phy_1s.csv\", row)\n"
    affinity: ''
    alias: ''
    comment: Writes csma_*, arq_*, udp, msgs, phy_1s, events into $CDP_DEBUG_DIR
    flush_s: '0.5'
    idle_every_s: '10.0'
    log_dir: ''''''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_id: MY_ID
  states:
    _io_cache: ('Session Logger (performance logs)', 'SessionLogger', [('my_id', '1'),
      ('log_dir', "''"), ('flush_s', '0.5'), ('idle_every_s', '10.0')], [('attach',
      'message', 1)], [], '', ['flush_s', 'idle_every_s', 'log_dir', 'my_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 2600.0]
    rotation: 0
    state: enabled
- name: epy_noise
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Noise-floor tracker -> automatic\
      \ squelch threshold\n- Sink block: connect it to the SDR source output (BEFORE\
      \ any squelch/AGC).\n- Splits the stream into short slices (default ~1 ms),\
      \ keeps the mean power of each slice for the\n  last `window_s` seconds, and\
      \ takes a low percentile of them as the noise floor (bursts only occupy\n  the\
      \ top of the distribution, so they are ignored as long as the channel is idle\
      \ > `percentile` % of the time).\n- level() returns the squelch threshold in\
      \ dB:  noise floor (dB) + margin_db, clamped to\n  [thr_min, thr_max]. The estimate\
      \ falls immediately but rises at most `rise_db_s` dB per second, so a\n  long\
      \ burst or a back-to-back transmission cannot drag the threshold up and close\
      \ the squelch.\n- Use with a \"Function Probe\" variable named power_threshold:\
      \  block id = this block, function = level,\n  poll rate ~ 5 Hz. The Pluto/squelch\
      \ power unit is the same: dB of mean |x|^2.\n- Stress-test build: 1 s snapshot\
      \ (noise floor, squelch threshold) goes to the debug bus (src \"noise\").\n\"\
      \"\"\nimport threading\nimport time\nfrom collections import deque\n\nimport\
      \ numpy as np\nfrom gnuradio import gr\n\n# ---- shared debug bus (one per flowgraph\
      \ process; the Stress Test block writes it to disk) ----\nimport sys as _sys\n\
      import types as _types\nimport collections as _collections\nimport time as _time\n\
      \n\ndef _bus():\n    b = _sys.modules.get(\"cdp_dbg_bus\")\n    if b is None:\n\
      \        nb = _types.ModuleType(\"cdp_dbg_bus\")\n        nb.events = _collections.deque(maxlen=400000)\
      \   # dicts; oldest dropped if nobody writes them\n        nb.sources = {} \
      \                                # name -> object with dbg_snapshot()\n    \
      \    b = _sys.modules.setdefault(\"cdp_dbg_bus\", nb)\n    return b\n\n\ndef\
      \ _emit(blk, kind, /, **kw):\n    kw[\"t\"] = round(_time.time(), 6)\n    kw[\"\
      blk\"] = blk\n    kw[\"k\"] = kind\n    _bus().events.append(kw)\n# ---- end\
      \ debug bus ----\n\n# ---- C++ kernels (cdp_fast.py / cdp_fast.cpp next to the\
      \ flowgraph); None -> the NumPy code of this block ----\ndef _load_fast():\n\
      \    import os as _os\n    if _os.environ.get(\"CDP_FAST\", \"1\").strip().lower()\
      \ in (\"0\", \"no\", \"off\", \"false\"):\n        return None\n    try:\n \
      \       import cdp_fast\n        return cdp_fast\n    except ImportError:\n\
      \        pass\n    for d in (_os.environ.get(\"CDP_HOME\"), _os.getcwd(),\n\
      \              _os.path.dirname(_os.path.abspath(_sys.argv[0])) if _sys.argv\
      \ and _sys.argv[0] else None):\n        if d and _os.path.isfile(_os.path.join(d,\
      \ \"cdp_fast.py\")):\n            if d not in _sys.path:\n                _sys.path.insert(0,\
      \ d)\n            try:\n                import cdp_fast\n                return\
      \ cdp_fast\n            except Exception:\n                return None\n   \
      \ return None\n# ---- end C++ kernels ----\n\n\nclass NoiseFloor(gr.sync_block):\n\
      \    def __init__(self, samp_rate=1.5e6, margin_db=6.0, window_s=1.0, percentile=10.0,\n\
      \                 rise_db_s=1.0, thr_min=-100.0, thr_max=-20.0, init_db=-40.0,\
      \ verbose=1):\n        gr.sync_block.__init__(self, name=\"Noise Floor Tracker\"\
      , in_sig=[np.complex64], out_sig=None)\n        self.samp_rate = float(samp_rate)\n\
      \        self.margin_db = float(margin_db)\n        self.window_s = float(window_s)\n\
      \        self.percentile = float(percentile)\n        self.rise_db_s = float(rise_db_s)\n\
      \        self.thr_min = float(thr_min)\n        self.thr_max = float(thr_max)\n\
      \        self.init_db = float(init_db)\n        self.verbose = int(verbose)\n\
      \n        self._slice = max(64, int(self.samp_rate * 1e-3))            # ~1\
      \ ms\n        n_slices = max(16, int(self.window_s * self.samp_rate / self._slice))\n\
      \        self._ring = deque(maxlen=n_slices)\n        self._min_slices = max(8,\
      \ n_slices // 4)                       # wait for 1/4 window before trusting\n\
      \        self._carry = np.zeros(0, np.float32)\n        self._lock = threading.Lock()\n\
      \        self._est_db = None\n        self._t_last = None\n        self._out\
      \ = self.init_db\n        self._printed = None\n        self._fast = None  \
      \                    # C++ slice means (set in start)\n\n    def start(self):\n\
      \        F = _load_fast()\n        if F is not None:\n            ns = F.NoiseSlices(self._slice)\n\
      \            self._fast = ns if ns.ok else None\n        if self.verbose:\n\
      \            print(F.status(\"noise floor\") if F is not None else \"[FAST]\
      \ noise floor: original Python code\", flush=True)\n        _bus().sources[\"\
      noise\"] = self\n        _emit(\"noise\", \"config\", margin_db=self.margin_db,\
      \ window_s=self.window_s, percentile=self.percentile,\n              rise_db_s=self.rise_db_s,\
      \ thr_min=self.thr_min, thr_max=self.thr_max)\n        return True\n\n    def\
      \ dbg_snapshot(self):\n        return {\"floor_db\": round(self._est_db, 2)\
      \ if self._est_db is not None else None,\n                \"squelch_thr_db\"\
      : round(self._out, 2), \"slices\": len(self._ring)}\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        n = len(x)\n        if\
      \ n == 0:\n            return 0\n        if self._fast is not None:        \
      \                             # C++: carries the partial slice itself\n    \
      \        means = self._fast(x)\n            if len(means):\n               \
      \ with self._lock:\n                    self._ring.extend(means)\n         \
      \   return n\n        p = x.real.astype(np.float32) ** 2 + x.imag.astype(np.float32)\
      \ ** 2\n        if self._carry.size:\n            p = np.concatenate((self._carry,\
      \ p))\n        k = len(p) // self._slice\n        if k:\n            means =\
      \ p[: k * self._slice].reshape(k, self._slice).mean(axis=1, dtype=np.float64)\n\
      \            with self._lock:\n                self._ring.extend(means)\n  \
      \      self._carry = p[k * self._slice:]\n        return n\n\n    def noise_db(self):\n\
      \        return self._est_db\n\n    def level(self):\n        \"\"\"Called by\
      \ the Function Probe variable: returns the squelch threshold in dB.\"\"\"\n\
      \        with self._lock:\n            arr = np.fromiter(self._ring, dtype=np.float64,\
      \ count=len(self._ring))\n        if arr.size < self._min_slices:\n        \
      \    return self._out\n        raw_db = 10.0 * np.log10(max(float(np.percentile(arr,\
      \ self.percentile)), 1e-20))\n        now = time.monotonic()\n        if self._est_db\
      \ is None:\n            self._est_db = raw_db\n        else:\n            dt\
      \ = max(0.0, now - self._t_last)\n            if raw_db <= self._est_db:\n \
      \               self._est_db = raw_db\n            else:\n                self._est_db\
      \ = min(raw_db, self._est_db + self.rise_db_s * dt)\n        self._t_last =\
      \ now\n        self._out = float(min(self.thr_max, max(self.thr_min, self._est_db\
      \ + self.margin_db)))\n        if self.verbose and (self._printed is None or\
      \ abs(self._out - self._printed) >= 1.0):\n            print(f\"[SQL] noise\
      \ floor {self._est_db:.1f} dB -> squelch threshold {self._out:.1f} dB\", flush=True)\n\
      \            self._printed = self._out\n        return self._out\n"
    affinity: ''
    alias: ''
    comment: ''
    init_db: '-40.0'
    margin_db: margin_db
    maxoutbuf: '0'
    minoutbuf: '0'
    percentile: '10.0'
    rise_db_s: '1.0'
    samp_rate: samp_rate
    thr_max: '-20.0'
    thr_min: '-100.0'
    verbose: '1'
    window_s: '1.0'
  states:
    _io_cache: ('Noise Floor Tracker', 'NoiseFloor', [('samp_rate', '1500000.0'),
      ('margin_db', '6.0'), ('window_s', '1.0'), ('percentile', '10.0'), ('rise_db_s',
      '1.0'), ('thr_min', '-100.0'), ('thr_max', '-20.0'), ('init_db', '-40.0'), ('verbose',
      '1')], [('0', 'complex', 1)], [], '', ['init_db', 'margin_db', 'percentile',
      'rise_db_s', 'samp_rate', 'thr_max', 'thr_min', 'verbose', 'window_s'])
    bus_sink: false

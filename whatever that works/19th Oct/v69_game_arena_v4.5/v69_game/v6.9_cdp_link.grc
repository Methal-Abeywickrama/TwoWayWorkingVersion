      \ = 0.0\n        self._windows = 0\n        self._dbg = collections.Counter()\n\
      \        self._dbg_t0 = 0.0\n        self._dbg_w0 = None\n        self._dbg_n0\
      \ = 0\n        self._prev_busy = None\n        self._busy_since = 0.0\n    \
      \    self._busy_max = -200.0\n        self._tr_sec = -1\n        self._tr_cnt\
      \ = 0\n\n        for p in (\"app_in\", \"phy_in\", \"rx_in\", \"ctrl\"):\n \
      \           self.message_port_register_in(pmt.intern(p))\n        self.set_msg_handler(pmt.intern(\"\
      app_in\"), self._on_app)\n        self.set_msg_handler(pmt.intern(\"phy_in\"\
      ), self._on_phy)\n        self.set_msg_handler(pmt.intern(\"rx_in\"), self._on_rx)\n\
      \        self.set_msg_handler(pmt.intern(\"ctrl\"), self._on_ctrl)\n       \
      \ for p in (\"to_phy\", \"pdu_out\", \"app_out\", \"tx_status\"):\n        \
      \    self.message_port_register_out(pmt.intern(p))\n\n    # ------------------------------------------------------------------\
      \ parameters / derived values\n    @property\n    def dest_id(self):\n     \
      \   return self._dest_id\n\n    @dest_id.setter\n    def dest_id(self, v):\n\
      \        try:\n            v = int(float(v))\n        except (TypeError, ValueError):\n\
      \            return\n        if 0 <= v <= 255 and v != self._dest_id:\n    \
      \        self._dest_id = v\n            print(f\"[MAC] default destination is\
      \ now ID {id_name(v)}\", flush=True)\n\n    def difs(self):\n        return\
      \ self.difs_s if self.difs_s > 0 else self.sifs_s + self.turnaround_s + 2.0\
      \ * self.slot_s\n\n    def _cw_for(self, k):\n        return min(self.cw_max,\
      \ (self.cw_min + 1) * (2 ** min(k, self.k_max)) - 1)\n\n    def phy_bytes(self,\
      \ plen):\n        \"\"\"Bytes on air for a framer payload of plen bytes (same\
      \ formula as the Packet Framer TX).\"\"\"\n        if self.phy_fec in (15, 31):\n\
      \            k = {15: 11, 31: 26}[self.phy_fec]\n            bits = math.ceil(56\
      \ / k) * self.phy_fec + math.ceil((plen + 4) * 8 / k) * self.phy_fec\n     \
      \       body = math.ceil(bits / 8)\n        else:\n            body = 7 + plen\
      \ + 4\n        raw = self.phy_preamble_len + 4 + 4 + body\n        if self.phy_buffer_size\
      \ <= 0:\n            return raw\n        unit = max(1, math.ceil(self.phy_buffer_size\
      \ / self.samples_per_byte))\n        return math.ceil((raw + unit) / unit) *\
      \ unit\n\n    def air_s(self, plen):\n        return self.phy_bytes(plen) *\
      \ self.samples_per_byte / self.samp_rate\n\n    def ba_air(self):\n        return\
      \ self.air_s(HDR_BA + (self.burst_m + 7) // 8)\n\n    # ------------------------------------------------------------------\
      \ start / stop\n    def start(self):\n        F = _load_fast()\n        if F\
      \ is not None:\n            cs = F.CsFront(self._nfft, self._win, self._bins,\
      \ self._norm)\n            self._cs_fast = cs if cs.ok else None\n        print(F.status(\"\
      MAC carrier sense\") if F is not None else \"[FAST] MAC carrier sense: original\

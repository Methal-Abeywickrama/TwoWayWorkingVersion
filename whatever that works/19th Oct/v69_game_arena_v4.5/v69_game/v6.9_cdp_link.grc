      \ / self._dt))))\n        self._cs_fast = None                    # C++ carrier\
      \ sense front end (set in start)\n        self._carry = np.zeros(0, np.complex64)\n\
      \        self._cs_db = -200.0\n        self._hist = collections.deque(maxlen=max(64,\

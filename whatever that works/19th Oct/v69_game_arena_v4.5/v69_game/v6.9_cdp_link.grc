      \ * self.ba_air(), 2),\n              phy_preamble_len=self.phy_preamble_len,\
      \ phy_fec=self.phy_fec, phy_buffer_size=self.phy_buffer_size,\n            \
      \  cs_margin_db=self.cs_margin_db, cs_hyst_db=self.cs_hyst_db, nfft=self._nfft,\
      \ sense_s=self._sense_s,\n              floor_percentile=self.floor_percentile,\

      \    return\n        if medium_busy:\n            self._att_busy += dt\n   \
      \         if nav:\n                self._att_nav += dt\n\n        # ---- 1.\
      \ p-persistence\n        if self._ph == \"persist\":\n            if medium_busy:\n\
      \                self._p_first, self._p_acc = True, 0.0\n                return\n\
      \            draw = False\n            if self._p_first:\n                self._p_first,\
      \ draw = False, True\n            else:\n                self._p_acc += dt\n\
      \                if self._p_acc >= self.slot_s:\n                    self._p_acc\
      \ -= self.slot_s\n                    draw = True\n            if draw:\n  \
      \              self._p_draws += 1\n                if self._rng.random() < self.p_persist:\n\
      \                    self._ph, self._idle_d = \"difs\", 0.0\n              \
      \      self._p_done_t = self._t\n                    self._ev(\"persist\", draws=self._p_draws,\
      \ wait_ms=round(1e3 * (self._t - self._att_t0), 2))\n            return\n  \
      \      # ---- 2. DIFS\n        if self._ph == \"difs\":\n            if medium_busy:\n\
      \                self._idle_d = 0.0\n                return\n            self._idle_d\
      \ += dt\n            if self._idle_d + 1e-9 < self.difs():\n               \
      \ return\n            self._ph, self._bo_acc = \"backoff\", 0.0\n          \
      \  if self._bo is None:\n                cw = self._cw_for(self._k)\n      \
      \          self._bo = self._bo0 = int(self._rng.integers(0, cw + 1))\n     \
      \           self._ev(\"backoff\", slots=self._bo, cw=cw, stage=min(self._k,\
      \ self.k_max))\n        # ---- 3. backoff\n        if self._ph == \"backoff\"\
      :\n            if medium_busy:\n                self._ph, self._idle_d = \"\
      difs\", 0.0\n                self._freezes += 1\n                self._dbg[\"\
      deferrals\"] += 1\n                self._ev(\"defer\", left=self._bo, cs_db=round(cs_db,\
      \ 2), nav=int(nav))\n                return\n            if self._bo > 0:\n\
      \                self._bo_acc += dt\n                while self._bo_acc >= self.slot_s\
      \ and self._bo > 0:\n                    self._bo_acc -= self.slot_s\n     \
      \               self._bo -= 1\n            if self._bo == 0:\n             \
      \   self._start_txop()\n\n    def _tx_phase(self, cs_db):\n        tx = self._tx\n\
      \        ph = tx[\"phase\"]\n        if ph == \"prep\":                    \
      \                  # framer round trip + TX unmute, in parallel\n          \
      \  ready = all(f[\"coded\"] is not None for f in tx[\"frames\"])\n         \
      \   muted_ok = (not tx[\"mute\"]) or self._muter.done(tx[\"seq\"])\n       \
      \     waited = self._t - tx[\"t_rel\"]\n            if ready and (muted_ok or\
      \ waited >= self.unmute_timeout_s):\n                if not muted_ok:\n    \
      \                self._st[\"late_unmute\"] += 1\n                    self._ev(\"\
      late_unmute\", wait_ms=round(1e3 * waited, 2))\n                self._publish()\n\
      \            elif not ready and waited >= 0.5:\n                self._abort_tx(\"\
      the framer did not return the frames within 0.5 s\")\n                if tx[\"\
      mute\"]:\n                    self._sync_mute()\n            return\n      \
      \  if ph == \"air\":\n            echo_thr = (self._floor_db if self._floor_db\
      \ is not None else 1e9) + \\\n                (max(self.cs_margin_db, self.echo_margin_db)\
      \ if tx[\"mute\"] else self.cs_margin_db)\n            if (tx[\"echo_t\"] is\
      \ None and cs_db > echo_thr and self._t < tx[\"win_end\"]\n                \
      \    and self._t - tx[\"t0\"] >= 0.002):\n                tx[\"echo_t\"] = self._t\n\
      \                self._echo_delays.append(self._t - tx[\"t0\"])\n          \
      \      self._ev(\"echo\", delay_ms=round(1e3 * (self._t - tx[\"t0\"]), 2), cs_db=round(cs_db,\
      \ 2),\n                         thr_db=round(echo_thr, 2))\n            if self._t\
      \ >= tx[\"win_end\"]:\n                self._ev(\"win_end\", echo=tx[\"echo_t\"\
      ] is not None, cs_db=round(cs_db, 2),\n                         off_ms=round(1e3\
      \ * (self._t - tx[\"t_rel\"]), 2))\n                if tx[\"mute\"]:\n     \
      \               tx[\"phase\"] = \"mute\"\n                    tx[\"seq\"] =\
      \ self._sync_mute()\n                else:\n                    self._end_tx()\n\
      \            return\n        if ph == \"mute\":\n            if self._muter.done(tx[\"\
      seq\"]) or self._t - tx[\"win_end\"] >= self.unmute_timeout_s:\n           \
      \     self._end_tx()\n\n    def _transitions(self, cs_db, thr_on):\n       \
      \ if self._busy == self._prev_busy:\n            return\n        if self._prev_busy\
      \ is not None:\n            self._dbg[\"busy_on\" if self._busy else \"busy_off\"\
      ] += 1\n            sec = int(self._t)\n            if sec != self._tr_sec:\n\
      \                if self._tr_cnt > 100:\n                    self._ev(\"transitions_suppressed\"\
      , n=self._tr_cnt - 100, sec=self._tr_sec)\n                self._tr_sec, self._tr_cnt\
      \ = sec, 0\n            self._tr_cnt += 1\n            if self._tr_cnt <= 100:\n\
      \                if self._busy:\n                    self._ev(\"busy\", cs_db=round(cs_db,\
      \ 2), thr_db=round(thr_on, 2), q=self.queue_len())\n                else:\n\
      \                    self._ev(\"idle\", cs_db=round(cs_db, 2), dur_ms=round(1e3\
      \ * (self._t - self._busy_since), 2),\n                             max_db=round(self._busy_max,\
      \ 2), q=self.queue_len())\n        self._prev_busy = self._busy\n        self._busy_since\
      \ = self._t\n        self._busy_max = cs_db\n\n    def _update_floor(self):\n\
      \        if len(self._hist) < self._hist.maxlen // 4:\n            return\n\
      \        raw = float(np.percentile(np.fromiter(self._hist, float, len(self._hist)),\
      \ self.floor_percentile))\n        if self._floor_db is None or raw <= self._floor_db:\n\
      \            self._floor_db = raw\n        else:\n            self._floor_db\
      \ = min(raw, self._floor_db + self.floor_rise_db_s * 0.05)\n\n    # ------------------------------------------------------------------\
      \ stream\n    def _work_fast(self, buf, nb, first_abs, blank):\n        \"\"\
      \"The loop of work() with the C++ kernels (cdp_fast.cpp): the same steps, the\
      \ same arithmetic, the same\n        results (tools/test_fast_blocks.py compares\
      \ them event by event).\n        - carrier sense: the FFT medians and the smoothed\
      \ cs_db of all nb sense steps at once (C++)\n        - steps that only do bookkeeping\
      \ run in C++ (_fast_steps): carrier-sense statistics, the contention timers\n\
      \          (p-persistence slot timer, DIFS, backoff countdown) and the TX time\
      \ while the own burst is on the air.\n          C++ stops before every step\
      \ that has a side effect - busy/idle change, random draw, event, start of a\n\
      \          transmission, Block ACK deadline, received frame - and _step() runs\
      \ that step exactly as before.\n          Messages (app_in, rx_in, phy_in, ctrl)\
      \ are handled by GNU Radio between work() calls, never during one,\n       \
      \   so nothing can change under a stretch of steps.\"\"\"\n        med = self._cs_fast(buf,\
      \ nb)\n        cs_all = self._cs_fast.smooth_db(self._smooth, med)\n       \
      \ self._smooth.extend(med.tolist())\n        i = 0\n        while i < nb:\n\
      \            k = self._fast_steps(cs_all, i, first_abs, blank)\n           \
      \ if k:\n                i += k\n                if self._t >= self._floor_next:\n\
      \                    self._floor_next = self._t + 0.05\n                   \
      \ self._update_floor()\n                continue\n            self._cs_db =\
      \ cs_all[i]\n            self._t = (first_abs + (i + 1) * self._nfft) / self.samp_rate\n\
      \            was_tx = self._self_tx\n            self._step(self._cs_db)\n \
      \           if self.blank_rx and (was_tx or self._self_tx):\n              \
      \  s = first_abs + i * self._nfft\n                blank.append((s, s + self._nfft))\n\
      \            if self._t >= self._floor_next:\n                self._floor_next\
      \ = self._t + 0.05\n                self._update_floor()\n            i += 1\n\
      \n    def _fast_steps(self, cs_all, i, first_abs, blank):\n        \"\"\"->\
      \ number of steps (from step i) done in C++; 0 = step i needs _step()\"\"\"\n\
      \        if self._rx_ev or self._arq_inbox:\n            return 0\n        F\
      \ = self._cs_fast\n        if self._self_tx:                               \
      \   # own burst on the air: only the TX time is counted\n            tx = self._tx\n\
      \            if tx.get(\"phase\") != \"air\":\n                return 0\n  \
      \          echo_thr = (self._floor_db if self._floor_db is not None else 1e9)\
      \ + \\\n                (max(self.cs_margin_db, self.echo_margin_db) if tx[\"\
      mute\"] else self.cs_margin_db)\n            st = np.array([self._dbg.get(\"\
      tx_s\", 0), self._t], np.float64)\n            k = F.air(cs_all, i, first_abs,\
      \ self._nfft, self.samp_rate, tx[\"echo_t\"] is None, echo_thr,\n          \
      \            tx[\"win_end\"], tx[\"t0\"], self._floor_next, self._dt, st)\n\
      \            if k:\n                self._dbg[\"tx_s\"] = float(st[0])\n   \
      \             self._t = float(st[1])\n                self._cs_db = cs_all[i\
      \ + k - 1]\n                if self.blank_rx:\n                    blank.append((first_abs\
      \ + i * self._nfft, first_abs + (i + k) * self._nfft))\n            return k\n\
      \        if self._ba_due or self._prev_busy is None or self._prev_busy != self._busy:\n\
      \            return 0\n        aw = self._await\n        if aw is not None:\
      \                                 # waiting for a Block ACK (until its deadline)\n\
      \            contend, deadline = False, aw[\"deadline\"]\n        else:\n  \
      \          contend, deadline = self._has_work(), math.inf\n            if contend\
      \ and self._ph not in F.PHASES:\n                return 0\n        st = np.array([self._busy_time,\
      \ self._dbg.get(\"busy_s\", 0), self._busy_max, self._nav_time,\n          \
      \             self._dbg.get(\"nav_s\", 0), self._t, self._att_busy, self._att_nav,\
      \ self._p_acc,\n                       self._idle_d, self._bo_acc], np.float64)\n\
      \        ist = np.array([F.PHASES.get(self._ph, 0), 1 if self._p_first else\
      \ 0, -1 if self._bo is None else self._bo],\n                       np.int32)\n\
      \        k, cnt = F.steps(cs_all, i, first_abs, self._nfft, self.samp_rate,\
      \ self._floor_db, self.cs_margin_db,\n                         self.cs_hyst_db,\
      \ self._busy, self._nav_until, deadline, self._floor_next, self._dt,\n     \
      \                    contend, self.slot_s, self.difs(), st, ist)\n        if\
      \ k == 0:\n            return 0\n        self._hist.extend(cs_all[i:i + k])\n\
      \        if cnt[0]:\n            self._busy_time, self._dbg[\"busy_s\"], self._busy_max\
      \ = float(st[0]), float(st[1]), st[2]\n        if cnt[1]:\n            self._nav_time,\
      \ self._dbg[\"nav_s\"] = float(st[3]), float(st[4])\n        self._t = float(st[5])\n\
      \        self._cs_db = cs_all[i + k - 1]\n        if contend:\n            self._att_busy,\
      \ self._att_nav = float(st[6]), float(st[7])\n            self._p_acc, self._idle_d,\
      \ self._bo_acc = float(st[8]), float(st[9]), float(st[10])\n            self._p_first\
      \ = bool(ist[1])\n            self._bo = None if ist[2] < 0 else int(ist[2])\n\
      \        elif aw is None:\n            self._reset_contention()            \
      \           # what each of these steps did (nothing to send)\n        return\
      \ k\n\n    def work(self, input_items, output_items):\n        t_cpu = time.perf_counter()\n\
      \        if self._wall0 is None:\n            self._wall0, self._n_wall0 = time.monotonic(),\
      \ self._n_abs\n        if self._muter is not None:\n            seen = (self.tx_mute,\
      \ self.tx_att_db)\n            self._sync_mute(force=(seen != self._seen_ctl))\n\
      \            self._seen_ctl = seen\n        x = input_items[0]\n        out\
      \ = output_items[0]\n        n = len(x)\n        out[:] = x\n        first_abs\
      \ = self._n_abs - len(self._carry)\n        buf = np.concatenate((self._carry,\
      \ x)) if len(self._carry) else x\n        nb = len(buf) // self._nfft\n    \
      \    blank = []\n        if nb and self._cs_fast is not None:\n            self._work_fast(buf,\
      \ nb, first_abs, blank)     # C++ front end + quiet steps: same results, see\
      \ below\n        elif nb:\n            blocks = buf[:nb * self._nfft].reshape(nb,\
      \ self._nfft) * self._win\n            p = np.abs(np.fft.fft(blocks, axis=1)[:,\
      \ self._bins]) ** 2\n            med = np.median(p, axis=1) * self._norm\n \
      \           for i in range(nb):\n                self._smooth.append(float(med[i]))\n\
      \                self._cs_db = 10.0 * np.log10(max(sum(self._smooth) / len(self._smooth),\
      \ 1e-20))\n                self._t = (first_abs + (i + 1) * self._nfft) / self.samp_rate\n\
      \                was_tx = self._self_tx\n                self._step(self._cs_db)\n\
      \                if self.blank_rx and (was_tx or self._self_tx):\n         \
      \           s = first_abs + i * self._nfft\n                    blank.append((s,\
      \ s + self._nfft))\n                if self._t >= self._floor_next:\n      \
      \              self._floor_next = self._t + 0.05\n                    self._update_floor()\n\
      \        self._carry = buf[nb * self._nfft:].copy()\n        self._n_abs +=\
      \ n\n        if self.blank_rx and self._self_tx:\n            blank.append((self._n_abs\
      \ - len(self._carry), self._n_abs))\n        x0 = self._n_abs - n\n        for\
      \ s, e in blank:\n            a, b = max(s, x0) - x0, min(e, self._n_abs) -\
      \ x0\n            if b > a:\n                out[a:b] = 0\n        self._cpu\
      \ += time.perf_counter() - t_cpu\n        if self.verbose and self.stats_every_s\
      \ > 0 and self._t - self._stat_t0 >= self.stats_every_s:\n            self._print_stats()\n\
      \        return n\n\n    def _print_stats(self):\n        span = max(1e-9, self._t\
      \ - self._stat_t0)\n        st = self._st\n        floor = f\"{self._floor_db:.1f}\"\
      \ if self._floor_db is not None else \"learning\"\n        dl = list(self._delay)\n\
      \        rtt = list(self._rtt)\n        bs = \", \".join(f\"{k}: {v}\" for k,\
      \ v in sorted(self._bsizes.items())) or \"-\"\n        print(f\"[MAC] floor\
      \ {floor} dB (+{self.cs_margin_db:g}), now {self._cs_db:.1f} dB, busy \"\n \
      \             f\"{100 * self._busy_time / span:.1f} %, NAV {100 * self._nav_time\
      \ / span:.1f} % | bursts by size {{{bs}}}, \"\n              f\"Block ACKs received\
      \ {st['ba_rx']} (late {st['late_ba']}), timeouts {st['ba_timeout']}, CW \"\n\
      \              f\"{self.cw()} | Block ACKs sent {st['tx_BA']}, NAV set {st['nav_set']}x\"\
      , flush=True)\n        print(f\"[ARQ] frames sent {st['tx_D']} (retransmissions\
      \ {st['tx_retx']}), acknowledged {st['acked']}, \"\n              f\"dropped\
      \ after {self.retry_limit} retries {st['retry_drop']}, queue drops {st['qdrop']}\
      \ | received \"\n              f\"{st['rx_data']} new + {st['rx_dup']} duplicates,\
      \ given up {st['rx_gave_up']} | \"\n              f\"{self.window_info()} |\
      \ delay median {1e3 * np.median(dl) if dl else 0:.0f} ms, Block ACK round trip\
      \ \"\n              f\"median {1e3 * np.median(rtt) if rtt else 0:.1f} ms (timeout\
      \ {1e3 * self.ba_timeout_s:g})\", flush=True)\n        m = self._muter\n   \
      \     mute = (\"TX mute OFF\" if m is None or m.failed else \"TX mute connecting\"\
      \ if not m.ok else\n                f\"TX mute {'on' if self.tx_mute else 'switched\
      \ off'} (write max \"\n                f\"{max(m.write_ms) if m.write_ms else\
      \ 0:.1f} ms, late {st['late_unmute']})\")\n        wall = max(1e-9, time.monotonic()\
      \ - self._wall0)\n        rate = (self._n_abs - self._n_wall0) / wall\n    \
      \    share = 100.0 * rate / self.samp_rate\n        ed = list(self._echo_delays)\n\
      \        print(f\"[MAC] own echo {1e3 * np.median(ed) if ed else 0:.1f} ms |\
      \ {mute} | radio {share:.1f} % of \"\n              f\"samp_rate, MAC CPU {100.0\
      \ * self._cpu / wall:.0f} %\"\n              + (f\" | WARNING frame length formula\
      \ off {st['len_mismatch']}x: phy_* must match the framer\"\n               \
      \  if st[\"len_mismatch\"] else \"\"), flush=True)\n        self._windows +=\
      \ 1\n        if self._windows >= 2 and share < 99.0:\n            print(f\"\
      [MAC] WARNING: only {share:.1f} % of the samples arrive: the PC is not keeping\
      \ up.\", flush=True)\n        self._wall0, self._n_wall0, self._cpu = time.monotonic(),\
      \ self._n_abs, 0.0\n        self._stat_t0 = self._t\n        self._busy_time\
      \ = self._nav_time = 0.0\n"
    affinity: ''
    alias: ''
    auto_delay: '1'
    ba_timeout_s: MAC_BA_TO
    blank_rx: '1'
    burst_m: ARQ_M
    comment: 'CSMA/CA (p-persistence, DIFS, exponential backoff, NAV) + SR-ARQ: TXOP
      burst of M frames, Block ACK bitmap, window N; TX mute / RX blanking'

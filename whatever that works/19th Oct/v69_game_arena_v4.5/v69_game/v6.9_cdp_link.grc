    stats_every_s: '10.0'
    turnaround_s: MAC_TURN
    tx_att_db: CH_GAIN
    tx_delay_s: '0.012'
    tx_mute: TX_MUTE
    txop_limit_s: MAC_TXOP
    udp_queue: MAC_UDPQ
    unmute_timeout_s: '0.1'
    verbose: '1'
    window_n: ARQ_N
  states:
    _io_cache: ('CSMA/CA DCF + SR-ARQ (TXOP burst, Block ACK) + TX mute', 'SrArqMac',
      [('samp_rate', '1000000.0'), ('samples_per_byte', '32'), ('my_id', '1'), ('dest_id',
      '255'), ('burst_m', '4'), ('window_n', '16'), ('txop_limit_s', '0.25'), ('p_persist',
      '0.04'), ('slot_s', '0.002'), ('sifs_s', '0.001'), ('turnaround_s', '0.025'),
      ('difs_s', '0.0'), ('cw_min', '15'), ('cw_max', '1023'), ('k_max', '5'), ('retry_limit',
      '7'), ('ba_timeout_s', '0.07'), ('max_queue', '256'), ('udp_queue', '32'), ('phy_preamble_len',
      '128'), ('phy_fec', '31'), ('phy_buffer_size', '4096'), ('phy_max_payload',
      '2048'), ('cs_margin_db', '6.0'), ('cs_hyst_db', '2.0'), ('cs_bw_hz', '400000.0'),
      ('dc_exclude_hz', '10000.0'), ('nfft', '256'), ('sense_s', '0.001'), ('floor_window_s',
      '2.0'), ('floor_percentile', '10.0'), ('floor_rise_db_s', '1.0'), ('blank_rx',
      '1'), ('tx_delay_s', '0.012'), ('auto_delay', '1'), ('gate_guard_s', '0.005'),
      ('tx_mute', '1'), ('iio_uri', "'ip:192.168.1.10'"), ('tx_att_db', '20.0'), ('mute_att_db',

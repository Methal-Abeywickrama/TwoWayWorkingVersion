- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Test Traffic TX  (packet generator\
      \ + TX log)\n\nConnect:  msg_out  ->  Packet Framer TX  msg_in      (the QT\
      \ message edit box can stay connected too)\n\nSends test packets following a\
      \ test plan and writes one CSV row per packet (wall-clock timestamp\nand the\
      \ exact payload) to  <log_dir>/tx_<date>_<time>_run<id>.csv\n\ntest_plan (string):\
      \  \"SIZExCOUNT@INTERVAL; SIZExCOUNT@INTERVAL; ...\"\n    \"20x50@0.5; 200x50@0.5;\
      \ 1000x50@1; 2000x30@1.5\"\n    SIZE      payload bytes, including the 8-byte\
      \ test header (min 8, max max_payload_len)\n    COUNT     packets in this set\n\
      \    INTERVAL  seconds between packet starts; \"ms\" suffix allowed: 100x50@250ms\n\
      \    optional set names:  \"short:20x50@0.5; long:2000x30@1.5\"\n  A Python\
      \ list also works:  [(20, 50, 0.5), (200, 50, 0.5, \"medium\")]\n\nPayload =\
      \ [A5 5A][run_id: 2 B][seq: 4 B][fill]\n    payload_mode \"ascii\"  : readable\
      \ text (default; keeps the framer/deframer console prints clean)\n         \
      \        \"random\" : reproducible pseudo-random bytes (most representative\
      \ for the PHY)\n                 \"fixed\"  : fill_byte repeated\nThe RX logger\
      \ and analyze_link.py match packets by (run_id, seq).\n\nA run starts start_delay\
      \ seconds after the flowgraph starts (autostart=1), or whenever any message\n\
      arrives on the ctrl port (e.g. a QT GUI Msg Push Button). A ctrl message containing\
      \ \"stop\" ends the run.\nEach run gets a new random run_id and its own log\
      \ file.\nTimestamps are wall-clock (time.time) in microseconds; keep both PCs\
      \ NTP-synced for one-way latency.\nNote: the timestamp is when the packet is\
      \ handed to the framer, not when it is on air. If the interval\nis shorter than\
      \ the airtime, packets queue in the TX chain and the measured latency grows.\n\
      \"\"\"\nimport csv\nimport datetime\nimport os\nimport re\nimport socket\nimport\
      \ threading\nimport time\n\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\nMAGIC = b\"\\xA5\\x5A\"\nTEST_HDR_LEN = 8                       # magic(2)\
      \ + run_id(2) + seq(4)\nASCII_TEXT = b\"The quick brown fox jumps over the lazy\
      \ dog 0123456789. \"\nTX_FIELDS = [\"run_id\", \"seq\", \"loop\", \"set_idx\"\
      , \"set_name\", \"size\", \"interval_s\",\n             \"tx_time_us\", \"tx_time_iso\"\
      , \"late_ms\", \"host\", \"payload_mode\", \"payload_hex\"]\n\n\ndef parse_plan(plan):\n\
      \    \"\"\"Returns [(name, size, count, interval_s), ...] from a plan string\
      \ or list.\"\"\"\n    entries = []\n    if isinstance(plan, str):\n        items\
      \ = [s.strip() for s in re.split(r\"[;\\n]\", plan) if s.strip()]\n        for\
      \ i, item in enumerate(items):\n            name = None\n            if \":\"\
      \ in item:\n                name, item = item.split(\":\", 1)\n            \
      \    name = name.strip() or None\n            m = re.fullmatch(r\"\\s*(\\d+)\\\
      s*[xX*]\\s*(\\d+)\\s*@\\s*([0-9]*\\.?[0-9]+)\\s*(ms|s)?\\s*\", item)\n     \
      \       if not m:\n                raise ValueError(f\"test_plan entry '{item}':\
      \ use SIZExCOUNT@INTERVAL, e.g. 100x50@0.5\")\n            size, count, iv =\
      \ int(m.group(1)), int(m.group(2)), float(m.group(3))\n            if m.group(4)\
      \ == \"ms\":\n                iv /= 1000.0\n            entries.append((name\
      \ or f\"set{i}_{size}B\", size, count, iv))\n    else:\n        for i, e in\
      \ enumerate(plan):\n            if isinstance(e, dict):\n                size,\
      \ count, iv, name = int(e[\"size\"]), int(e[\"count\"]), float(e[\"interval\"\
      ]), e.get(\"name\")\n            else:\n                size, count, iv = int(e[0]),\
      \ int(e[1]), float(e[2])\n                name = str(e[3]) if len(e) > 3 else\
      \ None\n            entries.append((name or f\"set{i}_{size}B\", size, count,\
      \ iv))\n    return entries\n\n\nclass TestTrafficTX(gr.basic_block):\n    def\
      \ __init__(self, test_plan=\"20x50@0.5; 200x50@0.5; 1000x50@1.0\", repeat_plan=1,\n\
      \                 start_delay=5.0, set_gap=2.0, payload_mode=\"ascii\", fill_byte=0x55,\n\
      \                 max_payload_len=2048, log_dir=\"~/link_tests\", autostart=1):\n\
      \        gr.basic_block.__init__(self, name=\"Test Traffic TX\", in_sig=None,\
      \ out_sig=None)\n        self.test_plan = test_plan\n        self.repeat_plan\
      \ = max(1, int(repeat_plan))\n        self.start_delay = max(0.0, float(start_delay))\n\
      \        self.set_gap = max(0.0, float(set_gap))\n        self.payload_mode\
      \ = str(payload_mode).lower()\n        self.fill_byte = int(fill_byte) & 0xFF\n\
      \        self.max_payload_len = int(max_payload_len)\n        self.log_dir =\
      \ str(log_dir)\n        self.autostart = int(autostart)\n        if self.payload_mode\
      \ not in (\"ascii\", \"random\", \"fixed\"):\n            raise ValueError(\"\
      payload_mode must be 'ascii', 'random' or 'fixed'\")\n        self._plan = self._checked_plan(test_plan)\
      \       # a bad plan raises here -> visible in GRC\n        self._host = socket.gethostname()\n\
      \        self._thread = None\n        self._stop_evt = threading.Event()\n \
      \       self._lock = threading.Lock()\n\n        self._port_out = pmt.intern(\"\
      msg_out\")\n        self.message_port_register_out(self._port_out)\n       \
      \ self.message_port_register_in(pmt.intern(\"ctrl\"))\n        self.set_msg_handler(pmt.intern(\"\
      ctrl\"), self._handle_ctrl)\n\n    # ----------------------------------------------------------------\
      \ plan\n    def _checked_plan(self, plan):\n        out = []\n        for name,\
      \ size, count, iv in parse_plan(plan):\n            s = max(size, TEST_HDR_LEN)\n\
      \            if self.max_payload_len > 0:\n                s = min(s, self.max_payload_len)\n\
      \            if s != size:\n                print(f\"[TEST TX] set '{name}':\
      \ size {size} B -> {s} B \"\n                      f\"(min {TEST_HDR_LEN}, max\
      \ {self.max_payload_len})\", flush=True)\n            if count <= 0 or iv <\
      \ 0:\n                raise ValueError(f\"set '{name}': count must be > 0 and\
      \ interval >= 0\")\n            out.append((name, s, count, iv))\n        if\
      \ not out:\n            raise ValueError(\"test_plan is empty\")\n        return\
      \ out\n\n    # ----------------------------------------------------------------\
      \ run control\n    def start(self):\n        if self.autostart:\n          \
      \  self._launch(self.start_delay)\n        return True\n\n    def stop(self):\n\
      \        self._halt()\n        return True\n\n    def _launch(self, delay):\n\
      \        with self._lock:\n            self._halt_locked()\n            self._stop_evt\
      \ = threading.Event()\n            self._thread = threading.Thread(target=self._run_safe,\
      \ args=(delay, self._stop_evt), daemon=True)\n            self._thread.start()\n\
      \n    def _halt(self):\n        with self._lock:\n            return self._halt_locked()\n\
      \n    def _halt_locked(self):\n        running = self._thread is not None and\
      \ self._thread.is_alive()\n        if running:\n            self._stop_evt.set()\n\
      \            self._thread.join(timeout=3.0)\n        self._thread = None\n \
      \       return running\n\n    def _handle_ctrl(self, msg):\n        try:\n \
      \           if pmt.is_pair(msg):\n                txt = f\"{pmt.to_python(pmt.car(msg))}\
      \ {pmt.to_python(pmt.cdr(msg))}\"\n            else:\n                txt =\
      \ str(pmt.to_python(msg))\n        except Exception:\n            txt = \"\"\
      \n        if \"stop\" in txt.lower():\n            if self._halt():\n      \
      \          print(\"[TEST TX] run stopped by ctrl message\", flush=True)\n  \
      \      else:\n            print(\"[TEST TX] new run requested by ctrl message\"\
      , flush=True)\n            self._launch(0.0)\n\n    # ----------------------------------------------------------------\
      \ payload\n    def _make_payload(self, run_id, seq, size):\n        hdr = MAGIC\
      \ + run_id.to_bytes(2, \"big\") + (seq & 0xFFFFFFFF).to_bytes(4, \"big\")\n\
      \        n = size - len(hdr)\n        if n <= 0:\n            return hdr\n \
      \       if self.payload_mode == \"random\":\n            rng = np.random.default_rng((run_id\
      \ << 32) | seq)\n            fill = rng.integers(0, 256, n, dtype=np.uint8).tobytes()\n\
      \        elif self.payload_mode == \"ascii\":\n            base = b\"#%07d \"\
      \ % seq + ASCII_TEXT\n            fill = (base * (n // len(base) + 1))[:n]\n\
      \        else:\n            fill = bytes([self.fill_byte]) * n\n        return\
      \ hdr + fill\n\n    # ----------------------------------------------------------------\
      \ worker thread\n    def _run_safe(self, delay, stop_evt):\n        try:\n \
      \           self._run(delay, stop_evt)\n        except Exception as e:     \
      \                 # never die silently in a thread\n            print(f\"[TEST\
      \ TX] ERROR: {e!r}\", flush=True)\n\n    def _run(self, delay, stop_evt):\n\
      \        if stop_evt.wait(delay):\n            return\n        run_id = int.from_bytes(os.urandom(2),\
      \ \"big\")\n        d = os.path.expanduser(self.log_dir)\n        os.makedirs(d,\
      \ exist_ok=True)\n        path = os.path.join(d, f\"tx_{datetime.datetime.now():%Y%m%d_%H%M%S}_run{run_id:04x}.csv\"\
      )\n        total = sum(c for _, _, c, _ in self._plan) * self.repeat_plan\n\
      \        print(f\"[TEST TX] run {run_id:04x}: {len(self._plan)} sets x {self.repeat_plan}\
      \ loop(s), \"\n              f\"{total} packets, log -> {path}\", flush=True)\n\
      \n        seq, max_late, n_late = 0, 0.0, 0\n        with open(path, \"w\",\
      \ newline=\"\") as f:\n            w = csv.writer(f)\n            w.writerow(TX_FIELDS)\n\
      \            f.flush()\n            for loop in range(self.repeat_plan):\n \
      \               for set_idx, (name, size, count, iv) in enumerate(self._plan):\n\
      \                    print(f\"[TEST TX] run {run_id:04x} loop {loop + 1}/{self.repeat_plan}\
      \ set {set_idx + 1}/\"\n                          f\"{len(self._plan)} '{name}':\
      \ {count} x {size} B every {iv:g} s\", flush=True)\n                    t_next\
      \ = time.monotonic()\n                    for _ in range(count):\n         \
      \               wait = t_next - time.monotonic()\n                        if\
      \ wait > 0 and stop_evt.wait(wait):\n                            print(f\"[TEST\
      \ TX] run {run_id:04x} stopped after {seq} packets\", flush=True)\n        \
      \                    return\n                        late = max(0.0, -wait)\n\
      \                        max_late = max(max_late, late)\n                  \
      \      if iv > 0 and late > 0.1 * iv:\n                            n_late +=\
      \ 1\n                        payload = self._make_payload(run_id, seq, size)\n\
      \                        t_us = time.time_ns() // 1000\n                   \
      \     self.message_port_pub(self._port_out,\n                              \
      \                pmt.cons(pmt.make_dict(),\n                               \
      \                        pmt.init_u8vector(len(payload), list(payload))))\n\
      \                        w.writerow([run_id, seq, loop, set_idx, name, size,\
      \ iv, t_us,\n                                    datetime.datetime.fromtimestamp(t_us\
      \ / 1e6).isoformat(timespec=\"milliseconds\"),\n                           \
      \         f\"{late * 1000:.2f}\", self._host, self.payload_mode, payload.hex()])\n\
      \                        f.flush()\n                        seq += 1\n     \
      \                   t_next += iv\n                    if self.set_gap > 0 and\
      \ stop_evt.wait(self.set_gap):\n                        print(f\"[TEST TX] run\
      \ {run_id:04x} stopped after {seq} packets\", flush=True)\n                \
      \        return\n        msg = f\"[TEST TX] run {run_id:04x} DONE: {seq} packets\
      \ sent, max scheduling lateness {max_late * 1000:.1f} ms\"\n        if n_late:\n\
      \            msg += f\" ({n_late} packets >10% of their interval late: this\
      \ PC cannot keep that rate)\"\n        print(msg, flush=True)"
    affinity: ''
    alias: ''
    autostart: '1'
    comment: ''
    fill_byte: '255'
    log_dir: '"~/link_tests"'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    payload_mode: '"ascii"'
    repeat_plan: '1'
    set_gap: '2'
    start_delay: '5'
    test_plan: '"20x50@0.5; 200x50@0.5; 1000x50@1.0"'
  states:
    _io_cache: ('Test Traffic TX', 'TestTrafficTX', [('test_plan', "'20x50@0.5; 200x50@0.5;
      1000x50@1.0'"), ('repeat_plan', '1'), ('start_delay', '5.0'), ('set_gap', '2.0'),
      ('payload_mode', "'ascii'"), ('fill_byte', '85'), ('max_payload_len', '2048'),
      ('log_dir', "'~/link_tests'"), ('autostart', '1')], [('ctrl', 'message', 1)],
      [('msg_out', 'message', 1)], '', ['autostart', 'fill_byte', 'log_dir', 'max_payload_len',
      'payload_mode', 'repeat_plan', 'set_gap', 'start_delay', 'test_plan'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 2000.0]
    rotation: 180
    state: disabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX (with equalizer\
      \ training word)\n- Outputs packed byte PDUs directly to pdu_pdu_to_tagged_stream\n\
      - Zero idle transmission between bursts\n- Frame layout: [preamble] [train word:\
      \ F8 DD 42 58] [1A CF FC 1D] [len: 2B][dest_id: 1B][msg_id: 1B][rep: 1B][n_reps:\
      \ 1B] [payload] [CRC32: 4B] [postamble]\n- The train word is known to the RX:\
      \ the correlator (digital_corr_est_cc) finds it, tags it,\n  and the linear\
      \ equalizer trains on it. The deframer does not look at it (it only looks for\
      \ the sync word).\n- Postamble dynamically padded so total size is a multiple\
      \ of buffer_size\n- Attaches tx_sob (Start of Burst) and tx_eob (End of Burst)\
      \ metadata tags\n\"\"\"\nimport zlib\nimport pmt\nfrom gnuradio import gr\n\n\
      SYNC_WORD = bytes([0x1A, 0xCF, 0xFC, 0x1D])\n# 31-bit m-sequence + 1 pad bit.\
      \ MUST match TRAIN_BITS in the flowgraph (RX side).\nTRAIN_WORD = bytes([0xF8,\
      \ 0xDD, 0x42, 0x58])\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(\n\
      \        self,\n        peer_id=1,\n        preamble_len=64,\n        repeat_count=5,\n\
      \        max_payload_len=1024,\n        preamble_byte=0xFF,\n        buffer_size=512,\n\
      \        postamble_byte=0x00,\n        train_enable=1,\n    ):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"Packet Framer TX (Burst)\",\n       \
      \     in_sig=None,\n            out_sig=None,\n        )\n        self.peer_id\
      \ = int(peer_id) & 0xFF\n        self.preamble_len = int(preamble_len)\n   \
      \     self.repeat_count = int(repeat_count)\n        self.max_payload_len =\
      \ int(max_payload_len)\n        self.preamble_byte = int(preamble_byte) & 0xFF\n\
      \        self.buffer_size = int(buffer_size)\n        self.postamble_byte =\
      \ int(postamble_byte) & 0xFF\n        self.train_enable = int(train_enable)\n\
      \        self._msg_id = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      msg_in\"))\n        self.set_msg_handler(pmt.intern(\"msg_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    @staticmethod\n\
      \    def _extract_payload(msg):\n        if pmt.is_pair(msg):\n            data\
      \ = pmt.cdr(msg)\n            if pmt.is_u8vector(data):\n                return\
      \ bytes(pmt.u8vector_elements(data))\n            return str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        if pmt.is_symbol(msg):\n            return pmt.symbol_to_string(msg).encode(\"\
      utf-8\")\n        val = pmt.to_python(msg)\n        if isinstance(val, (bytes,\
      \ bytearray)):\n            return bytes(val)\n        return str(val).encode(\"\
      utf-8\")\n\n    def handle_msg(self, msg):\n        try:\n            payload\
      \ = self._extract_payload(msg)\n        except Exception as e:\n           \
      \ print(f\"[TX] Could not parse message: {e}\", flush=True)\n            return\n\
      \n        if not payload:\n            return\n\n        if len(payload) > self.max_payload_len:\n\
      \            print(f\"[TX] Payload {len(payload)} B truncated to {self.max_payload_len}\
      \ B\", flush=True)\n            payload = payload[: self.max_payload_len]\n\n\
      \        msg_id = self._msg_id\n        self._msg_id = (self._msg_id + 1) &\
      \ 0xFF\n        n_reps = max(1, min(255, self.repeat_count))\n\n        preamble\
      \ = bytes([self.preamble_byte]) * self.preamble_len\n        train = TRAIN_WORD\
      \ if self.train_enable else b\"\"\n        print(\n            f\"[TX] msg #{msg_id}\
      \ (to peer {self.peer_id}): '{payload.decode('utf-8', 'replace')}' ({n_reps}\
      \ bursts queued)\",\n            flush=True,\n        )\n\n        for rep in\
      \ range(n_reps):\n            header = len(payload).to_bytes(2, \"big\") + bytes([self.peer_id,\
      \ msg_id, rep, n_reps])\n            crc = zlib.crc32(header + payload).to_bytes(4,\
      \ \"big\")\n\n            # Core frame structure before buffer alignment\n \
      \           raw_frame = preamble + train + SYNC_WORD + header + payload + crc\n\
      \n            # Calculate postamble padding required to match buffer_size multiple\n\
      \            if self.buffer_size > 0:\n                rem = len(raw_frame)\
      \ % self.buffer_size\n                pad_len = (self.buffer_size - rem) % self.buffer_size\n\
      \            else:\n                pad_len = 0\n\n            postamble = bytes([self.postamble_byte])\
      \ * pad_len\n            frame = raw_frame + postamble\n\n            # Build\
      \ metadata dictionary with tx_sob and tx_eob tags\n            meta = pmt.make_dict()\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"tx_sob\"), pmt.PMT_T)\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"tx_eob\"), pmt.PMT_T)\n\n\
      \            # Explicit offset tags for downstream PDU-to-Tagged-Stream conversion\n\
      \            sob_tag = pmt.make_tuple(pmt.from_long(0), pmt.intern(\"tx_sob\"\
      ), pmt.PMT_T)\n            eob_tag = pmt.make_tuple(pmt.from_long(len(frame)\
      \ - 1), pmt.intern(\"tx_eob\"), pmt.PMT_T)\n            extra_tags = pmt.list2(sob_tag,\
      \ eob_tag)\n            meta = pmt.dict_add(meta, pmt.intern(\"extra_tags\"\
      ), extra_tags)\n\n            vec = pmt.init_u8vector(len(frame), list(frame))\n\
      \            self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(meta, vec))\n"
    affinity: ''
    alias: ''
    buffer_size: BUFFER_SIZE
    comment: ''
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    peer_id: '1'
    postamble_byte: '0xFF'
    preamble_byte: '0xFF'
    preamble_len: '128'
    repeat_count: '1'
    train_enable: '1'
  states:
    _io_cache: ('Packet Framer TX (Burst)', 'PacketFramerTX', [('peer_id', '1'), ('preamble_len',
      '64'), ('repeat_count', '5'), ('max_payload_len', '1024'), ('preamble_byte',
      '255'), ('buffer_size', '512'), ('postamble_byte', '0'), ('train_enable', '1')],
      [('msg_in', 'message', 1)], [('pdu_out', 'message', 1)], '', ['buffer_size',
      'max_payload_len', 'peer_id', 'postamble_byte', 'preamble_byte', 'preamble_len',
      'repeat_count', 'train_enable'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 1732.0]
    rotation: 180
    state: disabled
- name: epy_block_0_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Fast Burst Packet Deframer RX (Hamming\
      \ FEC) - v6.5, src / dest addressing, diagnostics\n- Vectorized NumPy sliding-window\
      \ sync detection; positive correlation only (diff decoder resolves 180 deg)\n\
      - fec = 0 / 15 / 31 and interleave must match the TX framer (v6.5 framer: 7-byte\
      \ header with dest_id and src_id)\n- Hamming decode: header section first (gives\
      \ the length), then payload+CRC section; CRC32 over header+payload\n- src_id\
      \ = this node's ID (the same value its framer writes as src_id).\n  Address\
      \ filter: delivers frames whose dest_id == src_id or dest_id == 255 (every node);\
      \ drops frames addressed\n  to other nodes, and frames whose src_id == this\
      \ node's (its own echo). accept_all = 1 delivers every good frame.\n- Repeat\
      \ filter, per sender: a frame is a repeat only if it has the same msg_id as\
      \ that sender's last message, a\n  burst number not seen yet, and arrives within\
      \ dup_window_s. A restarted sender (msg_id back to 0) is shown again.\n- pdu_out\
      \ metadata: src_id, dest_id, msg_id, n_reps, fec_corrected\n\nDiagnostics (debug\
      \ = 1), at most max_dbg_lines lines per second:\n  [RX dbg] train word ... \
      \ for every 'corr_est' tag (the correlator found the train word), once the bits\
      \ behind it\n                           have arrived: bit errors in the train\
      \ word and in the sync word right after it, counted\n                      \
      \     on the decoded bits (after equalizer, Costas, slicer, diff decoder, i.e.\
      \ what this block\n                           gets). The deframer locks only\
      \ if the sync word has <= max_bit_errors errors.\n  [RX dbg] frame ...     \
      \  for every sync word this block locks on: header length, CRC result, bits\
      \ fixed by the\n                           FEC, squelch closures inside the\
      \ frame ('squelch_eob' tags: the power squelch with\n                      \
      \     gate = True dropped samples there), sender ID and what happened to the\
      \ frame.\n  [RX stats] ...           every stats_every_s while there is traffic:\
      \ counters for each stage since the\n                           previous [RX\
      \ stats] line, and good frames per sender ID.\nv6.7: print_rx = 0 stops the\
      \ per-frame [RX RECEIVED] / [RX] msg prints (use with the DCF MAC, which receives\
      \ every\nframe with accept_all = 1, removes duplicates and prints what is for\
      \ this node).\nStress-test build: every train-word check and every sync lock\
      \ (with its result) also goes to the debug bus\n(src \"deframer\"); stress DATA\
      \ packets (\"CDPST,D,...\") are not printed as [RX RECEIVED].\n\"\"\"\nimport\
      \ time\nimport zlib\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\
      \n# ---- shared debug bus (one per flowgraph process; the Stress Test block\
      \ writes it to disk) ----\nimport sys as _sys\nimport types as _types\nimport\
      \ collections as _collections\nimport time as _time\n\n\ndef _bus():\n    b\
      \ = _sys.modules.get(\"cdp_dbg_bus\")\n    if b is None:\n        nb = _types.ModuleType(\"\
      cdp_dbg_bus\")\n        nb.events = _collections.deque(maxlen=400000)   # dicts;\
      \ oldest dropped if nobody writes them\n        nb.sources = {}            \
      \                     # name -> object with dbg_snapshot()\n        b = _sys.modules.setdefault(\"\
      cdp_dbg_bus\", nb)\n    return b\n\n\ndef _emit(blk, kind, /, **kw):\n    kw[\"\
      t\"] = round(_time.time(), 6)\n    kw[\"blk\"] = blk\n    kw[\"k\"] = kind\n\
      \    _bus().events.append(kw)\n# ---- end debug bus ----\n\n# ---- C++ kernels\
      \ (cdp_fast.py / cdp_fast.cpp next to the flowgraph); None -> the NumPy code\
      \ of this block ----\ndef _load_fast():\n    import os as _os\n    if _os.environ.get(\"\
      CDP_FAST\", \"1\").strip().lower() in (\"0\", \"no\", \"off\", \"false\"):\n\
      \        return None\n    try:\n        import cdp_fast\n        return cdp_fast\n\
      \    except ImportError:\n        pass\n    for d in (_os.environ.get(\"CDP_HOME\"\
      ), _os.getcwd(),\n              _os.path.dirname(_os.path.abspath(_sys.argv[0]))\
      \ if _sys.argv and _sys.argv[0] else None):\n        if d and _os.path.isfile(_os.path.join(d,\
      \ \"cdp_fast.py\")):\n            if d not in _sys.path:\n                _sys.path.insert(0,\
      \ d)\n            try:\n                import cdp_fast\n                return\
      \ cdp_fast\n            except Exception:\n                return None\n   \
      \ return None\n# ---- end C++ kernels ----\n\n\ndef _stress_seq(payload):\n\
      \    if payload.startswith(b\"CDPST,\"):\n        try:\n            f = payload[:48].split(b\"\
      ,\")\n            return f[1].decode(), int(f[3])\n        except Exception:\n\
      \            return \"?\", None\n    return None, None\n\nSYNC_WORD = bytes([0x1A,\
      \ 0xCF, 0xFC, 0x1D])\nTRAIN_WORD = bytes([0xF8, 0xDD, 0x42, 0x58])     # must\
      \ match the framer / TRAIN_BITS\nHDR_BYTES = 7  # len (2B) + dest_id (1B) +\
      \ src_id (1B) + msg_id (1B) + rep (1B) + n_reps (1B)\nBROADCAST = 0xFF\nHIST_BITS\
      \ = 1 << 16\n\n\ndef hamming_tables(n):\n    \"\"\"Standard positional Hamming\
      \ layout: parity bits at positions 1, 2, 4, 8, (16).\"\"\"\n    m = {15: 4,\
      \ 31: 5}[n]\n    pos = np.arange(1, n + 1)\n    is_parity = (pos & (pos - 1))\
      \ == 0\n    data_idx = np.flatnonzero(~is_parity)\n    H = ((pos[None, :] >>\
      \ np.arange(m)[:, None]) & 1).astype(np.int32)   # m x n, column j = bin(j)\n\
      \    weights = (1 << np.arange(m)).astype(np.int32)\n    return data_idx, H,\
      \ weights\n\n\ndef hamming_decode_bits(coded, n, nblk, interleave):\n    \"\"\
      \"coded: nblk*n bits. Returns (data bits nblk*k, number of corrected bits).\"\
      \"\"\n    data_idx, H, weights = hamming_tables(n)\n    c = np.asarray(coded,\
      \ dtype=np.int32)\n    cw = c.reshape(n, nblk).T.copy() if interleave else c.reshape(nblk,\
      \ n).copy()\n    S = ((cw @ H.T) & 1) @ weights          # syndrome = error\
      \ position (1..n), 0 = no error\n    bad = np.flatnonzero(S)\n    cw[bad, S[bad]\
      \ - 1] ^= 1                # flip bit at position S\n    return cw[:, data_idx].reshape(-1).astype(np.uint8),\
      \ int(bad.size)\n\n\ndef _pm(b):\n    return np.unpackbits(np.frombuffer(b,\
      \ np.uint8)).astype(np.int16) * 2 - 1\n\n\nclass PacketDeframerRX(gr.sync_block):\n\
      \    def __init__(self, src_id=1, max_bit_errors=2, max_payload_len=1024, bit_rate=375000,\n\
      \                 fec=15, interleave=True, accept_all=0, debug=1, max_dbg_lines=20,\
      \ stats_every_s=10.0,\n                 dup_window_s=2.0, print_rx=1):\n   \
      \     gr.sync_block.__init__(\n            self,\n            name=\"Packet\
      \ Deframer RX (Fast Burst, Hamming, src/dest)\",\n            in_sig=[np.uint8],\n\
      \            out_sig=None,\n        )\n        self.src_id = int(src_id) & 0xFF\n\
      \        self.accept_all = int(accept_all)\n        self.max_bit_errors = int(max_bit_errors)\n\
      \        self.max_payload_len = int(max_payload_len)\n        self.bit_rate\
      \ = float(bit_rate)\n        self.fec = int(fec)\n        self.interleave =\
      \ bool(interleave)\n        self.debug = int(debug)\n        self.max_dbg_lines\
      \ = max(1, int(max_dbg_lines))\n        self.stats_every_s = float(stats_every_s)\n\
      \        self.dup_window_s = float(dup_window_s)\n        self.print_rx = int(print_rx)\
      \         # 0: no [RX RECEIVED] / [RX] msg lines (the DCF MAC prints delivered\
      \ data)\n        if self.fec not in (0, 15, 31):\n            raise ValueError(\"\
      fec must be 0, 15 or 31\")\n\n        self._sync = _pm(SYNC_WORD)\n        self._train\
      \ = _pm(TRAIN_WORD)\n        self._buf = np.zeros(0, dtype=np.uint8)\n     \
      \   self._buf_abs = 0                     # absolute input index of self._buf[0]\n\
      \n        # decoded-bit history for the train-word check\n        self._hist\
      \ = np.zeros(0, dtype=np.uint8)\n        self._hist_abs = 0\n        self._train_pending\
      \ = []              # [(abs offset, rho)]\n        self._train_seen = []   \
      \              # [(abs index where the sync word should start, rho, terr, serr)]\n\
      \        self._eobs = []                       # abs offsets of squelch_eob\
      \ tags (recent)\n\n        self.n_sync = 0\n        self.n_ok = 0\n        self.n_crc_fail\
      \ = 0\n        self.n_bad_len = 0\n        self.n_fec_corrected = 0\n      \
      \  self._c = dict.fromkeys((\"train\", \"train_clean\", \"train_bad_sync\",\
      \ \"train_garbage\", \"lock\", \"bad_len\",\n                              \
      \   \"crc_fail\", \"crc_fail_cut\", \"ok\", \"other\", \"own\", \"delivered\"\
      , \"repeat\",\n                                 \"sq_eob\"), 0)\n        self._by_src\
      \ = {}                     # src id -> good frames since the last stats line\n\
      \        self._c_last = dict(self._c)\n        self._t_stats = time.monotonic()\n\
      \        self._dbg_t = 0.0\n        self._dbg_n = 0\n        self._dbg_dropped\
      \ = 0\n        self._warned_id = False\n        self._own_seen = 0\n\n     \
      \   self._bits_total = 0\n        self._bits_at_last_ok = 0\n        self._cur_id\
      \ = None\n        self._cur_reps = set()\n        self._cur_nreps = 0\n    \
      \    self._cur_corr = 0\n        self._last = {}                       # src\
      \ -> {\"msg\": msg_id, \"reps\": set, \"t\": time}\n        self._fast = None\
      \                     # C++ sync search + Hamming decoder (set in start)\n\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n        self.message_port_register_out(pmt.intern(\"\
      text_out\"))\n\n    # ---------- start / stop ----------\n    def start(self):\n\
      \        F = _load_fast()\n        self._fast = F if F is not None and F.lib()\
      \ is not None else None\n        print(F.status(\"deframer\") if F is not None\
      \ else \"[FAST] deframer: original Python code\", flush=True)\n        _bus().sources[\"\
      deframer\"] = self\n        _emit(\"deframer\", \"config\", src_id=self.src_id,\
      \ accept_all=self.accept_all, max_bit_errors=self.max_bit_errors,\n        \
      \      max_payload_len=self.max_payload_len, fec=self.fec, interleave=self.interleave)\n\
      \        self._dbg_last = dict(self._c)\n        what = \"every good frame (accept_all)\"\
      \ if self.accept_all else f\"frames with dest ID {self.src_id} or 255 (all)\"\
      \n        print(f\"[RX] this node: src ID {self.src_id}; delivers {what} \"\n\
      \              f\"(FEC {self.fec or 'off'}, sync word may have <= {self.max_bit_errors}\
      \ bit errors)\", flush=True)\n        return True\n\n    def stop(self):\n \
      \       self._flush_summary()\n        if self.debug:\n            self._print_stats(final=True)\n\
      \        return True\n\n    def dbg_snapshot(self):\n        c = dict(self._c)\n\
      \        last = getattr(self, \"_dbg_last\", None) or dict.fromkeys(c, 0)\n\
      \        self._dbg_last = c\n        return {k: c[k] - last.get(k, 0) for k\
      \ in c}\n\n    # ---------- debug output ----------\n    def _dbg(self, line):\n\
      \        if not self.debug:\n            return\n        now = time.monotonic()\n\
      \        if now - self._dbg_t >= 1.0:\n            self._dbg_t, self._dbg_n\
      \ = now, 0\n        if self._dbg_n >= self.max_dbg_lines:\n            self._dbg_dropped\
      \ += 1\n            return\n        self._dbg_n += 1\n        if self._dbg_dropped:\n\
      \            print(f\"[RX dbg] ({self._dbg_dropped} lines not shown: more than\
      \ {self.max_dbg_lines}/s)\", flush=True)\n            self._dbg_dropped = 0\n\
      \        print(f\"[RX dbg] {line}\", flush=True)\n\n    def _print_stats(self,\
      \ final=False):\n        c, l = self._c, self._c_last\n        d = {k: c[k]\
      \ - l[k] for k in c} if not final else c\n        if not final and not any(d.values()):\n\
      \            return\n        span = \"total\" if final else \"since last line\"\
      \n        senders = \", \".join(f\"ID {k}: {v}\" for k, v in sorted(self._by_src.items()))\
      \ or \"none\"\n        print(f\"[RX stats] {span}: train words {d['train']}\
      \ (clean {d['train_clean']}, sync word broken \"\n              f\"{d['train_bad_sync']},\
      \ no train word in the bits {d['train_garbage']}) | sync locks {d['lock']} |\
      \ \"\n              f\"bad length {d['bad_len']} | CRC fail {d['crc_fail']}\
      \ (squelch closed inside {d['crc_fail_cut']}) | \"\n              f\"CRC ok\
      \ {d['ok']}: delivered {d['delivered']}, repeats {d['repeat']}, for other nodes\
      \ {d['other']}, \"\n              f\"own {d['own']} | good frames by src ID:\
      \ {senders} | squelch closures {d['sq_eob']}\", flush=True)\n        self._c_last\
      \ = dict(c)\n        if not final:\n            self._by_src = {}\n\n    # ----------\
      \ section sizes (in channel bits) ----------\n    def _coded_len(self, n_bytes):\n\
      \        if self.fec == 0:\n            return n_bytes * 8, 0\n        nblk\
      \ = -(-(n_bytes * 8) // {15: 11, 31: 26}[self.fec])\n        return nblk * self.fec,\
      \ nblk\n\n    def _decode_section(self, coded, n_bytes, nblk):\n        if self.fec\
      \ == 0:\n            return np.packbits(coded).tobytes(), 0\n        if self._fast\
      \ is not None:\n            bits, corr = self._fast.hamming_decode_bits(coded,\
      \ self.fec, nblk, self.interleave)\n        else:\n            bits, corr =\
      \ hamming_decode_bits(coded, self.fec, nblk, self.interleave)\n        return\
      \ np.packbits(bits[:n_bytes * 8]).tobytes(), corr\n\n    # ---------- statistics\
      \ / delivery ----------\n    def _flush_summary(self):\n        if self._cur_id\
      \ is not None and self.print_rx:\n            got, n = len(self._cur_reps),\
      \ self._cur_nreps\n            loss = 100.0 * (n - got) / max(n, 1)\n      \
      \      fec_txt = f\", FEC corrected {self._cur_corr} bits\" if self.fec else\
      \ \"\"\n            print(f\"[RX] msg #{self._cur_id}: {got}/{n} bursts OK (Loss:\
      \ {loss:.0f}%){fec_txt}\", flush=True)\n        self._cur_id = None\n      \
      \  self._cur_reps = set()\n        self._cur_corr = 0\n\n    def _deliver(self,\
      \ header, payload, corrected):\n        \"\"\"Returns 'delivered' or 'repeat'.\"\
      \"\"\n        dst, sender, msg_id, rep, n_reps = header[2], header[3], header[4],\
      \ header[5], header[6]\n        now = time.monotonic()\n        last = self._last.get(sender)\n\
      \        repeat = (last is not None and last[\"msg\"] == msg_id and rep not\
      \ in last[\"reps\"]\n                  and now - last[\"t\"] <= self.dup_window_s)\n\
      \        self._bits_at_last_ok = self._bits_total\n        if repeat:\n    \
      \        last[\"reps\"].add(rep)\n            last[\"t\"] = now\n          \
      \  if rep not in self._cur_reps:\n                self._cur_corr += corrected\n\
      \            self._cur_reps.add(rep)\n            return \"repeat\"\n\n    \
      \    self._flush_summary()\n        self._last[sender] = {\"msg\": msg_id, \"\
      reps\": {rep}, \"t\": now}\n        self._cur_id, self._cur_nreps, self._cur_reps,\
      \ self._cur_corr = msg_id, n_reps, {rep}, corrected\n        text = payload.decode(\"\
      utf-8\", errors=\"replace\")\n        to = \"all\" if dst == BROADCAST else\
      \ f\"ID {dst}\"\n        if self.print_rx and not payload.startswith(b\"CDPST,D,\"\
      ):\n            shown = payload.split(b\"|\")[0].decode(\"ascii\", \"replace\"\
      ) if payload.startswith(b\"CDPST,\") else text\n            print(\"\\n\" +\
      \ \"=\" * 40, flush=True)\n            print(f\"[RX RECEIVED] #{msg_id} from\
      \ src ID {sender} to {to}: {shown}\", flush=True)\n            print(\"=\" *\
      \ 40 + \"\\n\", flush=True)\n\n        meta = pmt.make_dict()\n        meta\
      \ = pmt.dict_add(meta, pmt.intern(\"src_id\"), pmt.from_long(sender))\n    \
      \    meta = pmt.dict_add(meta, pmt.intern(\"dest_id\"), pmt.from_long(dst))\n\
      \        meta = pmt.dict_add(meta, pmt.intern(\"msg_id\"), pmt.from_long(msg_id))\n\
      \        meta = pmt.dict_add(meta, pmt.intern(\"n_reps\"), pmt.from_long(n_reps))\n\
      \        meta = pmt.dict_add(meta, pmt.intern(\"fec_corrected\"), pmt.from_long(corrected))\n\
      \        vec = pmt.init_u8vector(len(payload), list(payload))\n        self.message_port_pub(pmt.intern(\"\
      pdu_out\"), pmt.cons(meta, vec))\n        self.message_port_pub(pmt.intern(\"\
      text_out\"), pmt.intern(text))\n        return \"delivered\"\n\n    # ----------\
      \ diagnostics helpers ----------\n    def _read_tags(self, n):\n        try:\n\
      \            tags = self.get_tags_in_window(0, 0, n)\n        except Exception:\n\
      \            return\n        for t in tags:\n            try:\n            \
      \    key = pmt.symbol_to_string(t.key)\n            except Exception:\n    \
      \            continue\n            if key == \"corr_est\":\n               \
      \ try:\n                    rho = float(pmt.to_double(t.value))\n          \
      \      except Exception:\n                    rho = float(\"nan\")\n       \
      \         self._train_pending.append((int(t.offset), rho))\n               \
      \ self._c[\"train\"] += 1\n            elif key == \"squelch_eob\":\n      \
      \          self._eobs.append(int(t.offset))\n                self._c[\"sq_eob\"\
      ] += 1\n        if len(self._eobs) > 512:\n            self._eobs = self._eobs[-256:]\n\
      \n    def _check_trains(self):\n        \"\"\"Look at the decoded bits around\
      \ each correlator tag once enough bits have arrived.\"\"\"\n        end_abs\
      \ = self._hist_abs + len(self._hist)\n        keep = []\n        for off, rho\
      \ in self._train_pending:\n            if off + 160 > end_abs:\n           \
      \     keep.append((off, rho))\n                continue\n            a = max(0,\
      \ off - 64 - self._hist_abs)\n            b = off + 160 - self._hist_abs\n \
      \           seg = self._hist[a:b].astype(np.int16) * 2 - 1\n            if len(seg)\
      \ < 96:\n                continue\n            c = np.lib.stride_tricks.sliding_window_view(seg[:len(seg)\
      \ - 32], 32) @ self._train\n            j = int(np.argmax(c))\n            terr\
      \ = (32 - int(c[j])) // 2\n            serr = (32 - int(seg[j + 32:j + 64] @\
      \ self._sync)) // 2\n            sync_abs = self._hist_abs + a + j + 32\n  \
      \          self._train_seen.append((sync_abs, rho, terr, serr))\n          \
      \  _emit(\"deframer\", \"train\", rho=round(rho, 3), terr=terr, serr=serr, bit=int(sync_abs),\n\
      \                  ok=int(terr <= 3 and serr <= self.max_bit_errors))\n    \
      \        if terr <= 3 and serr <= self.max_bit_errors:\n                self._c[\"\
      train_clean\"] += 1\n                verdict = \"clean, deframer can lock\"\n\
      \            elif terr <= 3:\n                self._c[\"train_bad_sync\"] +=\
      \ 1\n                verdict = (f\"sync word has more than {self.max_bit_errors}\
      \ errors -> no lock: bits go wrong right \"\n                           f\"\
      after the train word (equalizer / Costas / squelch)\")\n            else:\n\
      \                self._c[\"train_garbage\"] += 1\n                verdict =\
      \ (\"the train word is not in the decoded bits: the demodulator output is wrong\
      \ although the \"\n                           \"correlator saw the word (equalizer,\
      \ Costas, slicer, diff decoder, DC offset)\")\n            self._dbg(f\"train\
      \ word (corr {rho:.2f}): decoded train word {terr}/32 bits wrong, \"\n     \
      \                 f\"sync word {serr}/32 wrong -> {verdict}\")\n        self._train_pending\
      \ = keep\n        if len(self._train_seen) > 64:\n            self._train_seen\
      \ = self._train_seen[-32:]\n\n    def _cuts(self, a, b):\n        return sum(1\
      \ for e in self._eobs if a < e < b)\n\n    def _keep(self, buf, start):\n  \
      \      start = max(0, min(start, len(buf)))\n        self._buf = buf[start:].copy()\n\
      \        self._buf_abs += start\n\n    # ---------- main loop ----------\n \
      \   def work(self, input_items, output_items):\n        bits = input_items[0]\
      \ & 1\n        n_in = len(bits)\n        self._bits_total += n_in\n        if\
      \ len(self._buf) == 0:\n            self._buf_abs = self.nitems_read(0)\n  \
      \      self._buf = np.concatenate((self._buf, bits)) if len(self._buf) else\
      \ bits.copy()\n\n        if self.debug:\n            self._read_tags(n_in)\n\
      \            if len(self._hist) == 0:\n                self._hist_abs = self.nitems_read(0)\n\
      \            self._hist = np.concatenate((self._hist, bits))\n            if\
      \ len(self._hist) > HIST_BITS:\n                cut = len(self._hist) - HIST_BITS\n\
      \                self._hist = self._hist[cut:]\n                self._hist_abs\
      \ += cut\n            self._check_trains()\n            if time.monotonic()\
      \ - self._t_stats >= self.stats_every_s:\n                self._t_stats = time.monotonic()\n\
      \                self._print_stats()\n\n        # Flush transmission stats once\
      \ channel has been quiet for > 0.5s of air time\n        if self._cur_id is\
      \ not None and self._bits_total - self._bits_at_last_ok > 0.5 * self.bit_rate:\n\
      \            self._flush_summary()\n\n        thr = 32 - 2 * self.max_bit_errors\n\
      \        hdr_coded, hdr_blk = self._coded_len(HDR_BYTES)\n        hdr_bits =\
      \ 32 + hdr_coded\n\n        while True:\n            buf = self._buf\n     \
      \       if len(buf) < hdr_bits:\n                return n_in\n\n           \
      \ if self._fast is not None:                  # C++: first sync word with <=\
      \ max_bit_errors errors\n                i = self._fast.find_sync(buf, 0, SYNC_WORD,\
      \ self.max_bit_errors)\n            else:\n                pm = buf.astype(np.int16)\
      \ * 2 - 1\n                corr = np.lib.stride_tricks.sliding_window_view(pm,\
      \ 32) @ self._sync\n                cand = np.flatnonzero(corr >= thr)\n   \
      \             i = int(cand[0]) if cand.size else -1\n\n            if i < 0:\n\
      \                self._keep(buf, len(buf) - 31)          # keep trailing bits\
      \ that might begin a sync word\n                return n_in\n\n            if\
      \ len(buf) < i + hdr_bits:\n                self._keep(buf, i)             \
      \         # await complete header bits\n                return n_in\n\n    \
      \        header, hdr_corr = self._decode_section(buf[i + 32: i + hdr_bits],\
      \ HDR_BYTES, hdr_blk)\n            length = int.from_bytes(header[:2], \"big\"\
      )\n            fa = self._buf_abs + i\n\n            if length == 0 or length\
      \ > self.max_payload_len:\n                self.n_bad_len += 1\n           \
      \     self._c[\"bad_len\"] += 1\n                if self._near_train(fa):\n\
      \                    _emit(\"deframer\", \"frame\", res=\"bad_len\", len=length,\
      \ bit=int(fa), fec=hdr_corr)\n                    self._dbg(f\"frame: sync word\
      \ found after a train word, but the header length {length} is \"\n         \
      \                     f\"invalid (FEC fixed {hdr_corr} bits) -> header corrupted\"\
      )\n                self._keep(buf, i + 1)                  # backtrack 1 bit\
      \ past false sync\n                continue\n\n            body_coded, body_blk\
      \ = self._coded_len(length + 4)\n            end = i + hdr_bits + body_coded\n\
      \            if len(buf) < end:\n                self._keep(buf, i)        \
      \              # await complete frame body bits\n                return n_in\n\
      \n            body, body_corr = self._decode_section(buf[i + hdr_bits: end],\
      \ length + 4, body_blk)\n            payload, rx_crc = body[:length], body[length:]\n\
      \            self.n_sync += 1\n            self._c[\"lock\"] += 1\n        \
      \    fe = self._buf_abs + end\n            cuts = self._cuts(fa - 32, fe)\n\
      \            cut_txt = f\", squelch closed {cuts}x inside the frame\" if cuts\
      \ else \"\"\n            corrected = hdr_corr + body_corr\n            crc_ok\
      \ = zlib.crc32(header + payload) == int.from_bytes(rx_crc, \"big\")\n      \
      \      styp, sseq = _stress_seq(payload) if crc_ok else (None, None)\n     \
      \       res = \"crc_fail\"\n            if crc_ok:\n                res = (\"\
      own\" if header[3] == self.src_id and not self.accept_all else\n           \
      \            \"ok\" if (self.accept_all or header[2] == self.src_id or header[2]\
      \ == BROADCAST) else \"other\")\n            _emit(\"deframer\", \"frame\",\
      \ res=res, len=length, src=int(header[3]), dst=int(header[2]),\n           \
      \       msg_id=int(header[4]), fec=corrected, cuts=cuts, bit=int(fa), near_train=int(self._near_train(fa)),\n\
      \                  stype=styp, sseq=sseq)\n\n            if zlib.crc32(header\
      \ + payload) == int.from_bytes(rx_crc, \"big\"):\n                self.n_fec_corrected\
      \ += corrected\n                self.n_ok += 1\n                self._c[\"ok\"\
      ] += 1\n                dst, sender, msg_id = header[2], header[3], header[4]\n\
      \                self._by_src[sender] = self._by_src.get(sender, 0) + 1\n  \
      \              to = \"all\" if dst == BROADCAST else f\"ID {dst}\"\n       \
      \         if sender == self.src_id and not self.accept_all:\n              \
      \      self._c[\"own\"] += 1\n                    preview = payload[:40].decode(\"\
      utf-8\", errors=\"replace\")\n                    self._dbg(f\"frame: {length}\
      \ B, CRC ok, src ID {sender} (this node's own) -> {to}, \"\n               \
      \               f\"msg #{msg_id} '{preview}' -> dropped\")\n               \
      \     if not self._warned_id:\n                        self._warned_id = True\n\
      \                        print(f\"[RX] WARNING: a good frame carried this node's\
      \ own src ID {sender}. If this PC \"\n                              f\"did not\
      \ just send that text, another PC uses the same CDP_MY_ID: every node needs\
      \ \"\n                              f\"its own ID. (If it is this PC's own text,\
      \ its own burst leaked past the CSMA \"\n                              f\"receive-off\
      \ window: raise gate_guard_s.)\", flush=True)\n                elif self.accept_all\
      \ or dst == self.src_id or dst == BROADCAST:\n                    what = self._deliver(header,\
      \ payload, corrected)\n                    self._c[what] += 1\n            \
      \        self._dbg(f\"frame: {length} B, CRC ok (FEC fixed {corrected} bits),\
      \ src ID {sender} -> {to}, \"\n                              f\"msg #{msg_id}\
      \ -> {'delivered' if what == 'delivered' else 'repeat burst, not shown again'}\"\
      )\n                else:\n                    self._c[\"other\"] += 1\n    \
      \                self._dbg(f\"frame: {length} B, CRC ok, src ID {sender} ->\
      \ {to}, msg #{msg_id} -> \"\n                              f\"not addressed\
      \ to this node (ID {self.src_id}), dropped\")\n                self._keep(buf,\
      \ end)                    # advance past valid frame\n            else:\n  \
      \              self.n_crc_fail += 1\n                self._c[\"crc_fail\"] +=\
      \ 1\n                if cuts:\n                    self._c[\"crc_fail_cut\"\
      ] += 1\n                self._dbg(f\"frame: header says {length} B, src ID {header[3]}\
      \ -> dest ID {header[2]}, msg #{header[4]}, CRC FAIL \"\n                  \
      \        f\"(FEC fixed {corrected} bits, still wrong){cut_txt}\")\n        \
      \        self._keep(buf, i + 1)                  # backtrack 1 bit past false\
      \ sync\n\n        return n_in\n\n    def _near_train(self, sync_abs):\n    \
      \    return any(abs(s - sync_abs) <= 8 for s, _, _, _ in self._train_seen)\n"
    accept_all: '1'
    affinity: ''
    alias: ''
    bit_rate: '375000'
    comment: 'v6.5: src_id = this node (MY_ID). Delivers frames with dest_id == src_id
      or 255; drops the rest and its own. accept_all=1: monitor every frame.'
    debug: '1'
    dup_window_s: '2.0'
    fec: FEC
    interleave: 'True'
    max_bit_errors: '1'
    max_dbg_lines: '10'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    print_rx: '0'
    src_id: MY_ID
    stats_every_s: '10.0'
  states:
    _io_cache: ('Packet Deframer RX (Fast Burst, Hamming, src/dest)', 'PacketDeframerRX',
      [('src_id', '1'), ('max_bit_errors', '2'), ('max_payload_len', '1024'), ('bit_rate',
      '375000'), ('fec', '15'), ('interleave', 'True'), ('accept_all', '0'), ('debug',
      '1'), ('max_dbg_lines', '20'), ('stats_every_s', '10.0'), ('dup_window_s', '2.0'),
      ('print_rx', '1')], [('0', 'byte', 1)], [('text_out', 'message', 1), ('pdu_out',
      'message', 1)], '', ['accept_all', 'bit_rate', 'debug', 'dup_window_s', 'fec',
      'interleave', 'max_bit_errors', 'max_dbg_lines', 'max_payload_len', 'print_rx',
      'src_id', 'stats_every_s'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 1760.0]
    rotation: 180
    state: enabled
- name: epy_block_0_0_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX (Hamming\
      \ FEC + train word) - v6.5, src / dest addressing\n- Outputs packed byte PDUs\
      \ (to the CSMA block / PDU to Tagged Stream)\n- Frame layout:\n    [preamble]\
      \ [train word: F8 DD 42 58] [sync: 1A CF FC 1D] [coded header] [coded body]\
      \ [postamble]\n  header = [len:2B][dest_id:1B][src_id:1B][msg_id:1B][rep:1B][n_reps:1B]\
      \   (7 bytes; v6.4 had 6, no dest)\n  body   = [payload][CRC32 over header+payload:\
      \ 4B]\n- src_id  = this node's ID (0..254), written into every frame.\n  dest_id\
      \ = default destination: 0..254 one node, 255 = every node. Can be changed while\
      \ running (GUI box).\n  Destination of each message, first match wins:\n   \
      \ 1. PDU metadata key \"dest_id\" (or \"dst\"), integer, e.g. set by an upper\
      \ layer\n    2. text messages (QT edit box) starting with \"@<id> \" -> that\
      \ node, \"@all \" or \"@* \" -> every node;\n       the prefix is removed before\
      \ sending. Binary PDUs are never parsed for \"@\".\n    3. dest_id\n- fec =\
      \ 0 / 15 / 31 (Hamming), interleave = column-wise codeword order. Must match\
      \ the deframer.\n- Postamble pads the frame to whole Pluto sink buffers (never\
      \ shorter than one buffer).\n- v6.7: verbose = 0 stops the per-message [TX]\
      \ lines (the DCF MAC prints its own); metadata keys mac_id / mac_type /\n  mac_seq\
      \ from the MAC are passed on to pdu_out, so the coded frame finds its way back\
      \ to the MAC entry.\n- Stress-test build: PDU metadata keys stress_seq / stress_type\
      \ are passed on, msg_id / src_id / dest_id / plen\n  are added (they become\
      \ stream tags after PDU to Tagged Stream, so the TX probes can follow each frame).\n\
      \  Stress DATA packets (payload \"CDPST,D,...\") are not printed, every frame\
      \ goes to the debug bus (src \"framer\").\n\"\"\"\nimport zlib\nimport numpy\
      \ as np\nimport pmt\nfrom gnuradio import gr\n\n# ---- shared debug bus (one\
      \ per flowgraph process; the Stress Test block writes it to disk) ----\nimport\
      \ sys as _sys\nimport types as _types\nimport collections as _collections\n\
      import time as _time\n\n\ndef _bus():\n    b = _sys.modules.get(\"cdp_dbg_bus\"\
      )\n    if b is None:\n        nb = _types.ModuleType(\"cdp_dbg_bus\")\n    \
      \    nb.events = _collections.deque(maxlen=400000)   # dicts; oldest dropped\
      \ if nobody writes them\n        nb.sources = {}                           \
      \      # name -> object with dbg_snapshot()\n        b = _sys.modules.setdefault(\"\
      cdp_dbg_bus\", nb)\n    return b\n\n\ndef _emit(blk, kind, /, **kw):\n    kw[\"\
      t\"] = round(_time.time(), 6)\n    kw[\"blk\"] = blk\n    kw[\"k\"] = kind\n\
      \    _bus().events.append(kw)\n# ---- end debug bus ----\n\nSYNC_WORD = bytes([0x1A,\
      \ 0xCF, 0xFC, 0x1D])\n# 31-bit m-sequence + 1 pad bit. MUST match TRAIN_BITS\
      \ in the flowgraph (RX side).\nTRAIN_WORD = bytes([0xF8, 0xDD, 0x42, 0x58])\n\
      BROADCAST = 0xFF\n\n\ndef hamming_tables(n):\n    \"\"\"Standard positional\
      \ Hamming layout: parity bits at positions 1, 2, 4, 8, (16).\"\"\"\n    m =\
      \ {15: 4, 31: 5}[n]\n    pos = np.arange(1, n + 1)\n    is_parity = (pos & (pos\
      \ - 1)) == 0\n    data_idx = np.flatnonzero(~is_parity)          # 0-based indices\
      \ of data positions\n    par_idx = np.flatnonzero(is_parity)            # 0-based\
      \ indices of 1, 2, 4, 8, (16)\n    P = ((pos[data_idx, None] >> np.arange(m))\
      \ & 1).astype(np.int32)   # k x m\n    return data_idx, par_idx, P\n\n\ndef\
      \ hamming_encode_bits(bits, n, interleave):\n    \"\"\"bits: 0/1 array. Pads\
      \ to a multiple of k, returns the coded bit array.\"\"\"\n    data_idx, par_idx,\
      \ P = hamming_tables(n)\n    k = len(data_idx)\n    nblk = -(-len(bits) // k)\n\
      \    d = np.zeros(nblk * k, dtype=np.int32)\n    d[:len(bits)] = bits\n    d\
      \ = d.reshape(nblk, k)\n    cw = np.zeros((nblk, n), dtype=np.uint8)\n    cw[:,\
      \ data_idx] = d\n    cw[:, par_idx] = (d @ P) & 1\n    return (cw.T if interleave\
      \ else cw).reshape(-1)\n\n\ndef id_name(i):\n    return \"all\" if i == BROADCAST\
      \ else str(i)\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(self,\
      \ src_id=1, dest_id=255, preamble_len=64, repeat_count=1, max_payload_len=1024,\n\
      \                 preamble_byte=0xFF, buffer_size=2048, postamble_byte=0xFF,\
      \ train_enable=1,\n                 fec=15, interleave=1, samples_per_byte=32,\
      \ verbose=1):\n        gr.basic_block.__init__(\n            self,\n       \
      \     name=\"Packet Framer TX (Burst, FEC, src/dest)\",\n            in_sig=None,\n\
      \            out_sig=None,\n        )\n        self.src_id = int(src_id)\n \
      \       if not 0 <= self.src_id <= 254:\n            raise ValueError(\"src_id\
      \ must be 0..254 (255 is the broadcast address)\")\n        self._dest_id =\
      \ self._check_id(dest_id, BROADCAST)\n        self.preamble_len = int(preamble_len)\n\
      \        self.repeat_count = int(repeat_count)\n        self.max_payload_len\
      \ = int(max_payload_len)\n        self.preamble_byte = int(preamble_byte) &\
      \ 0xFF\n        self.buffer_size = int(buffer_size)              # Pluto sink\
      \ buffer, in SAMPLES\n        self.postamble_byte = int(postamble_byte) & 0xFF\n\
      \        self.train_enable = int(train_enable)\n        self.fec = int(fec)\n\
      \        self.interleave = bool(int(interleave))\n        self.samples_per_byte\
      \ = max(1, int(samples_per_byte))   # 8 bits * samples/symbol (BPSK)\n     \
      \   self.verbose = int(verbose)          # 0: no per-message [TX] lines (the\
      \ MAC prints its own)\n        if self.fec not in (0, 15, 31):\n           \
      \ raise ValueError(\"fec must be 0, 15 or 31\")\n        self._msg_id = 0\n\n\
      \        self.message_port_register_in(pmt.intern(\"msg_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      msg_in\"), self.handle_msg)\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n    # dest_id is a property so the GUI box (GRC callback: blk.dest_id\
      \ = value) can change it while running\n    @property\n    def dest_id(self):\n\
      \        return self._dest_id\n\n    @dest_id.setter\n    def dest_id(self,\
      \ value):\n        new = self._check_id(value, None)\n        if new is None:\n\
      \            return\n        if new != self._dest_id:\n            self._dest_id\
      \ = new\n            print(f\"[TX] default destination is now ID {id_name(new)}\"\
      , flush=True)\n\n    @staticmethod\n    def _check_id(value, fallback):\n  \
      \      try:\n            v = int(float(value))\n        except (TypeError, ValueError):\n\
      \            v = -1\n        if 0 <= v <= 255:\n            return v\n     \
      \   print(f\"[TX] dest ID {value!r} ignored: use 0..254, or 255 for every node\"\
      , flush=True)\n        return fallback\n\n    def start(self):\n        _emit(\"\
      framer\", \"config\", src_id=self.src_id, dest_id=self._dest_id, preamble_len=self.preamble_len,\n\
      \              repeat_count=self.repeat_count, max_payload_len=self.max_payload_len,\
      \ buffer_size=self.buffer_size,\n              train_enable=self.train_enable,\
      \ fec=self.fec, interleave=self.interleave,\n              samples_per_byte=self.samples_per_byte)\n\
      \        print(f\"[TX] this node: src ID {self.src_id}; messages go to dest\
      \ ID {id_name(self._dest_id)} unless \"\n              f\"they start with '@<id>\
      \ ' or '@all '\", flush=True)\n        return True\n\n    # ---------- input\
      \ parsing ----------\n    @staticmethod\n    def _extract(msg):\n        \"\"\
      \"Returns (payload bytes, dst from metadata or None, is_text).\"\"\"\n     \
      \   meta_dst = None\n        if pmt.is_pair(msg):\n            meta, data =\
      \ pmt.car(msg), pmt.cdr(msg)\n            try:\n                if pmt.is_dict(meta):\n\
      \                    for key in (\"dest_id\", \"dst\"):\n                  \
      \      v = pmt.dict_ref(meta, pmt.intern(key), pmt.PMT_NIL)\n              \
      \          if pmt.is_integer(v):\n                            meta_dst = pmt.to_long(v)\
      \ & 0xFF\n                            break\n            except Exception:\n\
      \                pass\n            if pmt.is_u8vector(data):\n             \
      \   return bytes(pmt.u8vector_elements(data)), meta_dst, False\n           \
      \ return str(pmt.to_python(data)).encode(\"utf-8\"), meta_dst, True\n      \
      \  if pmt.is_symbol(msg):\n            return pmt.symbol_to_string(msg).encode(\"\
      utf-8\"), None, True\n        val = pmt.to_python(msg)\n        if isinstance(val,\
      \ (bytes, bytearray)):\n            return bytes(val), None, False\n       \
      \ return str(val).encode(\"utf-8\"), None, True\n\n    @staticmethod\n    def\
      \ _parse_at(payload):\n        \"\"\"'@3 hello' -> (3, b'hello'); '@all hi'\
      \ / '@* hi' -> (255, b'hi'); otherwise (None, payload).\"\"\"\n        if not\
      \ payload.startswith(b\"@\"):\n            return None, payload\n        head,\
      \ _, rest = payload[1:].partition(b\" \")\n        h = head.decode(\"ascii\"\
      , \"replace\").lower()\n        if h in (\"all\", \"*\"):\n            return\
      \ BROADCAST, rest\n        if h.isdigit() and 0 <= int(h) <= 255:\n        \
      \    return int(h), rest\n        return None, payload\n\n    # ---------- frame\
      \ building ----------\n    def _encode_section(self, data):\n        bits =\
      \ np.unpackbits(np.frombuffer(data, dtype=np.uint8))\n        return hamming_encode_bits(bits,\
      \ self.fec, self.interleave)\n\n    def _coded_body(self, header, payload):\n\
      \        \"\"\"Everything after the sync word: header + payload + CRC, coded\
      \ if fec != 0.\"\"\"\n        crc = zlib.crc32(header + payload).to_bytes(4,\
      \ \"big\")\n        if self.fec == 0:\n            return header + payload +\
      \ crc\n        coded = np.concatenate((self._encode_section(header),\n     \
      \                           self._encode_section(payload + crc)))\n        return\
      \ np.packbits(coded).tobytes()               # pads the last byte with 0s\n\n\
      \    def _postamble_len(self, raw_len):\n        \"\"\"Bytes of postamble: at\
      \ least one sink buffer, and total a whole number of buffers.\"\"\"\n      \
      \  if self.buffer_size <= 0:\n            return 0\n        unit = max(1, -(-self.buffer_size\
      \ // self.samples_per_byte))    # bytes per sink buffer\n        need = raw_len\
      \ + unit                                           # leave one full buffer of\
      \ postamble\n        return (-(-need // unit)) * unit - raw_len\n\n    def build_frame(self,\
      \ header, payload):\n        preamble = bytes([self.preamble_byte]) * self.preamble_len\n\
      \        train = TRAIN_WORD if self.train_enable else b\"\"\n        raw = preamble\
      \ + train + SYNC_WORD + self._coded_body(header, payload)\n        return raw\
      \ + bytes([self.postamble_byte]) * self._postamble_len(len(raw))\n\n    def\
      \ handle_msg(self, msg):\n        passthru = []\n        if pmt.is_pair(msg)\
      \ and pmt.is_dict(pmt.car(msg)):\n            for key in (\"stress_seq\", \"\
      stress_type\", \"mac_id\", \"mac_type\", \"mac_seq\"):\n                v =\
      \ pmt.dict_ref(pmt.car(msg), pmt.intern(key), pmt.PMT_NIL)\n               \
      \ if not pmt.is_null(v):\n                    passthru.append((key, v))\n  \
      \      try:\n            payload, dst, is_text = self._extract(msg)\n      \
      \  except Exception as e:\n            print(f\"[TX] Could not parse message:\
      \ {e}\", flush=True)\n            return\n        if dst is None and is_text:\n\
      \            dst, payload = self._parse_at(payload)\n        if dst is None:\n\
      \            dst = self._dest_id\n        if dst == self.src_id:\n         \
      \   print(f\"[TX] message addressed to this node (ID {dst}) not sent\", flush=True)\n\
      \            return\n        if not payload:\n            return\n\n       \
      \ if len(payload) > self.max_payload_len:\n            print(f\"[TX] Payload\
      \ {len(payload)} B truncated to {self.max_payload_len} B\", flush=True)\n  \
      \          payload = payload[: self.max_payload_len]\n\n        msg_id = self._msg_id\n\
      \        self._msg_id = (self._msg_id + 1) & 0xFF\n        n_reps = max(1, min(255,\
      \ self.repeat_count))\n\n        fec_txt = \"no FEC\" if self.fec == 0 else\
      \ f\"Hamming({self.fec},{self.fec - (4 if self.fec == 15 else 5)})\"\n     \
      \   shown = payload.decode(\"utf-8\", \"replace\") if is_text else f\"{len(payload)}\
      \ B binary\"\n        if self.verbose and not payload.startswith(b\"CDPST,D,\"\
      ):\n            if payload.startswith(b\"CDPST,\"):\n                shown =\
      \ payload.split(b\"|\")[0].decode(\"ascii\", \"replace\")\n            print(f\"\
      [TX] msg #{msg_id} src ID {self.src_id} -> dest ID {id_name(dst)}: '{shown}'\
      \ \"\n                  f\"({n_reps} bursts queued, {fec_txt})\", flush=True)\n\
      \n        for rep in range(n_reps):\n            header = len(payload).to_bytes(2,\
      \ \"big\") + bytes([dst, self.src_id, msg_id, rep, n_reps])\n            frame\
      \ = self.build_frame(header, payload)\n\n            meta = pmt.make_dict()\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"tx_sob\"), pmt.PMT_T)\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"tx_eob\"), pmt.PMT_T)\n\
      \            sob_tag = pmt.make_tuple(pmt.from_long(0), pmt.intern(\"tx_sob\"\
      ), pmt.PMT_T)\n            eob_tag = pmt.make_tuple(pmt.from_long(len(frame)\
      \ - 1), pmt.intern(\"tx_eob\"), pmt.PMT_T)\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"extra_tags\"), pmt.list2(sob_tag, eob_tag))\n            meta\
      \ = pmt.dict_add(meta, pmt.intern(\"msg_id\"), pmt.from_long(msg_id))\n    \
      \        meta = pmt.dict_add(meta, pmt.intern(\"src_id\"), pmt.from_long(self.src_id))\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"dest_id\"), pmt.from_long(dst))\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"plen\"), pmt.from_long(len(payload)))\n\
      \            for key, v in passthru:\n                meta = pmt.dict_add(meta,\
      \ pmt.intern(key), v)\n            _emit(\"framer\", \"frame\", msg_id=msg_id,\
      \ dst=dst, plen=len(payload), flen=len(frame),\n                  samples=len(frame)\
      \ * self.samples_per_byte, **{k: pmt.to_python(v) for k, v in passthru})\n\n\
      \            vec = pmt.init_u8vector(len(frame), list(frame))\n            self.message_port_pub(pmt.intern(\"\
      pdu_out\"), pmt.cons(meta, vec))\n"
    affinity: ''
    alias: ''
    buffer_size: BUFFER_SIZE
    comment: 'v6.5: header [len][dest_id][src_id][msg][rep][nreps]. src_id = MY_ID.
      dest_id = ''Dest ID'' box (live), overridden per message by ''@N text'' / ''@all
      text''.'
    dest_id: DEST_ID
    fec: FEC
    interleave: 'True'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    postamble_byte: '0xFF'
    preamble_byte: '0xFF'
    preamble_len: '128'
    repeat_count: '1'
    samples_per_byte: 8*sps
    src_id: MY_ID
    train_enable: '1'
    verbose: '0'
  states:
    _io_cache: ('Packet Framer TX (Burst, FEC, src/dest)', 'PacketFramerTX', [('src_id',
      '1'), ('dest_id', '255'), ('preamble_len', '64'), ('repeat_count', '1'), ('max_payload_len',
      '1024'), ('preamble_byte', '255'), ('buffer_size', '2048'), ('postamble_byte',
      '255'), ('train_enable', '1'), ('fec', '15'), ('interleave', '1'), ('samples_per_byte',
      '32'), ('verbose', '1')], [('msg_in', 'message', 1)], [('pdu_out', 'message',
      1)], '', ['buffer_size', 'dest_id', 'fec', 'interleave', 'max_payload_len',
      'postamble_byte', 'preamble_byte', 'preamble_len', 'repeat_count', 'samples_per_byte',
      'src_id', 'train_enable', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 1980.0]
    rotation: 180
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Test Traffic RX  (receive logger)\n\
      \nConnect:  Packet Deframer RX  pdu_out  ->  pdu_in\n\nEvery frame the deframer\
      \ delivers is written to  <log_dir>/rx_<date>_<time>.csv  with a wall-clock\n\
      timestamp (microseconds), the test run_id / seq when the payload carries the\
      \ test header (A5 5A ...),\nthe deframer's msg_id, and the payload as hex. Non-test\
      \ frames (chat etc.) are logged with is_test = 0.\nOne file per flowgraph start;\
      \ rows are flushed immediately, so the log survives a crash or Ctrl-C.\nPrints\
      \ a running count per test run (received, missing so far, delivery %).\nThe\
      \ deframer only delivers CRC-good frames, so this log holds correct packets\
      \ only; losses are\nfound by the analysis script from the gaps against the TX\
      \ log.\n\"\"\"\nimport csv\nimport datetime\nimport os\nimport socket\nimport\
      \ time\n\nimport pmt\nfrom gnuradio import gr\n\nMAGIC = b\"\\xA5\\x5A\"\nRX_FIELDS\
      \ = [\"rx_time_us\", \"rx_time_iso\", \"is_test\", \"run_id\", \"seq\", \"size\"\
      , \"msg_id\", \"host\", \"payload_hex\"]\n\n\nclass TestTrafficRX(gr.basic_block):\n\
      \    def __init__(self, log_dir=\"~/link_tests\", verbose=1, print_every=10):\n\
      \        gr.basic_block.__init__(self, name=\"Test Traffic RX\", in_sig=None,\
      \ out_sig=None)\n        self.log_dir = str(log_dir)\n        self.verbose =\
      \ int(verbose)\n        self.print_every = max(1, int(print_every))\n      \
      \  self._host = socket.gethostname()\n        self._f = None\n        self._w\
      \ = None\n        self._path = None\n        self._runs = {}            # run_id\
      \ -> {\"seqs\": set, \"max\": int, \"dups\": int}\n        self._n_other = 0\n\
      \n        self.message_port_register_in(pmt.intern(\"pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in\"), self._handle)\n\n    # ----------------------------------------------------------------\
      \ file\n    def start(self):\n        self._open()\n        return True\n\n\
      \    def stop(self):\n        self._summary()\n        if self._f:\n       \
      \     self._f.close()\n            self._f = None\n        return True\n\n \
      \   def _open(self):\n        if self._f:\n            return\n        d = os.path.expanduser(self.log_dir)\n\
      \        os.makedirs(d, exist_ok=True)\n        self._path = os.path.join(d,\
      \ f\"rx_{datetime.datetime.now():%Y%m%d_%H%M%S}.csv\")\n        self._f = open(self._path,\
      \ \"w\", newline=\"\")\n        self._w = csv.writer(self._f)\n        self._w.writerow(RX_FIELDS)\n\
      \        self._f.flush()\n        print(f\"[TEST RX] logging received frames\
      \ to {self._path}\", flush=True)\n\n    # ----------------------------------------------------------------\
      \ messages\n    def _handle(self, msg):\n        t_us = time.time_ns() // 1000\n\
      \        meta = pmt.PMT_NIL\n        try:\n            data = msg\n        \
      \    if pmt.is_pair(msg):\n                meta, data = pmt.car(msg), pmt.cdr(msg)\n\
      \            if pmt.is_u8vector(data):\n                payload = bytes(pmt.u8vector_elements(data))\n\
      \            elif pmt.is_symbol(data):\n                payload = pmt.symbol_to_string(data).encode(\"\
      utf-8\")\n            else:\n                payload = str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        except Exception as e:\n            print(f\"[TEST RX] could\
      \ not parse message: {e!r}\", flush=True)\n            return\n\n        msg_id\
      \ = -1\n        try:\n            if pmt.is_dict(meta):\n                v =\
      \ pmt.dict_ref(meta, pmt.intern(\"msg_id\"), pmt.PMT_NIL)\n                if\
      \ pmt.is_integer(v):\n                    msg_id = pmt.to_long(v)\n        except\
      \ Exception:\n            pass\n\n        is_test = len(payload) >= 8 and payload[:2]\
      \ == MAGIC\n        run_id = int.from_bytes(payload[2:4], \"big\") if is_test\
      \ else -1\n        seq = int.from_bytes(payload[4:8], \"big\") if is_test else\
      \ -1\n\n        self._open()\n        self._w.writerow([t_us,\n            \
      \              datetime.datetime.fromtimestamp(t_us / 1e6).isoformat(timespec=\"\
      milliseconds\"),\n                          int(is_test), run_id, seq, len(payload),\
      \ msg_id, self._host, payload.hex()])\n        self._f.flush()\n\n        if\
      \ not is_test:\n            self._n_other += 1\n            return\n       \
      \ st = self._runs.setdefault(run_id, {\"seqs\": set(), \"max\": -1, \"dups\"\
      : 0})\n        if seq in st[\"seqs\"]:\n            st[\"dups\"] += 1\n    \
      \    st[\"seqs\"].add(seq)\n        st[\"max\"] = max(st[\"max\"], seq)\n  \
      \      n = len(st[\"seqs\"])\n        if self.verbose and (n == 1 or n % self.print_every\
      \ == 0):\n            expected = st[\"max\"] + 1\n            print(f\"[TEST\
      \ RX] run {run_id:04x}: {n} received, last seq {seq}, {expected - n} missing\
      \ so far \"\n                  f\"({100.0 * n / expected:.1f}% of seq 0..{st['max']})\"\
      , flush=True)\n\n    def _summary(self):\n        for run_id, st in self._runs.items():\n\
      \            n, expected = len(st[\"seqs\"]), st[\"max\"] + 1\n            print(f\"\
      [TEST RX] run {run_id:04x} total: {n} received of seq 0..{st['max']} \"\n  \
      \                f\"({100.0 * n / max(expected, 1):.1f}%), {st['dups']} duplicates\"\
      , flush=True)\n        if self._n_other:\n            print(f\"[TEST RX] {self._n_other}\
      \ non-test frames logged\", flush=True)\n        if self._path:\n          \
      \  print(f\"[TEST RX] log: {self._path}\", flush=True)"
    affinity: ''
    alias: ''
    comment: ''
    log_dir: '"~/link_tests"'
    maxoutbuf: '0'
    minoutbuf: '0'
    print_every: '10'
    verbose: '1'
  states:
    _io_cache: ('Test Traffic RX', 'TestTrafficRX', [('log_dir', "'~/link_tests'"),
      ('verbose', '1'), ('print_every', '10')], [('pdu_in', 'message', 1)], [], '',
      ['log_dir', 'print_every', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 2040.0]
    rotation: 0
    state: disabled
- name: epy_block_corr
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Training-word correlator (drop-in\
      \ for digital_corr_est_cc)\n- Input : complex stream at 2 samples/symbol (symbol\
      \ sync output)\n- Output: the same stream delayed by a fixed EVEN number of\
      \ samples (so tags can be placed in the past\n  without shifting the symbol\
      \ / midpoint sample phase)\n- Slides the reference (TRAIN_REF) over the stream\
      \ and computes the NORMALIZED correlation\n      rho = |sum(conj(ref) * x)|^2\
      \ / (E_ref * E_window)      (0..1, independent of signal amplitude)\n  Where\
      \ rho has a local maximum above thr it adds a 'corr_est' tag (and 'corr_start')\
      \ on the\n  first training symbol, shifted by mark_delay samples. Random data\
      \ gives rho ~ 0.1-0.25; a real\n  training word gives ~0.8-1.0, so thr ~ 0.6-0.7\
      \ is a good start. The tag value is rho.\n- Pure numpy, bounds-checked: no use\
      \ of GNU Radio's corr_est_cc.\n- Stress-test build: every tag and a 1 s snapshot\
      \ (tags, strongest correlation) go to the debug bus (src \"corr\").\n\"\"\"\n\
      import numpy as np\nimport pmt\nfrom gnuradio import gr\n\n# ---- shared debug\
      \ bus (one per flowgraph process; the Stress Test block writes it to disk) ----\n\
      import sys as _sys\nimport types as _types\nimport collections as _collections\n\
      import time as _time\n\n\ndef _bus():\n    b = _sys.modules.get(\"cdp_dbg_bus\"\
      )\n    if b is None:\n        nb = _types.ModuleType(\"cdp_dbg_bus\")\n    \
      \    nb.events = _collections.deque(maxlen=400000)   # dicts; oldest dropped\
      \ if nobody writes them\n        nb.sources = {}                           \
      \      # name -> object with dbg_snapshot()\n        b = _sys.modules.setdefault(\"\
      cdp_dbg_bus\", nb)\n    return b\n\n\ndef _emit(blk, kind, /, **kw):\n    kw[\"\
      t\"] = round(_time.time(), 6)\n    kw[\"blk\"] = blk\n    kw[\"k\"] = kind\n\
      \    _bus().events.append(kw)\n# ---- end debug bus ----\n\n# ---- C++ kernels\
      \ (cdp_fast.py / cdp_fast.cpp next to the flowgraph); None -> the NumPy code\
      \ of this block ----\ndef _load_fast():\n    import os as _os\n    if _os.environ.get(\"\
      CDP_FAST\", \"1\").strip().lower() in (\"0\", \"no\", \"off\", \"false\"):\n\
      \        return None\n    try:\n        import cdp_fast\n        return cdp_fast\n\
      \    except ImportError:\n        pass\n    for d in (_os.environ.get(\"CDP_HOME\"\
      ), _os.getcwd(),\n              _os.path.dirname(_os.path.abspath(_sys.argv[0]))\
      \ if _sys.argv and _sys.argv[0] else None):\n        if d and _os.path.isfile(_os.path.join(d,\
      \ \"cdp_fast.py\")):\n            if d not in _sys.path:\n                _sys.path.insert(0,\
      \ d)\n            try:\n                import cdp_fast\n                return\
      \ cdp_fast\n            except Exception:\n                return None\n   \
      \ return None\n# ---- end C++ kernels ----\n\n\nclass TrainCorr(gr.sync_block):\n\
      \    def __init__(self, ref=None, thr=0.7, mark_delay=0, verbose=1):\n     \
      \   gr.sync_block.__init__(\n            self,\n            name=\"Training-word\
      \ Correlator\",\n            in_sig=[np.complex64],\n            out_sig=[np.complex64],\n\
      \        )\n        if ref is None:\n            ref = [1.0]\n        self._ref\
      \ = np.asarray(ref, dtype=np.complex64)\n        self._L = len(self._ref)\n\
      \        self._E = float(np.sum(np.abs(self._ref) ** 2))\n        self.thr =\
      \ float(thr)\n        self.mark_delay = max(0, int(mark_delay))\n        self.verbose\
      \ = int(verbose)\n        # Output delay: >= L + 3 so every peak is examined\
      \ exactly once, and a MULTIPLE OF 2 (samples per\n        # symbol) so the symbol-timed\
      \ samples stay on even stream indices -- the linear equalizer takes\n      \
      \  # the first sample of every 2-sample block, so an odd delay would make it\
      \ sample the midpoints.\n        self._D = self._L + 8\n        self._D += self._D\
      \ % 2\n        self.set_history(self._D + 1)\n        self._next_p = 0     \
      \          # first absolute input index not yet examined\n        self._last_p\
      \ = -10**12         # last tagged absolute input index\n        self._seen =\
      \ 0                 # samples since last status line\n        self._best = 0.0\
      \               # strongest normalized correlation since last status line\n\
      \        self._dbg_tags = 0\n        self._dbg_best = 0.0\n        self._dbg_n\
      \ = 0\n        self._fast = None              # C++ correlation (set in start)\n\
      \n    def start(self):\n        F = _load_fast()\n        if F is not None:\n\
      \            cm = F.CorrMetric(self._ref, self._E)\n            self._fast =\
      \ cm if cm.ok else None\n        if self.verbose:\n            print(F.status(\"\
      correlator\") if F is not None else \"[FAST] correlator: original Python code\"\
      , flush=True)\n        _bus().sources[\"corr\"] = self\n        _emit(\"corr\"\
      , \"config\", thr=self.thr, mark_delay=self.mark_delay, ref_len=self._L, delay=self._D)\n\
      \        return True\n\n    def dbg_snapshot(self):\n        out = {\"tags\"\
      : self._dbg_tags, \"best\": round(self._dbg_best, 3), \"n\": self._dbg_n, \"\
      thr\": self.thr}\n        self._dbg_tags, self._dbg_best, self._dbg_n = 0, 0.0,\
      \ 0\n        return out\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        out = output_items[0]\n        n_out =\
      \ len(out)\n        out[:] = x[:n_out]             # in[i] <-> absolute input\
      \ index a-D+i  ==  output index a+i\n\n        a = self.nitems_written(0)\n\
      \        base = a - self._D             # absolute input index of x[0]\n   \
      \     if len(x) < self._L + 5:\n            return n_out\n        if self._fast\
      \ is not None:\n            m = self._fast(x)                              \
      \      # C++: the same metric, without the GIL\n        else:\n            c\
      \ = np.correlate(x, self._ref, \"valid\")                  # window starting\
      \ at x[n]\n            w = np.convolve(np.abs(x).astype(np.float64) ** 2, np.ones(self._L),\
      \ \"valid\")\n            m = (np.abs(c).astype(np.float64) ** 2) / (self._E\
      \ * w + 1e-12)    # normalized, 0..1\n        n0 = max(self._next_p - base,\
      \ 2, -base)       # first window start to examine (p >= 0)\n        n1 = len(m)\
      \ - 3                               # last start with 2 neighbours on the right\n\
      \        if self._fast is not None:                    # C++: the same comparisons\
      \ on the same values\n            hits, m_max = self._fast.peaks(m, n0, n1,\
      \ self.thr)\n        else:\n            m_max = float(m.max())\n        self._best\
      \ = max(self._best, m_max)\n        self._dbg_best = max(self._dbg_best, m_max)\n\
      \        self._dbg_n += n_out\n        self._seen += n_out\n\n        if n1\
      \ >= n0:\n            mid = m[n0:n1 + 1]\n            if self._fast is None:\n\
      \                seg = m[n0 - 2 : n1 + 3]\n                mid = seg[2:-2]\n\
      \                thr_abs = self.thr\n                cond = (\n            \
      \        (mid > thr_abs)\n                    & (mid > seg[0:-4]) & (mid > seg[1:-3])\n\
      \                    & (mid >= seg[3:-1]) & (mid >= seg[4:])\n             \
      \   )\n                hits = np.flatnonzero(cond)\n            for j in hits:\n\
      \                p = base + n0 + int(j)\n                if p - self._last_p\
      \ < self._L:\n                    continue\n                self._last_p = p\n\
      \                ratio = float(mid[j])\n                off = int(p + self._D\
      \ + self.mark_delay)    # output index; always >= a\n                val = pmt.from_double(ratio)\n\
      \                self.add_item_tag(0, off, pmt.intern(\"corr_start\"), val)\n\
      \                self.add_item_tag(0, off, pmt.intern(\"corr_est\"), val)\n\
      \                self._dbg_tags += 1\n                _emit(\"corr\", \"tag\"\
      , rho=round(ratio, 3), off=off)\n                self._best = 0.0\n        \
      \        self._seen = 0\n                if self.verbose:\n                \
      \    print(f\"[CORR] train word found: correlation = {ratio:.2f} (thr {self.thr:.2f})\"\
      , flush=True)\n            self._next_p = base + n1 + 1\n\n        if self.verbose\
      \ and self._seen > 400000:\n            if self._best > 0.35:\n            \
      \    print(f\"[CORR] no tag; strongest correlation in last window = {self._best:.2f}\
      \ (thr {self.thr:.2f})\", flush=True)\n            self._best = 0.0\n      \
      \      self._seen = 0\n        return n_out\n"
    affinity: ''
    alias: ''
    comment: Python replacement for digital_corr_est_cc (avoids its out-of-range read).
    mark_delay: train_delay
    maxoutbuf: '0'
    minoutbuf: '0'
    ref: TRAIN_REF
    thr: corr_thr
    verbose: '1'
  states:
    _io_cache: ('Training-word Correlator', 'TrainCorr', [('ref', 'None'), ('thr',
      '0.7'), ('mark_delay', '0'), ('verbose', '1')], [('0', 'complex', 1)], [('0',
      'complex', 1)], '', ['mark_delay', 'thr', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2048, 632.0]
    rotation: 0
    state: enabled
- name: epy_bridge
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: App Socket Bridge (v6.9) - lets\
      \ programs outside GNU Radio use the link.\n\n  Reliable messages (any size,\
      \ delivered in order, SENT / FAIL per message): TCP host:arq_port\n      protocol\
      \ = cdp_sock.py: 4-byte big-endian length + body\n          SEND  01 | ref 4B\
      \ | dest 1B | data        program -> bridge\n          HELLO 80 | node 1B |\
      \ mss 2B | window 1B | max_msg 4B\n          RECV  81 | src 1B | data\n    \
      \      SENT  82 | ref 4B | dest 1B\n          FAIL  83 | ref 4B | dest 1B |\
      \ reason 1B   (1 no ACK, 2 bad dest, 3 queue full, 4 too large, 5 empty)\n \
      \         PROG  84 | ref 4B | dest 1B | acked 2B | segments 2B   (big messages,\
      \ at most once a second; cdp_sock\n                                        \
      \                            clients that do not know it see an \"other\" event)\n\
      \      Several programs may connect; every RECV goes to all of them, SENT /\
      \ FAIL to the one that sent.\n  Datagrams (UDP-like, no retransmission, no reordering):\
      \ send  dest 1B | data  to udp_bind:udp_port,\n      received ones arrive as\
      \  src 1B | dest 1B | data  on udp_bind:udp_out_port.\n\nOver the air (inside\
      \ the MAC payload) every message segment / datagram carries a send timestamp:\n\
      \      segment   'S' | msg id 4B | index 2B | count 2B | tx time (us since epoch)\
      \ 8B | data   (17 B header)\n      datagram  'U' | datagram seq 2B | tx time\
      \ (us) 8B | data                                 (11 B header)\nThe timestamps\
      \ are only logged (one-way delay, gaps); nothing in the link uses them.\nMessages\
      \ are cut into segments of mss bytes; at most inflight segments per destination\
      \ are handed to the MAC at a\ntime (the rest wait here), so a big file never\
      \ floods the MAC queue. The message with the fewest segments left goes\nfirst,\
      \ so a text is not stuck behind a file.\nv6.9.1: a segment the MAC drops (retry\
      \ limit) or cannot queue is handed to the MAC again (end-to-end retransmission;\n\
      the receiver removes duplicates). A message fails only when none of its segments\
      \ got through for stall_s seconds\n(or after msg_timeout_s, 0 = never); then\
      \ its frames still queued in the MAC are cancelled (MAC ctrl).\nThe receiver\
      \ reassembles several messages per sender at once and ignores segments of messages\
      \ it already delivered.\n\nWiring: to_mac -> MAC app_in;  MAC app_out -> from_mac;\
      \  MAC tx_status -> status;  mac_ctrl -> MAC ctrl\nLogging: events go to the\
      \ debug bus (blk \"bridge\": udp_tx, udp_rx, msg_tx, msg_rx, client), written\
      \ by the\nSession Logger block into the session folder.\n\"\"\"\nimport collections\n\
      import os\nimport random\nimport select\nimport socket\nimport struct\nimport\
      \ threading\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n#\
      \ ---- shared debug bus (one per flowgraph process; the Stress Test block writes\
      \ it to disk) ----\nimport sys as _sys\nimport types as _types\nimport collections\
      \ as _collections\nimport time as _time\n\n\ndef _bus():\n    b = _sys.modules.get(\"\
      cdp_dbg_bus\")\n    if b is None:\n        nb = _types.ModuleType(\"cdp_dbg_bus\"\
      )\n        nb.events = _collections.deque(maxlen=400000)   # dicts; oldest dropped\
      \ if nobody writes them\n        nb.sources = {}                           \
      \      # name -> object with dbg_snapshot()\n        b = _sys.modules.setdefault(\"\
      cdp_dbg_bus\", nb)\n    return b\n\n\ndef _emit(blk, kind, /, **kw):\n    kw[\"\
      t\"] = round(_time.time(), 6)\n    kw[\"blk\"] = blk\n    kw[\"k\"] = kind\n\
      \    _bus().events.append(kw)\n# ---- end debug bus ----\n\nSVC_SEG, SVC_UDP\
      \ = 0x53, 0x55\nSEG_HDR, UDP_HDR = 17, 11\nREASON = {1: \"no ACK\", 2: \"bad\
      \ destination\", 3: \"queue full\", 4: \"too large\", 5: \"empty\", 6: \"timeout\"\
      }\nRX_DONE_KEEP = 256          # message ids remembered per sender (duplicate\
      \ segments of delivered messages)\nRX_STALE_S = 600.0          # an incomplete\
      \ received message is discarded after this long without a new segment\n\n\n\
      def _now_us():\n    return _time.time_ns() // 1000\n\n\nclass AppBridge(gr.basic_block):\n\
      \    def __init__(self, my_id=1, host=\"127.0.0.1\", arq_port=5100, udp_bind=\"\
      127.0.0.1\", udp_port=5200,\n                 udp_out_port=5201, mss=1000, inflight=32,\
      \ window=16, max_msg=16000000, msg_timeout_s=0.0,\n                 stall_s=60.0,\
      \ verbose=1):\n        gr.basic_block.__init__(self, name=\"App Socket Bridge\
      \ (TCP ARQ + UDP)\", in_sig=None, out_sig=None)\n        self.my_id = int(my_id)\
      \ & 0xFF\n        self.host = str(host)\n        self.arq_port = int(arq_port)\n\
      \        self.udp_bind = str(udp_bind)\n        self.udp_port = int(udp_port)\n\
      \        self.udp_out_port = int(udp_out_port)\n        self.mss = max(16, int(mss))\n\
      \        self.inflight = max(1, int(inflight))\n        self.window = int(window)\n\
      \        self.max_msg = int(max_msg)\n        self.msg_timeout_s = float(msg_timeout_s)\n\
      \        self.stall_s = float(stall_s)\n        self.verbose = int(verbose)\n\
      \        self.message_port_register_out(pmt.intern(\"to_mac\"))\n        self.message_port_register_out(pmt.intern(\"\
      mac_ctrl\"))\n        self.message_port_register_in(pmt.intern(\"from_mac\"\
      ))\n        self.set_msg_handler(pmt.intern(\"from_mac\"), self._on_mac)\n \
      \       self.message_port_register_in(pmt.intern(\"status\"))\n        self.set_msg_handler(pmt.intern(\"\
      status\"), self._on_status)\n        self._lock = threading.RLock()\n      \
      \  self._stop = threading.Event()\n        self._threads = []\n        self._clients\
      \ = []                  # [sock, send-lock]\n        self._mid = random.getrandbits(31)\n\
      \        self._pending = {}                  # mid -> message being sent\n \
      \       self._active = {}                   # dest -> [mid, ...] messages with\
      \ segments to send / in the MAC\n        self._inflight_n = {}             \
      \  # dest -> segments in the MAC\n        self._dest_prog = {}             \
      \   # dest -> last time a segment to it was acknowledged\n        self._rx =\
      \ {}                       # (src, mid) -> reassembly state\n        self._rx_done\
      \ = {}                  # src -> (deque, set) of delivered message ids\n   \
      \     self._useq = 0\n        self._udp_last = {}                 # src -> (rx\
      \ time us, useq)\n        self._udp_tx = self._udp_rx = None\n        self._lsock\
      \ = None\n\n    # ------------------------------------------------------------------\
      \ start / stop\n    def start(self):\n        _bus().sources[\"bridge\"] = self\n\
      \        _emit(\"bridge\", \"config\", my_id=self.my_id, arq=f\"{self.host}:{self.arq_port}\"\
      ,\n              udp_in=f\"{self.udp_bind}:{self.udp_port}\", udp_out=f\"{self.udp_bind}:{self.udp_out_port}\"\
      ,\n              mss=self.mss, inflight=self.inflight, window=self.window, max_msg=self.max_msg,\
      \ stall_s=self.stall_s,\n              msg_timeout_s=self.msg_timeout_s)\n \
      \       self._stop.clear()\n        try:\n            self._lsock = socket.socket(socket.AF_INET,\
      \ socket.SOCK_STREAM)\n            self._lsock.setsockopt(socket.SOL_SOCKET,\
      \ socket.SO_REUSEADDR, 1)\n            self._lsock.bind((self.host, self.arq_port))\n\
      \            self._lsock.listen(4)\n        except OSError as e:\n         \
      \   print(f\"[BRIDGE] cannot listen on TCP {self.host}:{self.arq_port}: {e}\
      \ (another flowgraph still \"\n                  f\"running?)\", flush=True)\n\
      \            _emit(\"bridge\", \"error\", what=\"tcp_bind\", err=str(e))\n \
      \           self._lsock = None\n        try:\n            self._udp_rx = socket.socket(socket.AF_INET,\
      \ socket.SOCK_DGRAM)\n            self._udp_rx.setsockopt(socket.SOL_SOCKET,\
      \ socket.SO_REUSEADDR, 1)\n            self._udp_rx.bind((self.udp_bind, self.udp_port))\n\
      \            self._udp_tx = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n\
      \        except OSError as e:\n            print(f\"[BRIDGE] cannot bind UDP\
      \ {self.udp_bind}:{self.udp_port}: {e}\", flush=True)\n            _emit(\"\
      bridge\", \"error\", what=\"udp_bind\", err=str(e))\n            self._udp_rx\
      \ = None\n        for fn, nm in ((self._accept_loop, \"bridge-accept\"), (self._udp_loop,\
      \ \"bridge-udp\"),\n                       (self._timer_loop, \"bridge-timer\"\
      )):\n            t = threading.Thread(target=fn, name=nm, daemon=True)\n   \
      \         t.start()\n            self._threads.append(t)\n        print(f\"\
      [BRIDGE] node {self.my_id}: reliable messages on tcp://{self.host}:{self.arq_port},\
      \ datagrams in \"\n              f\"udp://{self.udp_bind}:{self.udp_port} ->\
      \ out udp://{self.udp_bind}:{self.udp_out_port} (mss \"\n              f\"{self.mss}\
      \ B)\", flush=True)\n        return True\n\n    def stop(self):\n        self._stop.set()\n\
      \        for s in [self._lsock, self._udp_rx] + [c[0] for c in self._clients]:\n\
      \            try:\n                if s:\n                    s.close()\n  \
      \          except OSError:\n                pass\n        return True\n\n  \
      \  # ------------------------------------------------------------------ TCP\
      \ clients\n    def _accept_loop(self):\n        while not self._stop.is_set()\
      \ and self._lsock is not None:\n            try:\n                r, _, _ =\
      \ select.select([self._lsock], [], [], 0.5)\n                if not r:\n   \
      \                 continue\n                c, addr = self._lsock.accept()\n\
      \            except OSError:\n                return\n            c.setsockopt(socket.IPPROTO_TCP,\
      \ socket.TCP_NODELAY, 1)\n            entry = [c, threading.Lock()]\n      \
      \      with self._lock:\n                self._clients.append(entry)\n     \
      \       self._send_to(entry, struct.pack(\">BBHBI\", 0x80, self.my_id, self.mss,\
      \ min(255, self.window),\n                                             self.max_msg))\n\
      \            _emit(\"bridge\", \"client\", ev=\"connect\", peer=f\"{addr[0]}:{addr[1]}\"\
      , n=len(self._clients))\n            if self.verbose:\n                print(f\"\
      [BRIDGE] program connected from {addr[0]}:{addr[1]}\", flush=True)\n       \
      \     t = threading.Thread(target=self._client_loop, args=(entry,), daemon=True)\n\
      \            t.start()\n\n    def _client_loop(self, entry):\n        sock,\
      \ buf = entry[0], bytearray()\n        try:\n            while not self._stop.is_set():\n\
      \                r, _, _ = select.select([sock], [], [], 0.5)\n            \
      \    if not r:\n                    continue\n                chunk = sock.recv(262144)\n\
      \                if not chunk:\n                    break\n                buf\
      \ += chunk\n                while len(buf) >= 4:\n                    n = int.from_bytes(buf[:4],\
      \ \"big\")\n                    if len(buf) < 4 + n:\n                     \
      \   break\n                    body = bytes(buf[4:4 + n])\n                \
      \    del buf[:4 + n]\n                    if body and body[0] == 0x01 and len(body)\
      \ >= 6:\n                        ref, dest = struct.unpack(\">IB\", body[1:6])\n\
      \                        self._submit(entry, ref, dest, body[6:])\n        except\
      \ OSError:\n            pass\n        with self._lock:\n            if entry\
      \ in self._clients:\n                self._clients.remove(entry)\n        _emit(\"\
      bridge\", \"client\", ev=\"disconnect\", n=len(self._clients))\n        try:\n\
      \            sock.close()\n        except OSError:\n            pass\n\n   \
      \ def _send_to(self, entry, body):\n        try:\n            with entry[1]:\n\
      \                entry[0].sendall(len(body).to_bytes(4, \"big\") + body)\n \
      \           return True\n        except OSError:\n            return False\n\
      \n    def _fail(self, entry, ref, dest, reason, m=None):\n        self._send_to(entry,\
      \ struct.pack(\">BIBB\", 0x83, ref, dest & 0xFF, reason))\n        if m is not\
      \ None:\n            self._log_msg_tx(m, \"fail:\" + REASON.get(reason, str(reason)))\n\
      \n    # ------------------------------------------------------------------ sending\
      \ a message\n    def _submit(self, entry, ref, dest, data):\n        if not\
      \ data:\n            return self._fail(entry, ref, dest, 5)\n        if dest\
      \ == self.my_id or dest > 255:\n            return self._fail(entry, ref, dest,\
      \ 2)\n        if len(data) > self.max_msg:\n            return self._fail(entry,\
      \ ref, dest, 4)\n        n = -(-len(data) // self.mss)\n        if n > 0xFFFF:\n\
      \            return self._fail(entry, ref, dest, 4)\n        now = _time.time()\n\
      \        with self._lock:\n            self._mid = (self._mid + 1) & 0xFFFFFFFF\n\
      \            mid = self._mid\n            m = {\"mid\": mid, \"ref\": ref, \"\
      entry\": entry, \"dest\": dest, \"data\": data, \"n\": n, \"acked\": set(),\n\
      \                 \"todo\": collections.deque(range(n)), \"out\": set(), \"\
      t0\": now, \"t_first\": None, \"t_prog\": now,\n                 \"t_hold\"\
      : 0.0, \"t_report\": 0.0, \"tx\": 0, \"resent\": 0, \"done\": False, \"bytes\"\
      : len(data)}\n            self._pending[mid] = m\n            self._active.setdefault(dest,\
      \ []).append(mid)\n            queued = sum(len(self._pending[x][\"todo\"])\
      \ for x in self._active[dest] if x in self._pending)\n        _emit(\"bridge\"\
      , \"msg_submit\", mid=mid, ref=ref, dst=dest, bytes=len(data), segs=n, queued_segs=queued)\n\
      \        self._pump(dest)\n\n    def _next_segment(self, dest, now):\n     \
      \   \"\"\"The message with the fewest segments left that has one to send (texts\
      \ overtake files).\"\"\"\n        best = None\n        for mid in self._active.get(dest,\
      \ []):\n            m = self._pending.get(mid)\n            if m is None or\
      \ m[\"done\"] or not m[\"todo\"] or m[\"t_hold\"] > now:\n                continue\n\
      \            left = m[\"n\"] - len(m[\"acked\"])\n            if best is None\
      \ or left < best[0]:\n                best = (left, m)\n        if best is None:\n\
      \            return None\n        m = best[1]\n        return m, m[\"todo\"\
      ].popleft()\n\n    def _pump(self, dest):\n        \"\"\"Hand segments to the\
      \ MAC while fewer than inflight are outstanding for this destination.\"\"\"\n\
      \        out = []\n        now = _time.time()\n        with self._lock:\n  \
      \          while dest == 255 or self._inflight_n.get(dest, 0) < self.inflight:\n\
      \                nxt = self._next_segment(dest, now)\n                if nxt\
      \ is None:\n                    break\n                m, idx = nxt\n      \
      \          if idx in m[\"acked\"]:\n                    continue\n         \
      \       m[\"out\"].add(idx)\n                if dest != 255:\n             \
      \       self._inflight_n[dest] = self._inflight_n.get(dest, 0) + 1\n       \
      \         if m[\"t_first\"] is None:\n                    m[\"t_first\"] = now\n\
      \                out.append((m, idx))\n        for m, idx in out:\n        \
      \    chunk = m[\"data\"][idx * self.mss:(idx + 1) * self.mss]\n            hdr\
      \ = struct.pack(\">BIHHQ\", SVC_SEG, m[\"mid\"], idx, m[\"n\"], _now_us())\n\
      \            meta = pmt.make_dict()\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      dest_id\"), pmt.from_long(m[\"dest\"]))\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"app_ref\"), pmt.from_long(m[\"mid\"]))\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"app_seg\"), pmt.from_long(idx))\n            body = hdr + chunk\n\
      \            self.message_port_pub(pmt.intern(\"to_mac\"), pmt.cons(meta, pmt.init_u8vector(len(body),\
      \ list(body))))\n        if dest == 255:                                  #\
      \ broadcast is best effort: done once handed over\n            for m, _ in out:\n\
      \                with self._lock:\n                    if not m[\"done\"] and\
      \ not m[\"todo\"]:\n                        self._finish(m)\n              \
      \          self._send_to(m[\"entry\"], struct.pack(\">BIB\", 0x82, m[\"ref\"\
      ], 255))\n                        self._log_msg_tx(m, \"sent(broadcast, unconfirmed)\"\
      )\n\n    def _finish(self, m):\n        \"\"\"Caller holds the lock.\"\"\"\n\
      \        m[\"done\"] = True\n        self._pending.pop(m[\"mid\"], None)\n \
      \       lst = self._active.get(m[\"dest\"], [])\n        if m[\"mid\"] in lst:\n\
      \            lst.remove(m[\"mid\"])\n\n    def _on_status(self, msg):\n    \
      \    try:\n            d = pmt.to_python(msg)\n        except Exception:\n \
      \           return\n        mid, seg, st = int(d.get(\"app_ref\", -1)), int(d.get(\"\
      app_seg\", 0)), str(d.get(\"status\"))\n        dest = int(d.get(\"dst\", -1))\n\
      \        fin, prog = None, None\n        now = _time.time()\n        with self._lock:\n\
      \            if dest in self._inflight_n and st in (\"acked\", \"dropped\",\
      \ \"qfull\"):\n                self._inflight_n[dest] = max(0, self._inflight_n[dest]\
      \ - 1)\n            m = self._pending.get(mid)\n            if m is not None\
      \ and not m[\"done\"]:\n                m[\"tx\"] += int(d.get(\"tx\", 1) or\
      \ 1)\n                m[\"out\"].discard(seg)\n                if st == \"acked\"\
      :\n                    if seg not in m[\"acked\"]:\n                       \
      \ m[\"acked\"].add(seg)\n                        m[\"t_prog\"] = now\n     \
      \                   self._dest_prog[dest] = now\n                    if len(m[\"\
      acked\"]) >= m[\"n\"]:\n                        self._finish(m)\n          \
      \              fin = (m, \"sent\")\n                    elif m[\"n\"] >= 8 and\
      \ now - m[\"t_report\"] >= 1.0:\n                        m[\"t_report\"] = now\n\
      \                        prog = (m, len(m[\"acked\"]))\n                elif\
      \ st in (\"dropped\", \"qfull\") and seg not in m[\"acked\"]:\n            \
      \        m[\"todo\"].appendleft(seg)              # end-to-end retransmission:\
      \ send it again\n                    m[\"resent\"] += 1\n                  \
      \  if st == \"qfull\":\n                        m[\"t_hold\"] = now + 0.3  \
      \          # MAC queue full: give it a moment\n                    if m[\"resent\"\
      ] <= 3 or m[\"resent\"] % 100 == 0:\n                        _emit(\"bridge\"\
      , \"seg_resend\", mid=mid, seg=seg, why=st, resent=m[\"resent\"],\n        \
      \                      acked=len(m[\"acked\"]), segs=m[\"n\"])\n        if prog\
      \ is not None:\n            pm, acked = prog\n            self._send_to(pm[\"\
      entry\"], struct.pack(\">BIBHH\", 0x84, pm[\"ref\"], pm[\"dest\"] & 0xFF, acked\
      \ & 0xFFFF,\n                                                   pm[\"n\"] &\
      \ 0xFFFF))\n        if fin is not None:\n            m, res = fin\n        \
      \    self._send_to(m[\"entry\"], struct.pack(\">BIB\", 0x82, m[\"ref\"], m[\"\
      dest\"]))\n            self._log_msg_tx(m, \"sent\")\n        if dest >= 0:\n\
      \            self._pump(dest)\n\n    def _give_up(self, m, reason, why):\n \
      \       \"\"\"Caller does NOT hold the lock.\"\"\"\n        with self._lock:\n\
      \            if m[\"done\"]:\n                return\n            self._finish(m)\n\
      \        if self.verbose:\n            print(f\"[BRIDGE] message {m['mid']}\
      \ to ID {m['dest']} failed ({why}): {len(m['acked'])}/{m['n']} \"\n        \
      \          f\"segments acknowledged, {m['resent']} resent\", flush=True)\n \
      \       d = pmt.make_dict()\n        d = pmt.dict_add(d, pmt.intern(\"cancel_ref\"\
      ), pmt.from_long(m[\"mid\"]))\n        self.message_port_pub(pmt.intern(\"mac_ctrl\"\
      ), d)\n        self._fail(m[\"entry\"], m[\"ref\"], m[\"dest\"], reason, m)\n\
      \n    def _log_msg_tx(self, m, res):\n        now = _time.time()\n        dur\
      \ = now - m[\"t0\"]\n        _emit(\"bridge\", \"msg_tx\", mid=m[\"mid\"], ref=m[\"\
      ref\"], dst=m[\"dest\"], bytes=m[\"bytes\"], segs=m[\"n\"],\n              acked=len(m[\"\
      acked\"]), frames_tx=m[\"tx\"], resent=m[\"resent\"],\n              wait_s=round((m[\"\
      t_first\"] or now) - m[\"t0\"], 3),\n              dur_s=round(dur, 3), kBps=round(m[\"\
      bytes\"] / max(dur, 1e-6) / 1e3, 2), res=res)\n\n    def _timer_loop(self):\n\
      \        while not self._stop.wait(0.5):\n            now = _time.time()\n \
      \           late, dests = [], set()\n            with self._lock:\n        \
      \        for mid, m in list(self._pending.items()):\n                    if\
      \ m[\"done\"]:\n                        continue\n                    dests.add(m[\"\
      dest\"])\n                    if self.msg_timeout_s > 0 and now - m[\"t0\"]\
      \ > self.msg_timeout_s:\n                        late.append((m, 6, f\"not done\
      \ after {self.msg_timeout_s:g} s\"))\n                    elif self.stall_s\
      \ > 0 and now - max(self._dest_prog.get(m[\"dest\"], 0.0), m[\"t0\"]) > self.stall_s:\n\
      \                        late.append((m, 1, f\"nothing reached ID {m['dest']}\
      \ for {self.stall_s:g} s\"))\n                for (src, mid), st in list(self._rx.items()):\n\
      \                    if now - st[\"t_last\"] / 1e6 > RX_STALE_S:\n         \
      \               self._rx.pop((src, mid), None)\n                        _emit(\"\
      bridge\", \"msg_rx\", src=src, mid=mid, bytes=sum(len(p) for p in st[\"parts\"\
      ].values()),\n                              segs=st[\"cnt\"], got=len(st[\"\
      parts\"]), res=\"incomplete (no segment for \"\n                           \
      \   f\"{RX_STALE_S:g} s)\", dur_s=round((st[\"t_last\"] - st[\"t_first\"]) /\
      \ 1e6, 3))\n            for m, reason, why in late:\n                self._give_up(m,\
      \ reason, why)\n            for d in dests:                                \
      \  # segments held back after a 'queue full'\n                self._pump(d)\n\
      \n    # ------------------------------------------------------------------ datagrams\n\
      \    def _udp_loop(self):\n        while not self._stop.is_set() and self._udp_rx\
      \ is not None:\n            try:\n                r, _, _ = select.select([self._udp_rx],\
      \ [], [], 0.5)\n                if not r:\n                    continue\n  \
      \              d, _ = self._udp_rx.recvfrom(65535)\n            except OSError:\n\
      \                return\n            if len(d) < 2:\n                continue\n\
      \            dest, data = d[0], d[1:]\n            if dest == self.my_id:\n\
      \                continue\n            with self._lock:\n                useq\
      \ = self._useq\n                self._useq = (self._useq + 1) & 0xFFFF\n   \
      \         t_us = _now_us()\n            body = struct.pack(\">BHQ\", SVC_UDP,\
      \ useq, t_us) + data\n            meta = pmt.make_dict()\n            meta =\
      \ pmt.dict_add(meta, pmt.intern(\"dest_id\"), pmt.from_long(dest))\n       \
      \     meta = pmt.dict_add(meta, pmt.intern(\"noack\"), pmt.from_long(1))\n \
      \           self.message_port_pub(pmt.intern(\"to_mac\"), pmt.cons(meta, pmt.init_u8vector(len(body),\
      \ list(body))))\n            _emit(\"bridge\", \"udp_tx\", dst=dest, useq=useq,\
      \ bytes=len(data), tx_us=t_us)\n\n    # ------------------------------------------------------------------\
      \ from the radio\n    def _on_mac(self, msg):\n        if not pmt.is_pair(msg)\
      \ or not pmt.is_u8vector(pmt.cdr(msg)):\n            return\n        rx_us =\
      \ _now_us()\n        try:\n            md = pmt.to_python(pmt.car(msg)) if pmt.is_dict(pmt.car(msg))\
      \ else {}\n        except Exception:\n            md = {}\n        src, dst\
      \ = int(md.get(\"src_id\", -1)), int(md.get(\"dest_id\", -1))\n        raw =\
      \ bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        if len(raw) >= UDP_HDR\
      \ and raw[0] == SVC_UDP:\n            _, useq, tx_us = struct.unpack(\">BHQ\"\
      , raw[:UDP_HDR])\n            data = raw[UDP_HDR:]\n            if self._udp_tx\
      \ is not None:\n                try:\n                    self._udp_tx.sendto(bytes([src\
      \ & 0xFF, dst & 0xFF]) + data, (self.udp_bind, self.udp_out_port))\n       \
      \         except OSError:\n                    pass\n            last = self._udp_last.get(src)\n\
      \            self._udp_last[src] = (rx_us, useq)\n            iat = None if\
      \ last is None else round((rx_us - last[0]) / 1e3, 2)\n            gap = None\
      \ if last is None else ((useq - last[1] - 1) & 0xFFFF)\n            if gap is\
      \ not None and gap > 0x8000:\n                gap -= 0x10000               \
      \                 # negative: arrived after a later one\n            _emit(\"\
      bridge\", \"udp_rx\", src=src, useq=useq, bytes=len(data), tx_us=tx_us,\n  \
      \                owd_ms=round((rx_us - tx_us) / 1e3, 2), iat_ms=iat, gap=gap,\
      \ mac_sn=md.get(\"mac_seq\"))\n            return\n        if len(raw) >= SEG_HDR\
      \ and raw[0] == SVC_SEG:\n            _, mid, idx, cnt, tx_us = struct.unpack(\"\
      >BIHHQ\", raw[:SEG_HDR])\n            self._rx_segment(src, dst, mid, idx, cnt,\
      \ tx_us, raw[SEG_HDR:], rx_us)\n            return\n        self._deliver(src,\
      \ raw)                               # plain message (e.g. typed in the GRC\
      \ box)\n\n    def _rx_segment(self, src, dst, mid, idx, cnt, tx_us, chunk, rx_us):\n\
      \        with self._lock:\n            data, st = self._rx_add(src, mid, idx,\
      \ cnt, tx_us, chunk, rx_us)\n        if data is None:\n            return\n\
      \        self._deliver(src, data)\n        dur = (rx_us - st[\"t_first\"]) /\
      \ 1e6\n        _emit(\"bridge\", \"msg_rx\", src=src, dst=dst, mid=mid, bytes=len(data),\
      \ segs=cnt, got=cnt, res=\"ok\",\n              dups=st[\"dups\"], dur_s=round(dur,\
      \ 3), span_s=round((rx_us - st[\"tx_first\"]) / 1e6, 3),\n              owd_first_ms=round(st[\"\
      owd_first\"] / 1e3, 1), owd_max_ms=round(st[\"owd_max\"] / 1e3, 1),\n      \
      \        kBps=round(len(data) / max(dur, 1e-3) / 1e3, 2))\n\n    def _rx_add(self,\
      \ src, mid, idx, cnt, tx_us, chunk, rx_us):\n        \"\"\"Caller holds the\
      \ lock. Returns (complete message or None, state).\"\"\"\n        dq, done =\
      \ self._rx_done.setdefault(src, (collections.deque(), set()))\n        if mid\
      \ in done or idx >= cnt:\n            return None, None                    \
      \             # duplicate of a delivered message (resent segment)\n        key\
      \ = (src, mid)\n        st = self._rx.get(key)\n        if st is None:\n   \
      \         st = self._rx[key] = {\"mid\": mid, \"cnt\": cnt, \"parts\": {}, \"\
      t_first\": rx_us, \"owd_first\": rx_us - tx_us,\n                          \
      \        \"tx_first\": tx_us, \"t_last\": rx_us, \"owd_max\": rx_us - tx_us,\
      \ \"dups\": 0}\n        if idx in st[\"parts\"]:\n            st[\"dups\"] +=\
      \ 1\n        st[\"parts\"][idx] = chunk\n        st[\"t_last\"] = rx_us\n  \
      \      st[\"owd_max\"] = max(st[\"owd_max\"], rx_us - tx_us)\n        if len(st[\"\
      parts\"]) >= st[\"cnt\"]:\n            data = b\"\".join(st[\"parts\"][i] for\
      \ i in range(st[\"cnt\"]))\n            self._rx.pop(key, None)\n          \
      \  done.add(mid)\n            dq.append(mid)\n            while len(dq) > RX_DONE_KEEP:\n\
      \                done.discard(dq.popleft())\n            return data, st\n \
      \       return None, st\n\n    def _deliver(self, src, data):\n        body\
      \ = bytes([0x81, src & 0xFF]) + data\n        with self._lock:\n           \
      \ clients = list(self._clients)\n        for c in clients:\n            self._send_to(c,\
      \ body)\n"
    affinity: ''
    alias: ''
    arq_port: ARQ_PORT
    comment: 'Programs use the link here: TCP ARQ_PORT (reliable), UDP UDP_PORT /
      UDP_OUT_PORT'
    host: '''127.0.0.1'''
    inflight: APP_INFLIGHT
    max_msg: '16000000'
    maxoutbuf: '0'
    minoutbuf: '0'
    msg_timeout_s: '0.0'
    mss: APP_MSS
    my_id: MY_ID
    stall_s: APP_STALL
    udp_bind: '''127.0.0.1'''
    udp_out_port: UDP_OUT_PORT
    udp_port: UDP_PORT
    verbose: '1'
    window: ARQ_N
  states:
    _io_cache: ('App Socket Bridge (TCP ARQ + UDP)', 'AppBridge', [('my_id', '1'),
      ('host', "'127.0.0.1'"), ('arq_port', '5100'), ('udp_bind', "'127.0.0.1'"),
      ('udp_port', '5200'), ('udp_out_port', '5201'), ('mss', '1000'), ('inflight',
      '32'), ('window', '16'), ('max_msg', '16000000'), ('msg_timeout_s', '0.0'),
      ('stall_s', '60.0'), ('verbose', '1')], [('status', 'message', 1), ('from_mac',
      'message', 1)], [('mac_ctrl', 'message', 1), ('to_mac', 'message', 1)], '',
      ['arq_port', 'host', 'inflight', 'max_msg', 'msg_timeout_s', 'mss', 'my_id',
      'stall_s', 'udp_bind', 'udp_out_port', 'udp_port', 'verbose', 'window'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 2430.0]
    rotation: 0
    state: enabled
- name: epy_csma
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: CSMA/CA DCF MAC + Selective-Repeat\
      \ ARQ with TXOP bursts and Block ACK        - v6.9\nv6.9 adds: an unreliable\
      \ service (metadata noack = 1, used for UDP datagrams: no Block ACK, no reordering,\n\
      burst of up to M frames, queue of udp_queue per destination, oldest dropped\
      \ when full), a tx_status output (one\nmessage per reliable frame that carries\
      \ app_ref: acked / dropped / qfull), and a one-line 'txop' summary event per\n\
      channel access for the session logs.\n(single frequency, half duplex, TX mute\
      \ + RX blanking as in v6.7)\n\nWiring (same as v6.7)\n  RX stream : DC blocker\
      \ -> in0 -> out0 (zeroed while this node transmits) -> Power Squelch -> ...\
      \ -> Deframer\n  app_in    <- data to send: text (\"@N text\" = to node N, \"\
      @all text\" = everyone) or PDUs (metadata dest_id)\n  to_phy    -> Packet Framer\
      \ TX msg_in            phy_in <- Packet Framer TX pdu_out (coded frames come\
      \ back)\n  pdu_out   -> PDU to Tagged Stream -> modulator -> Pluto sink\n  rx_in\
      \     <- Packet Deframer RX pdu_out (accept_all = 1)\n  app_out   -> received\
      \ data for this node, IN ORDER per sender, duplicates removed, MAC header stripped\n\
      \  ctrl      <- \"flush\" drops everything not yet sent\n  tx_status -> {app_ref,\
      \ app_seg, status (acked / dropped / qfull), dst, tx, ms}: delivery report per\
      \ reliable frame\n\nTwo layers inside this block\n  MAC (802.11 DCF + TXOP,\
      \ from v6.7): p-persistence -> DIFS -> backoff (CW = (cw_min+1)*2^k - 1, k <=\
      \ k_max) ->\n      TXOP: up to M DATA frames to ONE destination, back to back\
      \ in one transmission (802.11 A-MPDU / TXOP burst,\n      limited to txop_limit_s\
      \ of airtime) -> waits for ONE Block ACK.\n      Block ACK received -> the TXOP\
      \ succeeded: k = 0, the MAC goes straight back to contention;\n            \
      \                the Block ACK is handed to the ARQ layer, which reads it afterwards.\n\
      \      no Block ACK      -> k += 1 (CW doubles, up to k_max); every frame of\
      \ the burst counts as not received.\n  ARQ (selective repeat, per destination,\
      \ 802.11 Block Ack session):\n      sender window of N sequence numbers starting\
      \ at WS (oldest frame not yet acknowledged). New frames get a\n      sequence\
      \ number only when they fit in [WS, WS+N). A burst takes the eligible frames\
      \ in sequence order\n      (retransmissions first, because they are older),\
      \ at most M.\n      Block ACK bit i = 1 -> burst frame i acknowledged; 0 ->\
      \ retransmitted in a later burst. Each frame has its own\n      retry counter;\
      \ after retry_limit retransmissions it is dropped (802.11 per-MPDU retry limit).\
      \ WS then moves\n      past every acknowledged / dropped frame and new frames\
      \ enter the window.\n      The receiver keeps a reorder buffer of N (802.11\
      \ recipient scoreboard), delivers in order, removes\n      duplicates, and gives\
      \ up on a missing frame when the sender's WS has moved past it (the WS carried\
      \ in every\n      DATA frame does what an 802.11 BlockAckReq does).\n\nMAC header\
      \ (first bytes of the framer payload; the framer's CRC32 and Hamming FEC cover\
      \ it)\n  DATA (13 B):  FC | SN (2) | DURATION (2) | WS (2) | BSN (2) | IDX |\
      \ CNT | REM (2)\n       FC        1011 R T T   (TT 00 = DATA, 10 = Block ACK;\
      \ R = contains a retransmission)\n       SN        sequence number of this frame\
      \ (16 bit, per destination)\n       DURATION  NAV, 0.1 ms units: rest of the\
      \ burst + SIFS + turnaround + Block ACK airtime (0 for broadcast)\n       WS\
      \        sender's window start: everything before it is acknowledged or given\
      \ up\n       BSN       burst (TXOP) sequence number - the number the Block ACK\
      \ answers\n       IDX, CNT  position of this frame in the burst, number of frames\
      \ in the burst\n       REM       airtime of the burst still to come after this\
      \ frame, 0.1 ms units (tells the receiver when to ACK)\n  BLOCK ACK (8 B + ceil(M/8)):\
      \  FC | BSN (2) | DURATION (2) = 0 | RWS (2) | CNT | BITMAP\n       BSN    \
      \   the burst being answered\n       RWS       receiver's window start = next\
      \ sequence number it needs in order (cumulative ACK)\n       BITMAP    CNT bits\
      \ (M max), LSB first: bit i = burst frame i received with a good CRC\n  Source\
      \ / destination IDs are in the framer header. Broadcast DATA (dest 255): one\
      \ frame per TXOP, no Block ACK.\n\nReceiver timing: the Block ACK is sent SIFS\
      \ after the burst ended: (decode time of the latest frame + its REM) +\nsifs_s\
      \ - i.e. SIFS after the last frame if that arrived, otherwise at the time it\
      \ should have ended. It ignores\ncarrier sense, NAV and backoff and goes before\
      \ any own DATA (802.11 immediate Block Ack).\nOverheard frames for other nodes\
      \ set the NAV (virtual carrier sense) from DURATION.\n\nTiming constants (as\
      \ v6.7): turnaround_s = frame end on air -> reply on air on this SDR (~20-30\
      \ ms);\nDIFS = sifs_s + turnaround_s + 2 slot_s (difs_s > 0 overrides); Block\
      \ ACK timeout ba_timeout_s after the burst\nended on air. Frame airtimes are\
      \ computed from the framer settings (phy_preamble_len, phy_fec, phy_buffer_size,\n\
      samples_per_byte) - keep them equal to the framer's.\n\nRead-out for QT widgets\
      \ (Function Probe): cs_db(), floor_db(), threshold_db(), is_busy(), is_tx(),\
      \ queue_len(),\nis_muted(), nav_ms(), cw(), window_info()\n\"\"\"\nimport collections\n\
      import math\nimport os\nimport threading\nimport time\n\nimport numpy as np\n\
      import pmt\nfrom gnuradio import gr\n\n# ---- shared debug bus (one per flowgraph\
      \ process; the Stress Test block writes it to disk) ----\nimport sys as _sys\n\
      import types as _types\nimport collections as _collections\nimport time as _time\n\
      \n\ndef _bus():\n    b = _sys.modules.get(\"cdp_dbg_bus\")\n    if b is None:\n\
      \        nb = _types.ModuleType(\"cdp_dbg_bus\")\n        nb.events = _collections.deque(maxlen=400000)\
      \   # dicts; oldest dropped if nobody writes them\n        nb.sources = {} \
      \                                # name -> object with dbg_snapshot()\n    \
      \    b = _sys.modules.setdefault(\"cdp_dbg_bus\", nb)\n    return b\n\n\ndef\
      \ _emit(blk, kind, /, **kw):\n    kw[\"t\"] = round(_time.time(), 6)\n    kw[\"\
      blk\"] = blk\n    kw[\"k\"] = kind\n    _bus().events.append(kw)\n# ---- end\
      \ debug bus ----\n\n# ---- C++ kernels (cdp_fast.py / cdp_fast.cpp next to the\
      \ flowgraph); None -> the NumPy code of this block ----\ndef _load_fast():\n\
      \    import os as _os\n    if _os.environ.get(\"CDP_FAST\", \"1\").strip().lower()\
      \ in (\"0\", \"no\", \"off\", \"false\"):\n        return None\n    try:\n \
      \       import cdp_fast\n        return cdp_fast\n    except ImportError:\n\
      \        pass\n    for d in (_os.environ.get(\"CDP_HOME\"), _os.getcwd(),\n\
      \              _os.path.dirname(_os.path.abspath(_sys.argv[0])) if _sys.argv\
      \ and _sys.argv[0] else None):\n        if d and _os.path.isfile(_os.path.join(d,\
      \ \"cdp_fast.py\")):\n            if d not in _sys.path:\n                _sys.path.insert(0,\
      \ d)\n            try:\n                import cdp_fast\n                return\
      \ cdp_fast\n            except Exception:\n                return None\n   \
      \ return None\n# ---- end C++ kernels ----\n\nFC_BASE = 0xB0\nT_DATA, T_BA =\
      \ 0, 2\nF_RETRY = 0x04\nF_NOACK = 0x08          # unreliable frame (UDP / broadcast):\
      \ no Block ACK, no reordering\nHDR_DATA = 13\nHDR_BA = 8\nBCAST = 0xFF\nMASK\
      \ = 0xFFFF\n\n\ndef sdiff(a, b):\n    \"\"\"a - b in 16-bit sequence space,\
      \ -32768..32767\"\"\"\n    d = (a - b) & MASK\n    return d - 0x10000 if d >=\
      \ 0x8000 else d\n\n\ndef u16(x):\n    return bytes([(x >> 8) & 0xFF, x & 0xFF])\n\
      \n\ndef t01(s):\n    return max(0, min(65535, int(round(s * 1e4))))\n\n\ndef\
      \ data_header(sn, dur_s, ws, bsn, idx, cnt, rem_s, retry, noack=False):\n  \
      \  return (bytes([FC_BASE | (F_RETRY if retry else 0) | (F_NOACK if noack else\
      \ 0) | T_DATA]) + u16(sn) + u16(t01(dur_s)) + u16(ws) + u16(bsn)\n         \
      \   + bytes([idx & 0xFF, cnt & 0xFF]) + u16(t01(rem_s)))\n\n\ndef ba_frame(bsn,\
      \ rws, cnt, bits):\n    nb = max(1, (cnt + 7) // 8)\n    bm = bytearray(nb)\n\
      \    for i in range(cnt):\n        if bits >> i & 1:\n            bm[i // 8]\
      \ |= 1 << (i % 8)\n    return bytes([FC_BASE | T_BA]) + u16(bsn) + u16(0) +\
      \ u16(rws) + bytes([cnt & 0xFF]) + bytes(bm)\n\n\ndef parse_mac(b):\n    if\
      \ len(b) < 5 or (b[0] & 0xF0) != FC_BASE:\n        return None\n    t = b[0]\
      \ & 0x03\n    g = lambda i: (b[i] << 8) | b[i + 1]\n    if t == T_DATA and len(b)\
      \ >= HDR_DATA:\n        return {\"type\": T_DATA, \"retry\": bool(b[0] & F_RETRY),\
      \ \"noack\": bool(b[0] & F_NOACK), \"sn\": g(1), \"dur\": g(3) / 1e4, \"ws\"\
      : g(5),\n                \"bsn\": g(7), \"idx\": b[9], \"cnt\": b[10], \"rem\"\
      : g(11) / 1e4}\n    if t == T_BA and len(b) >= HDR_BA + 1:\n        cnt = b[7]\n\
      \        bits = 0\n        for i in range(min(cnt, 8 * (len(b) - HDR_BA))):\n\
      \            if b[HDR_BA + i // 8] >> (i % 8) & 1:\n                bits |=\
      \ 1 << i\n        return {\"type\": T_BA, \"bsn\": g(1), \"dur\": g(3) / 1e4,\
      \ \"rws\": g(5), \"cnt\": cnt, \"bits\": bits}\n    return None\n\n\ndef id_name(i):\n\
      \    return \"all\" if i == BCAST else str(i)\n\n\ndef bitstr(bits, cnt):\n\
      \    return \"\".join(\"1\" if bits >> i & 1 else \"0\" for i in range(cnt))\n\
      \n\n# ========================================================================================\
      \ ARQ: sender side\nclass TxSession:\n    \"\"\"Originator side of a Block Ack\
      \ session to one destination (selective repeat, window N).\"\"\"\n\n    def\
      \ __init__(self, dst, n_win, retry_limit):\n        self.dst = dst\n       \
      \ self.N = n_win\n        self.retry_limit = retry_limit\n        self.ws =\
      \ 0\n        self.next_sn = 0\n        self.frames = {}                 # sn\
      \ -> record\n        self.backlog = collections.deque()\n\n    def admit(self):\n\
      \        new = []\n        while self.backlog and sdiff(self.next_sn, self.ws)\
      \ < self.N:\n            payload, keep, t_enq = self.backlog.popleft()\n   \
      \         r = {\"sn\": self.next_sn, \"payload\": payload, \"keep\": keep, \"\
      t_enq\": t_enq, \"retries\": 0,\n                 \"state\": \"new\", \"tx\"\
      : 0}\n            self.frames[self.next_sn] = r\n            new.append(r)\n\
      \            self.next_sn = (self.next_sn + 1) & MASK\n        return new\n\n\
      \    def in_window(self):\n        return [self.frames[(self.ws + i) & MASK]\
      \ for i in range(sdiff(self.next_sn, self.ws))\n                if (self.ws\
      \ + i) & MASK in self.frames]\n\n    def eligible(self):\n        return [r\
      \ for r in self.in_window() if r[\"state\"] in (\"new\", \"retx\")]\n\n    def\
      \ pending(self):\n        return any(r[\"state\"] in (\"new\", \"retx\") for\
      \ r in list(self.frames.values()))\n\n    def outstanding(self):\n        return\
      \ len(self.frames) + len(self.backlog)\n\n    def _done(self, r, state):\n \
      \       r[\"state\"] = state\n\n    def slide(self):\n        moved = 0\n  \
      \      while self.ws != self.next_sn:\n            r = self.frames.get(self.ws)\n\
      \            if r is not None and r[\"state\"] not in (\"acked\", \"dropped\"\
      ):\n                break\n            self.frames.pop(self.ws, None)\n    \
      \        self.ws = (self.ws + 1) & MASK\n            moved += 1\n        return\
      \ moved\n\n    def on_block_ack(self, burst, bits, rws):\n        \"\"\"burst:\
      \ list of records in burst order. Returns (acked, nacked, dropped) lists of\
      \ records.\"\"\"\n        acked, nacked, dropped = [], [], []\n        for i,\
      \ r in enumerate(burst):\n            if r[\"state\"] in (\"acked\", \"dropped\"\
      ):\n                continue\n            ok = bool(bits >> i & 1) or sdiff(r[\"\
      sn\"], rws) < 0\n            if ok:\n                r[\"state\"] = \"acked\"\
      \n                acked.append(r)\n            else:\n                self._fail(r,\
      \ nacked, dropped)\n        # cumulative part: everything before the receiver's\
      \ window start has arrived (or was given up)\n        ids = {id(r) for r in\
      \ burst}\n        for r in self.in_window():\n            if r[\"state\"] not\
      \ in (\"acked\", \"dropped\") and sdiff(r[\"sn\"], rws) < 0 and id(r) not in\
      \ ids:\n                r[\"state\"] = \"acked\"\n                acked.append(r)\n\
      \        return acked, nacked, dropped\n\n    def on_no_ba(self, burst):\n \
      \       nacked, dropped = [], []\n        for r in burst:\n            if r[\"\
      state\"] == \"out\":\n                self._fail(r, nacked, dropped)\n     \
      \   return nacked, dropped\n\n    def _fail(self, r, nacked, dropped):\n   \
      \     r[\"retries\"] += 1\n        if r[\"retries\"] > self.retry_limit:\n \
      \           r[\"state\"] = \"dropped\"\n            dropped.append(r)\n    \
      \    else:\n            r[\"state\"] = \"retx\"\n            nacked.append(r)\n\
      \n\n# ========================================================================================\
      \ ARQ: receiver side\nclass RxSession:\n    \"\"\"Recipient side: reorder buffer\
      \ of N, in-order delivery, duplicate removal.\"\"\"\n\n    def __init__(self,\
      \ src, n_win, ws):\n        self.src = src\n        self.N = n_win\n       \
      \ self.rws = ws\n        self.buf = {}\n\n    def on_frame(self, sn, ws_sender,\
      \ item):\n        \"\"\"Returns (list of items to deliver in order, duplicate?,\
      \ gave_up count).\"\"\"\n        out, gave_up = [], 0\n        if sdiff(self.rws,\
      \ ws_sender) > self.N:             # sender restarted (its window is far behind\
      \ ours)\n            self.buf.clear()\n            self.rws = ws_sender\n  \
      \      if sdiff(ws_sender, self.rws) > 0:                   # sender moved its\
      \ window: missing frames are given up\n            gave_up += self._flush_to(ws_sender,\
      \ out)\n        d = sdiff(sn, self.rws)\n        if d < 0:\n            return\
      \ out, True, gave_up\n        if d >= self.N:                              \
      \        # beyond the window: move it (802.11 rule)\n            gave_up +=\
      \ self._flush_to((sn - self.N + 1) & MASK, out)\n        if sn in self.buf:\n\
      \            return out, True, gave_up\n        self.buf[sn] = item\n      \
      \  while self.rws in self.buf:\n            out.append(self.buf.pop(self.rws))\n\
      \            self.rws = (self.rws + 1) & MASK\n        return out, False, gave_up\n\
      \n    def _flush_to(self, new_ws, out):\n        gave_up = 0\n        while\
      \ sdiff(new_ws, self.rws) > 0:\n            it = self.buf.pop(self.rws, None)\n\
      \            if it is None:\n                gave_up += 1\n            else:\n\
      \                out.append(it)\n            self.rws = (self.rws + 1) & MASK\n\
      \        while self.rws in self.buf:\n            out.append(self.buf.pop(self.rws))\n\
      \            self.rws = (self.rws + 1) & MASK\n        return gave_up\n\n\n\
      class TxMuter:\n    \"\"\"Writes the Pluto TX attenuation (ad9361-phy, output\
      \ voltage0, hardwaregain) from a worker thread.\"\"\"\n\n    def __init__(self,\
      \ uri, verbose=1):\n        self.uri = str(uri)\n        self.verbose = int(verbose)\n\
      \        self.ok = False\n        self.failed = False\n        self.reason =\
      \ \"connecting\"\n        self.backend = \"\"\n        self.errors = 0\n   \
      \     self.writes = 0\n        self.write_ms = collections.deque(maxlen=200)\n\
      \        self._cv = threading.Condition()\n        self._want = None\n     \
      \   self._seq = 0\n        self._done_seq = 0\n        self._stop = False\n\
      \        self._last_write = 0.0\n        self._write = None\n        self._close\
      \ = None\n        self._thr = None\n\n    def start(self):\n        self._thr\
      \ = threading.Thread(target=self._run, name=\"tx-mute\", daemon=True)\n    \
      \    self._thr.start()\n\n    def request(self, att_db):\n        with self._cv:\n\
      \            self._want = float(att_db)\n            self._seq += 1\n      \
      \      self._cv.notify()\n            return self._seq\n\n    def done(self,\
      \ seq):\n        return self._done_seq >= seq\n\n    def stop(self, restore_att=None):\n\
      \        with self._cv:\n            self._stop = True\n            self._cv.notify()\n\
      \        if self._thr is not None:\n            self._thr.join(timeout=2.0)\n\
      \        if self.ok and restore_att is not None:\n            try:\n       \
      \         self._write(float(restore_att))\n            except Exception:\n \
      \               pass\n        if self._close:\n            try:\n          \
      \      self._close()\n            except Exception:\n                pass\n\n\
      \    def _open(self):\n        errs = []\n        try:\n            import ctypes\n\
      \            import ctypes.util\n            name = ctypes.util.find_library(\"\
      iio\") or \"libiio.so.0\"\n            lib = ctypes.CDLL(name)\n           \
      \ vp, cp = ctypes.c_void_p, ctypes.c_char_p\n            lib.iio_create_context_from_uri.restype\
      \ = vp\n            lib.iio_create_context_from_uri.argtypes = [cp]\n      \
      \      lib.iio_context_find_device.restype = vp\n            lib.iio_context_find_device.argtypes\
      \ = [vp, cp]\n            lib.iio_device_find_channel.restype = vp\n       \
      \     lib.iio_device_find_channel.argtypes = [vp, cp, ctypes.c_bool]\n     \
      \       lib.iio_channel_attr_write.restype = ctypes.c_ssize_t\n            lib.iio_channel_attr_write.argtypes\
      \ = [vp, cp, cp]\n            lib.iio_context_set_timeout.restype = ctypes.c_int\n\
      \            lib.iio_context_set_timeout.argtypes = [vp, ctypes.c_uint]\n  \
      \          lib.iio_context_destroy.restype = None\n            lib.iio_context_destroy.argtypes\
      \ = [vp]\n            ctx = lib.iio_create_context_from_uri(self.uri.encode())\n\
      \            if not ctx:\n                raise RuntimeError(f\"cannot open\
      \ {self.uri}\")\n            lib.iio_context_set_timeout(ctx, 1000)\n      \
      \      dev = lib.iio_context_find_device(ctx, b\"ad9361-phy\")\n           \
      \ chn = lib.iio_device_find_channel(dev, b\"voltage0\", True) if dev else None\n\
      \            if not chn:\n                lib.iio_context_destroy(ctx)\n   \
      \             raise RuntimeError(\"ad9361-phy output voltage0 not found\")\n\
      \n            def write(att):\n                r = lib.iio_channel_attr_write(chn,\
      \ b\"hardwaregain\", f\"{-att:.2f}\".encode())\n                if r < 0:\n\
      \                    raise OSError(-r, os.strerror(-r))\n\n            self._write,\
      \ self._close = write, (lambda: lib.iio_context_destroy(ctx))\n            self.backend\
      \ = f\"libiio C library ({name})\"\n            return\n        except Exception\
      \ as e:\n            errs.append(f\"libiio C library: {e}\")\n        try:\n\
      \            import iio\n            ctx = iio.Context(self.uri)\n         \
      \   dev = ctx.find_device(\"ad9361-phy\")\n            chn = dev.find_channel(\"\
      voltage0\", True) if dev else None\n            if chn is None:\n          \
      \      raise RuntimeError(\"ad9361-phy output voltage0 not found\")\n      \
      \      attr = chn.attrs[\"hardwaregain\"]\n\n            def write(att):\n \
      \               attr.value = f\"{-att:.2f}\"\n\n            self._write, self._close\
      \ = write, None\n            self._ctx_keepalive = ctx\n            self.backend\
      \ = \"python iio module\"\n            return\n        except Exception as e:\n\
      \            errs.append(f\"python iio module: {e}\")\n        raise RuntimeError(\"\
      ; \".join(errs))\n\n    def _run(self):\n        try:\n            self._open()\n\
      \        except Exception as e:\n            self.failed, self.reason = True,\
      \ str(e)\n            print(f\"[MAC] TX mute OFF: could not control the radio's\
      \ TX attenuation ({e}). Install libiio \"\n                  f\"(Fedora: sudo\
      \ dnf install libiio python3-libiio) or check iio_uri. Running without mute.\"\
      , flush=True)\n            return\n        self.ok, self.reason = True, \"ok\"\
      \n        if self.verbose:\n            print(f\"[MAC] TX mute ready ({self.backend},\
      \ {self.uri})\", flush=True)\n        while True:\n            with self._cv:\n\
      \                while (not self._stop and self._seq == self._done_seq\n   \
      \                    and time.monotonic() - self._last_write < 1.0):\n     \
      \               self._cv.wait(timeout=0.25)\n                if self._stop:\n\
      \                    return\n                seq, att = self._seq, self._want\n\
      \            if att is not None:\n                t = time.perf_counter()\n\
      \                try:\n                    self._write(att)\n              \
      \      self.writes += 1\n                    self.write_ms.append(1e3 * (time.perf_counter()\
      \ - t))\n                except Exception as e:\n                    self.errors\
      \ += 1\n                    if self.errors <= 3:\n                        print(f\"\
      [MAC] TX attenuation write failed: {e}\", flush=True)\n            self._last_write\
      \ = time.monotonic()\n            with self._cv:\n                self._done_seq\
      \ = max(self._done_seq, seq)\n\n\n# ========================================================================================\
      \ the block\nclass SrArqMac(gr.sync_block):\n    def __init__(self, samp_rate=1e6,\

      \ echo_margin_db=25.0, verbose=1, stats_every_s=10.0):\n        gr.sync_block.__init__(self,\
      \ name=\"CSMA/CA DCF + SR-ARQ (TXOP burst, Block ACK) + TX mute\",\n       \

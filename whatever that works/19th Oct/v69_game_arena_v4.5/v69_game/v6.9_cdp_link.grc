options:
  parameters:
    author: mushab404
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'start it with cdp_daemon.py: login sets CDP_MY_ID / CDP_DEBUG_DIR;
      apps use TCP 5100 / UDP 5200'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: cdp_link
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: CDP link v6.9.1 (CSMA/CA + SR-ARQ + socket bridge + session logs)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: ADDR
  id: variable
  parameters:
    comment: ''
    value: '"ip:192.168.1.10"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 92.0]
    rotation: 0
    state: enabled
- name: APP_INFLIGHT
  id: variable
  parameters:
    comment: segments per destination handed to the MAC at a time (env CDP_INFLIGHT)
    value: int(os.environ.get('CDP_INFLIGHT', '32'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 2680.0]
    rotation: 0
    state: enabled
- name: APP_MSS
  id: variable
  parameters:
    comment: bytes per reliable segment (one radio frame) (env CDP_MSS)
    value: int(os.environ.get('CDP_MSS', '1000'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 2680.0]
    rotation: 0
    state: enabled
- name: APP_STALL
  id: variable
  parameters:
    comment: a message fails only when nothing reached its destination for this many
      s (env CDP_MSG_STALL)
    value: float(os.environ.get('CDP_MSG_STALL', '60'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 2680.0]
    rotation: 0
    state: enabled
- name: ARQ_M
  id: variable
  parameters:
    comment: 'M: max frames per burst = bits in the Block ACK bitmap (1..64) (env
      CDP_ARQ_M)'
    value: int(os.environ.get('CDP_ARQ_M', '4'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 2590.0]
    rotation: 0
    state: enabled
- name: ARQ_N
  id: variable
  parameters:
    comment: 'N: selective-repeat window (sender window and receiver reorder buffer,
      >= M) (env CDP_ARQ_N)'
    value: int(os.environ.get('CDP_ARQ_N', '16'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 2590.0]
    rotation: 0
    state: enabled
- name: ARQ_PORT
  id: variable
  parameters:
    comment: TCP port for reliable messages (cdp_sock / daemon) (env CDP_ARQ_PORT)
    value: int(os.environ.get('CDP_ARQ_PORT', '5100'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 2680.0]
    rotation: 0
    state: enabled
- name: BPSK_CONST
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[1+0j, -1+0j]'
    imag_sect: '1'
    precision: '8'
    real_sect: '2'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 452.0]
    rotation: 0
    state: enabled
- name: BUFFER_SIZE
  id: variable
  parameters:
    comment: ''
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 340.0]
    rotation: 0
    state: enabled
- name: CH_GAIN
  id: variable_qtgui_range
  parameters:
    comment: Pluto TX attenuation used for own bursts. While idle the CSMA block sets
      89.75 dB (if 'Mute TX when idle'). Start value from env CDP_TX_ATT.
    gui_hint: ''
    label: TX attenuation while sending (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.25'
    stop: '89.75'
    value: float(os.environ.get('CDP_TX_ATT', '0.0'))
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 88.0]
    rotation: 0
    state: enabled
- name: DEST_ID
  id: variable_qtgui_entry
  parameters:
    comment: 'Default destination for typed messages: 0..254 = that node, 255 = every
      node. Start value from env CDP_DEST. Type a new ID and press Enter / leave the
      box.'
    entry_signal: editingFinished
    gui_hint: ''
    label: Dest ID (255 = all)
    type: int
    value: int(os.environ.get('CDP_DEST', '255'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1328, 32.0]
    rotation: 0
    state: enabled
- name: FEC
  id: variable
  parameters:
    comment: '0 = no FEC

      15 = Hamming(15,11)

      31 = Hamming(31,26)'
    value: '31'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 176.0]
    rotation: 0
    state: enabled
- name: FILTER_BW
  id: variable
  parameters:
    comment: ''
    value: int(1e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1616, 176.0]
    rotation: 0
    state: enabled
- name: FREQ
  id: variable
  parameters:
    comment: Single frequency (half duplex, CSMA). Both nodes TX and RX here.
    value: 2.49e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 256.0]
    rotation: 0
    state: enabled
- name: MAC_BA_TO
  id: variable
  parameters:
    comment: Block ACK timeout in s after the burst ended on air (env CDP_MAC_BA_TO)
    value: float(os.environ.get('CDP_MAC_BA_TO', '0.070'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 2590.0]
    rotation: 0
    state: enabled
- name: MAC_CWMAX
  id: variable
  parameters:
    comment: 'maximum contention window (env CDP_MAC_CWMAX; v6.9.1 default 63, was
      1023: most losses are not collisions)'
    value: int(os.environ.get('CDP_MAC_CWMAX', '63'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1208, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_CWMIN
  id: variable
  parameters:
    comment: minimum contention window (env CDP_MAC_CWMIN)
    value: int(os.environ.get('CDP_MAC_CWMIN', '15'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_DIFS
  id: variable
  parameters:
    comment: DIFS in s; 0 = SIFS + turnaround + 2 slots (env CDP_MAC_DIFS)
    value: float(os.environ.get('CDP_MAC_DIFS', '0'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_KMAX
  id: variable
  parameters:
    comment: 'max backoff stage K: CW doubles at most K times (env CDP_MAC_KMAX)'
    value: int(os.environ.get('CDP_MAC_KMAX', '5'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 2590.0]
    rotation: 0
    state: enabled
- name: MAC_P
  id: variable
  parameters:
    comment: 'p-persistence: chance to go on per idle slot (env CDP_MAC_P; v6.9.1
      default 0.2, was 0.04)'
    value: float(os.environ.get('CDP_MAC_P', '0.2'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_RETRY
  id: variable
  parameters:
    comment: retransmissions before a frame is dropped (802.11 short retry limit 7)
      (env CDP_MAC_RETRY)
    value: int(os.environ.get('CDP_MAC_RETRY', '7'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 2590.0]
    rotation: 0
    state: enabled
- name: MAC_SIFS
  id: variable
  parameters:
    comment: 'SIFS in s: wait after decoding a DATA before its ACK goes (env CDP_MAC_SIFS)'
    value: float(os.environ.get('CDP_MAC_SIFS', '0.001'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_SLOT
  id: variable
  parameters:
    comment: slot time in s (env CDP_MAC_SLOT)
    value: float(os.environ.get('CDP_MAC_SLOT', '0.002'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_TURN
  id: variable
  parameters:
    comment: 'turnaround in s: frame end on air -> reply on air (decode + SIFS + unmute
      + TX chain). Sets DIFS and NAV (env CDP_MAC_TURN)'
    value: float(os.environ.get('CDP_MAC_TURN', '0.025'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 2500.0]
    rotation: 0
    state: enabled
- name: MAC_TXOP
  id: variable
  parameters:
    comment: 'TXOP limit: max airtime of one burst in s (at least 1 frame) (env CDP_MAC_TXOP)'
    value: float(os.environ.get('CDP_MAC_TXOP', '0.25'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 2590.0]
    rotation: 0
    state: enabled
- name: MAC_UDPQ
  id: variable
  parameters:
    comment: datagrams queued per destination before the oldest is dropped (env CDP_UDP_QUEUE)
    value: int(os.environ.get('CDP_UDP_QUEUE', '32'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1208, 2590.0]
    rotation: 0
    state: enabled
- name: MY_ID
  id: variable
  parameters:
    comment: This node's src ID, 0..254, different on every node. From env CDP_MY_ID
      (default 1).
    value: int(os.environ.get('CDP_MY_ID', '1'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 12.0]
    rotation: 0
    state: enabled
- name: QPSK_CONST
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 148.0]
    rotation: 0
    state: enabled
- name: RC_PULSE
  id: variable
  parameters:
    comment: ''
    value: np.sinc(RC_X)*np.cos(np.pi*alpha*RC_X)/(1-(2*alpha*RC_X)**2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 256.0]
    rotation: 0
    state: enabled
- name: RC_X
  id: variable
  parameters:
    comment: ''
    value: np.arange(-8, 9)/2.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 256.0]
    rotation: 0
    state: enabled
- name: RX_AMP
  id: variable
  parameters:
    comment: ''
    value: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 256.0]
    rotation: 0
    state: enabled
- name: RX_FREQ
  id: variable
  parameters:
    comment: ''
    value: FREQ
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1520, 176.0]
    rotation: 0
    state: enabled
- name: SDR_CF
  id: variable
  parameters:
    comment: ''
    value: 433e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 92.0]
    rotation: 0
    state: enabled
- name: TRAIN_BITS
  id: variable
  parameters:
    comment: ''
    value: np.unpackbits(np.frombuffer(bytes([0xF8, 0xDD, 0x42, 0x58]), np.uint8))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 256.0]
    rotation: 0
    state: enabled
- name: TRAIN_REF
  id: variable
  parameters:
    comment: ''
    value: list(map(complex, RX_AMP*np.convolve(np.kron(TRAIN_SYMS, [1, 0]), RC_PULSE)[8:8+2*len(TRAIN_SYMS)-1]))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 336.0]
    rotation: 0
    state: enabled
- name: TRAIN_SYMS
  id: variable
  parameters:
    comment: ''
    value: list(map(complex, 1 - 2*np.bitwise_xor.accumulate(TRAIN_BITS).astype(int)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 256.0]
    rotation: 0
    state: enabled
- name: TX_FREQ
  id: variable
  parameters:
    comment: ''
    value: FREQ
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 176.0]
    rotation: 0
    state: enabled
- name: TX_FREQ_A
  id: variable
  parameters:
    comment: ''
    value: int(1250e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 176.0]
    rotation: 0
    state: enabled
- name: TX_FREQ_B
  id: variable
  parameters:
    comment: ''
    value: int(1270e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 176.0]
    rotation: 0
    state: enabled
- name: TX_MUTE
  id: variable_qtgui_check_box
  parameters:
    comment: 1 = TX attenuation 89.75 dB whenever this node is not sending (CSMA block,
      via libiio).
    'false': '0'
    gui_hint: ''
    label: Mute TX when idle
    'true': '1'
    type: int
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 340.0]
    rotation: 0
    state: enabled
- name: UDP_OUT_PORT
  id: variable
  parameters:
    comment: UDP port received datagrams are sent to (env CDP_UDP_OUT_PORT)
    value: int(os.environ.get('CDP_UDP_OUT_PORT', '5201'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1008, 2680.0]
    rotation: 0
    state: enabled
- name: UDP_PORT
  id: variable
  parameters:
    comment: UDP port the bridge receives datagrams on (env CDP_UDP_PORT)
    value: int(os.environ.get('CDP_UDP_PORT', '5200'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 2680.0]
    rotation: 0
    state: enabled
- name: adpt_alg
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: BPSK_CONST
    delta: '10.0'
    ffactor: '0.99'
    modulus: '2'
    step_size: '0.5'
    type: nlms
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 660.0]
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 12.0]
    rotation: 0
    state: enabled
- name: corr_thr
  id: variable_qtgui_range
  parameters:
    comment: Normalized correlation threshold (0..1). Random data ~0.1-0.25, real
      train word ~0.8-1.0.
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.3'
    step: '0.01'
    stop: '0.98'
    value: '0.7'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 16.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
  parameters:
    comment: ''
    value: '0.06'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 92.0]
    rotation: 0
    state: enabled
- name: cs_margin
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: CSMA sense margin (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '3'
    step: '0.5'
    stop: '15'
    value: '6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [822, 16.0]
    rotation: 0
    state: enabled
- name: fll_loop_bw
  id: variable
  parameters:
    comment: ''
    value: '0.01'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 16.0]
    rotation: 0
    state: enabled
- name: margin_db
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Squelch margin over noise (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '2'
    step: '0.5'
    stop: '20'
    value: '6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 16.0]
    rotation: 0
    state: enabled
- name: max_payload_len
  id: variable
  parameters:
    comment: ''
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 176.0]
    rotation: 0
    state: enabled
- name: power_threshold
  id: variable_function_probe
  parameters:
    block_id: epy_noise
    comment: Automatic squelch threshold (dB) from the noise-floor tracker
    function_args: ''
    function_name: level
    poll_rate: '5'
    value: '-40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 100.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: sample rate (env CDP_SAMP_RATE); the last hardware-proven v6.5 ran at
      1.5e6
    value: float(os.environ.get('CDP_SAMP_RATE', '1e6'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 12.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 12.0]
    rotation: 0
    state: enabled
- name: sym_bw
  id: variable
  parameters:
    comment: ''
    value: '0.020'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 172.0]
    rotation: 0
    state: enabled
- name: train_delay
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '12'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 16.0]
    rotation: 0
    state: enabled
- name: analog_agc_xx_0
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gain: '1.0'
    max_gain: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'

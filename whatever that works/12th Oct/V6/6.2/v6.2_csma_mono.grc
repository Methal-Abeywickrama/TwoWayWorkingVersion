- name: epy_block_0_0_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX (Hamming\
      \ FEC + equalizer training word)\n- Outputs packed byte PDUs directly to pdu_pdu_to_tagged_stream\n\
      - Frame layout:\n    [preamble] [train word: F8 DD 42 58] [sync: 1A CF FC 1D]\
      \ [coded section(s)] [postamble]\n  Before coding the sections are:  header\
      \ = [len:2B][dest_id:1B][msg_id:1B][rep:1B][n_reps:1B]\n                   \
      \                body   = [payload][CRC32 over header+payload: 4B]\n- fec =\
      \ 0  : header + body sent uncoded (identical to the non-FEC framer)\n  fec =\
      \ 15 : Hamming(15,11)    fec = 31 : Hamming(31,26)\n  Preamble, train word and\
      \ sync word are never coded (the correlator / deframer look for them as raw\
      \ bits).\n  Header and body are two separate coded sections (the receiver decodes\
      \ the header first to learn the length);\n  the coded bits are bit-for-bit what\
      \ the previous FEC framer produced, so a deframer written for that\n  format\
      \ still decodes them. Anything after the body is ignored by the receiver.\n\
      - interleave = True: each section's codewords are sent column by column (burst-error\
      \ protection)\n- The train word is known to the RX: the correlator finds it,\
      \ tags it, and the equalizer trains on it.\n  It must match TRAIN_BITS in the\
      \ flowgraph.\n- Postamble: pads the frame to a whole number of Pluto sink buffers\
      \ (buffer_size is in SAMPLES, so one\n  buffer = buffer_size / samples_per_byte\
      \ bytes) and is never shorter than one buffer. The TX pulse-shaping\n  filter\
      \ holds back ~86 samples and the sink holds back the last partial buffer; both\
      \ fall inside the\n  postamble, so no frame bits are lost or delayed.\n\"\"\"\
      \nimport zlib\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nSYNC_WORD\
      \ = bytes([0x1A, 0xCF, 0xFC, 0x1D])\n# 31-bit m-sequence + 1 pad bit. MUST match\
      \ TRAIN_BITS in the flowgraph (RX side).\nTRAIN_WORD = bytes([0xF8, 0xDD, 0x42,\
      \ 0x58])\n\n\ndef hamming_tables(n):\n    \"\"\"Standard positional Hamming\
      \ layout: parity bits at positions 1, 2, 4, 8, (16).\"\"\"\n    m = {15: 4,\
      \ 31: 5}[n]\n    pos = np.arange(1, n + 1)\n    is_parity = (pos & (pos - 1))\
      \ == 0\n    data_idx = np.flatnonzero(~is_parity)          # 0-based indices\
      \ of data positions\n    par_idx = np.flatnonzero(is_parity)            # 0-based\
      \ indices of 1, 2, 4, 8, (16)\n    P = ((pos[data_idx, None] >> np.arange(m))\
      \ & 1).astype(np.int32)   # k x m\n    return data_idx, par_idx, P\n\n\ndef\
      \ hamming_encode_bits(bits, n, interleave):\n    \"\"\"bits: 0/1 array. Pads\
      \ to a multiple of k, returns the coded bit array.\"\"\"\n    data_idx, par_idx,\
      \ P = hamming_tables(n)\n    k = len(data_idx)\n    nblk = -(-len(bits) // k)\n\
      \    d = np.zeros(nblk * k, dtype=np.int32)\n    d[:len(bits)] = bits\n    d\
      \ = d.reshape(nblk, k)\n    cw = np.zeros((nblk, n), dtype=np.uint8)\n    cw[:,\
      \ data_idx] = d\n    cw[:, par_idx] = (d @ P) & 1\n    return (cw.T if interleave\
      \ else cw).reshape(-1)\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(self,\
      \ peer_id=1, preamble_len=64, repeat_count=1, max_payload_len=1024,\n      \
      \           preamble_byte=0xFF, buffer_size=2048, postamble_byte=0xFF, train_enable=1,\n\
      \                 fec=15, interleave=1, samples_per_byte=32):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"Packet Framer TX (Burst, FEC)\",\n  \
      \          in_sig=None,\n            out_sig=None,\n        )\n        self.peer_id\
      \ = int(peer_id) & 0xFF\n        self.preamble_len = int(preamble_len)\n   \
      \     self.repeat_count = int(repeat_count)\n        self.max_payload_len =\
      \ int(max_payload_len)\n        self.preamble_byte = int(preamble_byte) & 0xFF\n\
      \        self.buffer_size = int(buffer_size)              # Pluto sink buffer,\
      \ in SAMPLES\n        self.postamble_byte = int(postamble_byte) & 0xFF\n   \
      \     self.train_enable = int(train_enable)\n        self.fec = int(fec)\n \
      \       self.interleave = bool(int(interleave))\n        self.samples_per_byte\
      \ = max(1, int(samples_per_byte))   # 8 bits * samples/symbol (BPSK)\n     \
      \   if self.fec not in (0, 15, 31):\n            raise ValueError(\"fec must\
      \ be 0, 15 or 31\")\n        self._msg_id = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      msg_in\"))\n        self.set_msg_handler(pmt.intern(\"msg_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    @staticmethod\n\
      \    def _extract_payload(msg):\n        if pmt.is_pair(msg):\n            data\
      \ = pmt.cdr(msg)\n            if pmt.is_u8vector(data):\n                return\
      \ bytes(pmt.u8vector_elements(data))\n            return str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        if pmt.is_symbol(msg):\n            return pmt.symbol_to_string(msg).encode(\"\
      utf-8\")\n        val = pmt.to_python(msg)\n        if isinstance(val, (bytes,\
      \ bytearray)):\n            return bytes(val)\n        return str(val).encode(\"\
      utf-8\")\n\n    def _encode_section(self, data):\n        bits = np.unpackbits(np.frombuffer(data,\
      \ dtype=np.uint8))\n        return hamming_encode_bits(bits, self.fec, self.interleave)\n\
      \n    def _coded_body(self, header, payload):\n        \"\"\"Everything after\
      \ the sync word: header + payload + CRC, coded if fec != 0.\"\"\"\n        crc\
      \ = zlib.crc32(header + payload).to_bytes(4, \"big\")\n        if self.fec ==\
      \ 0:\n            return header + payload + crc\n        coded = np.concatenate((self._encode_section(header),\n\
      \                                self._encode_section(payload + crc)))\n   \
      \     return np.packbits(coded).tobytes()               # pads the last byte\
      \ with 0s\n\n    def _postamble_len(self, raw_len):\n        \"\"\"Bytes of\
      \ postamble: at least one sink buffer, and total a whole number of buffers.\"\
      \"\"\n        if self.buffer_size <= 0:\n            return 0\n        unit\
      \ = max(1, -(-self.buffer_size // self.samples_per_byte))    # bytes per sink\
      \ buffer\n        need = raw_len + unit                                    \
      \       # leave one full buffer of postamble\n        return (-(-need // unit))\
      \ * unit - raw_len\n\n    def build_frame(self, header, payload):\n        preamble\
      \ = bytes([self.preamble_byte]) * self.preamble_len\n        train = TRAIN_WORD\
      \ if self.train_enable else b\"\"\n        raw = preamble + train + SYNC_WORD\
      \ + self._coded_body(header, payload)\n        return raw + bytes([self.postamble_byte])\
      \ * self._postamble_len(len(raw))\n\n    def handle_msg(self, msg):\n      \
      \  try:\n            payload = self._extract_payload(msg)\n        except Exception\
      \ as e:\n            print(f\"[TX] Could not parse message: {e}\", flush=True)\n\
      \            return\n\n        if not payload:\n            return\n\n     \
      \   if len(payload) > self.max_payload_len:\n            print(f\"[TX] Payload\
      \ {len(payload)} B truncated to {self.max_payload_len} B\", flush=True)\n  \
      \          payload = payload[: self.max_payload_len]\n\n        msg_id = self._msg_id\n\
      \        self._msg_id = (self._msg_id + 1) & 0xFF\n        n_reps = max(1, min(255,\
      \ self.repeat_count))\n\n        fec_txt = \"no FEC\" if self.fec == 0 else\
      \ f\"Hamming({self.fec},{self.fec - (4 if self.fec == 15 else 5)})\"\n     \
      \   print(\n            f\"[TX] msg #{msg_id} (to peer {self.peer_id}): '{payload.decode('utf-8',\
      \ 'replace')}' \"\n            f\"({n_reps} bursts queued, {fec_txt})\",\n \
      \           flush=True,\n        )\n\n        for rep in range(n_reps):\n  \
      \          header = len(payload).to_bytes(2, \"big\") + bytes([self.peer_id,\
      \ msg_id, rep, n_reps])\n            frame = self.build_frame(header, payload)\n\
      \n            # Build metadata dictionary with tx_sob and tx_eob tags\n    \
      \        meta = pmt.make_dict()\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      tx_sob\"), pmt.PMT_T)\n            meta = pmt.dict_add(meta, pmt.intern(\"tx_eob\"\
      ), pmt.PMT_T)\n\n            # Explicit offset tags for downstream PDU-to-Tagged-Stream\
      \ conversion\n            sob_tag = pmt.make_tuple(pmt.from_long(0), pmt.intern(\"\
      tx_sob\"), pmt.PMT_T)\n            eob_tag = pmt.make_tuple(pmt.from_long(len(frame)\
      \ - 1), pmt.intern(\"tx_eob\"), pmt.PMT_T)\n            extra_tags = pmt.list2(sob_tag,\
      \ eob_tag)\n            meta = pmt.dict_add(meta, pmt.intern(\"extra_tags\"\
      ), extra_tags)\n\n            vec = pmt.init_u8vector(len(frame), list(frame))\n\
      \            self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(meta, vec))"
    affinity: ''
    alias: ''
    buffer_size: BUFFER_SIZE
    comment: ''
    fec: FEC
    interleave: 'True'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    peer_id: MY_ID
    postamble_byte: '0xFF'
    preamble_byte: '0xFF'
    preamble_len: '128'
    repeat_count: '1'
    samples_per_byte: 8*sps
    train_enable: '1'
  states:
    _io_cache: ('Packet Framer TX (Burst, FEC)', 'PacketFramerTX', [('peer_id', '1'),
      ('preamble_len', '64'), ('repeat_count', '1'), ('max_payload_len', '1024'),
      ('preamble_byte', '255'), ('buffer_size', '2048'), ('postamble_byte', '255'),
      ('train_enable', '1'), ('fec', '15'), ('interleave', '1'), ('samples_per_byte',
      '32')], [('msg_in', 'message', 1)], [('pdu_out', 'message', 1)], '', ['buffer_size',
      'fec', 'interleave', 'max_payload_len', 'peer_id', 'postamble_byte', 'preamble_byte',
      'preamble_len', 'repeat_count', 'samples_per_byte', 'train_enable'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 1980.0]
    rotation: 180
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Test Traffic RX  (receive logger)\n\
      \nConnect:  Packet Deframer RX  pdu_out  ->  pdu_in\n\nEvery frame the deframer\
      \ delivers is written to  <log_dir>/rx_<date>_<time>.csv  with a wall-clock\n\
      timestamp (microseconds), the test run_id / seq when the payload carries the\
      \ test header (A5 5A ...),\nthe deframer's msg_id, and the payload as hex. Non-test\
      \ frames (chat etc.) are logged with is_test = 0.\nOne file per flowgraph start;\
      \ rows are flushed immediately, so the log survives a crash or Ctrl-C.\nPrints\
      \ a running count per test run (received, missing so far, delivery %).\nThe\
      \ deframer only delivers CRC-good frames, so this log holds correct packets\
      \ only; losses are\nfound by the analysis script from the gaps against the TX\
      \ log.\n\"\"\"\nimport csv\nimport datetime\nimport os\nimport socket\nimport\
      \ time\n\nimport pmt\nfrom gnuradio import gr\n\nMAGIC = b\"\\xA5\\x5A\"\nRX_FIELDS\
      \ = [\"rx_time_us\", \"rx_time_iso\", \"is_test\", \"run_id\", \"seq\", \"size\"\
      , \"msg_id\", \"host\", \"payload_hex\"]\n\n\nclass TestTrafficRX(gr.basic_block):\n\
      \    def __init__(self, log_dir=\"~/link_tests\", verbose=1, print_every=10):\n\
      \        gr.basic_block.__init__(self, name=\"Test Traffic RX\", in_sig=None,\
      \ out_sig=None)\n        self.log_dir = str(log_dir)\n        self.verbose =\
      \ int(verbose)\n        self.print_every = max(1, int(print_every))\n      \
      \  self._host = socket.gethostname()\n        self._f = None\n        self._w\
      \ = None\n        self._path = None\n        self._runs = {}            # run_id\
      \ -> {\"seqs\": set, \"max\": int, \"dups\": int}\n        self._n_other = 0\n\
      \n        self.message_port_register_in(pmt.intern(\"pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in\"), self._handle)\n\n    # ----------------------------------------------------------------\
      \ file\n    def start(self):\n        self._open()\n        return True\n\n\
      \    def stop(self):\n        self._summary()\n        if self._f:\n       \
      \     self._f.close()\n            self._f = None\n        return True\n\n \
      \   def _open(self):\n        if self._f:\n            return\n        d = os.path.expanduser(self.log_dir)\n\
      \        os.makedirs(d, exist_ok=True)\n        self._path = os.path.join(d,\
      \ f\"rx_{datetime.datetime.now():%Y%m%d_%H%M%S}.csv\")\n        self._f = open(self._path,\
      \ \"w\", newline=\"\")\n        self._w = csv.writer(self._f)\n        self._w.writerow(RX_FIELDS)\n\
      \        self._f.flush()\n        print(f\"[TEST RX] logging received frames\
      \ to {self._path}\", flush=True)\n\n    # ----------------------------------------------------------------\
      \ messages\n    def _handle(self, msg):\n        t_us = time.time_ns() // 1000\n\
      \        meta = pmt.PMT_NIL\n        try:\n            data = msg\n        \
      \    if pmt.is_pair(msg):\n                meta, data = pmt.car(msg), pmt.cdr(msg)\n\
      \            if pmt.is_u8vector(data):\n                payload = bytes(pmt.u8vector_elements(data))\n\
      \            elif pmt.is_symbol(data):\n                payload = pmt.symbol_to_string(data).encode(\"\
      utf-8\")\n            else:\n                payload = str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        except Exception as e:\n            print(f\"[TEST RX] could\
      \ not parse message: {e!r}\", flush=True)\n            return\n\n        msg_id\
      \ = -1\n        try:\n            if pmt.is_dict(meta):\n                v =\
      \ pmt.dict_ref(meta, pmt.intern(\"msg_id\"), pmt.PMT_NIL)\n                if\
      \ pmt.is_integer(v):\n                    msg_id = pmt.to_long(v)\n        except\
      \ Exception:\n            pass\n\n        is_test = len(payload) >= 8 and payload[:2]\
      \ == MAGIC\n        run_id = int.from_bytes(payload[2:4], \"big\") if is_test\
      \ else -1\n        seq = int.from_bytes(payload[4:8], \"big\") if is_test else\
      \ -1\n\n        self._open()\n        self._w.writerow([t_us,\n            \
      \              datetime.datetime.fromtimestamp(t_us / 1e6).isoformat(timespec=\"\
      milliseconds\"),\n                          int(is_test), run_id, seq, len(payload),\
      \ msg_id, self._host, payload.hex()])\n        self._f.flush()\n\n        if\
      \ not is_test:\n            self._n_other += 1\n            return\n       \
      \ st = self._runs.setdefault(run_id, {\"seqs\": set(), \"max\": -1, \"dups\"\
      : 0})\n        if seq in st[\"seqs\"]:\n            st[\"dups\"] += 1\n    \
      \    st[\"seqs\"].add(seq)\n        st[\"max\"] = max(st[\"max\"], seq)\n  \
      \      n = len(st[\"seqs\"])\n        if self.verbose and (n == 1 or n % self.print_every\
      \ == 0):\n            expected = st[\"max\"] + 1\n            print(f\"[TEST\
      \ RX] run {run_id:04x}: {n} received, last seq {seq}, {expected - n} missing\
      \ so far \"\n                  f\"({100.0 * n / expected:.1f}% of seq 0..{st['max']})\"\
      , flush=True)\n\n    def _summary(self):\n        for run_id, st in self._runs.items():\n\
      \            n, expected = len(st[\"seqs\"]), st[\"max\"] + 1\n            print(f\"\
      [TEST RX] run {run_id:04x} total: {n} received of seq 0..{st['max']} \"\n  \
      \                f\"({100.0 * n / max(expected, 1):.1f}%), {st['dups']} duplicates\"\
      , flush=True)\n        if self._n_other:\n            print(f\"[TEST RX] {self._n_other}\
      \ non-test frames logged\", flush=True)\n        if self._path:\n          \
      \  print(f\"[TEST RX] log: {self._path}\", flush=True)"
    affinity: ''
    alias: ''
    comment: ''
    log_dir: '"~/link_tests"'
    maxoutbuf: '0'
    minoutbuf: '0'
    print_every: '10'
    verbose: '1'
  states:
    _io_cache: ('Test Traffic RX', 'TestTrafficRX', [('log_dir', "'~/link_tests'"),
      ('verbose', '1'), ('print_every', '10')], [('pdu_in', 'message', 1)], [], '',
      ['log_dir', 'print_every', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 2016.0]
    rotation: 0
    state: disabled
- name: epy_block_corr
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Training-word correlator (drop-in\
      \ for digital_corr_est_cc)\n- Input : complex stream at 2 samples/symbol (symbol\
      \ sync output)\n- Output: the same stream delayed by a fixed EVEN number of\
      \ samples (so tags can be placed in the past\n  without shifting the symbol\
      \ / midpoint sample phase)\n- Slides the reference (TRAIN_REF) over the stream\
      \ and computes the NORMALIZED correlation\n      rho = |sum(conj(ref) * x)|^2\
      \ / (E_ref * E_window)      (0..1, independent of signal amplitude)\n  Where\
      \ rho has a local maximum above thr it adds a 'corr_est' tag (and 'corr_start')\
      \ on the\n  first training symbol, shifted by mark_delay samples. Random data\
      \ gives rho ~ 0.1-0.25; a real\n  training word gives ~0.8-1.0, so thr ~ 0.6-0.7\
      \ is a good start. The tag value is rho.\n- Pure numpy, bounds-checked: no use\
      \ of GNU Radio's corr_est_cc.\n\"\"\"\nimport numpy as np\nimport pmt\nfrom\
      \ gnuradio import gr\n\n\nclass TrainCorr(gr.sync_block):\n    def __init__(self,\
      \ ref=None, thr=0.7, mark_delay=0, verbose=1):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Training-word Correlator\",\n       \
      \     in_sig=[np.complex64],\n            out_sig=[np.complex64],\n        )\n\
      \        if ref is None:\n            ref = [1.0]\n        self._ref = np.asarray(ref,\
      \ dtype=np.complex64)\n        self._L = len(self._ref)\n        self._E = float(np.sum(np.abs(self._ref)\
      \ ** 2))\n        self.thr = float(thr)\n        self.mark_delay = max(0, int(mark_delay))\n\
      \        self.verbose = int(verbose)\n        # Output delay: >= L + 3 so every\
      \ peak is examined exactly once, and a MULTIPLE OF 2 (samples per\n        #\
      \ symbol) so the symbol-timed samples stay on even stream indices -- the linear\
      \ equalizer takes\n        # the first sample of every 2-sample block, so an\
      \ odd delay would make it sample the midpoints.\n        self._D = self._L +\
      \ 8\n        self._D += self._D % 2\n        self.set_history(self._D + 1)\n\
      \        self._next_p = 0               # first absolute input index not yet\
      \ examined\n        self._last_p = -10**12         # last tagged absolute input\
      \ index\n        self._seen = 0                 # samples since last status\
      \ line\n        self._best = 0.0               # strongest normalized correlation\
      \ since last status line\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        out = output_items[0]\n        n_out =\
      \ len(out)\n        out[:] = x[:n_out]             # in[i] <-> absolute input\
      \ index a-D+i  ==  output index a+i\n\n        a = self.nitems_written(0)\n\
      \        base = a - self._D             # absolute input index of x[0]\n   \
      \     if len(x) < self._L + 5:\n            return n_out\n        c = np.correlate(x,\
      \ self._ref, \"valid\")                  # window starting at x[n]\n       \
      \ w = np.convolve(np.abs(x).astype(np.float64) ** 2, np.ones(self._L), \"valid\"\
      )\n        m = (np.abs(c).astype(np.float64) ** 2) / (self._E * w + 1e-12) \
      \   # normalized, 0..1\n        self._best = max(self._best, float(m.max()))\n\
      \        self._seen += n_out\n\n        n0 = max(self._next_p - base, 2, -base)\
      \       # first window start to examine (p >= 0)\n        n1 = len(m) - 3  \
      \                             # last start with 2 neighbours on the right\n\
      \        if n1 >= n0:\n            seg = m[n0 - 2 : n1 + 3]\n            mid\
      \ = seg[2:-2]\n            thr_abs = self.thr\n            cond = (\n      \
      \          (mid > thr_abs)\n                & (mid > seg[0:-4]) & (mid > seg[1:-3])\n\
      \                & (mid >= seg[3:-1]) & (mid >= seg[4:])\n            )\n  \
      \          for j in np.flatnonzero(cond):\n                p = base + n0 + int(j)\n\
      \                if p - self._last_p < self._L:\n                    continue\n\
      \                self._last_p = p\n                ratio = float(mid[j])\n \
      \               off = int(p + self._D + self.mark_delay)    # output index;\
      \ always >= a\n                val = pmt.from_double(ratio)\n              \
      \  self.add_item_tag(0, off, pmt.intern(\"corr_start\"), val)\n            \
      \    self.add_item_tag(0, off, pmt.intern(\"corr_est\"), val)\n            \
      \    self._best = 0.0\n                self._seen = 0\n                if self.verbose:\n\
      \                    print(f\"[CORR] train word found: correlation = {ratio:.2f}\
      \ (thr {self.thr:.2f})\", flush=True)\n            self._next_p = base + n1\
      \ + 1\n\n        if self.verbose and self._seen > 400000:\n            if self._best\
      \ > 0.35:\n                print(f\"[CORR] no tag; strongest correlation in\
      \ last window = {self._best:.2f} (thr {self.thr:.2f})\", flush=True)\n     \
      \       self._best = 0.0\n            self._seen = 0\n        return n_out\n"
    affinity: ''
    alias: ''
    comment: Python replacement for digital_corr_est_cc (avoids its out-of-range read).
    mark_delay: train_delay
    maxoutbuf: '0'
    minoutbuf: '0'
    ref: TRAIN_REF
    thr: corr_thr
    verbose: '1'
  states:
    _io_cache: ('Training-word Correlator', 'TrainCorr', [('ref', 'None'), ('thr',
      '0.7'), ('mark_delay', '0'), ('verbose', '1')], [('0', 'complex', 1)], [('0',
      'complex', 1)], '', ['mark_delay', 'thr', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2048, 632.0]
    rotation: 0
    state: enabled
- name: epy_csma
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: CSMA/CA MAC  (carrier sense + slotted\
      \ random backoff, single frequency)\n\nWiring\n  RX  : Pluto Source  -> in0\
      \ (this block) -> out0 -> Power Squelch -> ... (rest of the RX chain)\n  TX\
      \  : Packet Framer TX pdu_out -> pdu_in (this block) ;  pdu_out -> PDU to Tagged\
      \ Stream -> modulator -> Pluto Sink\n  ctrl: optional messages \"fail\"/\"collision\"\
      \ (double the contention window), \"ok\" (reset it), \"flush\" (empty the queue)\n\
      \nCarrier sense (spike-proof)\n  Every nfft samples the block takes an FFT and\
      \ uses the MEDIAN power of the bins inside +/- cs_bw_hz/2\n  (bins within dc_exclude_hz\
      \ of 0 Hz are left out). A data burst raises every in-band bin, so the median\n\
      \  rises; a narrow spike (LO leakage / carrier left after a burst) lifts one\
      \ or two bins and does not move the\n  median. The median is smoothed over sense_s\
      \ and compared with a tracked noise floor:\n      busy  when  cs > floor + cs_margin_db\
      \ ;   idle again when  cs < floor + cs_margin_db - cs_hyst_db\n  The floor is\
      \ the floor_percentile of cs over the last floor_window_s (own transmissions\
      \ excluded); it falls\n  at once but rises at most floor_rise_db_s dB/s, so\
      \ traffic cannot drag it up.\n\nAccess (CSMA/CA, as in 802.11 DCF without ACKs)\n\
      \  Before every frame: draw a backoff of 0 .. cw-1 slots. Slot boundaries are\
      \ counted from the moment the\n  channel went quiet: quiet start + difs_s, +\
      \ slot_s, + 2*slot_s ... Each boundary reached while idle uses up\n  one slot;\
      \ the frame is released at the boundary where the count reaches zero. A busy\
      \ channel freezes the\n  count; after it, DIFS again and the count continues.\
      \ Because both nodes anchor their boundaries on the same\n  burst end, two frames\
      \ only collide if they picked the same boundary. cw starts at cw_min; \"fail\"\
      \ messages\n  on ctrl double it up to cw_max, \"ok\" resets it (wire these from\
      \ the ARQ layer if available).\n\nOwn transmission (half duplex): receiver off\
      \ while we send\n  From the moment a frame is released the receiver is \"off\"\
      : no sensing, no floor update, and (blank_rx = 1)\n  the RX output is zeroed\
      \ so the squelch / AGC / FLL / equalizer / deframer never see our own burst.\n\
      \  gate_mode = 1 (default): the receiver comes back at a fixed time,\n     \
      \   release + tx_delay + airtime + gate_guard_s\n     where tx_delay is the\
      \ TX + RX latency of the radios (tx_delay_s, replaced by the measured echo delay\
      \ once\n     3 own bursts have been seen, if auto_delay = 1). Nothing waits\
      \ for the echo to end.\n  gate_mode = 0: the receiver comes back when our own\
      \ echo has ended (+ tail_s), or after\n     echo_timeout_s + airtime + tail_s\
      \ if no echo is seen.\n  The echo delay = the window in which both nodes can\
      \ still collide; slot_s must be longer than it.\n  The measured value is printed\
      \ in the stats line.\n\nAll timing runs on the RX sample clock (samples / samp_rate),\
      \ not on the PC clock.\nThe stats line also shows how many samples per second\
      \ really arrive from the radio (PC clock). Below ~99 % of\nsamp_rate the PC\
      \ is not keeping up and the radio drops samples: frames then fail CRC although\
      \ the train word is\nfound. It also shows how much of one CPU core this block\
      \ uses.\nRead-out for QT widgets (Function Probe): cs_db(), threshold_db(),\
      \ floor_db(), is_busy(), is_tx(), queue_len()\n\"\"\"\nimport collections\n\
      import threading\nimport time\n\nimport numpy as np\nimport pmt\nfrom gnuradio\
      \ import gr\n\n\nclass CsmaMac(gr.sync_block):\n    def __init__(self, samp_rate=1.5e6,\
      \ samples_per_byte=32, slot_s=0.015, difs_s=0.020,\n                 cw_min=8,\
      \ cw_max=128, cs_margin_db=6.0, cs_hyst_db=2.0, cs_bw_hz=400e3,\n          \
      \       dc_exclude_hz=10e3, nfft=256, sense_s=0.001, floor_window_s=2.0,\n \
      \                floor_percentile=10.0, floor_rise_db_s=1.0, echo_timeout_s=0.100,\
      \ tail_s=0.002,\n                 blank_rx=1, max_queue=64, max_defer_s=0.0,\
      \ verbose=1, stats_every_s=10.0,\n                 gate_mode=1, tx_delay_s=0.009,\
      \ auto_delay=1, gate_guard_s=0.002):\n        gr.sync_block.__init__(self, name=\"\
      CSMA/CA MAC\", in_sig=[np.complex64], out_sig=[np.complex64])\n        self.samp_rate\
      \ = float(samp_rate)\n        self.samples_per_byte = float(samples_per_byte)\n\
      \        self.slot_s = float(slot_s)\n        self.difs_s = float(difs_s)\n\
      \        self.cw_min = max(1, int(cw_min))\n        self.cw_max = max(self.cw_min,\
      \ int(cw_max))\n        self.cs_margin_db = float(cs_margin_db)\n        self.cs_hyst_db\
      \ = float(cs_hyst_db)\n        self.floor_percentile = float(floor_percentile)\n\
      \        self.floor_rise_db_s = float(floor_rise_db_s)\n        self.echo_timeout_s\
      \ = float(echo_timeout_s)\n        self.tail_s = float(tail_s)\n        self.blank_rx\
      \ = int(blank_rx)\n        self.gate_mode = int(gate_mode)\n        self.tx_delay_s\
      \ = float(tx_delay_s)\n        self.auto_delay = int(auto_delay)\n        self.gate_guard_s\
      \ = float(gate_guard_s)\n        self._sense_s = float(sense_s)\n        self.max_queue\
      \ = max(1, int(max_queue))\n        self.max_defer_s = float(max_defer_s)\n\
      \        self.verbose = int(verbose)\n        self.stats_every_s = float(stats_every_s)\n\
      \n        # ---- carrier-sense front end\n        self._nfft = int(nfft)\n \
      \       self._dt = self._nfft / self.samp_rate                          # time\
      \ per FFT block\n        f = np.fft.fftfreq(self._nfft, 1.0 / self.samp_rate)\n\
      \        sel = (np.abs(f) <= float(cs_bw_hz) / 2) & (np.abs(f) >= float(dc_exclude_hz))\n\
      \        self._bins = np.flatnonzero(sel)\n        if self._bins.size < 8:\n\
      \            raise ValueError(\"cs_bw_hz / dc_exclude_hz / nfft leave fewer\
      \ than 8 bins to sense\")\n        self._win = np.hanning(self._nfft).astype(np.float32)\n\
      \        # median of |X|^2 of white noise = ln2 * nfft * mean(w^2) * power \
      \ -> scale to \"white-equivalent\" power\n        self._norm = 1.0 / (np.log(2.0)\
      \ * self._nfft * float(np.mean(self._win ** 2)))\n        self._smooth = collections.deque(maxlen=max(1,\
      \ int(round(float(sense_s) / self._dt))))\n        self._carry = np.zeros(0,\
      \ np.complex64)\n        self._cs_db = -200.0\n        n_hist = max(64, int(float(floor_window_s)\
      \ / self._dt))\n        self._hist = collections.deque(maxlen=n_hist)\n    \
      \    self._floor_db = None\n        self._floor_next = 0.0\n        self._busy\
      \ = True\n\n        # ---- MAC state\n        self._lock = threading.Lock()\n\
      \        self._queue = collections.deque()\n        self._cw = self.cw_min\n\
      \        self._backoff = None\n        self._idle_run = 0.0\n        self._rng\
      \ = np.random.default_rng()\n        self._n_abs = 0                       #\
      \ absolute input sample index of the next new sample\n        self._t = 0.0\
      \                         # current time on the RX sample clock, s\n       \
      \ self._self_tx = False\n        self._tx = {}\n\n        # ---- statistics\n\
      \        self._st = collections.Counter()\n        self._echo_delays = collections.deque(maxlen=200)\n\
      \        self._access_delays = collections.deque(maxlen=200)\n        self._busy_time\
      \ = 0.0\n        self._stat_t0 = 0.0\n        self._warned_no_echo = False\n\
      \        self._wall0 = None                    # PC clock at the start of the\
      \ stats window\n        self._n_wall0 = 0                     # samples received\
      \ before that\n        self._cpu = 0.0                       # seconds spent\
      \ in work() in this stats window\n        self._windows = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self._on_pdu)\n\
      \        self.message_port_register_in(pmt.intern(\"ctrl\"))\n        self.set_msg_handler(pmt.intern(\"\
      ctrl\"), self._on_ctrl)\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n    # ------------------------------------------------------------------\
      \ read-outs (Function Probe)\n    def cs_db(self):\n        return float(self._cs_db)\n\
      \n    def floor_db(self):\n        return float(self._floor_db) if self._floor_db\
      \ is not None else -200.0\n\n    def threshold_db(self):\n        return self.floor_db()\
      \ + self.cs_margin_db\n\n    def is_busy(self):\n        return int(self._busy\
      \ or self._self_tx)\n\n    def is_tx(self):\n        return int(self._self_tx)\n\
      \n    def queue_len(self):\n        return len(self._queue)\n\n    # ------------------------------------------------------------------\
      \ messages\n    def _on_pdu(self, msg):\n        if not pmt.is_pair(msg) or\
      \ not pmt.is_u8vector(pmt.cdr(msg)):\n            print(\"[CSMA] pdu_in expects\
      \ a PDU (meta . u8vector) from the framer; message ignored\", flush=True)\n\
      \            return\n        with self._lock:\n            if len(self._queue)\
      \ >= self.max_queue:\n                self._queue.popleft()\n              \
      \  self._st[\"dropped\"] += 1\n                print(f\"[CSMA] queue full ({self.max_queue}):\
      \ oldest frame dropped\", flush=True)\n            self._queue.append((msg,\
      \ self._t))\n\n    def _on_ctrl(self, msg):\n        try:\n            txt =\
      \ str(pmt.to_python(pmt.car(msg) if pmt.is_pair(msg) else msg)).lower()\n  \
      \      except Exception:\n            txt = \"\"\n        if \"fail\" in txt\
      \ or \"collision\" in txt or \"nack\" in txt:\n            self._cw = min(self.cw_max,\
      \ self._cw * 2)\n        elif \"ok\" in txt or \"success\" in txt or \"ack\"\
      \ in txt:\n            self._cw = self.cw_min\n        elif \"flush\" in txt:\n\
      \            with self._lock:\n                self._queue.clear()\n\n    #\
      \ ------------------------------------------------------------------ carrier\
      \ sense helpers\n    def _update_floor(self):\n        if len(self._hist) <\
      \ self._hist.maxlen // 4:\n            return\n        raw = float(np.percentile(np.fromiter(self._hist,\
      \ float, len(self._hist)), self.floor_percentile))\n        if self._floor_db\
      \ is None or raw <= self._floor_db:\n            self._floor_db = raw\n    \
      \    else:\n            self._floor_db = min(raw, self._floor_db + self.floor_rise_db_s\
      \ * 0.05)\n\n    def _release(self):\n        with self._lock:\n           \
      \ if not self._queue:\n                return\n            msg, t_enq = self._queue.popleft()\n\
      \        nbytes = pmt.length(pmt.cdr(msg))\n        airtime = nbytes * self.samples_per_byte\
      \ / self.samp_rate\n        self.message_port_pub(pmt.intern(\"pdu_out\"), msg)\n\
      \        self._self_tx = True\n        delay = self._tx_delay()\n        self._tx\
      \ = {\"t0\": self._t, \"air\": airtime, \"echo_t\": None, \"low_since\": None,\n\
      \                    \"hard_end\": self._t + self.echo_timeout_s + airtime +\
      \ self.tail_s + 0.02,\n                    \"win_end\": self._t + delay + airtime\
      \ + self.gate_guard_s}\n        self._backoff, self._idle_run = None, 0.0\n\
      \        self._st[\"tx\"] += 1\n        self._access_delays.append(self._t -\
      \ t_enq)\n        if self.verbose >= 2:\n            print(f\"[CSMA] TX {nbytes}\
      \ B frame ({airtime * 1e3:.1f} ms) after {1e3 * (self._t - t_enq):.1f} ms \"\
      \n                  f\"in queue, cw {self._cw}\", flush=True)\n\n    def _tx_delay(self):\n\
      \        \"\"\"TX + RX latency used for the fixed receive-off window: measured\
      \ echo delay if available.\"\"\"\n        if self.auto_delay and len(self._echo_delays)\
      \ >= 3:\n            return float(np.median(self._echo_delays))\n        return\
      \ self.tx_delay_s\n\n    def _end_self_tx(self, reason):\n        self._self_tx\
      \ = False\n        # the channel went quiet when our echo dropped (tail_s ago):\
      \ count idle time from there, so our slot\n        # grid lines up with the\
      \ other node's, which saw the same burst end\n        if reason == \"echo_end\"\
      :\n            self._idle_run = self.tail_s\n        elif reason == \"window\"\
      :\n            # window end = predicted end of our echo + guard; the other node\
      \ notices the end about sense_s\n            # after the echo stops, so start\
      \ our idle count so that both slot grids line up\n            self._idle_run\
      \ = self.gate_guard_s - self._sense_s\n        else:\n            self._idle_run\
      \ = 0.0\n        if reason == \"timeout\" and self._tx.get(\"echo_t\") is None:\n\
      \            self._st[\"no_echo\"] += 1\n            if not self._warned_no_echo:\n\
      \                self._warned_no_echo = True\n                print(\"[CSMA]\
      \ own burst not seen on our receiver: RX blanking falls back to the timer \"\
      \n                      \"(echo_timeout_s + airtime). Check the TX, or raise\
      \ echo_timeout_s.\", flush=True)\n\n    # ------------------------------------------------------------------\
      \ one sense step (nfft samples)\n    def _step(self, cs_db):\n        dt = self._dt\n\
      \        thr_on = (self._floor_db if self._floor_db is not None else 1e9) +\
      \ self.cs_margin_db\n        loud = cs_db > thr_on\n\n        if self._self_tx\
      \ and self.gate_mode == 1:           # fixed receive-off window\n          \
      \  tx = self._tx\n            if tx[\"echo_t\"] is None and loud and self._t\
      \ < tx[\"win_end\"]:\n                tx[\"echo_t\"] = self._t             \
      \         # measure TX + RX latency for auto_delay\n                self._echo_delays.append(self._t\
      \ - tx[\"t0\"])\n            if self._t >= tx[\"win_end\"]:\n              \
      \  if tx[\"echo_t\"] is None:\n                    self._st[\"no_echo\"] +=\
      \ 1\n                self._end_self_tx(\"window\")\n            return\n\n \
      \       if self._self_tx:                                   # gate_mode 0: wait\
      \ until our own echo has ended\n            tx = self._tx\n            if tx[\"\
      echo_t\"] is None:\n                if loud:\n                    tx[\"echo_t\"\
      ] = self._t\n                    self._echo_delays.append(self._t - tx[\"t0\"\
      ])\n                elif self._t - tx[\"t0\"] > self.echo_timeout_s + tx[\"\
      air\"] + self.tail_s:\n                    self._end_self_tx(\"timeout\")\n\
      \                    return\n            else:\n                if loud:\n \
      \                   tx[\"low_since\"] = None\n                elif tx[\"low_since\"\
      ] is None:\n                    tx[\"low_since\"] = self._t\n              \
      \  elif self._t - tx[\"low_since\"] >= self.tail_s:\n                    self._end_self_tx(\"\
      echo_end\")\n                    return\n            if self._t >= tx[\"hard_end\"\
      ]:\n                self._end_self_tx(\"timeout\")\n            return\n\n \
      \       # channel state with hysteresis (busy until the floor is known)\n  \
      \      self._hist.append(cs_db)\n        if self._floor_db is None:\n      \
      \      self._busy = True\n        elif self._busy:\n            self._busy =\
      \ cs_db > thr_on - self.cs_hyst_db\n        else:\n            self._busy =\
      \ loud\n        if self._busy:\n            self._busy_time += dt\n\n      \
      \  with self._lock:\n            pending = len(self._queue)\n            t_head\
      \ = self._queue[0][1] if pending else None\n        if not pending:\n      \
      \      self._idle_run = 0.0 if self._busy else self._idle_run + dt\n       \
      \     return\n\n        if self.max_defer_s > 0 and self._t - t_head > self.max_defer_s\
      \ and self._floor_db is not None:\n            self._st[\"forced\"] += 1\n \
      \           self._release()\n            return\n\n        if self._backoff\
      \ is None:                           # new frame at the head: draw its backoff\n\
      \            self._backoff = int(self._rng.integers(0, self._cw))\n\n      \
      \  if self._busy:\n            if self._idle_run > 0.0:\n                self._st[\"\
      deferrals\"] += 1\n            self._idle_run = 0.0                        \
      \    # countdown frozen; DIFS again after the busy period\n            return\n\
      \n        # Slot boundaries sit at idle_start + difs + m * slot (m = 0, 1, 2\
      \ ...). Both nodes see the same burst end,\n        # so their boundaries coincide\
      \ and only frames released at the SAME boundary can collide.\n        p_prev\
      \ = self._idle_run - self.difs_s\n        self._idle_run += dt\n        p_now\
      \ = self._idle_run - self.difs_s\n        if p_now < 0:\n            return\n\
      \        crossings = int(np.floor(p_now / self.slot_s)) - int(np.floor(p_prev\
      \ / self.slot_s))\n        for _ in range(crossings):\n            if self._backoff\
      \ == 0:\n                self._release()\n                return\n         \
      \   self._backoff -= 1\n\n    # ------------------------------------------------------------------\
      \ stream\n    def work(self, input_items, output_items):\n        t_cpu = time.perf_counter()\n\
      \        if self._wall0 is None:\n            self._wall0, self._n_wall0 = time.monotonic(),\
      \ self._n_abs\n        x = input_items[0]\n        out = output_items[0]\n \
      \       n = len(x)\n        out[:] = x\n\n        first_abs = self._n_abs -\
      \ len(self._carry)           # absolute index of buf[0]\n        buf = np.concatenate((self._carry,\
      \ x)) if len(self._carry) else x\n        nb = len(buf) // self._nfft\n    \
      \    blank = []                                           # (start, stop) absolute\
      \ sample ranges\n        if nb:\n            blocks = buf[:nb * self._nfft].reshape(nb,\
      \ self._nfft) * self._win\n            p = np.abs(np.fft.fft(blocks, axis=1)[:,\
      \ self._bins]) ** 2\n            med = np.median(p, axis=1) * self._norm\n \
      \           for i in range(nb):\n                self._smooth.append(float(med[i]))\
      \                 # sliding mean over sense_s\n                self._cs_db =\
      \ 10.0 * np.log10(max(sum(self._smooth) / len(self._smooth), 1e-20))\n     \
      \           self._t = (first_abs + (i + 1) * self._nfft) / self.samp_rate\n\
      \                was_tx = self._self_tx\n                self._step(self._cs_db)\n\
      \                if self.blank_rx and (was_tx or self._self_tx):\n         \
      \           s = first_abs + i * self._nfft\n                    blank.append((s,\
      \ s + self._nfft))\n                if self._t >= self._floor_next:\n      \
      \              self._floor_next = self._t + 0.05\n                    self._update_floor()\n\
      \        self._carry = buf[nb * self._nfft:].copy()\n        self._n_abs +=\
      \ n\n\n        if self.blank_rx and self._self_tx:                  # samples\
      \ not yet sensed, but already ours\n            blank.append((self._n_abs -\
      \ len(self._carry), self._n_abs))\n        x0 = self._n_abs - n\n        for\
      \ s, e in blank:\n            a, b = max(s, x0) - x0, min(e, self._n_abs) -\
      \ x0\n            if b > a:\n                out[a:b] = 0\n\n        self._cpu\
      \ += time.perf_counter() - t_cpu\n        if self.verbose and self.stats_every_s\
      \ > 0 and self._t - self._stat_t0 >= self.stats_every_s:\n            self._print_stats()\n\
      \        return n\n\n    def _print_stats(self):\n        span = max(1e-9, self._t\
      \ - self._stat_t0)\n        ed = list(self._echo_delays)\n        ad = list(self._access_delays)\n\
      \        echo = (f\"own echo after {1e3 * np.median(ed):.1f} ms (max {1e3 *\
      \ max(ed):.1f}) -> keep slot_s above it\"\n                if ed else \"own\
      \ echo not measured yet\")\n        if self.gate_mode == 1:\n            echo\
      \ += f\" | RX off for {1e3 * self._tx_delay():.1f} ms + airtime + {1e3 * self.gate_guard_s:.1f}\
      \ ms\"\n        floor = f\"{self._floor_db:.1f}\" if self._floor_db is not None\
      \ else \"learning\"\n        print(f\"[CSMA] floor {floor} dB, threshold +{self.cs_margin_db:g}\
      \ dB, now {self._cs_db:.1f} dB, \"\n              f\"busy {100 * self._busy_time\
      \ / span:.1f} % | tx {self._st['tx']}, deferrals {self._st['deferrals']}, \"\
      \n              f\"queue {len(self._queue)}, cw {self._cw}, dropped {self._st['dropped']},\
      \ forced {self._st['forced']}, \"\n              f\"no-echo {self._st['no_echo']}\
      \ | access delay median \"\n              f\"{(1e3 * np.median(ad)) if ad else\
      \ 0:.0f} ms | {echo}\", flush=True)\n        wall = max(1e-9, time.monotonic()\
      \ - self._wall0)\n        rate = (self._n_abs - self._n_wall0) / wall\n    \
      \    share = 100.0 * rate / self.samp_rate\n        print(f\"[CSMA] radio delivers\
      \ {rate / 1e6:.4f} Msps = {share:.1f} % of samp_rate | this block uses \"\n\
      \              f\"{100.0 * self._cpu / wall:.0f} % of one CPU core\", flush=True)\n\
      \        self._windows += 1\n        if self._windows >= 2 and share < 99.0:\n\
      \            print(f\"[CSMA] WARNING: only {share:.1f} % of the samples arrive.\
      \ The PC is not keeping up and the radio \"\n                  f\"drops samples,\
      \ which breaks frames (train word found, CRC fails). Close GUI sinks you do\
      \ not \"\n                  f\"need, run without the GUI, or lower samp_rate.\"\
      , flush=True)\n        self._wall0, self._n_wall0, self._cpu = time.monotonic(),\
      \ self._n_abs, 0.0\n        self._stat_t0 = self._t\n        self._busy_time\
      \ = 0.0\n"
    affinity: ''
    alias: ''
    auto_delay: '1'
    blank_rx: '1'
    comment: 'CSMA/CA. RX off (zeroed) from each release until release + tx_delay
      + airtime + guard. Stats every 10 s: [CSMA] lines, incl. samples/s really received
      and CPU use.'
    cs_bw_hz: 400e3
    cs_hyst_db: '2.0'
    cs_margin_db: cs_margin
    cw_max: '128'
    cw_min: '8'
    dc_exclude_hz: 10e3
    difs_s: '0.020'
    echo_timeout_s: '0.100'
    floor_percentile: '10.0'

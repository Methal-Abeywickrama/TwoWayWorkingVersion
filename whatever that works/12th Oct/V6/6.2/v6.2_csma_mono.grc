- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Test Traffic TX  (packet generator\
      \ + TX log)\n\nConnect:  msg_out  ->  Packet Framer TX  msg_in      (the QT\
      \ message edit box can stay connected too)\n\nSends test packets following a\
      \ test plan and writes one CSV row per packet (wall-clock timestamp\nand the\
      \ exact payload) to  <log_dir>/tx_<date>_<time>_run<id>.csv\n\ntest_plan (string):\
      \  \"SIZExCOUNT@INTERVAL; SIZExCOUNT@INTERVAL; ...\"\n    \"20x50@0.5; 200x50@0.5;\
      \ 1000x50@1; 2000x30@1.5\"\n    SIZE      payload bytes, including the 8-byte\
      \ test header (min 8, max max_payload_len)\n    COUNT     packets in this set\n\
      \    INTERVAL  seconds between packet starts; \"ms\" suffix allowed: 100x50@250ms\n\
      \    optional set names:  \"short:20x50@0.5; long:2000x30@1.5\"\n  A Python\
      \ list also works:  [(20, 50, 0.5), (200, 50, 0.5, \"medium\")]\n\nPayload =\
      \ [A5 5A][run_id: 2 B][seq: 4 B][fill]\n    payload_mode \"ascii\"  : readable\
      \ text (default; keeps the framer/deframer console prints clean)\n         \
      \        \"random\" : reproducible pseudo-random bytes (most representative\
      \ for the PHY)\n                 \"fixed\"  : fill_byte repeated\nThe RX logger\
      \ and analyze_link.py match packets by (run_id, seq).\n\nA run starts start_delay\
      \ seconds after the flowgraph starts (autostart=1), or whenever any message\n\
      arrives on the ctrl port (e.g. a QT GUI Msg Push Button). A ctrl message containing\
      \ \"stop\" ends the run.\nEach run gets a new random run_id and its own log\
      \ file.\nTimestamps are wall-clock (time.time) in microseconds; keep both PCs\
      \ NTP-synced for one-way latency.\nNote: the timestamp is when the packet is\
      \ handed to the framer, not when it is on air. If the interval\nis shorter than\
      \ the airtime, packets queue in the TX chain and the measured latency grows.\n\
      \"\"\"\nimport csv\nimport datetime\nimport os\nimport re\nimport socket\nimport\
      \ threading\nimport time\n\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\nMAGIC = b\"\\xA5\\x5A\"\nTEST_HDR_LEN = 8                       # magic(2)\
      \ + run_id(2) + seq(4)\nASCII_TEXT = b\"The quick brown fox jumps over the lazy\
      \ dog 0123456789. \"\nTX_FIELDS = [\"run_id\", \"seq\", \"loop\", \"set_idx\"\
      , \"set_name\", \"size\", \"interval_s\",\n             \"tx_time_us\", \"tx_time_iso\"\
      , \"late_ms\", \"host\", \"payload_mode\", \"payload_hex\"]\n\n\ndef parse_plan(plan):\n\
      \    \"\"\"Returns [(name, size, count, interval_s), ...] from a plan string\
      \ or list.\"\"\"\n    entries = []\n    if isinstance(plan, str):\n        items\
      \ = [s.strip() for s in re.split(r\"[;\\n]\", plan) if s.strip()]\n        for\
      \ i, item in enumerate(items):\n            name = None\n            if \":\"\
      \ in item:\n                name, item = item.split(\":\", 1)\n            \
      \    name = name.strip() or None\n            m = re.fullmatch(r\"\\s*(\\d+)\\\
      s*[xX*]\\s*(\\d+)\\s*@\\s*([0-9]*\\.?[0-9]+)\\s*(ms|s)?\\s*\", item)\n     \
      \       if not m:\n                raise ValueError(f\"test_plan entry '{item}':\
      \ use SIZExCOUNT@INTERVAL, e.g. 100x50@0.5\")\n            size, count, iv =\
      \ int(m.group(1)), int(m.group(2)), float(m.group(3))\n            if m.group(4)\
      \ == \"ms\":\n                iv /= 1000.0\n            entries.append((name\
      \ or f\"set{i}_{size}B\", size, count, iv))\n    else:\n        for i, e in\
      \ enumerate(plan):\n            if isinstance(e, dict):\n                size,\
      \ count, iv, name = int(e[\"size\"]), int(e[\"count\"]), float(e[\"interval\"\
      ]), e.get(\"name\")\n            else:\n                size, count, iv = int(e[0]),\
      \ int(e[1]), float(e[2])\n                name = str(e[3]) if len(e) > 3 else\
      \ None\n            entries.append((name or f\"set{i}_{size}B\", size, count,\
      \ iv))\n    return entries\n\n\nclass TestTrafficTX(gr.basic_block):\n    def\
      \ __init__(self, test_plan=\"20x50@0.5; 200x50@0.5; 1000x50@1.0\", repeat_plan=1,\n\
      \                 start_delay=5.0, set_gap=2.0, payload_mode=\"ascii\", fill_byte=0x55,\n\
      \                 max_payload_len=2048, log_dir=\"~/link_tests\", autostart=1):\n\
      \        gr.basic_block.__init__(self, name=\"Test Traffic TX\", in_sig=None,\
      \ out_sig=None)\n        self.test_plan = test_plan\n        self.repeat_plan\
      \ = max(1, int(repeat_plan))\n        self.start_delay = max(0.0, float(start_delay))\n\
      \        self.set_gap = max(0.0, float(set_gap))\n        self.payload_mode\
      \ = str(payload_mode).lower()\n        self.fill_byte = int(fill_byte) & 0xFF\n\
      \        self.max_payload_len = int(max_payload_len)\n        self.log_dir =\
      \ str(log_dir)\n        self.autostart = int(autostart)\n        if self.payload_mode\
      \ not in (\"ascii\", \"random\", \"fixed\"):\n            raise ValueError(\"\
      payload_mode must be 'ascii', 'random' or 'fixed'\")\n        self._plan = self._checked_plan(test_plan)\
      \       # a bad plan raises here -> visible in GRC\n        self._host = socket.gethostname()\n\
      \        self._thread = None\n        self._stop_evt = threading.Event()\n \
      \       self._lock = threading.Lock()\n\n        self._port_out = pmt.intern(\"\
      msg_out\")\n        self.message_port_register_out(self._port_out)\n       \
      \ self.message_port_register_in(pmt.intern(\"ctrl\"))\n        self.set_msg_handler(pmt.intern(\"\
      ctrl\"), self._handle_ctrl)\n\n    # ----------------------------------------------------------------\
      \ plan\n    def _checked_plan(self, plan):\n        out = []\n        for name,\
      \ size, count, iv in parse_plan(plan):\n            s = max(size, TEST_HDR_LEN)\n\
      \            if self.max_payload_len > 0:\n                s = min(s, self.max_payload_len)\n\
      \            if s != size:\n                print(f\"[TEST TX] set '{name}':\
      \ size {size} B -> {s} B \"\n                      f\"(min {TEST_HDR_LEN}, max\
      \ {self.max_payload_len})\", flush=True)\n            if count <= 0 or iv <\
      \ 0:\n                raise ValueError(f\"set '{name}': count must be > 0 and\
      \ interval >= 0\")\n            out.append((name, s, count, iv))\n        if\
      \ not out:\n            raise ValueError(\"test_plan is empty\")\n        return\
      \ out\n\n    # ----------------------------------------------------------------\
      \ run control\n    def start(self):\n        if self.autostart:\n          \
      \  self._launch(self.start_delay)\n        return True\n\n    def stop(self):\n\
      \        self._halt()\n        return True\n\n    def _launch(self, delay):\n\
      \        with self._lock:\n            self._halt_locked()\n            self._stop_evt\
      \ = threading.Event()\n            self._thread = threading.Thread(target=self._run_safe,\
      \ args=(delay, self._stop_evt), daemon=True)\n            self._thread.start()\n\
      \n    def _halt(self):\n        with self._lock:\n            return self._halt_locked()\n\
      \n    def _halt_locked(self):\n        running = self._thread is not None and\
      \ self._thread.is_alive()\n        if running:\n            self._stop_evt.set()\n\
      \            self._thread.join(timeout=3.0)\n        self._thread = None\n \
      \       return running\n\n    def _handle_ctrl(self, msg):\n        try:\n \
      \           if pmt.is_pair(msg):\n                txt = f\"{pmt.to_python(pmt.car(msg))}\
      \ {pmt.to_python(pmt.cdr(msg))}\"\n            else:\n                txt =\
      \ str(pmt.to_python(msg))\n        except Exception:\n            txt = \"\"\
      \n        if \"stop\" in txt.lower():\n            if self._halt():\n      \
      \          print(\"[TEST TX] run stopped by ctrl message\", flush=True)\n  \
      \      else:\n            print(\"[TEST TX] new run requested by ctrl message\"\
      , flush=True)\n            self._launch(0.0)\n\n    # ----------------------------------------------------------------\
      \ payload\n    def _make_payload(self, run_id, seq, size):\n        hdr = MAGIC\
      \ + run_id.to_bytes(2, \"big\") + (seq & 0xFFFFFFFF).to_bytes(4, \"big\")\n\
      \        n = size - len(hdr)\n        if n <= 0:\n            return hdr\n \
      \       if self.payload_mode == \"random\":\n            rng = np.random.default_rng((run_id\
      \ << 32) | seq)\n            fill = rng.integers(0, 256, n, dtype=np.uint8).tobytes()\n\
      \        elif self.payload_mode == \"ascii\":\n            base = b\"#%07d \"\
      \ % seq + ASCII_TEXT\n            fill = (base * (n // len(base) + 1))[:n]\n\
      \        else:\n            fill = bytes([self.fill_byte]) * n\n        return\
      \ hdr + fill\n\n    # ----------------------------------------------------------------\
      \ worker thread\n    def _run_safe(self, delay, stop_evt):\n        try:\n \
      \           self._run(delay, stop_evt)\n        except Exception as e:     \
      \                 # never die silently in a thread\n            print(f\"[TEST\
      \ TX] ERROR: {e!r}\", flush=True)\n\n    def _run(self, delay, stop_evt):\n\
      \        if stop_evt.wait(delay):\n            return\n        run_id = int.from_bytes(os.urandom(2),\
      \ \"big\")\n        d = os.path.expanduser(self.log_dir)\n        os.makedirs(d,\
      \ exist_ok=True)\n        path = os.path.join(d, f\"tx_{datetime.datetime.now():%Y%m%d_%H%M%S}_run{run_id:04x}.csv\"\
      )\n        total = sum(c for _, _, c, _ in self._plan) * self.repeat_plan\n\
      \        print(f\"[TEST TX] run {run_id:04x}: {len(self._plan)} sets x {self.repeat_plan}\
      \ loop(s), \"\n              f\"{total} packets, log -> {path}\", flush=True)\n\
      \n        seq, max_late, n_late = 0, 0.0, 0\n        with open(path, \"w\",\
      \ newline=\"\") as f:\n            w = csv.writer(f)\n            w.writerow(TX_FIELDS)\n\
      \            f.flush()\n            for loop in range(self.repeat_plan):\n \
      \               for set_idx, (name, size, count, iv) in enumerate(self._plan):\n\
      \                    print(f\"[TEST TX] run {run_id:04x} loop {loop + 1}/{self.repeat_plan}\
      \ set {set_idx + 1}/\"\n                          f\"{len(self._plan)} '{name}':\
      \ {count} x {size} B every {iv:g} s\", flush=True)\n                    t_next\
      \ = time.monotonic()\n                    for _ in range(count):\n         \
      \               wait = t_next - time.monotonic()\n                        if\
      \ wait > 0 and stop_evt.wait(wait):\n                            print(f\"[TEST\
      \ TX] run {run_id:04x} stopped after {seq} packets\", flush=True)\n        \
      \                    return\n                        late = max(0.0, -wait)\n\
      \                        max_late = max(max_late, late)\n                  \
      \      if iv > 0 and late > 0.1 * iv:\n                            n_late +=\
      \ 1\n                        payload = self._make_payload(run_id, seq, size)\n\
      \                        t_us = time.time_ns() // 1000\n                   \
      \     self.message_port_pub(self._port_out,\n                              \
      \                pmt.cons(pmt.make_dict(),\n                               \
      \                        pmt.init_u8vector(len(payload), list(payload))))\n\
      \                        w.writerow([run_id, seq, loop, set_idx, name, size,\
      \ iv, t_us,\n                                    datetime.datetime.fromtimestamp(t_us\
      \ / 1e6).isoformat(timespec=\"milliseconds\"),\n                           \
      \         f\"{late * 1000:.2f}\", self._host, self.payload_mode, payload.hex()])\n\
      \                        f.flush()\n                        seq += 1\n     \
      \                   t_next += iv\n                    if self.set_gap > 0 and\
      \ stop_evt.wait(self.set_gap):\n                        print(f\"[TEST TX] run\
      \ {run_id:04x} stopped after {seq} packets\", flush=True)\n                \
      \        return\n        msg = f\"[TEST TX] run {run_id:04x} DONE: {seq} packets\
      \ sent, max scheduling lateness {max_late * 1000:.1f} ms\"\n        if n_late:\n\
      \            msg += f\" ({n_late} packets >10% of their interval late: this\
      \ PC cannot keep that rate)\"\n        print(msg, flush=True)"
    affinity: ''
    alias: ''
    autostart: '1'
    comment: ''
    fill_byte: '"FF"'
    log_dir: '"~/link_tests"'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    payload_mode: '"ascii"'
    repeat_plan: '1'
    set_gap: '2'
    start_delay: '5'
    test_plan: '"20x50@0.5; 200x50@0.5; 1000x50@1.0"'
  states:
    _io_cache: ('Test Traffic TX', 'TestTrafficTX', [('test_plan', "'20x50@0.5; 200x50@0.5;
      1000x50@1.0'"), ('repeat_plan', '1'), ('start_delay', '5.0'), ('set_gap', '2.0'),
      ('payload_mode', "'ascii'"), ('fill_byte', '85'), ('max_payload_len', '2048'),
      ('log_dir', "'~/link_tests'"), ('autostart', '1')], [('ctrl', 'message', 1)],
      [('msg_out', 'message', 1)], '', ['autostart', 'fill_byte', 'log_dir', 'max_payload_len',
      'payload_mode', 'repeat_plan', 'set_gap', 'start_delay', 'test_plan'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 2000.0]
    rotation: 180
    state: disabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX (with equalizer\
      \ training word)\n- Outputs packed byte PDUs directly to pdu_pdu_to_tagged_stream\n\
      - Zero idle transmission between bursts\n- Frame layout: [preamble] [train word:\
      \ F8 DD 42 58] [1A CF FC 1D] [len: 2B][dest_id: 1B][msg_id: 1B][rep: 1B][n_reps:\
      \ 1B] [payload] [CRC32: 4B] [postamble]\n- The train word is known to the RX:\
      \ the correlator (digital_corr_est_cc) finds it, tags it,\n  and the linear\
      \ equalizer trains on it. The deframer does not look at it (it only looks for\
      \ the sync word).\n- Postamble dynamically padded so total size is a multiple\
      \ of buffer_size\n- Attaches tx_sob (Start of Burst) and tx_eob (End of Burst)\
      \ metadata tags\n\"\"\"\nimport zlib\nimport pmt\nfrom gnuradio import gr\n\n\
      SYNC_WORD = bytes([0x1A, 0xCF, 0xFC, 0x1D])\n# 31-bit m-sequence + 1 pad bit.\
      \ MUST match TRAIN_BITS in the flowgraph (RX side).\nTRAIN_WORD = bytes([0xF8,\
      \ 0xDD, 0x42, 0x58])\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(\n\
      \        self,\n        peer_id=1,\n        preamble_len=64,\n        repeat_count=5,\n\
      \        max_payload_len=1024,\n        preamble_byte=0xFF,\n        buffer_size=512,\n\
      \        postamble_byte=0x00,\n        train_enable=1,\n    ):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"Packet Framer TX (Burst)\",\n       \
      \     in_sig=None,\n            out_sig=None,\n        )\n        self.peer_id\
      \ = int(peer_id) & 0xFF\n        self.preamble_len = int(preamble_len)\n   \
      \     self.repeat_count = int(repeat_count)\n        self.max_payload_len =\
      \ int(max_payload_len)\n        self.preamble_byte = int(preamble_byte) & 0xFF\n\
      \        self.buffer_size = int(buffer_size)\n        self.postamble_byte =\
      \ int(postamble_byte) & 0xFF\n        self.train_enable = int(train_enable)\n\
      \        self._msg_id = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      msg_in\"))\n        self.set_msg_handler(pmt.intern(\"msg_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    @staticmethod\n\
      \    def _extract_payload(msg):\n        if pmt.is_pair(msg):\n            data\
      \ = pmt.cdr(msg)\n            if pmt.is_u8vector(data):\n                return\
      \ bytes(pmt.u8vector_elements(data))\n            return str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        if pmt.is_symbol(msg):\n            return pmt.symbol_to_string(msg).encode(\"\
      utf-8\")\n        val = pmt.to_python(msg)\n        if isinstance(val, (bytes,\
      \ bytearray)):\n            return bytes(val)\n        return str(val).encode(\"\
      utf-8\")\n\n    def handle_msg(self, msg):\n        try:\n            payload\
      \ = self._extract_payload(msg)\n        except Exception as e:\n           \
      \ print(f\"[TX] Could not parse message: {e}\", flush=True)\n            return\n\
      \n        if not payload:\n            return\n\n        if len(payload) > self.max_payload_len:\n\
      \            print(f\"[TX] Payload {len(payload)} B truncated to {self.max_payload_len}\
      \ B\", flush=True)\n            payload = payload[: self.max_payload_len]\n\n\
      \        msg_id = self._msg_id\n        self._msg_id = (self._msg_id + 1) &\
      \ 0xFF\n        n_reps = max(1, min(255, self.repeat_count))\n\n        preamble\
      \ = bytes([self.preamble_byte]) * self.preamble_len\n        train = TRAIN_WORD\
      \ if self.train_enable else b\"\"\n        print(\n            f\"[TX] msg #{msg_id}\
      \ (to peer {self.peer_id}): '{payload.decode('utf-8', 'replace')}' ({n_reps}\
      \ bursts queued)\",\n            flush=True,\n        )\n\n        for rep in\
      \ range(n_reps):\n            header = len(payload).to_bytes(2, \"big\") + bytes([self.peer_id,\
      \ msg_id, rep, n_reps])\n            crc = zlib.crc32(header + payload).to_bytes(4,\
      \ \"big\")\n\n            # Core frame structure before buffer alignment\n \
      \           raw_frame = preamble + train + SYNC_WORD + header + payload + crc\n\
      \n            # Calculate postamble padding required to match buffer_size multiple\n\
      \            if self.buffer_size > 0:\n                rem = len(raw_frame)\
      \ % self.buffer_size\n                pad_len = (self.buffer_size - rem) % self.buffer_size\n\
      \            else:\n                pad_len = 0\n\n            postamble = bytes([self.postamble_byte])\
      \ * pad_len\n            frame = raw_frame + postamble\n\n            # Build\
      \ metadata dictionary with tx_sob and tx_eob tags\n            meta = pmt.make_dict()\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"tx_sob\"), pmt.PMT_T)\n\
      \            meta = pmt.dict_add(meta, pmt.intern(\"tx_eob\"), pmt.PMT_T)\n\n\
      \            # Explicit offset tags for downstream PDU-to-Tagged-Stream conversion\n\
      \            sob_tag = pmt.make_tuple(pmt.from_long(0), pmt.intern(\"tx_sob\"\
      ), pmt.PMT_T)\n            eob_tag = pmt.make_tuple(pmt.from_long(len(frame)\
      \ - 1), pmt.intern(\"tx_eob\"), pmt.PMT_T)\n            extra_tags = pmt.list2(sob_tag,\
      \ eob_tag)\n            meta = pmt.dict_add(meta, pmt.intern(\"extra_tags\"\
      ), extra_tags)\n\n            vec = pmt.init_u8vector(len(frame), list(frame))\n\
      \            self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(meta, vec))\n"
    affinity: ''
    alias: ''
    buffer_size: BUFFER_SIZE
    comment: ''
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    peer_id: '1'
    postamble_byte: '0xFF'
    preamble_byte: '0xFF'
    preamble_len: '128'
    repeat_count: '1'
    train_enable: '1'
  states:
    _io_cache: ('Packet Framer TX (Burst)', 'PacketFramerTX', [('peer_id', '1'), ('preamble_len',

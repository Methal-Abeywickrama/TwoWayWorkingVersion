- name: epy_block_0_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Fast Burst Packet Deframer RX (Hamming\
      \ FEC) - v6.2, with stage diagnostics\n- Vectorized NumPy sliding-window sync\
      \ detection; positive correlation only (diff decoder resolves 180 deg)\n- fec\
      \ = 0 / 15 / 31 and interleave must match the TX framer\n- Hamming decode: header\
      \ section first (gives the length), then payload+CRC section; CRC32 over header+payload\n\
      - Sender filter: delivers only frames whose ID byte (written by the sender's\
      \ framer as its MY_ID) == peer_id\n- Repeat filter: a frame is a repeat only\
      \ if it has the same (sender, msg_id) as the last message, a burst\n  number\
      \ not seen yet, and arrives within dup_window_s. A restarted sender (msg_id\
      \ back to 0) is shown again.\n\nDiagnostics (debug = 1), at most max_dbg_lines\
      \ lines per second:\n  [RX dbg] train word ...  for every 'corr_est' tag (the\
      \ correlator found the train word), once the bits behind it\n              \
      \             have arrived: bit errors in the train word and in the sync word\
      \ right after it, counted\n                           on the decoded bits (after\
      \ equalizer, Costas, slicer, diff decoder, i.e. what this block\n          \
      \                 gets). The deframer locks only if the sync word has <= max_bit_errors\
      \ errors.\n  [RX dbg] frame ...       for every sync word this block locks on:\
      \ header length, CRC result, bits fixed by the\n                           FEC,\
      \ squelch closures inside the frame ('squelch_eob' tags: the power squelch with\n\
      \                           gate = True dropped samples there), sender ID and\
      \ what happened to the frame.\n  [RX stats] ...           every stats_every_s\
      \ while there is traffic: counters for each stage.\nown_id is only used in the\
      \ messages (this node's MY_ID, i.e. the ID its own frames carry).\n\"\"\"\n\
      import time\nimport zlib\nimport numpy as np\nimport pmt\nfrom gnuradio import\
      \ gr\n\nSYNC_WORD = bytes([0x1A, 0xCF, 0xFC, 0x1D])\nTRAIN_WORD = bytes([0xF8,\
      \ 0xDD, 0x42, 0x58])     # must match the framer / TRAIN_BITS\nHDR_BYTES = 6\
      \  # len (2B) + sender/dest id (1B) + msg_id (1B) + rep (1B) + n_reps (1B)\n\
      HIST_BITS = 1 << 16\n\n\ndef hamming_tables(n):\n    \"\"\"Standard positional\
      \ Hamming layout: parity bits at positions 1, 2, 4, 8, (16).\"\"\"\n    m =\
      \ {15: 4, 31: 5}[n]\n    pos = np.arange(1, n + 1)\n    is_parity = (pos & (pos\
      \ - 1)) == 0\n    data_idx = np.flatnonzero(~is_parity)\n    H = ((pos[None,\
      \ :] >> np.arange(m)[:, None]) & 1).astype(np.int32)   # m x n, column j = bin(j)\n\
      \    weights = (1 << np.arange(m)).astype(np.int32)\n    return data_idx, H,\
      \ weights\n\n\ndef hamming_decode_bits(coded, n, nblk, interleave):\n    \"\"\
      \"coded: nblk*n bits. Returns (data bits nblk*k, number of corrected bits).\"\
      \"\"\n    data_idx, H, weights = hamming_tables(n)\n    c = np.asarray(coded,\
      \ dtype=np.int32)\n    cw = c.reshape(n, nblk).T.copy() if interleave else c.reshape(nblk,\
      \ n).copy()\n    S = ((cw @ H.T) & 1) @ weights          # syndrome = error\
      \ position (1..n), 0 = no error\n    bad = np.flatnonzero(S)\n    cw[bad, S[bad]\
      \ - 1] ^= 1                # flip bit at position S\n    return cw[:, data_idx].reshape(-1).astype(np.uint8),\
      \ int(bad.size)\n\n\ndef _pm(b):\n    return np.unpackbits(np.frombuffer(b,\
      \ np.uint8)).astype(np.int16) * 2 - 1\n\n\nclass PacketDeframerRX(gr.sync_block):\n\
      \    def __init__(self, peer_id=1, max_bit_errors=2, max_payload_len=1024, bit_rate=375000,\n\
      \                 fec=15, interleave=True, own_id=-1, debug=1, max_dbg_lines=20,\
      \ stats_every_s=10.0,\n                 dup_window_s=2.0):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Packet Deframer RX (Fast Burst, Hamming,\
      \ diag)\",\n            in_sig=[np.uint8],\n            out_sig=None,\n    \
      \    )\n        self.peer_id = int(peer_id) & 0xFF\n        self.own_id = int(own_id)\n\
      \        self.max_bit_errors = int(max_bit_errors)\n        self.max_payload_len\
      \ = int(max_payload_len)\n        self.bit_rate = float(bit_rate)\n        self.fec\
      \ = int(fec)\n        self.interleave = bool(interleave)\n        self.debug\
      \ = int(debug)\n        self.max_dbg_lines = max(1, int(max_dbg_lines))\n  \
      \      self.stats_every_s = float(stats_every_s)\n        self.dup_window_s\
      \ = float(dup_window_s)\n        if self.fec not in (0, 15, 31):\n         \
      \   raise ValueError(\"fec must be 0, 15 or 31\")\n\n        self._sync = _pm(SYNC_WORD)\n\
      \        self._train = _pm(TRAIN_WORD)\n        self._buf = np.zeros(0, dtype=np.uint8)\n\
      \        self._buf_abs = 0                     # absolute input index of self._buf[0]\n\
      \n        # decoded-bit history for the train-word check\n        self._hist\
      \ = np.zeros(0, dtype=np.uint8)\n        self._hist_abs = 0\n        self._train_pending\
      \ = []              # [(abs offset, rho)]\n        self._train_seen = []   \
      \              # [(abs index where the sync word should start, rho, terr, serr)]\n\
      \        self._eobs = []                       # abs offsets of squelch_eob\
      \ tags (recent)\n\n        self.n_sync = 0\n        self.n_ok = 0\n        self.n_crc_fail\
      \ = 0\n        self.n_bad_len = 0\n        self.n_fec_corrected = 0\n      \
      \  self._c = dict.fromkeys((\"train\", \"train_clean\", \"train_bad_sync\",\
      \ \"train_garbage\", \"lock\", \"bad_len\",\n                              \
      \   \"crc_fail\", \"crc_fail_cut\", \"ok\", \"wrong_id\", \"delivered\", \"\
      repeat\", \"sq_eob\"), 0)\n        self._c_last = dict(self._c)\n        self._t_stats\
      \ = time.monotonic()\n        self._dbg_t = 0.0\n        self._dbg_n = 0\n \
      \       self._dbg_dropped = 0\n        self._warned_id = False\n\n        self._bits_total\
      \ = 0\n        self._bits_at_last_ok = 0\n        self._cur_id = None\n    \
      \    self._cur_reps = set()\n        self._cur_nreps = 0\n        self._cur_corr\
      \ = 0\n        self._last = None                     # {\"key\": (sender, msg_id),\
      \ \"reps\": set, \"t\": time}\n\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n        self.message_port_register_out(pmt.intern(\"text_out\"\
      ))\n\n    # ---------- start / stop ----------\n    def start(self):\n     \
      \   own = f\"MY_ID {self.own_id}\" if self.own_id >= 0 else \"this node\"\n\
      \        print(f\"[RX] {own}: delivers frames sent by ID {self.peer_id} only\
      \ \"\n              f\"(FEC {self.fec or 'off'}, sync word may have <= {self.max_bit_errors}\
      \ bit errors)\", flush=True)\n        if self.own_id == self.peer_id:\n    \
      \        print(f\"[RX] WARNING: own_id == peer_id ({self.peer_id}). This node\
      \ would accept its own frames; \"\n                  f\"check MY_ID / peer_id.\"\
      , flush=True)\n        return True\n\n    def stop(self):\n        self._flush_summary()\n\
      \        if self.debug:\n            self._print_stats(final=True)\n       \
      \ return True\n\n    # ---------- debug output ----------\n    def _dbg(self,\
      \ line):\n        if not self.debug:\n            return\n        now = time.monotonic()\n\
      \        if now - self._dbg_t >= 1.0:\n            self._dbg_t, self._dbg_n\
      \ = now, 0\n        if self._dbg_n >= self.max_dbg_lines:\n            self._dbg_dropped\
      \ += 1\n            return\n        self._dbg_n += 1\n        if self._dbg_dropped:\n\
      \            print(f\"[RX dbg] ({self._dbg_dropped} lines not shown: more than\
      \ {self.max_dbg_lines}/s)\", flush=True)\n            self._dbg_dropped = 0\n\
      \        print(f\"[RX dbg] {line}\", flush=True)\n\n    def _print_stats(self,\
      \ final=False):\n        c, l = self._c, self._c_last\n        d = {k: c[k]\
      \ - l[k] for k in c} if not final else c\n        if not final and not any(d.values()):\n\
      \            return\n        span = \"total\" if final else f\"last {self.stats_every_s:g}\
      \ s\"\n        print(f\"[RX stats] {span}: train words {d['train']} (clean {d['train_clean']},\
      \ sync word broken \"\n              f\"{d['train_bad_sync']}, no train word\
      \ in the bits {d['train_garbage']}) | sync locks {d['lock']} | \"\n        \
      \      f\"bad length {d['bad_len']} | CRC fail {d['crc_fail']} (squelch closed\
      \ inside {d['crc_fail_cut']}) | \"\n              f\"CRC ok {d['ok']}: wrong\
      \ sender ID {d['wrong_id']}, delivered {d['delivered']}, repeats {d['repeat']}\
      \ | \"\n              f\"squelch closures {d['sq_eob']}\", flush=True)\n   \
      \     self._c_last = dict(c)\n\n    # ---------- section sizes (in channel bits)\
      \ ----------\n    def _coded_len(self, n_bytes):\n        if self.fec == 0:\n\
      \            return n_bytes * 8, 0\n        nblk = -(-(n_bytes * 8) // {15:\
      \ 11, 31: 26}[self.fec])\n        return nblk * self.fec, nblk\n\n    def _decode_section(self,\
      \ coded, n_bytes, nblk):\n        if self.fec == 0:\n            return np.packbits(coded).tobytes(),\
      \ 0\n        bits, corr = hamming_decode_bits(coded, self.fec, nblk, self.interleave)\n\
      \        return np.packbits(bits[:n_bytes * 8]).tobytes(), corr\n\n    # ----------\
      \ statistics / delivery ----------\n    def _flush_summary(self):\n        if\
      \ self._cur_id is not None:\n            got, n = len(self._cur_reps), self._cur_nreps\n\
      \            loss = 100.0 * (n - got) / max(n, 1)\n            fec_txt = f\"\
      , FEC corrected {self._cur_corr} bits\" if self.fec else \"\"\n            print(f\"\
      [RX] msg #{self._cur_id}: {got}/{n} bursts OK (Loss: {loss:.0f}%){fec_txt}\"\
      , flush=True)\n        self._cur_id = None\n        self._cur_reps = set()\n\
      \        self._cur_corr = 0\n\n    def _deliver(self, header, payload, corrected):\n\
      \        \"\"\"Returns 'delivered' or 'repeat'.\"\"\"\n        sender, msg_id,\
      \ rep, n_reps = header[2], header[3], header[4], header[5]\n        now = time.monotonic()\n\
      \        last = self._last\n        repeat = (last is not None and last[\"key\"\
      ] == (sender, msg_id) and rep not in last[\"reps\"]\n                  and now\
      \ - last[\"t\"] <= self.dup_window_s)\n        self._bits_at_last_ok = self._bits_total\n\
      \        if repeat:\n            last[\"reps\"].add(rep)\n            last[\"\
      t\"] = now\n            if rep not in self._cur_reps:\n                self._cur_corr\
      \ += corrected\n            self._cur_reps.add(rep)\n            return \"repeat\"\
      \n\n        self._flush_summary()\n        self._last = {\"key\": (sender, msg_id),\
      \ \"reps\": {rep}, \"t\": now}\n        self._cur_id, self._cur_nreps, self._cur_reps,\
      \ self._cur_corr = msg_id, n_reps, {rep}, corrected\n        text = payload.decode(\"\
      utf-8\", errors=\"replace\")\n        print(\"\\n\" + \"=\" * 40, flush=True)\n\
      \        print(f\"[RX RECEIVED] #{msg_id}: {text}\", flush=True)\n        print(\"\
      =\" * 40 + \"\\n\", flush=True)\n\n        meta = pmt.make_dict()\n        meta\
      \ = pmt.dict_add(meta, pmt.intern(\"dest_id\"), pmt.from_long(sender))\n   \
      \     meta = pmt.dict_add(meta, pmt.intern(\"msg_id\"), pmt.from_long(msg_id))\n\
      \        meta = pmt.dict_add(meta, pmt.intern(\"n_reps\"), pmt.from_long(n_reps))\n\
      \        meta = pmt.dict_add(meta, pmt.intern(\"fec_corrected\"), pmt.from_long(corrected))\n\
      \        vec = pmt.init_u8vector(len(payload), list(payload))\n        self.message_port_pub(pmt.intern(\"\
      pdu_out\"), pmt.cons(meta, vec))\n        self.message_port_pub(pmt.intern(\"\
      text_out\"), pmt.intern(text))\n        return \"delivered\"\n\n    # ----------\
      \ diagnostics helpers ----------\n    def _read_tags(self, n):\n        try:\n\
      \            tags = self.get_tags_in_window(0, 0, n)\n        except Exception:\n\
      \            return\n        for t in tags:\n            try:\n            \
      \    key = pmt.symbol_to_string(t.key)\n            except Exception:\n    \
      \            continue\n            if key == \"corr_est\":\n               \
      \ try:\n                    rho = float(pmt.to_double(t.value))\n          \
      \      except Exception:\n                    rho = float(\"nan\")\n       \
      \         self._train_pending.append((int(t.offset), rho))\n               \
      \ self._c[\"train\"] += 1\n            elif key == \"squelch_eob\":\n      \
      \          self._eobs.append(int(t.offset))\n                self._c[\"sq_eob\"\
      ] += 1\n        if len(self._eobs) > 512:\n            self._eobs = self._eobs[-256:]\n\
      \n    def _check_trains(self):\n        \"\"\"Look at the decoded bits around\
      \ each correlator tag once enough bits have arrived.\"\"\"\n        end_abs\
      \ = self._hist_abs + len(self._hist)\n        keep = []\n        for off, rho\
      \ in self._train_pending:\n            if off + 160 > end_abs:\n           \
      \     keep.append((off, rho))\n                continue\n            a = max(0,\
      \ off - 64 - self._hist_abs)\n            b = off + 160 - self._hist_abs\n \
      \           seg = self._hist[a:b].astype(np.int16) * 2 - 1\n            if len(seg)\
      \ < 96:\n                continue\n            c = np.lib.stride_tricks.sliding_window_view(seg[:len(seg)\
      \ - 32], 32) @ self._train\n            j = int(np.argmax(c))\n            terr\
      \ = (32 - int(c[j])) // 2\n            serr = (32 - int(seg[j + 32:j + 64] @\
      \ self._sync)) // 2\n            sync_abs = self._hist_abs + a + j + 32\n  \
      \          self._train_seen.append((sync_abs, rho, terr, serr))\n          \
      \  if terr <= 3 and serr <= self.max_bit_errors:\n                self._c[\"\
      train_clean\"] += 1\n                verdict = \"clean, deframer can lock\"\n\
      \            elif terr <= 3:\n                self._c[\"train_bad_sync\"] +=\
      \ 1\n                verdict = (f\"sync word has more than {self.max_bit_errors}\
      \ errors -> no lock: bits go wrong right \"\n                           f\"\
      after the train word (equalizer / Costas / squelch)\")\n            else:\n\
      \                self._c[\"train_garbage\"] += 1\n                verdict =\
      \ (\"the train word is not in the decoded bits: the demodulator output is wrong\
      \ although the \"\n                           \"correlator saw the word (equalizer,\
      \ Costas, slicer, diff decoder, DC offset)\")\n            self._dbg(f\"train\
      \ word (corr {rho:.2f}): decoded train word {terr}/32 bits wrong, \"\n     \
      \                 f\"sync word {serr}/32 wrong -> {verdict}\")\n        self._train_pending\
      \ = keep\n        if len(self._train_seen) > 64:\n            self._train_seen\
      \ = self._train_seen[-32:]\n\n    def _cuts(self, a, b):\n        return sum(1\
      \ for e in self._eobs if a < e < b)\n\n    def _keep(self, buf, start):\n  \
      \      start = max(0, min(start, len(buf)))\n        self._buf = buf[start:].copy()\n\
      \        self._buf_abs += start\n\n    # ---------- main loop ----------\n \
      \   def work(self, input_items, output_items):\n        bits = input_items[0]\
      \ & 1\n        n_in = len(bits)\n        self._bits_total += n_in\n        if\
      \ len(self._buf) == 0:\n            self._buf_abs = self.nitems_read(0)\n  \
      \      self._buf = np.concatenate((self._buf, bits)) if len(self._buf) else\
      \ bits.copy()\n\n        if self.debug:\n            self._read_tags(n_in)\n\
      \            if len(self._hist) == 0:\n                self._hist_abs = self.nitems_read(0)\n\
      \            self._hist = np.concatenate((self._hist, bits))\n            if\
      \ len(self._hist) > HIST_BITS:\n                cut = len(self._hist) - HIST_BITS\n\
      \                self._hist = self._hist[cut:]\n                self._hist_abs\
      \ += cut\n            self._check_trains()\n            if time.monotonic()\
      \ - self._t_stats >= self.stats_every_s:\n                self._t_stats = time.monotonic()\n\
      \                self._print_stats()\n\n        # Flush transmission stats once\
      \ channel has been quiet for > 0.5s of air time\n        if self._cur_id is\
      \ not None and self._bits_total - self._bits_at_last_ok > 0.5 * self.bit_rate:\n\
      \            self._flush_summary()\n\n        thr = 32 - 2 * self.max_bit_errors\n\
      \        hdr_coded, hdr_blk = self._coded_len(HDR_BYTES)\n        hdr_bits =\
      \ 32 + hdr_coded\n\n        while True:\n            buf = self._buf\n     \
      \       if len(buf) < hdr_bits:\n                return n_in\n\n           \
      \ pm = buf.astype(np.int16) * 2 - 1\n            corr = np.lib.stride_tricks.sliding_window_view(pm,\
      \ 32) @ self._sync\n            cand = np.flatnonzero(corr >= thr)\n\n     \
      \       if cand.size == 0:\n                self._keep(buf, len(buf) - 31) \
      \         # keep trailing bits that might begin a sync word\n              \
      \  return n_in\n\n            i = int(cand[0])\n            if len(buf) < i\
      \ + hdr_bits:\n                self._keep(buf, i)                      # await\
      \ complete header bits\n                return n_in\n\n            header, hdr_corr\
      \ = self._decode_section(buf[i + 32: i + hdr_bits], HDR_BYTES, hdr_blk)\n  \
      \          length = int.from_bytes(header[:2], \"big\")\n            fa = self._buf_abs\
      \ + i\n\n            if length == 0 or length > self.max_payload_len:\n    \
      \            self.n_bad_len += 1\n                self._c[\"bad_len\"] += 1\n\
      \                if self._near_train(fa):\n                    self._dbg(f\"\
      frame: sync word found after a train word, but the header length {length} is\
      \ \"\n                              f\"invalid (FEC fixed {hdr_corr} bits) ->\
      \ header corrupted\")\n                self._keep(buf, i + 1)              \
      \    # backtrack 1 bit past false sync\n                continue\n\n       \
      \     body_coded, body_blk = self._coded_len(length + 4)\n            end =\
      \ i + hdr_bits + body_coded\n            if len(buf) < end:\n              \
      \  self._keep(buf, i)                      # await complete frame body bits\n\
      \                return n_in\n\n            body, body_corr = self._decode_section(buf[i\
      \ + hdr_bits: end], length + 4, body_blk)\n            payload, rx_crc = body[:length],\
      \ body[length:]\n            self.n_sync += 1\n            self._c[\"lock\"\
      ] += 1\n            fe = self._buf_abs + end\n            cuts = self._cuts(fa\
      \ - 32, fe)\n            cut_txt = f\", squelch closed {cuts}x inside the frame\"\
      \ if cuts else \"\"\n            corrected = hdr_corr + body_corr\n\n      \
      \      if zlib.crc32(header + payload) == int.from_bytes(rx_crc, \"big\"):\n\
      \                self.n_fec_corrected += corrected\n                self.n_ok\
      \ += 1\n                self._c[\"ok\"] += 1\n                sender, msg_id\
      \ = header[2], header[3]\n                if sender == self.peer_id:\n     \
      \               what = self._deliver(header, payload, corrected)\n         \
      \           self._c[what] += 1\n                    self._dbg(f\"frame: {length}\
      \ B, CRC ok (FEC fixed {corrected} bits), sender ID {sender}, \"\n         \
      \                     f\"msg #{msg_id} -> {'delivered' if what == 'delivered'\
      \ else 'repeat burst, not shown again'}\")\n                else:\n        \
      \            # Frame from another ID: not for us\n                    self._c[\"\
      wrong_id\"] += 1\n                    preview = payload[:40].decode(\"utf-8\"\
      , errors=\"replace\")\n                    self._dbg(f\"frame: {length} B, CRC\
      \ ok, sender ID {sender}, msg #{msg_id} '{preview}' -> DROPPED: \"\n       \
      \                       f\"this node accepts only sender ID {self.peer_id}\"\
      )\n                    if not self._warned_id and (self.own_id < 0 or sender\
      \ == self.own_id):\n                        self._warned_id = True\n       \
      \                 print(f\"[RX] WARNING: a good frame carried sender ID {sender},\
      \ the ID this node sends with. \"\n                              f\"If this\
      \ PC did not just send that text, the other PC has the same MY_ID: set \"\n\
      \                              f\"MY_ID {self.peer_id} on the other PC. (If\
      \ it is this PC's own text, its own burst \"\n                             \
      \ f\"leaked past the CSMA receive-off window.)\", flush=True)\n            \
      \    self._keep(buf, end)                    # advance past valid frame\n  \
      \          else:\n                self.n_crc_fail += 1\n                self._c[\"\
      crc_fail\"] += 1\n                if cuts:\n                    self._c[\"crc_fail_cut\"\
      ] += 1\n                self._dbg(f\"frame: header says {length} B from ID {header[2]}\
      \ msg #{header[3]}, CRC FAIL \"\n                          f\"(FEC fixed {corrected}\
      \ bits, still wrong){cut_txt}\")\n                self._keep(buf, i + 1)   \
      \               # backtrack 1 bit past false sync\n\n        return n_in\n\n\
      \    def _near_train(self, sync_abs):\n        return any(abs(s - sync_abs)\
      \ <= 8 for s, _, _, _ in self._train_seen)\n"
    affinity: ''
    alias: ''
    bit_rate: '375000'
    comment: 'v6.2: prints [RX dbg] per train word / frame and [RX stats] every 10
      s. debug=0 silences it.'
    debug: '1'
    dup_window_s: '2.0'
    fec: FEC
    interleave: 'True'
    max_bit_errors: '1'
    max_dbg_lines: '20'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    own_id: MY_ID
    peer_id: (1-MY_ID)
    stats_every_s: '10.0'
  states:
    _io_cache: ('Packet Deframer RX (Fast Burst, Hamming, diag)', 'PacketDeframerRX',
      [('peer_id', '1'), ('max_bit_errors', '2'), ('max_payload_len', '1024'), ('bit_rate',
      '375000'), ('fec', '15'), ('interleave', 'True'), ('own_id', '-1'), ('debug',
      '1'), ('max_dbg_lines', '20'), ('stats_every_s', '10.0'), ('dup_window_s', '2.0')],
      [('0', 'byte', 1)], [('text_out', 'message', 1), ('pdu_out', 'message', 1)],
      '', ['bit_rate', 'debug', 'dup_window_s', 'fec', 'interleave', 'max_bit_errors',
      'max_dbg_lines', 'max_payload_len', 'own_id', 'peer_id', 'stats_every_s'])

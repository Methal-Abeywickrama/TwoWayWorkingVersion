      \ max(d, self.tx_delay_s) if self._mute_on() else d\n        return self.tx_delay_s\n\
      \n    def _end_self_tx(self, reason):\n        self._self_tx = False\n     \
      \   if reason == \"echo_end\":\n            self._idle_run = self.tail_s\n \
      \       elif reason == \"window\":\n            # our burst ended at about win_end\
      \ - guard; the other node noticed it about sense_s later. Count idle\n     \

      \     self.iio_uri = str(iio_uri)\n        self.tx_att_db = float(tx_att_db)\n\
      \        self.mute_att_db = float(mute_att_db)\n        self.unmute_timeout_s\
      \ = float(unmute_timeout_s)\n        self.echo_margin_db = float(echo_margin_db)\n\
      \        self._muter = None\n        self._req_att = None\n        self._mute_seq\
      \ = 0\n        self._seen = (None, None)\n        self._unmute_delays = collections.deque(maxlen=200)\n\
      \n        # ---- carrier-sense front end\n        self._nfft = int(nfft)\n \
      \       self._dt = self._nfft / self.samp_rate\n        f = np.fft.fftfreq(self._nfft,\
      \ 1.0 / self.samp_rate)\n        sel = (np.abs(f) <= float(cs_bw_hz) / 2) &\
      \ (np.abs(f) >= float(dc_exclude_hz))\n        self._bins = np.flatnonzero(sel)\n\
      \        if self._bins.size < 8:\n            raise ValueError(\"cs_bw_hz /\
      \ dc_exclude_hz / nfft leave fewer than 8 bins to sense\")\n        self._win\
      \ = np.hanning(self._nfft).astype(np.float32)\n        self._norm = 1.0 / (np.log(2.0)\
      \ * self._nfft * float(np.mean(self._win ** 2)))\n        self._smooth = collections.deque(maxlen=max(1,\
      \ int(round(float(sense_s) / self._dt))))\n        self._carry = np.zeros(0,\
      \ np.complex64)\n        self._cs_db = -200.0\n        n_hist = max(64, int(float(floor_window_s)\
      \ / self._dt))\n        self._hist = collections.deque(maxlen=n_hist)\n    \
      \    self._floor_db = None\n        self._floor_next = 0.0\n        self._busy\

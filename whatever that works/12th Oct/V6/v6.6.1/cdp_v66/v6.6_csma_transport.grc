      \ and (force or att != self._req_att):\n            self._mute_seq = self._muter.request(att)\n\
      \            self._req_att = att\n        return self._mute_seq\n\n    # ------------------------------------------------------------------\
      \ messages\n    def _on_pdu(self, msg):\n        if not pmt.is_pair(msg) or\
      \ not pmt.is_u8vector(pmt.cdr(msg)):\n            print(\"[CSMA] pdu_in expects\
      \ a PDU (meta . u8vector) from the framer; message ignored\", flush=True)\n\
      \            return\n        with self._lock:\n            if len(self._queue)\
      \ >= self.max_queue:\n                self._queue.popleft()\n              \
      \  self._st[\"dropped\"] += 1\n                print(f\"[CSMA] queue full ({self.max_queue}):\
      \ oldest frame dropped\", flush=True)\n            self._queue.append((msg,\
      \ self._t))\n\n    def _on_ctrl(self, msg):\n        try:\n            txt =\
      \ str(pmt.to_python(pmt.car(msg) if pmt.is_pair(msg) else msg)).lower()\n  \
      \      except Exception:\n            txt = \"\"\n        if \"fail\" in txt\
      \ or \"collision\" in txt or \"nack\" in txt:\n            self._cw = min(self.cw_max,\
      \ self._cw * 2)\n        elif \"ok\" in txt or \"success\" in txt or \"ack\"\
      \ in txt:\n            self._cw = self.cw_min\n        elif \"flush\" in txt:\n\
      \            with self._lock:\n                self._queue.clear()\n\n    #\
      \ ------------------------------------------------------------------ carrier\
      \ sense helpers\n    def _update_floor(self):\n        if len(self._hist) <\
      \ self._hist.maxlen // 4:\n            return\n        raw = float(np.percentile(np.fromiter(self._hist,\
      \ float, len(self._hist)), self.floor_percentile))\n        if self._floor_db\
      \ is None or raw <= self._floor_db:\n            self._floor_db = raw\n    \
      \    else:\n            self._floor_db = min(raw, self._floor_db + self.floor_rise_db_s\
      \ * 0.05)\n\n    # ------------------------------------------------------------------\
      \ own transmission\n    def _release(self):\n        \"\"\"Backoff done: receiver\
      \ off; unmute the TX first if muting, then send.\"\"\"\n        with self._lock:\n\
      \            if not self._queue:\n                return\n            msg, t_enq\
      \ = self._queue.popleft()\n        nbytes = pmt.length(pmt.cdr(msg))\n     \
      \   airtime = nbytes * self.samples_per_byte / self.samp_rate\n        self._backoff,\
      \ self._idle_run = None, 0.0\n        self._self_tx = True\n        if self._mute_on():\n\
      \            self._tx = {\"phase\": \"unmute\", \"msg\": msg, \"nbytes\": nbytes,\
      \ \"air\": airtime, \"t_enq\": t_enq,\n                        \"t_dec\": self._t,\
      \ \"mute\": True}\n            self._tx[\"seq\"] = self._sync_mute()\n     \
      \   else:\n            self._tx = {\"mute\": False}\n            self._publish(msg,\
      \ nbytes, airtime, t_enq)\n\n    def _publish(self, msg, nbytes, airtime, t_enq):\n\
      \        self.message_port_pub(pmt.intern(\"pdu_out\"), msg)\n        delay\
      \ = self._tx_delay()\n        self._tx.update({\"phase\": \"air\", \"t0\": self._t,\
      \ \"air\": airtime, \"echo_t\": None, \"low_since\": None,\n               \
      \          \"hard_end\": self._t + self.echo_timeout_s + airtime + self.tail_s\
      \ + 0.02,\n                         \"win_end\": self._t + delay + airtime +\
      \ self.gate_guard_s})\n        self._tx.pop(\"msg\", None)\n        self._st[\"\
      tx\"] += 1\n        self._access_delays.append(self._t - t_enq)\n        if\
      \ self.verbose >= 2:\n            print(f\"[CSMA] TX {nbytes} B frame ({airtime\
      \ * 1e3:.1f} ms) after {1e3 * (self._t - t_enq):.1f} ms \"\n               \
      \   f\"in queue, cw {self._cw}\", flush=True)\n\n    def _tx_delay(self):\n\
      \        if self.auto_delay and len(self._echo_delays) >= 3:\n            d\
      \ = float(np.median(self._echo_delays))\n            # with the mute on, the\

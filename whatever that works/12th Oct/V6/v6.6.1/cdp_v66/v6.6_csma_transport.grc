      win_end\", self._t))\n            self._idle_run = self.gate_guard_s - self._sense_s\
      \ + extra if extra <= 0.005 else 0.0\n        else:\n            self._idle_run\
      \ = 0.0\n        if reason == \"timeout\" and self._tx.get(\"echo_t\") is None:\n\
      \            self._st[\"no_echo\"] += 1\n            if not self._warned_no_echo:\n\
      \                self._warned_no_echo = True\n                print(\"[CSMA]\
      \ own burst not seen on our receiver: RX blanking falls back to the timer \"\

      ctrl\"), self._on_ctrl)\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n    # ------------------------------------------------------------------\
      \ start / stop (radio access only here,\n    # never in __init__: GRC builds\
      \ the block once just to read its ports)\n    def start(self):\n        self._muter\
      \ = TxMuter(self.iio_uri, self.verbose)\n        self._muter.start()\n     \
      \   return True\n\n    def stop(self):\n        if self._muter is not None:\n\
      \            self._muter.stop(restore_att=self.tx_att_db)\n        return True\n\
      \n    # ------------------------------------------------------------------ read-outs\
      \ (Function Probe)\n    def cs_db(self):\n        return float(self._cs_db)\n\
      \n    def floor_db(self):\n        return float(self._floor_db) if self._floor_db\
      \ is not None else -200.0\n\n    def threshold_db(self):\n        return self.floor_db()\
      \ + self.cs_margin_db\n\n    def is_busy(self):\n        return int(self._busy\
      \ or self._self_tx)\n\n    def is_tx(self):\n        return int(self._self_tx)\n\
      \n    def queue_len(self):\n        return len(self._queue)\n\n    def is_muted(self):\n\
      \        return int(self._mute_on() and self._req_att == self.mute_att_db)\n\
      \n    # ------------------------------------------------------------------ TX\
      \ mute helpers\n    def _mute_on(self):\n        return bool(self.tx_mute) and\
      \ self._muter is not None and self._muter.ok\n\n    def _desired_att(self):\n\
      \        if self._muter is None or not self._muter.ok:\n            return None\n\
      \        if not self.tx_mute:\n            return self.tx_att_db\n        if\
      \ self._self_tx and self._tx.get(\"phase\") in (\"unmute\", \"air\"):\n    \
      \        return self.tx_att_db\n        return self.mute_att_db\n\n    def _sync_mute(self,\

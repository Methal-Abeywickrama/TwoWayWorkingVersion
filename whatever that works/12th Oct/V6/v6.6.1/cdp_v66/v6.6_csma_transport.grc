- name: epy_noise
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Noise-floor tracker -> automatic\
      \ squelch threshold\n- Sink block: connect it to the SDR source output (BEFORE\
      \ any squelch/AGC).\n- Splits the stream into short slices (default ~1 ms),\
      \ keeps the mean power of each slice for the\n  last `window_s` seconds, and\
      \ takes a low percentile of them as the noise floor (bursts only occupy\n  the\
      \ top of the distribution, so they are ignored as long as the channel is idle\
      \ > `percentile` % of the time).\n- level() returns the squelch threshold in\
      \ dB:  noise floor (dB) + margin_db, clamped to\n  [thr_min, thr_max]. The estimate\
      \ falls immediately but rises at most `rise_db_s` dB per second, so a\n  long\
      \ burst or a back-to-back transmission cannot drag the threshold up and close\
      \ the squelch.\n- Use with a \"Function Probe\" variable named power_threshold:\
      \  block id = this block, function = level,\n  poll rate ~ 5 Hz. The Pluto/squelch\
      \ power unit is the same: dB of mean |x|^2.\n\"\"\"\nimport threading\nimport\
      \ time\nfrom collections import deque\n\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\nclass NoiseFloor(gr.sync_block):\n    def __init__(self, samp_rate=1.5e6,\
      \ margin_db=6.0, window_s=1.0, percentile=10.0,\n                 rise_db_s=1.0,\
      \ thr_min=-100.0, thr_max=-20.0, init_db=-40.0, verbose=1):\n        gr.sync_block.__init__(self,\
      \ name=\"Noise Floor Tracker\", in_sig=[np.complex64], out_sig=None)\n     \
      \   self.samp_rate = float(samp_rate)\n        self.margin_db = float(margin_db)\n\
      \        self.window_s = float(window_s)\n        self.percentile = float(percentile)\n\
      \        self.rise_db_s = float(rise_db_s)\n        self.thr_min = float(thr_min)\n\
      \        self.thr_max = float(thr_max)\n        self.init_db = float(init_db)\n\
      \        self.verbose = int(verbose)\n\n        self._slice = max(64, int(self.samp_rate\
      \ * 1e-3))            # ~1 ms\n        n_slices = max(16, int(self.window_s\
      \ * self.samp_rate / self._slice))\n        self._ring = deque(maxlen=n_slices)\n\
      \        self._min_slices = max(8, n_slices // 4)                       # wait\
      \ for 1/4 window before trusting\n        self._carry = np.zeros(0, np.float32)\n\
      \        self._lock = threading.Lock()\n        self._est_db = None\n      \
      \  self._t_last = None\n        self._out = self.init_db\n        self._printed\
      \ = None\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        n = len(x)\n        if n == 0:\n            return 0\n        p = x.real.astype(np.float32)\
      \ ** 2 + x.imag.astype(np.float32) ** 2\n        if self._carry.size:\n    \
      \        p = np.concatenate((self._carry, p))\n        k = len(p) // self._slice\n\
      \        if k:\n            means = p[: k * self._slice].reshape(k, self._slice).mean(axis=1,\
      \ dtype=np.float64)\n            with self._lock:\n                self._ring.extend(means)\n\
      \        self._carry = p[k * self._slice:]\n        return n\n\n    def noise_db(self):\n\
      \        return self._est_db\n\n    def level(self):\n        \"\"\"Called by\
      \ the Function Probe variable: returns the squelch threshold in dB.\"\"\"\n\
      \        with self._lock:\n            arr = np.fromiter(self._ring, dtype=np.float64,\
      \ count=len(self._ring))\n        if arr.size < self._min_slices:\n        \
      \    return self._out\n        raw_db = 10.0 * np.log10(max(float(np.percentile(arr,\
      \ self.percentile)), 1e-20))\n        now = time.monotonic()\n        if self._est_db\
      \ is None:\n            self._est_db = raw_db\n        else:\n            dt\
      \ = max(0.0, now - self._t_last)\n            if raw_db <= self._est_db:\n \
      \               self._est_db = raw_db\n            else:\n                self._est_db\
      \ = min(raw_db, self._est_db + self.rise_db_s * dt)\n        self._t_last =\
      \ now\n        self._out = float(min(self.thr_max, max(self.thr_min, self._est_db\
      \ + self.margin_db)))\n        if self.verbose and (self._printed is None or\
      \ abs(self._out - self._printed) >= 1.0):\n            print(f\"[SQL] noise\
      \ floor {self._est_db:.1f} dB -> squelch threshold {self._out:.1f} dB\", flush=True)\n\
      \            self._printed = self._out\n        return self._out\n"
    affinity: ''
    alias: ''
    comment: ''
    init_db: '-40.0'
    margin_db: margin_db
    maxoutbuf: '0'
    minoutbuf: '0'
    percentile: '10.0'
    rise_db_s: '1.0'
    samp_rate: samp_rate
    thr_max: '-20.0'
    thr_min: '-100.0'
    verbose: '1'
    window_s: '1.0'
  states:
    _io_cache: ('Noise Floor Tracker', 'NoiseFloor', [('samp_rate', '1500000.0'),
      ('margin_db', '6.0'), ('window_s', '1.0'), ('percentile', '10.0'), ('rise_db_s',
      '1.0'), ('thr_min', '-100.0'), ('thr_max', '-20.0'), ('init_db', '-40.0'), ('verbose',
      '1')], [('0', 'complex', 1)], [], '', ['init_db', 'margin_db', 'percentile',
      'rise_db_s', 'samp_rate', 'thr_max', 'thr_min', 'verbose', 'window_s'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 1156.0]
    rotation: 0
    state: enabled
- name: epy_udp
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: UDP Transport (unreliable datagrams)\
      \ + UDP sockets for an external daemon\n\nWiring\n  Packet Deframer RX pdu_out\
      \ -> pdu_in        pdu_out -> Packet Framer TX msg_in\n\nWhat it does\n  One\
      \ daemon datagram = one radio frame, sent once: no ACK, no retransmission, no\
      \ ordering, no splitting.\n  dest 255 = every node (broadcast). Use it for chat\
      \ lines, beacons, status, anything where a lost or late\n  packet is better\
      \ than a delayed one. Larger data or anything that must arrive: use the ARQ\
      \ block.\n\nOn air (inside the framer payload; the framer adds src_id / dest_id):\
      \   C5 01 | payload\n\nDaemon sockets (UDP, plain datagrams)\n  daemon -> block\
      \ : send to  bind_addr:listen_port   datagram = dest 1B | payload\n  block ->\
      \ daemon : sent to  deliver_addr:deliver_port   datagram = src 1B | dest 1B\
      \ | payload\n                    (dest = this node's ID, or 255 if it was a\
      \ broadcast)\n  payload up to max_payload_len - 2 bytes; larger datagrams are\
      \ dropped with a message.\n\"\"\"\nimport collections\nimport socket\nimport\
      \ threading\nimport time\n\nimport pmt\nfrom gnuradio import gr\n\nMAGIC, P_UDP\
      \ = 0xC5, 0x01\n\n\nclass UdpTransport(gr.basic_block):\n    def __init__(self,\
      \ src_id=1, listen_port=5200, deliver_port=5201, bind_addr=\"127.0.0.1\",\n\
      \                 deliver_addr=\"127.0.0.1\", max_payload_len=2048, verbose=1,\
      \ stats_every_s=10.0):\n        gr.basic_block.__init__(self, name=\"UDP Transport\
      \ (datagrams, socket)\", in_sig=None, out_sig=None)\n        self.src_id = int(src_id)\n\
      \        self.listen_port = int(listen_port)\n        self.deliver_port = int(deliver_port)\n\
      \        self.bind_addr = str(bind_addr)\n        self.deliver_addr = str(deliver_addr)\n\
      \        self.max_data = max(1, int(max_payload_len) - 2)\n        self.verbose\
      \ = int(verbose)\n        self.stats_every_s = float(stats_every_s)\n      \
      \  self._sock = None\n        self._out = None\n        self._thr = None\n \
      \       self._run = False\n        self._st = collections.Counter()\n      \
      \  self._st_last = collections.Counter()\n\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self._on_pdu)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    def\
      \ start(self):\n        self._out = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n\
      \        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n   \
      \     self._sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n   \
      \     try:\n            self._sock.bind((self.bind_addr, self.listen_port))\n\
      \            self._sock.settimeout(0.2)\n        except OSError as e:\n    \
      \        print(f\"[UDP] cannot listen on {self.bind_addr}:{self.listen_port}:\
      \ {e}. Sending from the daemon \"\n                  f\"disabled.\", flush=True)\n\
      \            self._sock.close()\n            self._sock = None\n        self._run\
      \ = True\n        self._thr = threading.Thread(target=self._loop, name=\"udp\"\
      , daemon=True)\n        self._thr.start()\n        print(f\"[UDP] node {self.src_id}:\
      \ daemon sends to udp://{self.bind_addr}:{self.listen_port} \"\n           \
      \   f\"(dest 1B + payload, max {self.max_data} B), received datagrams go to\
      \ \"\n              f\"udp://{self.deliver_addr}:{self.deliver_port} (src 1B\
      \ + dest 1B + payload)\", flush=True)\n        return True\n\n    def stop(self):\n\
      \        self._run = False\n        if self._thr is not None:\n            self._thr.join(timeout=1.0)\n\
      \        for s in (self._sock, self._out):\n            if s is not None:\n\
      \                try:\n                    s.close()\n                except\
      \ OSError:\n                    pass\n        return True\n\n    # daemon ->\
      \ radio\n    def _loop(self):\n        t_stats = time.monotonic()\n        while\
      \ self._run:\n            if self._sock is not None:\n                try:\n\
      \                    dgram, addr = self._sock.recvfrom(65535)\n            \
      \    except socket.timeout:\n                    dgram = None\n            \
      \    except OSError:\n                    dgram = None\n                   \
      \ time.sleep(0.2)\n                if dgram:\n                    self._from_daemon(dgram)\n\
      \            else:\n                time.sleep(0.2)\n            if self.verbose\
      \ and self.stats_every_s > 0 and time.monotonic() - t_stats >= self.stats_every_s:\n\
      \                t_stats = time.monotonic()\n                d = {k: self._st[k]\
      \ - self._st_last[k] for k in (\"tx\", \"rx\", \"bcast\", \"rejected\", \"senderr\"\
      )}\n                if any(d.values()):\n                    print(f\"[UDP]\
      \ since last line: sent {d['tx']} (broadcast {d['bcast']}), received {d['rx']},\
      \ \"\n                          f\"rejected {d['rejected']}, local send errors\
      \ {d['senderr']}\", flush=True)\n                self._st_last = collections.Counter(self._st)\n\
      \n    def _from_daemon(self, dgram):\n        dest, data = dgram[0], dgram[1:]\n\
      \        if not data or len(data) > self.max_data or dest == self.src_id:\n\
      \            self._st[\"rejected\"] += 1\n            why = (\"empty\" if not\
      \ data else f\"{len(data)} B > {self.max_data} B\" if len(data) > self.max_data\n\
      \                   else \"dest is this node\")\n            print(f\"[UDP]\
      \ datagram to {dest} dropped: {why}\", flush=True)\n            return\n   \
      \     raw = bytes([MAGIC, P_UDP]) + data\n        meta = pmt.make_dict()\n \
      \       meta = pmt.dict_add(meta, pmt.intern(\"dest_id\"), pmt.from_long(int(dest)))\n\
      \        self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(meta, pmt.init_u8vector(len(raw),\
      \ list(raw))))\n        self._st[\"tx\"] += 1\n        if dest == 255:\n   \
      \         self._st[\"bcast\"] += 1\n\n    # radio -> daemon\n    def _on_pdu(self,\
      \ msg):\n        try:\n            meta, data = pmt.car(msg), pmt.cdr(msg)\n\
      \            if not pmt.is_u8vector(data):\n                return\n       \
      \     raw = bytes(pmt.u8vector_elements(data))\n            if len(raw) < 2\
      \ or raw[0] != MAGIC or raw[1] != P_UDP:\n                return\n         \
      \   src = pmt.to_long(pmt.dict_ref(meta, pmt.intern(\"src_id\"), pmt.from_long(0)))\n\
      \            dst = pmt.to_long(pmt.dict_ref(meta, pmt.intern(\"dest_id\"), pmt.from_long(self.src_id)))\n\
      \        except Exception:\n            return\n        self._st[\"rx\"] +=\
      \ 1\n        try:\n            self._out.sendto(bytes([src & 0xFF, dst & 0xFF])\
      \ + raw[2:], (self.deliver_addr, self.deliver_port))\n        except OSError:\n\
      \            self._st[\"senderr\"] += 1\n"
    affinity: ''
    alias: ''
    bind_addr: os.environ.get('CDP_BIND', '127.0.0.1')
    comment: UDP transport. Daemon sends to udp://CDP_BIND:CDP_UDP_PORT (5200), gets
      datagrams on CDP_UDP_OUT_PORT (5201).
    deliver_addr: os.environ.get('CDP_UDP_DELIVER', '127.0.0.1')
    deliver_port: int(os.environ.get('CDP_UDP_OUT_PORT', '5201'))
    listen_port: int(os.environ.get('CDP_UDP_PORT', '5200'))
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    src_id: MY_ID
    stats_every_s: '10.0'
    verbose: '1'
  states:
    _io_cache: ('UDP Transport (datagrams, socket)', 'UdpTransport', [('src_id', '1'),
      ('listen_port', '5200'), ('deliver_port', '5201'), ('bind_addr', "'127.0.0.1'"),
      ('deliver_addr', "'127.0.0.1'"), ('max_payload_len', '2048'), ('verbose', '1'),
      ('stats_every_s', '10.0')], [('pdu_in', 'message', 1)], [('pdu_out', 'message',
      1)], '', ['bind_addr', 'deliver_addr', 'deliver_port', 'listen_port', 'src_id',
      'stats_every_s', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 2244.0]
    rotation: 0
    state: enabled

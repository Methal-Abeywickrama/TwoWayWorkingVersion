      \            tx = self._tx\n            phase = tx.get(\"phase\")\n        \
      \    if phase == \"unmute\":                            # waiting for the TX\
      \ attenuation write\n                if self._muter.done(tx[\"seq\"]) or self._t\
      \ - tx[\"t_dec\"] >= self.unmute_timeout_s:\n                    if not self._muter.done(tx[\"\
      seq\"]):\n                        self._st[\"late_unmute\"] += 1\n         \
      \           self._unmute_delays.append(self._t - tx[\"t_dec\"])\n          \
      \          self._publish(tx[\"msg\"], tx[\"nbytes\"], tx[\"air\"], tx[\"t_enq\"\
      ])\n                return\n            if phase == \"mute\":              \
      \                # waiting for the mute write before listening again\n     \
      \           if self._muter.done(tx[\"seq\"]) or self._t - tx[\"win_end\"] >=\
      \ self.unmute_timeout_s:\n                    self._end_self_tx(\"window\")\n\
      \                return\n            if self.gate_mode == 1 or tx.get(\"mute\"\
      ):        # fixed receive-off window\n                echo_thr = thr_on if not\
      \ tx.get(\"mute\") else \\\n                    (self._floor_db if self._floor_db\
      \ is not None else 1e9) + max(self.cs_margin_db, self.echo_margin_db)\n    \
      \            if (tx[\"echo_t\"] is None and cs_db > echo_thr and self._t < tx[\"\
      win_end\"]\n                        and self._t - tx[\"t0\"] >= 0.002):    #\
      \ < 2 ms is not our burst (leak / noise)\n                    tx[\"echo_t\"\
      ] = self._t\n                    self._echo_delays.append(self._t - tx[\"t0\"\
      ])\n                if self._t >= tx[\"win_end\"]:\n                    if tx[\"\
      echo_t\"] is None:\n                        self._st[\"no_echo\"] += 1\n   \
      \                 if self._mute_on():\n                        tx[\"phase\"\
      ] = \"mute\"\n                        tx[\"seq\"] = self._sync_mute()\n    \
      \                else:\n                        self._end_self_tx(\"window\"\
      )\n                return\n            # gate_mode 0 (no mute): wait until our\
      \ own echo has ended\n            if tx[\"echo_t\"] is None:\n             \
      \   if loud:\n                    tx[\"echo_t\"] = self._t\n               \
      \     self._echo_delays.append(self._t - tx[\"t0\"])\n                elif self._t\
      \ - tx[\"t0\"] > self.echo_timeout_s + tx[\"air\"] + self.tail_s:\n        \
      \            self._end_self_tx(\"timeout\")\n                    return\n  \
      \          else:\n                if loud:\n                    tx[\"low_since\"\
      ] = None\n                elif tx[\"low_since\"] is None:\n                \
      \    tx[\"low_since\"] = self._t\n                elif self._t - tx[\"low_since\"\
      ] >= self.tail_s:\n                    self._end_self_tx(\"echo_end\")\n   \
      \                 return\n            if self._t >= tx[\"hard_end\"]:\n    \
      \            self._end_self_tx(\"timeout\")\n            return\n\n        #\
      \ channel state with hysteresis (busy until the floor is known)\n        self._hist.append(cs_db)\n\
      \        if self._floor_db is None:\n            self._busy = True\n       \
      \ elif self._busy:\n            self._busy = cs_db > thr_on - self.cs_hyst_db\n\
      \        else:\n            self._busy = loud\n        if self._busy:\n    \
      \        self._busy_time += dt\n\n        with self._lock:\n            pending\
      \ = len(self._queue)\n            t_head = self._queue[0][1] if pending else\
      \ None\n        if not pending:\n            self._idle_run = 0.0 if self._busy\
      \ else self._idle_run + dt\n            return\n\n        if self.max_defer_s\
      \ > 0 and self._t - t_head > self.max_defer_s and self._floor_db is not None:\n\
      \            self._st[\"forced\"] += 1\n            self._release()\n      \
      \      return\n\n        if self._backoff is None:\n            self._backoff\
      \ = int(self._rng.integers(0, self._cw))\n\n        if self._busy:\n       \
      \     if self._idle_run > 0.0:\n                self._st[\"deferrals\"] += 1\n\
      \            self._idle_run = 0.0\n            return\n\n        p_prev = self._idle_run\
      \ - self.difs_s\n        self._idle_run += dt\n        p_now = self._idle_run\
      \ - self.difs_s\n        if p_now < 0:\n            return\n        crossings\
      \ = int(np.floor(p_now / self.slot_s)) - int(np.floor(p_prev / self.slot_s))\n\
      \        for _ in range(crossings):\n            if self._backoff == 0:\n  \
      \              self._release()\n                return\n            self._backoff\
      \ -= 1\n\n    # ------------------------------------------------------------------\
      \ stream\n    def work(self, input_items, output_items):\n        t_cpu = time.perf_counter()\n\
      \        if self._wall0 is None:\n            self._wall0, self._n_wall0 = time.monotonic(),\
      \ self._n_abs\n        if self._muter is not None:\n            seen = (self.tx_mute,\
      \ self.tx_att_db)\n            self._sync_mute(force=(seen != self._seen)) \
      \     # slider / check box changed: write again\n            self._seen = seen\n\
      \        x = input_items[0]\n        out = output_items[0]\n        n = len(x)\n\
      \        out[:] = x\n\n        first_abs = self._n_abs - len(self._carry)\n\
      \        buf = np.concatenate((self._carry, x)) if len(self._carry) else x\n\
      \        nb = len(buf) // self._nfft\n        blank = []\n        if nb:\n \
      \           blocks = buf[:nb * self._nfft].reshape(nb, self._nfft) * self._win\n\
      \            p = np.abs(np.fft.fft(blocks, axis=1)[:, self._bins]) ** 2\n  \
      \          med = np.median(p, axis=1) * self._norm\n            for i in range(nb):\n\
      \                self._smooth.append(float(med[i]))\n                self._cs_db\
      \ = 10.0 * np.log10(max(sum(self._smooth) / len(self._smooth), 1e-20))\n   \
      \             self._t = (first_abs + (i + 1) * self._nfft) / self.samp_rate\n\
      \                was_tx = self._self_tx\n                self._step(self._cs_db)\n\
      \                if self.blank_rx and (was_tx or self._self_tx):\n         \
      \           s = first_abs + i * self._nfft\n                    blank.append((s,\
      \ s + self._nfft))\n                if self._t >= self._floor_next:\n      \
      \              self._floor_next = self._t + 0.05\n                    self._update_floor()\n\
      \        self._carry = buf[nb * self._nfft:].copy()\n        self._n_abs +=\
      \ n\n\n        if self.blank_rx and self._self_tx:\n            blank.append((self._n_abs\
      \ - len(self._carry), self._n_abs))\n        x0 = self._n_abs - n\n        for\
      \ s, e in blank:\n            a, b = max(s, x0) - x0, min(e, self._n_abs) -\
      \ x0\n            if b > a:\n                out[a:b] = 0\n\n        self._cpu\
      \ += time.perf_counter() - t_cpu\n        if self.verbose and self.stats_every_s\
      \ > 0 and self._t - self._stat_t0 >= self.stats_every_s:\n            self._print_stats()\n\
      \        return n\n\n    def _print_stats(self):\n        span = max(1e-9, self._t\
      \ - self._stat_t0)\n        ed = list(self._echo_delays)\n        ad = list(self._access_delays)\n\
      \        echo = (f\"own echo after {1e3 * np.median(ed):.1f} ms (max {1e3 *\
      \ max(ed):.1f}) -> keep slot_s above it\"\n                if ed else \"own\
      \ echo not measured yet\")\n        if self.gate_mode == 1 or self._mute_on():\n\
      \            echo += f\" | RX off for {1e3 * self._tx_delay():.1f} ms + airtime\
      \ + {1e3 * self.gate_guard_s:.1f} ms\"\n        floor = f\"{self._floor_db:.1f}\"\
      \ if self._floor_db is not None else \"learning\"\n        print(f\"[CSMA] floor\
      \ {floor} dB, threshold +{self.cs_margin_db:g} dB, now {self._cs_db:.1f} dB,\
      \ \"\n              f\"busy {100 * self._busy_time / span:.1f} % | tx {self._st['tx']},\
      \ deferrals {self._st['deferrals']}, \"\n              f\"queue {len(self._queue)},\
      \ cw {self._cw}, dropped {self._st['dropped']}, forced {self._st['forced']},\
      \ \"\n              f\"no-echo {self._st['no_echo']} | access delay median \"\
      \n              f\"{(1e3 * np.median(ad)) if ad else 0:.0f} ms | {echo}\", flush=True)\n\
      \        m = self._muter\n        if m is None or m.failed:\n            mute\
      \ = f\"TX mute OFF ({m.reason if m else 'not started'})\"\n        elif not\
      \ m.ok:\n            mute = \"TX mute: connecting to the radio\"\n        elif\
      \ not self.tx_mute:\n            mute = f\"TX mute switched off: TX always at\
      \ {self.tx_att_db:g} dB\"\n        else:\n            wm = list(m.write_ms)\n\
      \            ud = list(self._unmute_delays)\n            mute = (f\"TX mute\
      \ on: idle {self.mute_att_db:g} dB, sending {self.tx_att_db:g} dB | attenuation\
      \ write \"\n                    f\"{np.median(wm) if wm else 0:.1f} ms median\
      \ (max {max(wm) if wm else 0:.1f}), unmute wait \"\n                    f\"\
      {1e3 * np.median(ud) if ud else 0:.1f} ms median, late {self._st['late_unmute']},\
      \ \"\n                    f\"write errors {m.errors}\")\n        wall = max(1e-9,\
      \ time.monotonic() - self._wall0)\n        rate = (self._n_abs - self._n_wall0)\
      \ / wall\n        share = 100.0 * rate / self.samp_rate\n        print(f\"[CSMA]\
      \ {mute} | radio delivers {rate / 1e6:.4f} Msps = {share:.1f} % of samp_rate\
      \ | this block \"\n              f\"uses {100.0 * self._cpu / wall:.0f} % of\
      \ one CPU core\", flush=True)\n        self._windows += 1\n        if self._windows\
      \ >= 2 and share < 99.0:\n            print(f\"[CSMA] WARNING: only {share:.1f}\
      \ % of the samples arrive. The PC is not keeping up and the radio \"\n     \
      \             f\"drops samples, which breaks frames (train word found, CRC fails).\
      \ Close GUI sinks you do not \"\n                  f\"need, run without the\
      \ GUI, or lower samp_rate.\", flush=True)\n        self._wall0, self._n_wall0,\
      \ self._cpu = time.monotonic(), self._n_abs, 0.0\n        self._stat_t0 = self._t\n\
      \        self._busy_time = 0.0\n"
    affinity: ''
    alias: ''
    auto_delay: '1'
    blank_rx: '1'
    comment: 'v6.4: TX attenuation 89.75 dB while idle, CH_GAIN only around own bursts
      (libiio). RX off from release until release + tx_delay + airtime + guard.'

      \ = write, None\n            self._ctx_keepalive = ctx\n            self.backend\
      \ = \"python iio module\"\n            return\n        except Exception as e:\n\
      \            errs.append(f\"python iio module: {e}\")\n        raise RuntimeError(\"\
      ; \".join(errs))\n\n    def _run(self):\n        try:\n            self._open()\n\
      \        except Exception as e:\n            self.failed, self.reason = True,\
      \ str(e)\n            print(f\"[CSMA] TX mute OFF: could not control the radio's\

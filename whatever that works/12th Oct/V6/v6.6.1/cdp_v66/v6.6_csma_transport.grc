      \ {self.uri})\", flush=True)\n        while True:\n            with self._cv:\n\
      \                while (not self._stop and self._seq == self._done_seq\n   \
      \                    and time.monotonic() - self._last_write < 1.0):\n     \
      \               self._cv.wait(timeout=0.25)\n                if self._stop:\n\
      \                    return\n                seq, att = self._seq, self._want\n\
      \            if att is not None:\n                t = time.perf_counter()\n\
      \                try:\n                    self._write(att)\n              \
      \      self.writes += 1\n                    self.write_ms.append(1e3 * (time.perf_counter()\
      \ - t))\n                except Exception as e:\n                    self.errors\
      \ += 1\n                    if self.errors <= 3:\n                        print(f\"\
      [CSMA] TX attenuation write failed: {e}\", flush=True)\n            self._last_write\
      \ = time.monotonic()\n            with self._cv:\n                self._done_seq\
      \ = max(self._done_seq, seq)\n\n\nclass CsmaMac(gr.sync_block):\n    def __init__(self,\
      \ samp_rate=1.5e6, samples_per_byte=32, slot_s=0.015, difs_s=0.020,\n      \
      \           cw_min=8, cw_max=128, cs_margin_db=6.0, cs_hyst_db=2.0, cs_bw_hz=400e3,\n\
      \                 dc_exclude_hz=10e3, nfft=256, sense_s=0.001, floor_window_s=2.0,\n\
      \                 floor_percentile=10.0, floor_rise_db_s=1.0, echo_timeout_s=0.100,\
      \ tail_s=0.002,\n                 blank_rx=1, max_queue=64, max_defer_s=0.0,\
      \ verbose=1, stats_every_s=10.0,\n                 gate_mode=1, tx_delay_s=0.012,\
      \ auto_delay=1, gate_guard_s=0.005,\n                 tx_mute=1, iio_uri=\"\
      ip:192.168.1.10\", tx_att_db=20.0, mute_att_db=89.75,\n                 unmute_timeout_s=0.1,\
      \ echo_margin_db=25.0):\n        gr.sync_block.__init__(self, name=\"CSMA/CA\
      \ MAC + TX mute\", in_sig=[np.complex64], out_sig=[np.complex64])\n        self.samp_rate\
      \ = float(samp_rate)\n        self.samples_per_byte = float(samples_per_byte)\n\
      \        self.slot_s = float(slot_s)\n        self.difs_s = float(difs_s)\n\
      \        self.cw_min = max(1, int(cw_min))\n        self.cw_max = max(self.cw_min,\
      \ int(cw_max))\n        self.cs_margin_db = float(cs_margin_db)\n        self.cs_hyst_db\
      \ = float(cs_hyst_db)\n        self.floor_percentile = float(floor_percentile)\n\
      \        self.floor_rise_db_s = float(floor_rise_db_s)\n        self.echo_timeout_s\
      \ = float(echo_timeout_s)\n        self.tail_s = float(tail_s)\n        self.blank_rx\
      \ = int(blank_rx)\n        self.gate_mode = int(gate_mode)\n        self.tx_delay_s\
      \ = float(tx_delay_s)\n        self.auto_delay = int(auto_delay)\n        self.gate_guard_s\
      \ = float(gate_guard_s)\n        self._sense_s = float(sense_s)\n        self.max_queue\
      \ = max(1, int(max_queue))\n        self.max_defer_s = float(max_defer_s)\n\
      \        self.verbose = int(verbose)\n        self.stats_every_s = float(stats_every_s)\n\
      \        # TX mute (tx_mute and tx_att_db are plain attributes: GRC sliders\

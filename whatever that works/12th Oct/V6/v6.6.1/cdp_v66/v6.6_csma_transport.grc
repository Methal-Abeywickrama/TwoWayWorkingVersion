      \ echo_timeout_s.\", flush=True)\n        self._tx = {}\n\n    # ------------------------------------------------------------------\
      \ one sense step (nfft samples)\n    def _step(self, cs_db):\n        dt = self._dt\n\
      \        thr_on = (self._floor_db if self._floor_db is not None else 1e9) +\

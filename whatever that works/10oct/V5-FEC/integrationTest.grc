- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import struct, pmt\nfrom gnuradio import gr\n\nHDR_FMT  = \">BBBBBBHHQ\"\
      \nHDR_SIZE = struct.calcsize(HDR_FMT)  # 18\n\nPKT_STR   = {0x01:\"SYN\", 0x02:\"\
      SYN_ACK\", 0x03:\"DATA\",\n             0x04:\"ACK\", 0x05:\"FIN\", 0x06:\"\
      FIN_ACK\"}\nMEDIA_STR = {0x01:\"text\", 0x02:\"image\", 0x03:\"audio\"}\n\n\n\
      class blk(gr.sync_block):\n    \"\"\"Block 1: RX Header Parser -- stateless\
      \ 18-byte binary header deserializer.\"\"\"\n\n    def __init__(self):\n   \
      \     gr.sync_block.__init__(self, name='RX Header Parser',\n              \
      \                 in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern(\"\
      pdus\"))\n        self.message_port_register_out(pmt.intern(\"pdus\"))\n   \
      \     self.set_msg_handler(pmt.intern(\"pdus\"), self.handle)\n\n    def handle(self,\
      \ msg):\n        if not pmt.is_pair(msg): return\n        in_meta = pmt.car(msg)\n\
      \        in_data = pmt.cdr(msg)\n        if not pmt.is_u8vector(in_data): return\n\
      \        raw = bytes(pmt.u8vector_elements(in_data))\n        if len(raw) <\
      \ HDR_SIZE: return\n        fields   = struct.unpack_from(HDR_FMT, raw)\n  \
      \      pkt_type = fields[0]\n        if not (0x01 <= pkt_type <= 0x06): return\n\
      \        meta = in_meta if pmt.is_dict(in_meta) else pmt.make_dict()\n     \
      \   for k, v in [\n            (\"pkt_type\",     pmt.intern(PKT_STR.get(pkt_type,\
      \ \"UNKNOWN\"))),\n            (\"pkt_type_raw\", pmt.from_uint64(pkt_type)),\n\
      \            (\"media_type\",   pmt.intern(MEDIA_STR.get(fields[1], \"unknown\"\
      ))),\n            (\"src_addr\",     pmt.from_uint64(fields[2])),\n        \
      \    (\"src_port\",     pmt.from_uint64(fields[3])),\n            (\"dst_addr\"\
      ,     pmt.from_uint64(fields[4])),\n            (\"dst_port\",     pmt.from_uint64(fields[5])),\n\
      \            (\"seq_no\",       pmt.from_uint64(fields[6])),\n            (\"\
      total_pkts\",   pmt.from_uint64(fields[7])),\n            (\"session_id\", \
      \  pmt.from_uint64(fields[8])),\n        ]:\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(k), v)\n        payload  = raw[HDR_SIZE:]\n        out_data = pmt.init_u8vector(len(payload),\
      \ list(payload))\n        self.message_port_pub(pmt.intern(\"pdus\"), pmt.cons(meta,\
      \ out_data))\n\n    def work(self, input_items, output_items):\n        return\
      \ 0\n"
    affinity: ''
    alias: ''
    comment: 'Block 1: RX Header Parser'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''RX Header Parser'', ''blk'', [], [(''pdus'', ''message'', 1)],
      [(''pdus'', ''message'', 1)], ''Block 1: RX Header Parser -- stateless 18-byte
      binary header deserializer.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 1880.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Fast Burst Packet Deframer RX (with\
      \ Hamming FEC)\n- Vectorized NumPy sliding-window sync detection (fast C execution,\
      \ minimal GIL load)\n- Positive correlation search only (180-deg phase ambiguity\
      \ resolved upstream by diff decoder)\n- 1-bit false sync backtracking (prevents\
      \ dropped frames on noise triggers)\n- fec = 0 / 15 / 31 and interleave must\
      \ match the TX framer\n- Hamming decode: header section first (gives the length),\
      \ then payload+CRC section\n- Full CRC32 verification over header + payload\
      \ (after FEC correction)\n- Destination address filtering: drops frames where\
      \ dest_id != peer_id\n- Message deduplication: displays payload once per msg_id,\
      \ then logs burst statistics\n\"\"\"\nimport zlib\nimport numpy as np\nimport\
      \ pmt\nfrom gnuradio import gr\n\nSYNC_WORD = bytes([0x1A, 0xCF, 0xFC, 0x1D])\n\
      HDR_BYTES = 6  # len (2B) + dest_id (1B) + msg_id (1B) + rep (1B) + n_reps (1B)\n\
      \n\ndef hamming_tables(n):\n    \"\"\"Standard positional Hamming layout: parity\
      \ bits at positions 1, 2, 4, 8, (16).\"\"\"\n    m = {15: 4, 31: 5}[n]\n   \
      \ pos = np.arange(1, n + 1)\n    is_parity = (pos & (pos - 1)) == 0\n    data_idx\
      \ = np.flatnonzero(~is_parity)\n    H = ((pos[None, :] >> np.arange(m)[:, None])\
      \ & 1).astype(np.int32)   # m x n, column j = bin(j)\n    weights = (1 << np.arange(m)).astype(np.int32)\n\
      \    return data_idx, H, weights\n\n\ndef hamming_decode_bits(coded, n, nblk,\
      \ interleave):\n    \"\"\"coded: nblk*n bits. Returns (data bits nblk*k, number\
      \ of corrected bits).\"\"\"\n    data_idx, H, weights = hamming_tables(n)\n\
      \    c = np.asarray(coded, dtype=np.int32)\n    cw = c.reshape(n, nblk).T.copy()\
      \ if interleave else c.reshape(nblk, n).copy()\n    S = ((cw @ H.T) & 1) @ weights\
      \          # syndrome = error position (1..n), 0 = no error\n    bad = np.flatnonzero(S)\n\
      \    cw[bad, S[bad] - 1] ^= 1                # flip bit at position S\n    return\
      \ cw[:, data_idx].reshape(-1).astype(np.uint8), int(bad.size)\n\n\nclass PacketDeframerRX(gr.sync_block):\n\
      \    def __init__(self, peer_id=1, max_bit_errors=2, max_payload_len=1024, bit_rate=375000,\n\
      \                 fec=15, interleave=True):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Packet Deframer RX (Fast Burst, Hamming)\"\
      ,\n            in_sig=[np.uint8],\n            out_sig=None,\n        )\n  \
      \      self.peer_id = int(peer_id) & 0xFF\n        self.max_bit_errors = int(max_bit_errors)\n\
      \        self.max_payload_len = int(max_payload_len)\n        self.bit_rate\
      \ = float(bit_rate)\n        self.fec = int(fec)\n        self.interleave =\
      \ bool(interleave)\n        if self.fec not in (0, 15, 31):\n            raise\
      \ ValueError(\"fec must be 0, 15 or 31\")\n\n        # Bipolar template (+1\
      \ / -1) for correlation\n        self._sync = np.unpackbits(np.frombuffer(SYNC_WORD,\
      \ np.uint8)).astype(np.int16) * 2 - 1\n        self._buf = np.zeros(0, dtype=np.uint8)\n\
      \n        self.n_sync = 0\n        self.n_ok = 0\n        self.n_crc_fail =\
      \ 0\n        self.n_bad_len = 0\n        self.n_fec_corrected = 0      # total\
      \ bits corrected by Hamming in CRC-valid frames\n\n        self._bits_total\
      \ = 0\n        self._bits_at_last_ok = 0\n        self._cur_id = None\n    \
      \    self._cur_reps = set()\n        self._cur_nreps = 0\n        self._cur_corr\
      \ = 0\n\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n \
      \       self.message_port_register_out(pmt.intern(\"text_out\"))\n\n    # ----------\
      \ section sizes (in channel bits) ----------\n    def _coded_len(self, n_bytes):\n\
      \        if self.fec == 0:\n            return n_bytes * 8, 0\n        nblk\
      \ = -(-(n_bytes * 8) // {15: 11, 31: 26}[self.fec])\n        return nblk * self.fec,\
      \ nblk\n\n    def _decode_section(self, coded, n_bytes, nblk):\n        if self.fec\
      \ == 0:\n            return np.packbits(coded).tobytes(), 0\n        bits, corr\
      \ = hamming_decode_bits(coded, self.fec, nblk, self.interleave)\n        return\
      \ np.packbits(bits[:n_bytes * 8]).tobytes(), corr\n\n    # ---------- statistics\
      \ / delivery ----------\n    def _flush_summary(self):\n        if self._cur_id\
      \ is not None:\n            got, n = len(self._cur_reps), self._cur_nreps\n\
      \            loss = 100.0 * (n - got) / max(n, 1)\n            fec_txt = f\"\
      , FEC corrected {self._cur_corr} bits\" if self.fec else \"\"\n            print(f\"\
      [RX] msg #{self._cur_id}: {got}/{n} bursts OK (Loss: {loss:.0f}%){fec_txt}\"\
      , flush=True)\n        self._cur_id = None\n        self._cur_reps = set()\n\
      \        self._cur_corr = 0\n\n    def _deliver(self, header, payload, corrected):\n\
      \        dest_id, msg_id, rep, n_reps = header[2], header[3], header[4], header[5]\n\
      \        if msg_id != self._cur_id:\n            self._flush_summary()\n   \
      \         self._cur_id, self._cur_nreps = msg_id, n_reps\n            text =\
      \ payload.decode(\"utf-8\", errors=\"replace\")\n            print(\"\\n\" +\
      \ \"=\" * 40, flush=True)\n            print(f\"[RX RECEIVED] #{msg_id}: {text}\"\
      , flush=True)\n            print(\"=\" * 40 + \"\\n\", flush=True)\n\n     \
      \       meta = pmt.make_dict()\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      dest_id\"), pmt.from_long(dest_id))\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      msg_id\"), pmt.from_long(msg_id))\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      n_reps\"), pmt.from_long(n_reps))\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      fec_corrected\"), pmt.from_long(corrected))\n            vec = pmt.init_u8vector(len(payload),\
      \ list(payload))\n            self.message_port_pub(pmt.intern(\"pdu_out\"),\
      \ pmt.cons(meta, vec))\n            self.message_port_pub(pmt.intern(\"text_out\"\
      ), pmt.intern(text))\n\n        if rep not in self._cur_reps:\n            self._cur_corr\
      \ += corrected\n        self._cur_reps.add(rep)\n        self._bits_at_last_ok\
      \ = self._bits_total\n\n    # ---------- main loop ----------\n    def work(self,\
      \ input_items, output_items):\n        bits = input_items[0] & 1\n        self._bits_total\
      \ += len(bits)\n        self._buf = np.concatenate((self._buf, bits)) if len(self._buf)\
      \ else bits.copy()\n\n        # Flush transmission stats once channel has been\
      \ quiet for > 0.5s of air time\n        if self._cur_id is not None and self._bits_total\
      \ - self._bits_at_last_ok > 0.5 * self.bit_rate:\n            self._flush_summary()\n\
      \n        thr = 32 - 2 * self.max_bit_errors\n        hdr_coded, hdr_blk = self._coded_len(HDR_BYTES)\n\
      \        hdr_bits = 32 + hdr_coded\n\n        while True:\n            buf =\
      \ self._buf\n            if len(buf) < hdr_bits:\n                return len(bits)\n\
      \n            # Fast matrix dot product over 32-bit window (only positive peaks)\n\
      \            pm = buf.astype(np.int16) * 2 - 1\n            corr = np.lib.stride_tricks.sliding_window_view(pm,\
      \ 32) @ self._sync\n            cand = np.flatnonzero(corr >= thr)\n\n     \
      \       if cand.size == 0:\n                self._buf = buf[-31:].copy()  #\
      \ Preserve trailing bits that might begin a sync word\n                return\
      \ len(bits)\n\n            i = int(cand[0])\n\n            if len(buf) < i +\
      \ hdr_bits:\n                self._buf = buf[i:].copy()  # Await complete header\
      \ bits\n                return len(bits)\n\n            header, hdr_corr = self._decode_section(buf[i\
      \ + 32 : i + hdr_bits], HDR_BYTES, hdr_blk)\n            length = int.from_bytes(header[:2],\
      \ \"big\")\n\n            if length == 0 or length > self.max_payload_len:\n\
      \                self.n_bad_len += 1\n                self._buf = buf[i + 1:].copy()\
      \  # Backtrack 1 bit past false sync\n                continue\n\n         \
      \   body_coded, body_blk = self._coded_len(length + 4)\n            end = i\
      \ + hdr_bits + body_coded\n            if len(buf) < end:\n                self._buf\
      \ = buf[i:].copy()  # Await complete frame body bits\n                return\
      \ len(bits)\n\n            body, body_corr = self._decode_section(buf[i + hdr_bits\
      \ : end], length + 4, body_blk)\n            payload, rx_crc = body[:length],\
      \ body[length:]\n            self.n_sync += 1\n\n            if zlib.crc32(header\
      \ + payload) == int.from_bytes(rx_crc, \"big\"):\n                corrected\
      \ = hdr_corr + body_corr\n                self.n_fec_corrected += corrected\n\
      \                dest_id = header[2]\n                if dest_id == self.peer_id:\n\
      \                    self.n_ok += 1\n                    self._deliver(header,\
      \ payload, corrected)\n                # Frame addressed to another peer: discard\
      \ silently\n                self._buf = buf[end:].copy()  # Advance past valid\
      \ frame\n            else:\n                self.n_crc_fail += 1\n         \
      \       self._buf = buf[i + 1:].copy()  # Backtrack 1 bit past false sync\n\n\
      \        return len(bits)\n"
    affinity: ''
    alias: ''
    bit_rate: '375000'
    comment: ''
    fec: FEC
    interleave: 'True'
    max_bit_errors: '1'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    peer_id: (1-MY_ID)
  states:
    _io_cache: ('Packet Deframer RX (Fast Burst, Hamming)', 'PacketDeframerRX', [('peer_id',
      '1'), ('max_bit_errors', '2'), ('max_payload_len', '1024'), ('bit_rate', '375000'),
      ('fec', '15'), ('interleave', 'True')], [('0', 'byte', 1)], [('text_out', 'message',
      1), ('pdu_out', 'message', 1)], '', ['bit_rate', 'fec', 'interleave', 'max_bit_errors',
      'max_payload_len', 'peer_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 1696.0]
    rotation: 180
    state: enabled
- name: epy_block_0_0_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX (Hamming\
      \ FEC + equalizer training word)\n- Outputs packed byte PDUs directly to pdu_pdu_to_tagged_stream\n\
      - Frame layout:\n    [preamble] [train word: F8 DD 42 58] [sync: 1A CF FC 1D]\
      \ [coded section(s)] [postamble]\n  Before coding the sections are:  header\
      \ = [len:2B][dest_id:1B][msg_id:1B][rep:1B][n_reps:1B]\n                   \
      \                body   = [payload][CRC32 over header+payload: 4B]\n- fec =\
      \ 0  : header + body sent uncoded (identical to the non-FEC framer)\n  fec =\
      \ 15 : Hamming(15,11)    fec = 31 : Hamming(31,26)\n  Preamble, train word and\
      \ sync word are never coded (the correlator / deframer look for them as raw\
      \ bits).\n  Header and body are two separate coded sections (the receiver decodes\
      \ the header first to learn the length);\n  the coded bits are bit-for-bit what\
      \ the previous FEC framer produced, so a deframer written for that\n  format\
      \ still decodes them. Anything after the body is ignored by the receiver.\n\
      - interleave = True: each section's codewords are sent column by column (burst-error\
      \ protection)\n- The train word is known to the RX: the correlator finds it,\
      \ tags it, and the equalizer trains on it.\n  It must match TRAIN_BITS in the\
      \ flowgraph.\n- Postamble: pads the frame to a whole number of Pluto sink buffers\
      \ (buffer_size is in SAMPLES, so one\n  buffer = buffer_size / samples_per_byte\
      \ bytes) and is never shorter than one buffer. The TX pulse-shaping\n  filter\
      \ holds back ~86 samples and the sink holds back the last partial buffer; both\
      \ fall inside the\n  postamble, so no frame bits are lost or delayed.\n\"\"\"\
      \nimport zlib\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nSYNC_WORD\
      \ = bytes([0x1A, 0xCF, 0xFC, 0x1D])\n# 31-bit m-sequence + 1 pad bit. MUST match\
      \ TRAIN_BITS in the flowgraph (RX side).\nTRAIN_WORD = bytes([0xF8, 0xDD, 0x42,\
      \ 0x58])\n\n\ndef hamming_tables(n):\n    \"\"\"Standard positional Hamming\
      \ layout: parity bits at positions 1, 2, 4, 8, (16).\"\"\"\n    m = {15: 4,\
      \ 31: 5}[n]\n    pos = np.arange(1, n + 1)\n    is_parity = (pos & (pos - 1))\
      \ == 0\n    data_idx = np.flatnonzero(~is_parity)          # 0-based indices\
      \ of data positions\n    par_idx = np.flatnonzero(is_parity)            # 0-based\
      \ indices of 1, 2, 4, 8, (16)\n    P = ((pos[data_idx, None] >> np.arange(m))\
      \ & 1).astype(np.int32)   # k x m\n    return data_idx, par_idx, P\n\n\ndef\
      \ hamming_encode_bits(bits, n, interleave):\n    \"\"\"bits: 0/1 array. Pads\
      \ to a multiple of k, returns the coded bit array.\"\"\"\n    data_idx, par_idx,\
      \ P = hamming_tables(n)\n    k = len(data_idx)\n    nblk = -(-len(bits) // k)\n\
      \    d = np.zeros(nblk * k, dtype=np.int32)\n    d[:len(bits)] = bits\n    d\
      \ = d.reshape(nblk, k)\n    cw = np.zeros((nblk, n), dtype=np.uint8)\n    cw[:,\
      \ data_idx] = d\n    cw[:, par_idx] = (d @ P) & 1\n    return (cw.T if interleave\
      \ else cw).reshape(-1)\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(self,\
      \ peer_id=1, preamble_len=64, repeat_count=1, max_payload_len=1024,\n      \
      \           preamble_byte=0xFF, buffer_size=2048, postamble_byte=0xFF, train_enable=1,\n\
      \                 fec=15, interleave=1, samples_per_byte=32):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"Packet Framer TX (Burst, FEC)\",\n  \
      \          in_sig=None,\n            out_sig=None,\n        )\n        self.peer_id\
      \ = int(peer_id) & 0xFF\n        self.preamble_len = int(preamble_len)\n   \
      \     self.repeat_count = int(repeat_count)\n        self.max_payload_len =\
      \ int(max_payload_len)\n        self.preamble_byte = int(preamble_byte) & 0xFF\n\
      \        self.buffer_size = int(buffer_size)              # Pluto sink buffer,\
      \ in SAMPLES\n        self.postamble_byte = int(postamble_byte) & 0xFF\n   \
      \     self.train_enable = int(train_enable)\n        self.fec = int(fec)\n \
      \       self.interleave = bool(int(interleave))\n        self.samples_per_byte\
      \ = max(1, int(samples_per_byte))   # 8 bits * samples/symbol (BPSK)\n     \
      \   if self.fec not in (0, 15, 31):\n            raise ValueError(\"fec must\
      \ be 0, 15 or 31\")\n        self._msg_id = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      msg_in\"))\n        self.set_msg_handler(pmt.intern(\"msg_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    @staticmethod\n\
      \    def _extract_payload(msg):\n        if pmt.is_pair(msg):\n            data\
      \ = pmt.cdr(msg)\n            if pmt.is_u8vector(data):\n                return\
      \ bytes(pmt.u8vector_elements(data))\n            return str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        if pmt.is_symbol(msg):\n            return pmt.symbol_to_string(msg).encode(\"\
      utf-8\")\n        val = pmt.to_python(msg)\n        if isinstance(val, (bytes,\
      \ bytearray)):\n            return bytes(val)\n        return str(val).encode(\"\
      utf-8\")\n\n    def _encode_section(self, data):\n        bits = np.unpackbits(np.frombuffer(data,\
      \ dtype=np.uint8))\n        return hamming_encode_bits(bits, self.fec, self.interleave)\n\
      \n    def _coded_body(self, header, payload):\n        \"\"\"Everything after\
      \ the sync word: header + payload + CRC, coded if fec != 0.\"\"\"\n        crc\
      \ = zlib.crc32(header + payload).to_bytes(4, \"big\")\n        if self.fec ==\
      \ 0:\n            return header + payload + crc\n        coded = np.concatenate((self._encode_section(header),\n\
      \                                self._encode_section(payload + crc)))\n   \
      \     return np.packbits(coded).tobytes()               # pads the last byte\
      \ with 0s\n\n    def _postamble_len(self, raw_len):\n        \"\"\"Bytes of\
      \ postamble: at least one sink buffer, and total a whole number of buffers.\"\
      \"\"\n        if self.buffer_size <= 0:\n            return 0\n        unit\
      \ = max(1, -(-self.buffer_size // self.samples_per_byte))    # bytes per sink\
      \ buffer\n        need = raw_len + unit                                    \
      \       # leave one full buffer of postamble\n        return (-(-need // unit))\
      \ * unit - raw_len\n\n    def build_frame(self, header, payload):\n        preamble\
      \ = bytes([self.preamble_byte]) * self.preamble_len\n        train = TRAIN_WORD\
      \ if self.train_enable else b\"\"\n        raw = preamble + train + SYNC_WORD\
      \ + self._coded_body(header, payload)\n        return raw + bytes([self.postamble_byte])\
      \ * self._postamble_len(len(raw))\n\n    def handle_msg(self, msg):\n      \
      \  try:\n            payload = self._extract_payload(msg)\n        except Exception\
      \ as e:\n            print(f\"[TX] Could not parse message: {e}\", flush=True)\n\
      \            return\n\n        if not payload:\n            return\n\n     \
      \   if len(payload) > self.max_payload_len:\n            print(f\"[TX] Payload\
      \ {len(payload)} B truncated to {self.max_payload_len} B\", flush=True)\n  \
      \          payload = payload[: self.max_payload_len]\n\n        msg_id = self._msg_id\n\
      \        self._msg_id = (self._msg_id + 1) & 0xFF\n        n_reps = max(1, min(255,\
      \ self.repeat_count))\n\n        fec_txt = \"no FEC\" if self.fec == 0 else\
      \ f\"Hamming({self.fec},{self.fec - (4 if self.fec == 15 else 5)})\"\n     \
      \   print(\n            f\"[TX] msg #{msg_id} (to peer {self.peer_id}): '{payload.decode('utf-8',\
      \ 'replace')}' \"\n            f\"({n_reps} bursts queued, {fec_txt})\",\n \
      \           flush=True,\n        )\n\n        for rep in range(n_reps):\n  \
      \          header = len(payload).to_bytes(2, \"big\") + bytes([self.peer_id,\
      \ msg_id, rep, n_reps])\n            frame = self.build_frame(header, payload)\n\
      \n            # Build metadata dictionary with tx_sob and tx_eob tags\n    \
      \        meta = pmt.make_dict()\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      tx_sob\"), pmt.PMT_T)\n            meta = pmt.dict_add(meta, pmt.intern(\"tx_eob\"\
      ), pmt.PMT_T)\n\n            # Explicit offset tags for downstream PDU-to-Tagged-Stream\
      \ conversion\n            sob_tag = pmt.make_tuple(pmt.from_long(0), pmt.intern(\"\
      tx_sob\"), pmt.PMT_T)\n            eob_tag = pmt.make_tuple(pmt.from_long(len(frame)\
      \ - 1), pmt.intern(\"tx_eob\"), pmt.PMT_T)\n            extra_tags = pmt.list2(sob_tag,\
      \ eob_tag)\n            meta = pmt.dict_add(meta, pmt.intern(\"extra_tags\"\
      ), extra_tags)\n\n            vec = pmt.init_u8vector(len(frame), list(frame))\n\
      \            self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(meta, vec))"
    affinity: ''
    alias: ''
    buffer_size: BUFFER_SIZE
    comment: ''
    fec: FEC
    interleave: 'True'
    max_payload_len: max_payload_len
    maxoutbuf: '0'
    minoutbuf: '0'
    peer_id: MY_ID
    postamble_byte: '0xFF'
    preamble_byte: '0xFF'
    preamble_len: '128'
    repeat_count: '1'
    samples_per_byte: 8*sps
    train_enable: '1'
  states:
    _io_cache: ('Packet Framer TX (Burst, FEC)', 'PacketFramerTX', [('peer_id', '1'),
      ('preamble_len', '64'), ('repeat_count', '1'), ('max_payload_len', '1024'),
      ('preamble_byte', '255'), ('buffer_size', '2048'), ('postamble_byte', '255'),
      ('train_enable', '1'), ('fec', '15'), ('interleave', '1'), ('samples_per_byte',
      '32')], [('msg_in', 'message', 1)], [('pdu_out', 'message', 1)], '', ['buffer_size',
      'fec', 'interleave', 'max_payload_len', 'peer_id', 'postamble_byte', 'preamble_byte',

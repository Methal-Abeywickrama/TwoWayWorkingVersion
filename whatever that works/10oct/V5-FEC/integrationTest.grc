- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import struct, pmt\nfrom gnuradio import gr\n\nHDR_FMT    = \"\
      >BBBBBBHHQ\"\nPKT_CODE   = {\"SYN\":0x01, \"SYN_ACK\":0x02, \"DATA\":0x03,\n\
      \              \"ACK\":0x04, \"FIN\":0x05, \"FIN_ACK\":0x06}\nMEDIA_CODE = {\"\
      text\":0x01, \"image\":0x02, \"audio\":0x03}\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Block 3: TX Header Serializer -- stateless 18-byte binary header\
      \ serializer.\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(self,\
      \ name='TX Header Serializer',\n                               in_sig=None,\
      \ out_sig=None)\n        self.message_port_register_in(pmt.intern(\"pdus\"))\n\
      \        self.message_port_register_out(pmt.intern(\"pdus\"))\n        self.set_msg_handler(pmt.intern(\"\
      pdus\"), self.handle)\n\n    def handle(self, msg):\n        if not pmt.is_pair(msg):\
      \ return\n        meta = pmt.car(msg); data = pmt.cdr(msg)\n        if not pmt.is_dict(meta):\
      \ return\n        def gu(k, d=0):\n            return pmt.to_uint64(pmt.dict_ref(meta,\
      \ pmt.intern(k), pmt.from_uint64(d)))\n        def gs(k, d=\"\"):\n        \
      \    return pmt.symbol_to_string(pmt.dict_ref(meta, pmt.intern(k), pmt.intern(d)))\n\
      \        hdr = struct.pack(HDR_FMT,\n            PKT_CODE.get(gs(\"pkt_type\"\
      ), 0),\n            MEDIA_CODE.get(gs(\"media_type\"), 0),\n            gu(\"\
      src_addr\") & 0xFF, gu(\"src_port\") & 0xFF,\n            gu(\"dst_addr\") &\
      \ 0xFF, gu(\"dst_port\") & 0xFF,\n            gu(\"seq_no\")    & 0xFFFF,\n\
      \            gu(\"total_pkts\") & 0xFFFF,\n            gu(\"session_id\"))\n\
      \        payload  = bytes(pmt.u8vector_elements(data)) if pmt.is_u8vector(data)\
      \ else b\"\"\n        frame    = hdr + payload\n        out_data = pmt.init_u8vector(len(frame),\
      \ list(frame))\n        self.message_port_pub(pmt.intern(\"pdus\"), pmt.cons(meta,\
      \ out_data))\n\n    def work(self, input_items, output_items):\n        return\
      \ 0\n"
    affinity: ''
    alias: ''
    comment: 'Block 3: TX Header Serializer'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''TX Header Serializer'', ''blk'', [], [(''pdus'', ''message'', 1)],
      [(''pdus'', ''message'', 1)], ''Block 3: TX Header Serializer -- stateless 18-byte
      binary header serializer.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1192, 1896.0]
    rotation: 0
    state: enabled
- name: epy_block_corr
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Training-word correlator (drop-in\
      \ for digital_corr_est_cc)\n- Input : complex stream at 2 samples/symbol (symbol\
      \ sync output)\n- Output: the same stream delayed by a fixed EVEN number of\
      \ samples (so tags can be placed in the past\n  without shifting the symbol\
      \ / midpoint sample phase)\n- Slides the reference (TRAIN_REF) over the stream\
      \ and computes the NORMALIZED correlation\n      rho = |sum(conj(ref) * x)|^2\
      \ / (E_ref * E_window)      (0..1, independent of signal amplitude)\n  Where\
      \ rho has a local maximum above thr it adds a 'corr_est' tag (and 'corr_start')\
      \ on the\n  first training symbol, shifted by mark_delay samples. Random data\
      \ gives rho ~ 0.1-0.25; a real\n  training word gives ~0.8-1.0, so thr ~ 0.6-0.7\
      \ is a good start. The tag value is rho.\n- Pure numpy, bounds-checked: no use\
      \ of GNU Radio's corr_est_cc.\n\"\"\"\nimport numpy as np\nimport pmt\nfrom\
      \ gnuradio import gr\n\n\nclass TrainCorr(gr.sync_block):\n    def __init__(self,\
      \ ref=None, thr=0.7, mark_delay=0, verbose=1):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Training-word Correlator\",\n       \
      \     in_sig=[np.complex64],\n            out_sig=[np.complex64],\n        )\n\
      \        if ref is None:\n            ref = [1.0]\n        self._ref = np.asarray(ref,\
      \ dtype=np.complex64)\n        self._L = len(self._ref)\n        self._E = float(np.sum(np.abs(self._ref)\
      \ ** 2))\n        self.thr = float(thr)\n        self.mark_delay = max(0, int(mark_delay))\n\
      \        self.verbose = int(verbose)\n        # Output delay: >= L + 3 so every\
      \ peak is examined exactly once, and a MULTIPLE OF 2 (samples per\n        #\
      \ symbol) so the symbol-timed samples stay on even stream indices -- the linear\
      \ equalizer takes\n        # the first sample of every 2-sample block, so an\
      \ odd delay would make it sample the midpoints.\n        self._D = self._L +\
      \ 8\n        self._D += self._D % 2\n        self.set_history(self._D + 1)\n\
      \        self._next_p = 0               # first absolute input index not yet\
      \ examined\n        self._last_p = -10**12         # last tagged absolute input\
      \ index\n        self._seen = 0                 # samples since last status\
      \ line\n        self._best = 0.0               # strongest normalized correlation\
      \ since last status line\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        out = output_items[0]\n        n_out =\
      \ len(out)\n        out[:] = x[:n_out]             # in[i] <-> absolute input\
      \ index a-D+i  ==  output index a+i\n\n        a = self.nitems_written(0)\n\
      \        base = a - self._D             # absolute input index of x[0]\n   \
      \     if len(x) < self._L + 5:\n            return n_out\n        c = np.correlate(x,\
      \ self._ref, \"valid\")                  # window starting at x[n]\n       \
      \ w = np.convolve(np.abs(x).astype(np.float64) ** 2, np.ones(self._L), \"valid\"\
      )\n        m = (np.abs(c).astype(np.float64) ** 2) / (self._E * w + 1e-12) \
      \   # normalized, 0..1\n        self._best = max(self._best, float(m.max()))\n\
      \        self._seen += n_out\n\n        n0 = max(self._next_p - base, 2, -base)\
      \       # first window start to examine (p >= 0)\n        n1 = len(m) - 3  \
      \                             # last start with 2 neighbours on the right\n\
      \        if n1 >= n0:\n            seg = m[n0 - 2 : n1 + 3]\n            mid\
      \ = seg[2:-2]\n            thr_abs = self.thr\n            cond = (\n      \
      \          (mid > thr_abs)\n                & (mid > seg[0:-4]) & (mid > seg[1:-3])\n\
      \                & (mid >= seg[3:-1]) & (mid >= seg[4:])\n            )\n  \
      \          for j in np.flatnonzero(cond):\n                p = base + n0 + int(j)\n\
      \                if p - self._last_p < self._L:\n                    continue\n\
      \                self._last_p = p\n                ratio = float(mid[j])\n \
      \               off = int(p + self._D + self.mark_delay)    # output index;\
      \ always >= a\n                val = pmt.from_double(ratio)\n              \
      \  self.add_item_tag(0, off, pmt.intern(\"corr_start\"), val)\n            \
      \    self.add_item_tag(0, off, pmt.intern(\"corr_est\"), val)\n            \
      \    self._best = 0.0\n                self._seen = 0\n                if self.verbose:\n\
      \                    print(f\"[CORR] train word found: correlation = {ratio:.2f}\
      \ (thr {self.thr:.2f})\", flush=True)\n            self._next_p = base + n1\
      \ + 1\n\n        if self.verbose and self._seen > 400000:\n            if self._best\
      \ > 0.35:\n                print(f\"[CORR] no tag; strongest correlation in\
      \ last window = {self._best:.2f} (thr {self.thr:.2f})\", flush=True)\n     \
      \       self._best = 0.0\n            self._seen = 0\n        return n_out\n"
    affinity: ''
    alias: ''
    comment: Python replacement for digital_corr_est_cc (avoids its out-of-range read).
    mark_delay: train_delay
    maxoutbuf: '0'
    minoutbuf: '0'
    ref: TRAIN_REF
    thr: corr_thr
    verbose: '1'
  states:
    _io_cache: ('Training-word Correlator', 'TrainCorr', [('ref', 'None'), ('thr',
      '0.7'), ('mark_delay', '0'), ('verbose', '1')], [('0', 'complex', 1)], [('0',
      'complex', 1)], '', ['mark_delay', 'thr', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2048, 632.0]
    rotation: 0
    state: enabled
- name: epy_noise
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Noise-floor tracker -> automatic\
      \ squelch threshold\n- Sink block: connect it to the SDR source output (BEFORE\
      \ any squelch/AGC).\n- Splits the stream into short slices (default ~1 ms),\
      \ keeps the mean power of each slice for the\n  last `window_s` seconds, and\
      \ takes a low percentile of them as the noise floor (bursts only occupy\n  the\
      \ top of the distribution, so they are ignored as long as the channel is idle\
      \ > `percentile` % of the time).\n- level() returns the squelch threshold in\
      \ dB:  noise floor (dB) + margin_db, clamped to\n  [thr_min, thr_max]. The estimate\
      \ falls immediately but rises at most `rise_db_s` dB per second, so a\n  long\
      \ burst or a back-to-back transmission cannot drag the threshold up and close\
      \ the squelch.\n- Use with a \"Function Probe\" variable named power_threshold:\
      \  block id = this block, function = level,\n  poll rate ~ 5 Hz. The Pluto/squelch\
      \ power unit is the same: dB of mean |x|^2.\n\"\"\"\nimport threading\nimport\
      \ time\nfrom collections import deque\n\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\nclass NoiseFloor(gr.sync_block):\n    def __init__(self, samp_rate=1.5e6,\
      \ margin_db=6.0, window_s=1.0, percentile=10.0,\n                 rise_db_s=1.0,\
      \ thr_min=-100.0, thr_max=-20.0, init_db=-40.0, verbose=1):\n        gr.sync_block.__init__(self,\
      \ name=\"Noise Floor Tracker\", in_sig=[np.complex64], out_sig=None)\n     \
      \   self.samp_rate = float(samp_rate)\n        self.margin_db = float(margin_db)\n\
      \        self.window_s = float(window_s)\n        self.percentile = float(percentile)\n\
      \        self.rise_db_s = float(rise_db_s)\n        self.thr_min = float(thr_min)\n\
      \        self.thr_max = float(thr_max)\n        self.init_db = float(init_db)\n\
      \        self.verbose = int(verbose)\n\n        self._slice = max(64, int(self.samp_rate\
      \ * 1e-3))            # ~1 ms\n        n_slices = max(16, int(self.window_s\
      \ * self.samp_rate / self._slice))\n        self._ring = deque(maxlen=n_slices)\n\
      \        self._min_slices = max(8, n_slices // 4)                       # wait\
      \ for 1/4 window before trusting\n        self._carry = np.zeros(0, np.float32)\n\
      \        self._lock = threading.Lock()\n        self._est_db = None\n      \
      \  self._t_last = None\n        self._out = self.init_db\n        self._printed\
      \ = None\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        n = len(x)\n        if n == 0:\n            return 0\n        p = x.real.astype(np.float32)\
      \ ** 2 + x.imag.astype(np.float32) ** 2\n        if self._carry.size:\n    \
      \        p = np.concatenate((self._carry, p))\n        k = len(p) // self._slice\n\
      \        if k:\n            means = p[: k * self._slice].reshape(k, self._slice).mean(axis=1,\
      \ dtype=np.float64)\n            with self._lock:\n                self._ring.extend(means)\n\
      \        self._carry = p[k * self._slice:]\n        return n\n\n    def noise_db(self):\n\
      \        return self._est_db\n\n    def level(self):\n        \"\"\"Called by\
      \ the Function Probe variable: returns the squelch threshold in dB.\"\"\"\n\
      \        with self._lock:\n            arr = np.fromiter(self._ring, dtype=np.float64,\
      \ count=len(self._ring))\n        if arr.size < self._min_slices:\n        \
      \    return self._out\n        raw_db = 10.0 * np.log10(max(float(np.percentile(arr,\
      \ self.percentile)), 1e-20))\n        now = time.monotonic()\n        if self._est_db\
      \ is None:\n            self._est_db = raw_db\n        else:\n            dt\
      \ = max(0.0, now - self._t_last)\n            if raw_db <= self._est_db:\n \
      \               self._est_db = raw_db\n            else:\n                self._est_db\
      \ = min(raw_db, self._est_db + self.rise_db_s * dt)\n        self._t_last =\
      \ now\n        self._out = float(min(self.thr_max, max(self.thr_min, self._est_db\
      \ + self.margin_db)))\n        if self.verbose and (self._printed is None or\
      \ abs(self._out - self._printed) >= 1.0):\n            print(f\"[SQL] noise\
      \ floor {self._est_db:.1f} dB -> squelch threshold {self._out:.1f} dB\", flush=True)\n\
      \            self._printed = self._out\n        return self._out\n"
    affinity: ''
    alias: ''
    comment: ''
    init_db: '-40.0'
    margin_db: margin_db
    maxoutbuf: '0'
    minoutbuf: '0'
    percentile: '10.0'
    rise_db_s: '1.0'
    samp_rate: samp_rate
    thr_max: '-20.0'
    thr_min: '-100.0'
    verbose: '1'
    window_s: '1.0'
  states:
    _io_cache: ('Noise Floor Tracker', 'NoiseFloor', [('samp_rate', '1500000.0'),
      ('margin_db', '6.0'), ('window_s', '1.0'), ('percentile', '10.0'), ('rise_db_s',
      '1.0'), ('thr_min', '-100.0'), ('thr_max', '-20.0'), ('init_db', '-40.0'), ('verbose',
      '1')], [('0', 'complex', 1)], [], '', ['init_db', 'margin_db', 'percentile',
      'rise_db_s', 'samp_rate', 'thr_max', 'thr_min', 'verbose', 'window_s'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 1156.0]
    rotation: 0
    state: enabled

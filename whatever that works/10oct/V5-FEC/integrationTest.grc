options:
  parameters:
    author: mushab404
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: transeciever
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'CDP transeciever '
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: ADDR
  id: variable
  parameters:
    comment: ''
    value: os.environ.get('SDR_URI', 'ip:192.168.1.10')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 92.0]
    rotation: 0
    state: enabled
- name: BPSK_CONST
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[1+0j, -1+0j]'
    imag_sect: '1'
    precision: '8'
    real_sect: '2'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 452.0]
    rotation: 0
    state: enabled
- name: BUFFER_SIZE
  id: variable
  parameters:
    comment: ''
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 176.0]
    rotation: 0
    state: enabled
- name: CH_GAIN
  id: variable
  parameters:
    comment: ''
    value: '20.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 88.0]
    rotation: 0
    state: enabled
- name: FEC
  id: variable
  parameters:
    comment: '0 = no FEC

      15 = Hamming(15,11)

      31 = Hamming(31,26)'
    value: '31'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 176.0]
    rotation: 0
    state: enabled
- name: FILTER_BW
  id: variable
  parameters:
    comment: ''
    value: int(1e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1616, 176.0]
    rotation: 0
    state: enabled
- name: MY_ID
  id: variable
  parameters:
    comment: 'Frequency plan: 0 -> TX 1250 / RX 1270 MHz, 1 -> TX 1270 / RX 1250 MHz.
      Env MY_ID, else derived from TL_LOCAL_ADDR (1 -> 0, anything else -> 1).'
    value: int(os.environ.get('MY_ID', '0' if tl_local_addr == 1 else '1'))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 12.0]
    rotation: 0
    state: enabled
- name: QPSK_CONST
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 148.0]
    rotation: 0
    state: enabled
- name: RC_PULSE
  id: variable
  parameters:
    comment: ''
    value: np.sinc(RC_X)*np.cos(np.pi*alpha*RC_X)/(1-(2*alpha*RC_X)**2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 256.0]
    rotation: 0
    state: enabled
- name: RC_X
  id: variable
  parameters:
    comment: ''
    value: np.arange(-8, 9)/2.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 256.0]
    rotation: 0
    state: enabled
- name: RX_AMP
  id: variable
  parameters:
    comment: ''
    value: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 256.0]
    rotation: 0
    state: enabled
- name: RX_FREQ
  id: variable
  parameters:
    comment: ''
    value: TX_FREQ_A if MY_ID == 1 else TX_FREQ_B
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1520, 176.0]
    rotation: 0
    state: enabled
- name: SDR_CF
  id: variable
  parameters:
    comment: ''
    value: 433e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 92.0]
    rotation: 0
    state: enabled
- name: TRAIN_BITS
  id: variable
  parameters:
    comment: ''
    value: np.unpackbits(np.frombuffer(bytes([0xF8, 0xDD, 0x42, 0x58]), np.uint8))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 256.0]
    rotation: 0
    state: enabled
- name: TRAIN_REF
  id: variable
  parameters:
    comment: ''
    value: list(map(complex, RX_AMP*np.convolve(np.kron(TRAIN_SYMS, [1, 0]), RC_PULSE)[8:8+2*len(TRAIN_SYMS)-1]))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 336.0]
    rotation: 0
    state: enabled
- name: TRAIN_SYMS
  id: variable
  parameters:
    comment: ''
    value: list(map(complex, 1 - 2*np.bitwise_xor.accumulate(TRAIN_BITS).astype(int)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 256.0]
    rotation: 0
    state: enabled
- name: TX_FREQ
  id: variable
  parameters:
    comment: ''
    value: TX_FREQ_A if MY_ID == 0 else TX_FREQ_B
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 176.0]
    rotation: 0
    state: enabled
- name: TX_FREQ_A
  id: variable
  parameters:
    comment: ''
    value: int(1250e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 176.0]
    rotation: 0
    state: enabled
- name: TX_FREQ_B
  id: variable
  parameters:
    comment: ''
    value: int(1270e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 176.0]
    rotation: 0
    state: enabled
- name: adpt_alg
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: BPSK_CONST
    delta: '10.0'
    ffactor: '0.99'
    modulus: '2'
    step_size: '0.5'
    type: nlms
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 660.0]
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 12.0]
    rotation: 0
    state: enabled
- name: corr_thr
  id: variable_qtgui_range
  parameters:
    comment: Normalized correlation threshold (0..1). Random data ~0.1-0.25, real
      train word ~0.8-1.0.
    gui_hint: ''
    label: ''
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.3'
    step: '0.01'
    stop: '0.98'
    value: '0.7'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 16.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
  parameters:
    comment: ''
    value: '0.06'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 92.0]
    rotation: 0
    state: enabled
- name: fll_loop_bw
  id: variable
  parameters:
    comment: ''
    value: '0.01'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 16.0]
    rotation: 0
    state: enabled
- name: margin_db
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Squelch margin over noise (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '2'
    step: '0.5'
    stop: '20'
    value: '6'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 16.0]
    rotation: 0
    state: enabled
- name: max_payload_len

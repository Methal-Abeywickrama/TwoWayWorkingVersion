- name: epy_block_0_0
  id: epy_block
  parameters: {_source_code: "\"\"\"\nEmbedded Python Block: Burst Packet Framer TX\
      \ (with training word)\n- Outputs packed byte PDUs directly to pdu_pdu_to_tagged_stream\n\
      - Zero idle transmission (idle between bursts = complete silence)\n- No idle\
      \ bytes after the frame except the short postamble below\n- Frame layout:\n\
      \  [preamble] [TRAIN: 4B PN] [1A CF FC 1D] [len: 2B][dest_id: 1B][msg_id: 1B][rep:\
      \ 1B][n_reps: 1B] [payload] [CRC32: 4B] [postamble]\n- CRC32 covers header +\
      \ payload (preamble / training word / sync are not covered)\n- TRAIN is a 31-bit\
      \ m-sequence + 1 pad bit (0xF8 0xDD 0x42 0x58). It is used by the receiver's\n\
      \  equalizer (correlator tag + training_sequence); the deframer ignores it,\
      \ it only searches the sync word.\n- Set train_enable = 0 to send the old frame\
      \ layout (no training word).\n- POSTAMBLE (postamble_len bytes of 0xAA, default\
      \ 4): the TX pulse-shaping filter (pfb_arb_resampler) holds\n  back its last\
      \ ~(11*sps^2 - sps)/2 = 86 samples (~21 symbols, ~2.7 bytes at sps=4) until\
      \ more input arrives.\n  Without a postamble the last bits of the CRC would\
      \ not leave the filter. The deframer ignores trailing bytes.\n\"\"\"\nimport\
      \ zlib\nimport pmt\nfrom gnuradio import gr\n\nSYNC_WORD = bytes([0x1A, 0xCF,\
      \ 0xFC, 0x1D])\n\n# 31-bit m-sequence (x^5 + x^3 + 1) + 1 pad bit -> 32 bits.\n\
      # Autocorrelation of the 31 bits: 31 at lag 0, -1 elsewhere.\nTRAIN_WORD = bytes([0xF8,\
      \ 0xDD, 0x42, 0x58])\n\n\nclass PacketFramerTX(gr.basic_block):\n    def __init__(self,\
      \ peer_id=1, preamble_len=4, repeat_count=1, max_payload_len=1024,\n       \
      \          preamble_byte=0xFF, train_enable=1, postamble_len=4):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"Packet Framer TX (Burst)\",\n       \
      \     in_sig=None,\n            out_sig=None,\n        )\n        self.peer_id\
      \ = int(peer_id) & 0xFF\n        self.preamble_len = int(preamble_len)\n   \
      \     self.repeat_count = int(repeat_count)\n        self.max_payload_len =\
      \ int(max_payload_len)\n        self.preamble_byte = int(preamble_byte) & 0xFF\n\
      \        self.train_enable = int(train_enable)\n        self.postamble_len =\
      \ max(0, int(postamble_len))\n        self._msg_id = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      msg_in\"))\n        self.set_msg_handler(pmt.intern(\"msg_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    @staticmethod\n\
      \    def _extract_payload(msg):\n        if pmt.is_pair(msg):\n            data\
      \ = pmt.cdr(msg)\n            if pmt.is_u8vector(data):\n                return\
      \ bytes(pmt.u8vector_elements(data))\n            return str(pmt.to_python(data)).encode(\"\
      utf-8\")\n        if pmt.is_symbol(msg):\n            return pmt.symbol_to_string(msg).encode(\"\
      utf-8\")\n        val = pmt.to_python(msg)\n        if isinstance(val, (bytes,\
      \ bytearray)):\n            return bytes(val)\n        return str(val).encode(\"\
      utf-8\")\n\n    def handle_msg(self, msg):\n        try:\n            payload\
      \ = self._extract_payload(msg)\n        except Exception as e:\n           \
      \ print(f\"[TX] Could not parse message: {e}\", flush=True)\n            return\n\
      \n        if not payload:\n            return\n\n        if len(payload) > self.max_payload_len:\n\
      \            print(f\"[TX] Payload {len(payload)} B truncated to {self.max_payload_len}\
      \ B\", flush=True)\n            payload = payload[:self.max_payload_len]\n\n\
      \        msg_id = self._msg_id\n        self._msg_id = (self._msg_id + 1) &\
      \ 0xFF\n        n_reps = max(1, min(255, self.repeat_count))\n\n        preamble\
      \ = bytes([self.preamble_byte]) * self.preamble_len\n        train = TRAIN_WORD\
      \ if self.train_enable else b\"\"\n        postamble = bytes([0xAA]) * self.postamble_len\n\
      \        print(f\"[TX] msg #{msg_id} (to peer {self.peer_id}): '{payload.decode('utf-8',\
      \ 'replace')}' ({n_reps} bursts queued)\", flush=True)\n\n        for rep in\
      \ range(n_reps):\n            header = len(payload).to_bytes(2, \"big\") + bytes([self.peer_id,\
      \ msg_id, rep, n_reps])\n            crc = zlib.crc32(header + payload).to_bytes(4,\
      \ \"big\")\n            frame = preamble + train + SYNC_WORD + header + payload\
      \ + crc + postamble\n\n            vec = pmt.init_u8vector(len(frame), list(frame))\n\
      \            self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(pmt.PMT_NIL,\
      \ vec))", affinity: '', alias: '', comment: '', max_payload_len: max_payload_len,
    maxoutbuf: '0', minoutbuf: '0', peer_id: 1 - MY_ID, preamble_byte: '0xFF', preamble_len: PREAMBLE_LEN,
    repeat_count: '1', train_enable: '1', postamble_len: POSTAMBLE_LEN}
  states:
    _io_cache: ('Packet Framer TX (Burst)', 'PacketFramerTX', [('peer_id', '1'), ('preamble_len',
      '4'), ('repeat_count', '1'), ('max_payload_len', '1024'), ('preamble_byte',
      '255'), ('train_enable', '1'), ('postamble_len', '4')], [('msg_in', 'message',
      1)], [('pdu_out', 'message', 1)], '', ['max_payload_len', 'peer_id', 'postamble_len',
      'preamble_byte', 'preamble_len', 'repeat_count', 'train_enable'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 1752.0]
    rotation: 180
    state: enabled
- name: epy_block_0_0_0
  id: epy_block
  parameters: {_source_code: "\"\"\"\nEmbedded Python Block: Fast Burst Packet Deframer\
      \ RX\n- Vectorized NumPy sliding-window sync detection (fast C execution, minimal\
      \ GIL load)\n- Positive correlation search only (180-deg phase ambiguity resolved\
      \ upstream by diff decoder)\n- 1-bit false sync backtracking (prevents dropped\
      \ frames on noise triggers)\n- Full CRC32 verification over header + payload\n\
      - Destination address filtering: drops frames where dest_id != peer_id\n- Message\
      \ deduplication: displays payload once per msg_id, then logs burst statistics\n\
      \"\"\"\nimport zlib\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\
      \nSYNC_WORD = bytes([0x1A, 0xCF, 0xFC, 0x1D])\nHDR_BYTES = 6  # len (2B) + dest_id\
      \ (1B) + msg_id (1B) + rep (1B) + n_reps (1B)\n\n\nclass PacketDeframerRX(gr.sync_block):\n\
      \    def __init__(self, peer_id=1, max_bit_errors=2, max_payload_len=1024, bit_rate=375000):\n\
      \        gr.sync_block.__init__(\n            self,\n            name=\"Packet\
      \ Deframer RX (Fast Burst)\",\n            in_sig=[np.uint8],\n            out_sig=None,\n\
      \        )\n        self.peer_id = int(peer_id) & 0xFF\n        self.max_bit_errors\
      \ = int(max_bit_errors)\n        self.max_payload_len = int(max_payload_len)\n\
      \        self.bit_rate = float(bit_rate)\n\n        # Bipolar template (+1 /\
      \ -1) for correlation\n        self._sync = np.unpackbits(np.frombuffer(SYNC_WORD,\
      \ np.uint8)).astype(np.int16) * 2 - 1\n        self._buf = np.zeros(0, dtype=np.uint8)\n\
      \n        self.n_sync = 0\n        self.n_ok = 0\n        self.n_crc_fail =\
      \ 0\n        self.n_bad_len = 0\n\n        self._bits_total = 0\n        self._bits_at_last_ok\
      \ = 0\n        self._cur_id = None\n        self._cur_reps = set()\n       \
      \ self._cur_nreps = 0\n\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n        self.message_port_register_out(pmt.intern(\"text_out\"\
      ))\n\n    def _flush_summary(self):\n        if self._cur_id is not None:\n\
      \            got, n = len(self._cur_reps), self._cur_nreps\n            loss\
      \ = 100.0 * (n - got) / max(n, 1)\n            print(f\"[RX] msg #{self._cur_id}:\
      \ {got}/{n} bursts OK (Loss: {loss:.0f}%)\", flush=True)\n        self._cur_id\
      \ = None\n        self._cur_reps = set()\n\n    def _deliver(self, header, payload):\n\
      \        dest_id, msg_id, rep, n_reps = header[2], header[3], header[4], header[5]\n\
      \        if msg_id != self._cur_id:\n            self._flush_summary()\n   \
      \         self._cur_id, self._cur_nreps = msg_id, n_reps\n            text =\
      \ payload.decode(\"utf-8\", errors=\"replace\")\n            print(\"\\n\" +\
      \ \"=\" * 40, flush=True)\n            print(f\"[RX RECEIVED] #{msg_id}: {text}\"\
      , flush=True)\n            print(\"=\" * 40 + \"\\n\", flush=True)\n\n     \
      \       meta = pmt.make_dict()\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      dest_id\"), pmt.from_long(dest_id))\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      msg_id\"), pmt.from_long(msg_id))\n            meta = pmt.dict_add(meta, pmt.intern(\"\
      n_reps\"), pmt.from_long(n_reps))\n            vec = pmt.init_u8vector(len(payload),\
      \ list(payload))\n            self.message_port_pub(pmt.intern(\"pdu_out\"),\
      \ pmt.cons(meta, vec))\n            self.message_port_pub(pmt.intern(\"text_out\"\
      ), pmt.intern(text))\n\n        self._cur_reps.add(rep)\n        self._bits_at_last_ok\
      \ = self._bits_total\n\n    def work(self, input_items, output_items):\n   \
      \     bits = input_items[0] & 1\n        self._bits_total += len(bits)\n   \
      \     self._buf = np.concatenate((self._buf, bits)) if len(self._buf) else bits.copy()\n\
      \n        # Flush transmission stats once channel has been quiet for > 0.5s\
      \ of air time\n        if self._cur_id is not None and self._bits_total - self._bits_at_last_ok\
      \ > 0.5 * self.bit_rate:\n            self._flush_summary()\n\n        thr =\
      \ 32 - 2 * self.max_bit_errors\n        hdr_bits = 32 + HDR_BYTES * 8\n\n  \
      \      while True:\n            buf = self._buf\n            if len(buf) < hdr_bits:\n\
      \                return len(bits)\n\n            # Fast matrix dot product over\
      \ 32-bit window (only positive peaks)\n            pm = buf.astype(np.int16)\
      \ * 2 - 1\n            corr = np.lib.stride_tricks.sliding_window_view(pm, 32)\
      \ @ self._sync\n            cand = np.flatnonzero(corr >= thr)\n\n         \
      \   if cand.size == 0:\n                self._buf = buf[-31:].copy()  # Preserve\
      \ trailing bits that might begin a sync word\n                return len(bits)\n\
      \n            i = int(cand[0])\n\n            if len(buf) < i + hdr_bits:\n\
      \                self._buf = buf[i:].copy()  # Await complete header bits\n\
      \                return len(bits)\n\n            header = np.packbits(buf[i\
      \ + 32 : i + hdr_bits]).tobytes()\n            length = int.from_bytes(header[:2],\
      \ \"big\")\n\n            if length == 0 or length > self.max_payload_len:\n\
      \                self.n_bad_len += 1\n                self._buf = buf[i + 1:].copy()\
      \  # Backtrack 1 bit past false sync\n                continue\n\n         \
      \   end = i + 32 + (HDR_BYTES + length + 4) * 8\n            if len(buf) < end:\n\
      \                self._buf = buf[i:].copy()  # Await complete frame body bits\n\
      \                return len(bits)\n\n            body = np.packbits(buf[i +\
      \ 32 : end]).tobytes()\n            hdr, payload, rx_crc = body[:HDR_BYTES],\
      \ body[HDR_BYTES : HDR_BYTES + length], body[-4:]\n            self.n_sync +=\
      \ 1\n\n            if zlib.crc32(hdr + payload) == int.from_bytes(rx_crc, \"\
      big\"):\n                dest_id = hdr[2]\n                if dest_id == self.peer_id:\n\
      \                    self.n_ok += 1\n                    self._deliver(hdr,\
      \ payload)\n                # Frame addressed to another peer: discard silently\n\
      \                self._buf = buf[end:].copy()  # Advance past valid frame\n\
      \            else:\n                self.n_crc_fail += 1\n                self._buf\
      \ = buf[i + 1:].copy()  # Backtrack 1 bit past false sync\n\n        return\
      \ len(bits)", affinity: '', alias: '', bit_rate: '375000', comment: '', max_bit_errors: '1',
    max_payload_len: max_payload_len, maxoutbuf: '0', minoutbuf: '0', peer_id: MY_ID}
  states:
    _io_cache: ('Packet Deframer RX (Fast Burst)', 'PacketDeframerRX', [('peer_id',
      '1'), ('max_bit_errors', '2'), ('max_payload_len', '1024'), ('bit_rate', '375000')],
      [('0', 'byte', 1)], [('text_out', 'message', 1), ('pdu_out', 'message', 1)],
      '', ['bit_rate', 'max_bit_errors', 'max_payload_len', 'peer_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 1736.0]
    rotation: 180
    state: enabled

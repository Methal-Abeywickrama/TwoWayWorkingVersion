    bus_source: false
    bus_structure: null
    coordinate: [1176, 112]
    rotation: 0
    state: enabled
- name: TRAIN_LEN
  id: variable
  parameters: {comment: Training word bytes (fixed by TRAIN_WORD in framer). Do not
      change., value: '4'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 112]
    rotation: 0
    state: enabled
- name: POSTAMBLE_LEN
  id: variable
  parameters: {comment: Bytes after the CRC that flush the TX pulse-shaping filter.
      Keep >= 3., value: '4'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 112]
    rotation: 0
    state: enabled
- name: BURST_SAMPLES
  id: variable
  parameters: {comment: Samples in every burst = Pluto sink buffer_size. 14 = sync
      4 + header 6 + CRC 4., value: (PREAMBLE_LEN+TRAIN_LEN+14+max_payload_len+POSTAMBLE_LEN)*8*sps}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 192]
    rotation: 0
    state: enabled

- name: epy_block_0
  id: epy_block
  parameters: {_source_code: "\"\"\"\nEmbedded Python Block: Burst Pad (fixed-length\
      \ zero fill)\n\nPads every modulated burst with ZERO SAMPLES (silence, not modulated\
      \ bytes) up to a fixed\nlength, so each burst is exactly as long as the Pluto/ANTSDR\
      \ sink buffer. The gr-iio sink in\ntagged mode only accepts packets whose length\
      \ equals its buffer_size.\n\nMessage ports (PDUs of complex samples):\n    pdu_in\
      \  : PDU with a c32vector (the modulated frame, length L samples)\n    pdu_out\
      \ : PDU with a c32vector of exactly TARGET samples = frame + (TARGET - L) zeros\n\
      \nTARGET = (preamble_len + train_len + sync 4 + header 6 + max_payload_len +\
      \ crc 4 + postamble_len) * samples_per_byte\n         i.e. the length of the\
      \ LARGEST frame the framer can produce.\nSet the sink's buffer_size to this\
      \ same number (the block prints it at start-up).\n\nFrames longer than TARGET\
      \ cannot be sent as one buffer; they are dropped with an error message.\n\"\"\
      \"\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nSYNC_BYTES =\
      \ 4\nHDR_BYTES = 6   # len(2) + dest_id + msg_id + rep + n_reps\nCRC_BYTES =\
      \ 4\n\n\ndef burst_samples(max_payload_len, preamble_len, train_len, samples_per_byte,\
      \ postamble_len=0):\n    \"\"\"Length in samples of the largest frame the framer\
      \ can emit.\"\"\"\n    nbytes = (int(preamble_len) + int(train_len) + SYNC_BYTES\
      \ + HDR_BYTES\n              + int(max_payload_len) + CRC_BYTES + int(postamble_len))\n\
      \    return nbytes * int(samples_per_byte)\n\n\ndef pad_to(samples, target):\n\
      \    \"\"\"Return `samples` followed by zeros, exactly `target` long (complex64).\"\
      \"\"\n    out = np.zeros(int(target), dtype=np.complex64)\n    out[:len(samples)]\
      \ = samples\n    return out\n\n\nclass BurstPad(gr.basic_block):\n    def __init__(self,\
      \ max_payload_len=1024, preamble_len=16, train_len=4,\n                 samples_per_byte=32,\
      \ postamble_len=0, verbose=1):\n        gr.basic_block.__init__(\n         \
      \   self,\n            name=\"Burst Pad (zero fill)\",\n            in_sig=None,\n\
      \            out_sig=None,\n        )\n        self.max_payload_len = int(max_payload_len)\n\
      \        self.preamble_len = int(preamble_len)\n        self.train_len = int(train_len)\n\
      \        self.samples_per_byte = int(samples_per_byte)\n        self.postamble_len\
      \ = int(postamble_len)\n        self.verbose = int(verbose)\n\n        self.target\
      \ = burst_samples(self.max_payload_len, self.preamble_len,\n               \
      \                     self.train_len, self.samples_per_byte, self.postamble_len)\n\
      \        self.n_sent = 0\n        self.n_dropped = 0\n\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_pdu)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n       \
      \ print(f\"[PAD] every burst = {self.target} samples \"\n              f\"({self.target\
      \ // max(self.samples_per_byte, 1)} bytes). \"\n              f\"Set the sink\
      \ buffer_size to {self.target}.\", flush=True)\n\n    def handle_pdu(self, msg):\n\
      \        if not pmt.is_pair(msg):\n            self.n_dropped += 1\n       \
      \     print(\"[PAD] dropped: message is not a PDU (pair)\", flush=True)\n  \
      \          return\n\n        data = pmt.cdr(msg)\n        if not pmt.is_c32vector(data):\n\
      \            self.n_dropped += 1\n            print(\"[PAD] dropped: PDU payload\
      \ is not a complex (c32) vector\", flush=True)\n            return\n\n     \
      \   samples = np.array(pmt.c32vector_elements(data), dtype=np.complex64)\n \
      \       n = len(samples)\n        if n == 0:\n            return\n\n       \
      \ if n > self.target:\n            self.n_dropped += 1\n            print(f\"\
      [PAD] dropped: frame is {n} samples but the fixed burst is only \"\n       \
      \           f\"{self.target}. Increase max_payload_len / check preamble_len,\
      \ train_len, \"\n                  f\"samples_per_byte.\", flush=True)\n   \
      \         return\n\n        out = pad_to(samples, self.target)\n        vec\
      \ = pmt.init_c32vector(self.target, out.tolist())\n        self.message_port_pub(pmt.intern(\"\
      pdu_out\"), pmt.cons(pmt.PMT_NIL, vec))\n        self.n_sent += 1\n\n      \
      \  if self.verbose:\n            print(f\"[PAD] burst {self.n_sent}: {n} samples\
      \ ({n / self.samples_per_byte:.1f} B) \"\n                  f\"+ {self.target\
      \ - n} zeros = {self.target}\", flush=True)", affinity: '', alias: '', comment: '',
    max_payload_len: max_payload_len, maxoutbuf: '0', minoutbuf: '0', preamble_len: PREAMBLE_LEN,
    samples_per_byte: 8*sps, train_len: TRAIN_LEN, verbose: '', postamble_len: POSTAMBLE_LEN}
  states:
    _io_cache: ('Burst Pad (zero fill)', 'BurstPad', [('max_payload_len', '1024'),
      ('preamble_len', '16'), ('train_len', '4'), ('samples_per_byte', '32'), ('postamble_len',
      '0'), ('verbose', '1')], [('pdu_in', 'message', 1)], [('pdu_out', 'message',
      1)], '', ['max_payload_len', 'postamble_len', 'preamble_len', 'samples_per_byte',

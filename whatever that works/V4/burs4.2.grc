    coordinate: [592, 12.0]
    rotation: 0
    state: enabled
- name: QPSK_CONST
  id: variable_constellation_rect
  parameters: {comment: '', const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]', imag_sect: '2',
    precision: '8', real_sect: '2', rot_sym: '4', soft_dec_lut: None, sym_map: '[0,
      1, 3, 2]', w_imag_sect: '1', w_real_sect: '1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 148.0]
    rotation: 0
    state: enabled
- name: RC_PULSE
  id: variable
  parameters: {comment: '', value: np.sinc(RC_X)*np.cos(np.pi*alpha*RC_X)/(1-(2*alpha*RC_X)**2)}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 256.0]
    rotation: 0
    state: enabled
- name: RC_X
  id: variable
  parameters: {comment: '', value: 'np.arange(-8, 9)/2.0'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 256.0]
    rotation: 0
    state: enabled
- name: RX_AMP
  id: variable
  parameters: {comment: '', value: '1.0'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 256.0]
    rotation: 0
    state: enabled
- name: SDR_CF
  id: variable
  parameters: {comment: '', value: 433e6}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 112.0]
    rotation: 0
    state: enabled
- name: TRAIN_BITS
  id: variable
  parameters: {comment: '', value: 'np.unpackbits(np.frombuffer(bytes([0xF8, 0xDD,
      0x42, 0x58]), np.uint8))'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 256.0]
    rotation: 0
    state: enabled
- name: TRAIN_REF
  id: variable
  parameters: {comment: '', value: 'list(map(complex, RX_AMP*np.convolve(np.kron(TRAIN_SYMS,
      [1, 0]), RC_PULSE)[8:8+2*len(TRAIN_SYMS)-1]))'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 336.0]
    rotation: 0
    state: enabled
- name: TRAIN_SYMS
  id: variable
  parameters: {comment: '', value: 'list(map(complex, 1 - 2*np.bitwise_xor.accumulate(TRAIN_BITS).astype(int)))'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 256.0]
    rotation: 0
    state: enabled

- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import struct, pmt\nfrom gnuradio import gr\n\nHDR_FMT    = \"\
      >BBBBBBHHQ\"\nPKT_CODE   = {\"SYN\":0x01, \"SYN_ACK\":0x02, \"DATA\":0x03,\n\
      \              \"ACK\":0x04, \"FIN\":0x05, \"FIN_ACK\":0x06}\nMEDIA_CODE = {\"\
      text\":0x01, \"image\":0x02, \"audio\":0x03}\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Block 3: TX Header Serializer -- stateless 18-byte binary header\
      \ serializer.\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(self,\
      \ name='TX Header Serializer',\n                               in_sig=None,\
      \ out_sig=None)\n        self.message_port_register_in(pmt.intern(\"pdus\"))\n\
      \        self.message_port_register_out(pmt.intern(\"pdus\"))\n        self.set_msg_handler(pmt.intern(\"\
      pdus\"), self.handle)\n\n    def handle(self, msg):\n        if not pmt.is_pair(msg):\
      \ return\n        meta = pmt.car(msg); data = pmt.cdr(msg)\n        if not pmt.is_dict(meta):\
      \ return\n        def gu(k, d=0):\n            return pmt.to_uint64(pmt.dict_ref(meta,\
      \ pmt.intern(k), pmt.from_uint64(d)))\n        def gs(k, d=\"\"):\n        \
      \    return pmt.symbol_to_string(pmt.dict_ref(meta, pmt.intern(k), pmt.intern(d)))\n\
      \        hdr = struct.pack(HDR_FMT,\n            PKT_CODE.get(gs(\"pkt_type\"\
      ), 0),\n            MEDIA_CODE.get(gs(\"media_type\"), 0),\n            gu(\"\
      src_addr\") & 0xFF, gu(\"src_port\") & 0xFF,\n            gu(\"dst_addr\") &\
      \ 0xFF, gu(\"dst_port\") & 0xFF,\n            gu(\"seq_no\")    & 0xFFFF,\n\
      \            gu(\"total_pkts\") & 0xFFFF,\n            gu(\"session_id\"))\n\
      \        payload  = bytes(pmt.u8vector_elements(data)) if pmt.is_u8vector(data)\
      \ else b\"\"\n        frame    = hdr + payload\n        out_data = pmt.init_u8vector(len(frame),\
      \ list(frame))\n        self.message_port_pub(pmt.intern(\"pdus\"), pmt.cons(meta,\
      \ out_data))\n\n    def work(self, input_items, output_items):\n        return\
      \ 0\n"
    affinity: ''
    alias: ''
    comment: 'Block 3: TX Header Serializer'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''TX Header Serializer'', ''blk'', [], [(''pdus'', ''message'', 1)],
      [(''pdus'', ''message'', 1)], ''Block 3: TX Header Serializer -- stateless 18-byte
      binary header serializer.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
